      "${QWEN_GRAMMAR_UNIT_SHA256}" /opt/qwen38/qwen_grammar_unit.py \
    | sha256sum --check --strict
RUN printf '%s  %s\n%s  %s\n%s  %s\n' \
      "${ABSTRACT_PARSER_PATCHED_FILE_SHA256}" \
        /usr/local/lib/python3.12/dist-packages/vllm/parser/abstract_parser.py \
      "${PARSER_ADAPTERS_PATCHED_FILE_SHA256}" \
