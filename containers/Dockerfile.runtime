    | sha256sum --check --strict
ARG ENGINE_PROTOCOL_UPSTREAM_FILE_SHA256
RUN printf '%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n' \
      "${CACHE_CONFIG_UPSTREAM_FILE_SHA256}" \
