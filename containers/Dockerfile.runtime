      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_vl.py \
    | sha256sum --check --strict
ARG CACHE_CONFIG_UPSTREAM_FILE_SHA256
ARG VLLM_CONFIG_UPSTREAM_FILE_SHA256
ARG ARG_UTILS_UPSTREAM_FILE_SHA256
ARG LLM_ENTRYPOINT_UPSTREAM_FILE_SHA256
