ARG BASE_IMAGE=qwen38-vllm:main-9df9b0b

FROM ${BASE_IMAGE} AS upstream-verifier
ARG TURBOQUANT_UPSTREAM_FILE_SHA256
ARG TURBOQUANT_STORE_UPSTREAM_FILE_SHA256
ARG TURBOQUANT_DECODE_UPSTREAM_FILE_SHA256
RUN printf '%s  %s\n' \
      "${TURBOQUANT_STORE_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_turboquant_store.py \
      "${TURBOQUANT_DECODE_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/triton_turboquant_decode.py \
    | sha256sum --check --strict
ARG TOOL_SCHEMA_UPSTREAM_FILE_SHA256
ARG TOOL_PARSER_ABSTRACT_UPSTREAM_FILE_SHA256
ARG TOOL_CALL_FILTER_UPSTREAM_FILE_SHA256
RUN printf '%s  %s\n' \
      "${TOOL_PARSER_ABSTRACT_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/abstract_tool_parser.py \
      "${TOOL_CALL_FILTER_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/utils/tool_calls_utils.py \
    | sha256sum --check --strict
ARG MODEL_CONFIG_UPSTREAM_FILE_SHA256
ARG ANTHROPIC_PROTOCOL_UPSTREAM_FILE_SHA256
ARG ANTHROPIC_SERVING_UPSTREAM_FILE_SHA256
ARG ERROR_RESPONSE_UPSTREAM_FILE_SHA256
ARG EXCEPTION_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256
ARG HTTP_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256
ARG VALIDATION_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256
ARG VLLM_ERROR_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256
RUN printf '%s  %s\n' \
      "${ERROR_RESPONSE_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/exception_handling/error_response.py \
      "${EXCEPTION_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/exception_handling/handlers/exception.py \
      "${HTTP_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/exception_handling/handlers/http.py \
      "${VALIDATION_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/exception_handling/handlers/validation.py \
      "${VLLM_ERROR_EXCEPTION_HANDLER_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/exception_handling/handlers/vllm_error.py \
    | sha256sum --check --strict
ARG CHAT_PROTOCOL_UPSTREAM_FILE_SHA256
ARG SAMPLING_PARAMS_UPSTREAM_FILE_SHA256
ARG SCHED_UTILS_UPSTREAM_FILE_SHA256
ARG INPUT_PROCESSOR_UPSTREAM_FILE_SHA256
ARG REQUEST_UPSTREAM_FILE_SHA256
ARG QWEN3_PARSER_UPSTREAM_FILE_SHA256
ARG STRUCTURED_OUTPUT_UPSTREAM_FILE_SHA256
ARG ANTHROPIC_API_ROUTER_UPSTREAM_FILE_SHA256
ARG CHAT_SERVING_UPSTREAM_FILE_SHA256
ARG RESPONSES_CONTEXT_UPSTREAM_FILE_SHA256
ARG RESPONSES_PROTOCOL_UPSTREAM_FILE_SHA256
ARG RESPONSES_SERVING_UPSTREAM_FILE_SHA256
ARG RESPONSES_STREAMING_UPSTREAM_FILE_SHA256
ARG RESPONSES_UTILS_UPSTREAM_FILE_SHA256
ARG PARSER_ENGINE_UPSTREAM_FILE_SHA256
ARG KV_OFFLOAD_WORKER_UPSTREAM_FILE_SHA256
ARG WORKSPACE_UPSTREAM_FILE_SHA256
ARG GPU_MODEL_RUNNER_UPSTREAM_FILE_SHA256
ARG API_UTILS_UPSTREAM_FILE_SHA256
ARG ENVS_UPSTREAM_FILE_SHA256
ARG CHAT_UTILS_UPSTREAM_FILE_SHA256
ARG MEDIA_CONNECTOR_UPSTREAM_FILE_SHA256
ARG IMAGE_MEDIA_UPSTREAM_FILE_SHA256
ARG RENDER_PARAMS_UPSTREAM_FILE_SHA256
ARG QWEN3_VL_MODEL_UPSTREAM_FILE_SHA256
RUN printf '%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n%s  %s\n' \
      "${TURBOQUANT_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/turboquant_attn.py \
      "${TOOL_SCHEMA_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/structural_tag_registry.py \
      "${MODEL_CONFIG_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/config/model.py \
      "${ANTHROPIC_PROTOCOL_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/protocol.py \
      "${ANTHROPIC_SERVING_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/serving.py \
      "${CHAT_PROTOCOL_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/chat_completion/protocol.py \
      "${SAMPLING_PARAMS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/sampling_params.py \
      "${SCHED_UTILS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/utils.py \
      "${INPUT_PROCESSOR_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/engine/input_processor.py \
      "${REQUEST_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/request.py \
      "${QWEN3_PARSER_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/parser/qwen3.py \
      "${STRUCTURED_OUTPUT_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/structured_output/__init__.py \
      "${ANTHROPIC_API_ROUTER_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/api_router.py \
      "${CHAT_SERVING_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/chat_completion/serving.py \
      "${RESPONSES_CONTEXT_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/context.py \
      "${RESPONSES_PROTOCOL_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/protocol.py \
      "${RESPONSES_SERVING_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/serving.py \
      "${RESPONSES_STREAMING_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/streaming_events.py \
      "${RESPONSES_UTILS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/utils.py \
      "${PARSER_ENGINE_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/parser/engine/parser_engine.py \
      "${KV_OFFLOAD_WORKER_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/gpu_worker.py \
    | sha256sum --check --strict
RUN printf '%s  %s\n%s  %s\n%s  %s\n' \
      "${WORKSPACE_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/workspace.py \
      "${GPU_MODEL_RUNNER_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_model_runner.py \
      "${API_UTILS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/serve/utils/api_utils.py \
    | sha256sum --check --strict
RUN printf '%s  %s\n' \
      "${ENVS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/envs.py \
      "${CHAT_UTILS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/chat_utils.py \
      "${MEDIA_CONNECTOR_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/multimodal/media/connector.py \
      "${IMAGE_MEDIA_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/multimodal/media/image.py \
      "${RENDER_PARAMS_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/renderers/params.py \
    | sha256sum --check --strict
RUN printf '%s  %s\n' \
      "${QWEN3_VL_MODEL_UPSTREAM_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_vl.py \
    | sha256sum --check --strict
ARG CACHE_CONFIG_UPSTREAM_FILE_SHA256
ARG VLLM_CONFIG_UPSTREAM_FILE_SHA256
ARG ARG_UTILS_UPSTREAM_FILE_SHA256
ARG LLM_ENTRYPOINT_UPSTREAM_FILE_SHA256
ARG KV_CACHE_UTILS_UPSTREAM_FILE_SHA256
ARG GPU_WORKER_UPSTREAM_FILE_SHA256
ARG STARTUP_PLAN_UPSTREAM_FILE_SHA256
ARG KV_OFFLOAD_CONFIG_UPSTREAM_FILE_SHA256
ARG KV_OFFLOAD_BASE_UPSTREAM_FILE_SHA256
ARG KV_OFFLOAD_CPU_SPEC_UPSTREAM_FILE_SHA256
ARG KV_OFFLOAD_CPU_MANAGER_UPSTREAM_FILE_SHA256
ARG KV_TIERING_SPEC_UPSTREAM_FILE_SHA256
ARG KV_TIERING_MANAGER_UPSTREAM_FILE_SHA256
