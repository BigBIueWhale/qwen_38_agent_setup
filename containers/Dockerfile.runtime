ARG REASONING_USAGE_UNIT_SHA256
# The verified pristine policy modules are removed, not replaced: the
# scope-aware manager is the only eviction mode, and a stranded importable
# copy of the pluggable LRU/ARC layer would be exactly the leftover this
# stage exists to eliminate. Absence is asserted like any other hash.
RUN rm /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/__init__.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/base.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/factory.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/lru.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/arc.py \
 && rm -rf /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies/__pycache__ \
 && rmdir /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies \
 && test ! -e /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/policies
RUN install --directory --mode=0755 /opt/qwen38
COPY --chmod=0644 \
  vllm/vllm/v1/attention/backends/turboquant_attn.py \
  /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/turboquant_attn.py
COPY --chmod=0644 \
  vllm/vllm/tool_parsers/structural_tag_registry.py \
  /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/structural_tag_registry.py
COPY --chmod=0644 \
  vllm/vllm/config/model.py \
  /usr/local/lib/python3.12/dist-packages/vllm/config/model.py
COPY --chmod=0644 \
  vllm/vllm/entrypoints/anthropic/protocol.py \
  /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/protocol.py
COPY --chmod=0644 \
  vllm/vllm/entrypoints/anthropic/serving.py \
  /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/serving.py
COPY --chmod=0644 \
