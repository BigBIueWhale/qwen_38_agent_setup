      "${PARSER_ENGINE_CONFIG_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/parser/engine/parser_engine_config.py \
      "${STREAMING_PARSER_ENGINE_UPSTREAM_FILE_SHA256}" /usr/local/lib/python3.12/dist-packages/vllm/parser/engine/streaming_parser_engine.py \
