ARG OFFLOAD_CONNECTOR_SCHEDULER_UPSTREAM_FILE_SHA256
ARG COMPLETION_PROTOCOL_UPSTREAM_FILE_SHA256
ARG GENERATE_API_ROUTER_UPSTREAM_FILE_SHA256
