        /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/llm.py \
      "${KV_CACHE_UTILS_PATCHED_FILE_SHA256}" \
        /usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py \
