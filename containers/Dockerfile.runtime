      /usr/local/lib/python3.12/dist-packages/vllm/v1/request.py \
      "${QWEN3_PARSER_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/parser/qwen3.py \
      "${STRUCTURED_OUTPUT_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/structured_output/__init__.py \
      "${ANTHROPIC_API_ROUTER_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/anthropic/api_router.py \
      "${CHAT_SERVING_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/chat_completion/serving.py \
      "${RESPONSES_CONTEXT_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/context.py \
      "${RESPONSES_PROTOCOL_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/protocol.py \
      "${RESPONSES_SERVING_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/serving.py \
      "${RESPONSES_STREAMING_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/streaming_events.py \
      "${RESPONSES_UTILS_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/entrypoints/openai/responses/utils.py \
      "${PARSER_ENGINE_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/parser/engine/parser_engine.py \
      "${KV_OFFLOAD_WORKER_PATCHED_FILE_SHA256}" \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/kv_offload/cpu/gpu_worker.py \
      "${AGENT_CHAT_TEMPLATE_SHA256}" \
      /opt/qwen38/chat_template.jinja \
      "${PHASE_BUDGET_UNIT_SHA256}" \
      /opt/qwen38/phase_budget_unit.py \
    | sha256sum --check --strict
# Every installed unit is executed here, each as the file it ships as. The
# grammar unit's assertions were an inline heredoc until they went stale
# against the vLLM-owned Qwen builder and killed two multi-hour builds; as a
# file the same bytes are also one of the units `./scripts/build-vllm.sh check`
# runs in seconds, so the image and the check can never run different source.
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/shared_prefix_cache_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/raw_media_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/generate_result_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/tool_output_parser_unit.py
RUN CUDA_VISIBLE_DEVICES= TRITON_INTERPRET=1 python3 /opt/qwen38/turboquant_guard_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/qwen_grammar_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/chat_template_retention_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/phase_budget_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/reasoning_usage_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/vision_workspace_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/vision_contract_unit.py
RUN CUDA_VISIBLE_DEVICES= python3 /opt/qwen38/vision_mlp_unit.py

# The upstream image already contains the fixed non-root `vllm` identity
# (uid 2000, gid 0).  Create the persistent cache mountpoint with the runtime's
# exact ownership.  The host lifecycle separately initializes a newly-created
# named volume through this exact image and refuses drift; it deliberately does
# not depend on Docker volume copy-up semantics.
RUN test "$(getent passwd vllm)" = 'vllm:x:2000:0::/home/vllm:/bin/bash' \
 && install --directory --owner=2000 --group=0 --mode=0770 \
      /home/vllm/.cache/vllm \
 && test "$(stat -c '%u:%g:%a' /home/vllm/.cache/vllm)" = '2000:0:770'

# Every provenance label reads the build argument the build just verified, so
# no label can describe bytes the image does not carry: one label per review
# diff, one per file whose final hash a stage pins, one for the template.
LABEL org.opencontainers.image.revision="9df9b0b0a1816b6d0d0f6ecd0da563cc37fd72f5" \
      qwen38.base.image="sha256:fa4a002a88b7043a1a89966dea8a500fe9696f84e75730d9da916f916048d401" \
      qwen38.patch.turboquant.diff.sha256="${TURBOQUANT_PATCH_DIFF_SHA256}" \
      qwen38.patch.turboquant.file.sha256="${TURBOQUANT_PATCHED_FILE_SHA256}" \
      qwen38.patch.tool-schema.diff.sha256="${TOOL_SCHEMA_PATCH_DIFF_SHA256}" \
      qwen38.patch.tool-schema.file.sha256="${TOOL_SCHEMA_PATCHED_FILE_SHA256}" \
      qwen38.patch.agent-defaults.diff.sha256="${AGENT_DEFAULTS_PATCH_DIFF_SHA256}" \
      qwen38.patch.phase-budgets.diff.sha256="${PHASE_BUDGET_PATCH_DIFF_SHA256}" \
      qwen38.patch.implicit-tool-grammar.diff.sha256="${IMPLICIT_TOOL_GRAMMAR_PATCH_DIFF_SHA256}" \
      qwen38.patch.implicit-tool-grammar.qwen3-file.sha256="${QWEN3_PARSER_PATCHED_FILE_SHA256}" \
      qwen38.patch.implicit-tool-grammar.manager-file.sha256="${STRUCTURED_OUTPUT_PATCHED_FILE_SHA256}" \
      qwen38.patch.anthropic-validation-http400.diff.sha256="${ANTHROPIC_VALIDATION_PATCH_DIFF_SHA256}" \
      qwen38.patch.anthropic-validation-http400.file.sha256="${ANTHROPIC_API_ROUTER_PATCHED_FILE_SHA256}" \
      qwen38.patch.tool-truncation.diff.sha256="${TOOL_TRUNCATION_PATCH_DIFF_SHA256}" \
      qwen38.patch.tool-truncation.chat-serving-file.sha256="${CHAT_SERVING_PATCHED_FILE_SHA256}" \
      qwen38.patch.tool-truncation.responses-serving-file.sha256="${RESPONSES_SERVING_PATCHED_FILE_SHA256}" \
      qwen38.patch.tool-truncation.parser-engine-file.sha256="${PARSER_ENGINE_PATCHED_FILE_SHA256}" \
      qwen38.patch.vision-runtime.diff.sha256="${VISION_RUNTIME_PATCH_DIFF_SHA256}" \
      qwen38.patch.workspace.file.sha256="${WORKSPACE_PATCHED_FILE_SHA256}" \
      qwen38.patch.gpu-model-runner.file.sha256="${GPU_MODEL_RUNNER_PATCHED_FILE_SHA256}" \
      qwen38.patch.api-utils.file.sha256="${API_UTILS_PATCHED_FILE_SHA256}" \
      qwen38.patch.envs.file.sha256="${ENVS_PATCHED_FILE_SHA256}" \
      qwen38.patch.chat-utils.file.sha256="${CHAT_UTILS_PATCHED_FILE_SHA256}" \
      qwen38.patch.media-connector.file.sha256="${MEDIA_CONNECTOR_PATCHED_FILE_SHA256}" \
      qwen38.patch.image-media.file.sha256="${IMAGE_MEDIA_PATCHED_FILE_SHA256}" \
      qwen38.patch.qwen3-vl-model.file.sha256="${QWEN3_VL_MODEL_PATCHED_FILE_SHA256}" \
      qwen38.patch.render-params.file.sha256="${RENDER_PARAMS_PATCHED_FILE_SHA256}" \
      qwen38.patch.numerical-audits.diff.sha256="${NUMERICAL_AUDITS_PATCH_DIFF_SHA256}" \
      qwen38.patch.turboquant-guards.diff.sha256="${TURBOQUANT_GUARDS_PATCH_DIFF_SHA256}" \
      qwen38.patch.kv-offload-pinning.diff.sha256="${KV_OFFLOAD_PINNING_PATCH_DIFF_SHA256}" \
      qwen38.patch.shared-prefix-cache.diff.sha256="${SHARED_PREFIX_CACHE_PATCH_DIFF_SHA256}" \
      qwen38.patch.exact-reasoning-usage.diff.sha256="${EXACT_REASONING_USAGE_PATCH_DIFF_SHA256}" \
      qwen38.patch.exact-reasoning-usage.abstract-parser-file.sha256="${ABSTRACT_PARSER_PATCHED_FILE_SHA256}" \
      qwen38.patch.exact-reasoning-usage.adapters-file.sha256="${PARSER_ADAPTERS_PATCHED_FILE_SHA256}" \
      qwen38.patch.exact-reasoning-usage.engine-protocol-file.sha256="${ENGINE_PROTOCOL_PATCHED_FILE_SHA256}" \
      qwen38.patch.anthropic-input-fidelity.diff.sha256="${ANTHROPIC_INPUTS_PATCH_DIFF_SHA256}" \
      qwen38.patch.error-response.file.sha256="${ERROR_RESPONSE_PATCHED_FILE_SHA256}" \
      qwen38.patch.exception-exception-handler.file.sha256="${EXCEPTION_EXCEPTION_HANDLER_PATCHED_FILE_SHA256}" \
      qwen38.patch.http-exception-handler.file.sha256="${HTTP_EXCEPTION_HANDLER_PATCHED_FILE_SHA256}" \
      qwen38.patch.validation-exception-handler.file.sha256="${VALIDATION_EXCEPTION_HANDLER_PATCHED_FILE_SHA256}" \
      qwen38.patch.vllm-error-exception-handler.file.sha256="${VLLM_ERROR_EXCEPTION_HANDLER_PATCHED_FILE_SHA256}" \
      qwen38.patch.qwen-exact-tool-language.diff.sha256="${QWEN_LANGUAGE_PATCH_DIFF_SHA256}" \
      qwen38.patch.png-source-admission.diff.sha256="${PNG_SOURCE_PATCH_DIFF_SHA256}" \
      qwen38.patch.kv-physical-free-memory.diff.sha256="${KV_PHYSICAL_PATCH_DIFF_SHA256}" \
      qwen38.patch.parser-events.file.sha256="${PARSER_EVENTS_PATCHED_FILE_SHA256}" \
      qwen38.patch.parser-engine-config.file.sha256="${PARSER_ENGINE_CONFIG_PATCHED_FILE_SHA256}" \
      qwen38.patch.streaming-parser-engine.file.sha256="${STREAMING_PARSER_ENGINE_PATCHED_FILE_SHA256}" \
      qwen38.patch.token-id-scanner.file.sha256="${TOKEN_ID_SCANNER_PATCHED_FILE_SHA256}" \
      qwen38.patch.qwen-single-call-grammar.diff.sha256="${SINGLE_CALL_PATCH_DIFF_SHA256}" \
      qwen38.patch.tool-parser-abstract.file.sha256="${TOOL_PARSER_ABSTRACT_PATCHED_FILE_SHA256}" \
      qwen38.patch.responses-history-integrity.diff.sha256="${RESPONSES_HISTORY_PATCH_DIFF_SHA256}" \
      qwen38.patch.responses-stream-identity.diff.sha256="${RESPONSES_IDENTITY_PATCH_DIFF_SHA256}" \
      qwen38.patch.anthropic-terminal-metadata.diff.sha256="${ANTHROPIC_TERMINAL_PATCH_DIFF_SHA256}" \
      qwen38.patch.generation-sampling-resolution.diff.sha256="${SAMPLING_RESOLUTION_PATCH_DIFF_SHA256}" \
      qwen38.patch.sampling-decoding-boundary.diff.sha256="${SAMPLING_BOUNDARY_PATCH_DIFF_SHA256}" \
      qwen38.patch.token-generation-result-integrity.diff.sha256="${GENERATE_RESULT_PATCH_DIFF_SHA256}" \
      qwen38.patch.raw-image-token-transport.diff.sha256="${RAW_IMAGE_TRANSPORT_PATCH_DIFF_SHA256}" \
      qwen38.patch.xml-text-fidelity.diff.sha256="${XML_TEXT_FIDELITY_PATCH_DIFF_SHA256}" \
      qwen38.patch.phase-aware-parser-terminals.diff.sha256="${PHASE_AWARE_PARSER_TERMINALS_PATCH_DIFF_SHA256}" \
      qwen38.patch.input-stream-agent-identity.diff.sha256="${INPUT_STREAM_AGENT_IDENTITY_PATCH_DIFF_SHA256}" \
      qwen38.patch.tool-output-completion.diff.sha256="${TOOL_OUTPUT_COMPLETION_PATCH_DIFF_SHA256}" \
      qwen38.patch.one-way-thinking-boundary.diff.sha256="${ONE_WAY_THINKING_BOUNDARY_PATCH_DIFF_SHA256}" \
      qwen38.patch.schema-faithful-xml.diff.sha256="${SCHEMA_FAITHFUL_XML_PATCH_DIFF_SHA256}" \
      qwen38.patch.token-text-provenance.diff.sha256="${TOKEN_TEXT_PROVENANCE_PATCH_DIFF_SHA256}" \
      qwen38.patch.precise-request-errors.diff.sha256="${PRECISE_REQUEST_ERRORS_PATCH_DIFF_SHA256}" \
      qwen38.template.file.sha256="${AGENT_CHAT_TEMPLATE_SHA256}" \
      qwen38.project="Qwen_best_model_ever" \
      qwen38.runtime.profile="${IMAGE_PROFILE_VERSION}"

ENV HOME=/home/vllm \
    VLLM_CACHE_ROOT=/home/vllm/.cache/vllm \
    XDG_CACHE_HOME=/home/vllm/.cache/vllm/xdg-cache \
    XDG_CONFIG_HOME=/home/vllm/.cache/vllm/xdg-config \
    CUDA_CACHE_PATH=/home/vllm/.cache/vllm/cuda \
    HF_HOME=/home/vllm/.cache/vllm/huggingface \
    PYTHONDONTWRITEBYTECODE=1

USER 2000:0
ENTRYPOINT ["vllm", "serve"]
