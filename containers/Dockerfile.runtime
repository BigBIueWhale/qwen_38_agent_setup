# `install --mode=0755` above and every `--chmod=0644` here construct these
# modes; this asserts the construction held across the whole directory rather
# than across a hand-kept list a newly shipped unit could quietly fall out of.
RUN test "$(stat -c '%a' /opt/qwen38)" = '755' \
 && test "$(stat -c '%a' /opt/qwen38/* | sort -u)" = '644'
