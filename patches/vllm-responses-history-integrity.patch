+def validate_tool_result_correlation(
+    messages: list[ChatCompletionMessageParam],
+) -> None:
+    """Validate transport IDs before rendering positional Qwen tool history.
+
+    Chat and converted Responses messages share this boundary. Every call must
+    have exactly one result in the declared order; never guess or reorder it.
+    """
+    pending_ids: list[str] = []
+    pending_message_index: int | None = None
+
+    for message_index, message in enumerate(messages):
+        if not isinstance(message, dict):
+            continue
+        role = message.get("role")
+        tool_calls = message.get("tool_calls") or []
+
+        if role == "tool":
+            result_id = message.get("tool_call_id")
+            if not pending_ids:
+                raise VLLMValidationError(
+                    f"Tool result at messages[{message_index}] is orphaned; "
+                    "no preceding assistant tool call is awaiting a result."
+                )
+            expected_id = pending_ids[0]
+            if not result_id:
+                raise VLLMValidationError(
+                    f"Tool result at messages[{message_index}] is missing "
+                    f"tool_call_id; expected {expected_id!r}."
+                )
+            if result_id != expected_id:
+                raise VLLMValidationError(
+                    f"Tool result at messages[{message_index}] has "
+                    f"tool_call_id {result_id!r}; expected {expected_id!r} "
+                    "to preserve declared parallel-call order."
+                )
+            pending_ids.pop(0)
+            if not pending_ids:
+                pending_message_index = None
+            continue
+
+        if pending_ids:
+            raise VLLMValidationError(
+                f"Message at messages[{message_index}] has role {role!r} "
+                f"before all results for assistant message "
+                f"messages[{pending_message_index}] were supplied; still "
+                f"awaiting {pending_ids!r}."
+            )
+
+        if not tool_calls:
+            continue
+        if role != "assistant":
+            raise VLLMValidationError(
+                f"Message at messages[{message_index}] declares tool_calls "
+                f"with non-assistant role {role!r}."
+            )
+
+        call_ids: list[str] = []
+        for call_index, tool_call in enumerate(tool_calls):
+            call_id = (
+                tool_call.get("id") if isinstance(tool_call, dict) else None
+            )
+            if not call_id:
+                raise VLLMValidationError(
+                    f"Tool call messages[{message_index}].tool_calls"
+                    f"[{call_index}] is missing its transport id."
+                )
+            if call_id in call_ids:
+                raise VLLMValidationError(
+                    f"Tool call messages[{message_index}].tool_calls"
+                    f"[{call_index}] repeats transport id {call_id!r}."
+                )
+            call_ids.append(call_id)
+        pending_ids = call_ids
+        pending_message_index = message_index
+
+    if pending_ids:
+        raise VLLMValidationError(
+            f"Assistant tool-call message messages[{pending_message_index}] "
+            f"has no complete result sequence; still awaiting {pending_ids!r}."
+        )
+
+
