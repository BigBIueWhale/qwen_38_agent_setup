+@dataclass(frozen=True)
+class ToolHistoryOrigin:
+    """Where each message of a tool history, and each call in it, came from
+    in the request, so a refusal names the field the caller sent rather than
+    a position in a list the server built from it.
+
+    Each origin is a ``(parameter, location)`` pair: the top-level request
+    field and the place within it.
+    """
+
+    messages: Sequence[tuple[str, str]]
+    calls: Mapping[tuple[int, int], tuple[str, str]]
+    # The field a tool result names its call by.
+    result_id: str
+
+    @classmethod
+    def chat(cls, messages: Sequence[Any]) -> "ToolHistoryOrigin":
+        return cls(
+            messages=[("messages", f"messages[{i}]") for i in range(len(messages))],
+            calls={
+                (i, j): ("messages", f"messages[{i}].tool_calls[{j}]")
+                for i, message in enumerate(messages)
+                if isinstance(message, dict)
+                for j in range(len(message.get("tool_calls") or []))
+            },
+            result_id="tool_call_id",
+        )
+
+
+def validate_tool_result_correlation(
+    messages: list[ChatCompletionMessageParam],
+    origin: ToolHistoryOrigin,
+) -> None:
+    """Validate transport IDs before rendering positional Qwen tool history.
+
+    Chat and converted Responses messages share this boundary. Every call must
+    have exactly one result in the declared order; never guess or reorder it.
+    A refusal names where the caller sent the offending message or call.
+    """
+    pending_ids: list[str] = []
+    pending_message_index: int | None = None
+
+    for message_index, message in enumerate(messages):
+        if not isinstance(message, dict):
+            continue
+        role = message.get("role")
+        tool_calls = message.get("tool_calls") or []
+        parameter, location = origin.messages[message_index]
+
+        if role == "tool":
+            result_id = message.get("tool_call_id")
+            if not pending_ids:
+                raise VLLMValidationError(
+                    f"Tool result at {location} is orphaned; "
+                    "no preceding assistant tool call is awaiting a result.",
+                    parameter=parameter,
+                )
+            expected_id = pending_ids[0]
+            if not result_id:
+                raise VLLMValidationError(
+                    f"Tool result at {location} is missing "
+                    f"{origin.result_id}; expected {expected_id!r}.",
+                    parameter=parameter,
+                )
+            if result_id != expected_id:
+                raise VLLMValidationError(
+                    f"Tool result at {location} has {origin.result_id} "
+                    f"{result_id!r}; expected {expected_id!r} "
+                    "to preserve declared parallel-call order.",
+                    parameter=parameter,
+                )
+            pending_ids.pop(0)
+            if not pending_ids:
+                pending_message_index = None
+            continue
+
+        if pending_ids:
+            assert pending_message_index is not None
+            raise VLLMValidationError(
+                f"Message at {location} has role {role!r} "
+                f"before all results for the tool calls at "
+                f"{origin.messages[pending_message_index][1]} were supplied; "
+                f"still awaiting {pending_ids!r}.",
+                parameter=parameter,
+            )
+
+        if not tool_calls:
+            continue
+        if role != "assistant":
+            raise VLLMValidationError(
+                f"Message at {location} declares tool_calls "
+                f"with non-assistant role {role!r}.",
+                parameter=parameter,
+            )
+
+        call_ids: list[str] = []
+        for call_index, tool_call in enumerate(tool_calls):
+            call_parameter, call_location = origin.calls[(message_index, call_index)]
+            call_id = (
+                tool_call.get("id") if isinstance(tool_call, dict) else None
+            )
+            if not call_id:
+                raise VLLMValidationError(
+                    f"Tool call {call_location} is missing its transport id.",
+                    parameter=call_parameter,
+                )
+            if call_id in call_ids:
+                raise VLLMValidationError(
+                    f"Tool call {call_location} repeats transport id {call_id!r}.",
+                    parameter=call_parameter,
+                )
+            call_ids.append(call_id)
+        pending_ids = call_ids
+        pending_message_index = message_index
+
+    if pending_ids:
+        assert pending_message_index is not None
+        parameter, location = origin.messages[pending_message_index]
+        raise VLLMValidationError(
+            f"The tool calls at {location} have no complete result sequence; "
+            f"still awaiting {pending_ids!r}.",
+            parameter=parameter,
+        )
+
+
 def make_tool_call_id(id_type: str = "random", func_name=None, idx=None):
     if id_type == "kimi_k2":
         return f"functions.{func_name}:{idx}"
