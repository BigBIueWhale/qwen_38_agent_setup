+def test_installed_source_digest_covers_every_source_file(tmp_path):
+    """The digest reads every Python file of the installed package, so a
+    change to any one of them is another plan."""
+    import vllm
+
+    package = tmp_path / "vllm"
+    (package / "v1" / "worker").mkdir(parents=True)
+    (package / "__init__.py").write_text("")
+    source = package / "v1" / "worker" / "gpu_worker.py"
+    source.write_text("bound = 1\n")
+    digest = startup_plan.installed_source_digest.__wrapped__
+    with patch.object(vllm, "__file__", str(package / "__init__.py")):
+        first = digest()
+        assert first == digest()
+        source.write_text("bound = 2\n")
+        assert digest() != first
 
 
