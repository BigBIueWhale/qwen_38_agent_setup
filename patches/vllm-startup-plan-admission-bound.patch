 PLAN_SCHEMA_VERSION = 1
 
 
+@functools.cache
+def installed_source_digest() -> str:
+    """A digest of every Python source file of the installed vllm package.
+
+    The value a plan records is what this code derives -- the profile, the
+    bound, the model and its kernels -- and a version string does not
+    identify it: builds that patch one upstream commit share its version.
+    Any change to any of these files is therefore another plan.
+    """
+    import vllm
+
+    root = Path(vllm.__file__).resolve().parent
+    digest = hashlib.sha256()
+    for path in sorted(root.rglob("*.py")):
+        digest.update(path.relative_to(root).as_posix().encode())
+        digest.update(b"\0")
+        digest.update(path.read_bytes())
+        digest.update(b"\0")
+    return digest.hexdigest()
+
