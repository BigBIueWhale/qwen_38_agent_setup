+
+
+_REFUSING_TEMPLATE = (
+    "{%- if not messages %}{{ raise_exception('No messages.', 'messages') }}{% endif %}"
+    "{%- if reasoning_effort is defined and reasoning_effort != 'xhigh' %}"
+    "{{ raise_exception('Unexpected effort.', 'reasoning_effort') }}{% endif %}"
+    "{%- if enable_thinking is defined and enable_thinking is false %}"
+    "{{ raise_exception('Thinking cannot be disabled.', 'enable_thinking') }}{% endif %}"
+    "{%- if refuse_unnamed is defined %}{{ raise_exception('Unnamed.') }}{% endif %}"
+    "{{ messages[0]['content'] }}"
+)
+
+
+def _template_refusal_parameter(request, conversation, server_defaults=None):
+    from types import SimpleNamespace
+
+    from tokenizers import Tokenizer, models
+    from transformers import TokenizersBackend
+
+    tokenizer = TokenizersBackend(tokenizer_object=Tokenizer(models.WordLevel({"hi": 0})))
+    params = request.build_chat_params(_REFUSING_TEMPLATE, "openai").with_defaults(
+        server_defaults
+    )
+    with pytest.raises(VLLMValidationError) as refusal:
+        safe_apply_chat_template(
+            SimpleNamespace(), tokenizer, conversation,
+            parameter_names=params.parameter_names,
+            **params.get_apply_chat_template_kwargs(),
+        )
+    return refusal.value.parameter
+
+
+@pytest.mark.parametrize(
+    ("surface", "fields", "conversation", "parameter"),
+    [
+        ("chat", {"reasoning_effort": "low"}, None, "reasoning_effort"),
+        ("chat", {"reasoning_effort": "none"}, None, "reasoning_effort"),
+        ("chat", {"chat_template_kwargs": {"reasoning_effort": "low"}}, None,
+         "chat_template_kwargs.reasoning_effort"),
+        ("chat", {"chat_template_kwargs": {"enable_thinking": False}}, None,
+         "chat_template_kwargs.enable_thinking"),
+        ("chat", {}, [], "messages"),
+        ("chat", {"chat_template_kwargs": {"refuse_unnamed": True}}, None, None),
+        ("responses", {"reasoning": {"effort": "low"}}, None, "reasoning.effort"),
+        ("responses", {}, [], "input"),
+        ("tokenize", {"chat_template_kwargs": {"reasoning_effort": "low"}}, None,
+         "chat_template_kwargs.reasoning_effort"),
+    ],
+)
+def test_template_refusal_names_the_request_parameter(
+    surface, fields, conversation, parameter
+):
+    """A template refusal names the request parameter behind the variable the
+    template refused, never one the request did not use."""
+    from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+    from vllm.entrypoints.serve.tokenize.protocol import TokenizeChatRequest
+
+    messages = [{"role": "user", "content": "hi"}]
+    request = {
+        "chat": lambda: ChatCompletionRequest(model="m", messages=messages, **fields),
+        "responses": lambda: ResponsesRequest(
+            model="m", input="hi", kv_scope="unit", **fields
+        ),
+        "tokenize": lambda: TokenizeChatRequest(model="m", messages=messages, **fields),
+    }[surface]()
+    observed = _template_refusal_parameter(
+        request, messages if conversation is None else conversation
+    )
+    assert observed == parameter
+
+
+def test_template_refusal_of_a_server_default_names_no_request_parameter():
+    request = ChatCompletionRequest(model="m", messages=[{"role": "user", "content": "hi"}])
+    assert _template_refusal_parameter(
+        request, [{"role": "user", "content": "hi"}], {"reasoning_effort": "low"}
+    ) is None
