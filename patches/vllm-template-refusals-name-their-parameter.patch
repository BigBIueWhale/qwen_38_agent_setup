+def request_chat_template_kwargs(
+    chat_template_kwargs: dict[str, Any] | None,
+    fields: dict[str, tuple[Any, str]],
+) -> tuple[dict[str, Any], dict[str, str]]:
+    """Merge a request's ``chat_template_kwargs`` with the template variables
+    its own fields set, each given as its value and the request parameter that
+    supplied it, and name the parameter behind every variable the request set.
+    A field left unset supplies nothing and names nothing."""
+    set_fields = merge_kwargs(None, {name: value for name, (value, _) in fields.items()})
+    parameter_names = {
+        name: f"chat_template_kwargs.{name}" for name in chat_template_kwargs or {}
+    }
+    parameter_names.update({name: fields[name][1] for name in set_fields})
+    return merge_kwargs(chat_template_kwargs, set_fields), parameter_names
+
