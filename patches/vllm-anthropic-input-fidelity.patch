+class TestToolResultFidelity:
+    """A tool result reaches the model whole, or the request is refused.
+
+    The rendering carries text, image and tool_reference items; anything
+    else -- a document, a search result -- cannot be rendered, and dropping
+    it would tell the model the tool returned less than it did.  The
+    ``is_error`` flag has no field in the rendering and is stated in the
+    result's text instead.
+    """
+
+    def _request(self, tool_result_content, **block) -> AnthropicMessagesRequest:
+        return _make_request(
+            [
+                {
+                    "role": "assistant",
+                    "content": [
+                        {
+                            "type": "tool_use",
+                            "id": "call_001",
+                            "name": "read_file",
+                            "input": {"path": "/tmp/report.pdf"},
+                        }
+                    ],
+                },
+                {
+                    "role": "user",
+                    "content": [
+                        {
+                            "type": "tool_result",
+                            "tool_use_id": "call_001",
+                            "content": tool_result_content,
+                            **block,
+                        }
+                    ],
+                },
+            ]
+        )
+
+    @pytest.mark.parametrize(
+        "item",
+        [
+            {
+                "type": "document",
+                "source": {"type": "base64", "media_type": "application/pdf", "data": "AAAA"},
+            },
+            {"type": "search_result", "source": "https://example.com", "title": "t"},
+        ],
+        ids=["document", "search_result"],
+    )
+    def test_an_item_the_rendering_cannot_carry_is_refused(self, item):
+        request = self._request([{"type": "text", "text": "kept"}, item])
+
+        with pytest.raises(VLLMValidationError) as refusal:
+            _convert(request)
+
+        assert "tool_result 'call_001' content[1]" in str(refusal.value)
+        assert "parameter=messages" in str(refusal.value)
+
+    def test_a_tool_reference_without_a_name_is_refused(self):
+        request = self._request([{"type": "tool_reference"}])
+
+        with pytest.raises(VLLMValidationError):
+            _convert(request)
+
+    @pytest.mark.parametrize(
+        "source",
+        [None, {"type": "url"}, {"type": "base64", "media_type": "image/png"}],
+        ids=["no-source", "url-without-url", "base64-without-data"],
+    )
+    def test_an_image_item_that_names_no_image_is_refused(self, source):
+        item = {"type": "image"} if source is None else {"type": "image", "source": source}
+        request = self._request([item])
+
+        with pytest.raises(VLLMValidationError) as refusal:
+            _convert(request)
+
+        assert "names no image" in str(refusal.value)
+
+    def test_a_user_image_block_that_names_no_image_is_refused(self):
+        request = _make_request(
+            [{"role": "user", "content": [{"type": "image", "source": {"type": "url"}}]}]
+        )
+
+        with pytest.raises(VLLMValidationError) as refusal:
+            _convert(request)
+
+        assert "an image block in a user message names no image" in str(refusal.value)
+
+    def test_is_error_is_stated_before_string_content(self):
+        request = self._request("ENOENT: no such file", is_error=True)
+        result = _convert(request)
+
+        tool_msg = [m for m in result.messages if m["role"] == "tool"][0]
+        assert tool_msg["content"] == f"{TOOL_RESULT_ERROR_LINE}\nENOENT: no such file"
