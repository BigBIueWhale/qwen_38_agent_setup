 import vllm.envs as envs
 
 
+ANTHROPIC_API_PATH_PREFIX = "/v1/messages"
+
+
+def is_anthropic_api_path(path: str) -> bool:
+    """Whether a request path belongs to the Anthropic Messages API.
+
+    Every refusal on these paths -- typed request validation, prompt
+    rendering, the engine's own request validation -- is answered in the
+    Messages API's error envelope, never in the OpenAI-compatible one.
+    """
+    return path == ANTHROPIC_API_PATH_PREFIX or path.startswith(
+        ANTHROPIC_API_PATH_PREFIX + "/"
+    )
+
+
+# The Messages API's documented error types, by the HTTP status each one
+# is defined for.  Statuses outside the table map to the nearest class:
+# any other client error is an invalid request, any other server error is
+# an API error.
+_ERROR_TYPES_BY_STATUS = {
+    400: "invalid_request_error",
+    401: "authentication_error",
+    403: "permission_error",
+    404: "not_found_error",
+    413: "request_too_large",
+    429: "rate_limit_error",
+    500: "api_error",
+    529: "overloaded_error",
+}
+
+
+def anthropic_error_type(status_code: int) -> str:
+    """The Anthropic error type that stands for an HTTP status."""
+    if status_code in _ERROR_TYPES_BY_STATUS:
+        return _ERROR_TYPES_BY_STATUS[status_code]
+    return "invalid_request_error" if status_code < 500 else "api_error"
+
+
