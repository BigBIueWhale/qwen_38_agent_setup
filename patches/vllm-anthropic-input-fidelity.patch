+def error_json_response(request: Request, error: ErrorResponse) -> JSONResponse:
+    """Serialize a refusal in the vocabulary of the API the request used.
+
+    The Anthropic Messages API answers every refusal, typed request
+    validation included, in its own envelope; the OpenAI-compatible
+    surfaces answer in theirs.  The status is the same either way.
+    """
+    if is_anthropic_api_path(get_route_path(request.scope)):
+        content = AnthropicErrorResponse.for_status(
+            error.error.code, error.error.message
+        ).model_dump()
+    else:
+        content = error.model_dump()
+    return JSONResponse(content, status_code=error.error.code)
 
 
