+class TestErrorEnvelopeFollowsTheApi:
+    """A refusal is answered in the vocabulary of the API that was called:
+    the OpenAI envelope with ``param`` on the OpenAI-compatible paths, the
+    Anthropic Messages envelope on ``/v1/messages`` and below it."""
+
+    _errors = [{"type": "missing", "loc": ("body", "messages"), "msg": "Field required"}]
+
+    @pytest.mark.asyncio
+    async def test_openai_path_keeps_the_openai_envelope(self):
+        response = await validation_exception_handler(
+            _fake_request(), RequestValidationError(self._errors)
+        )
+        body = json.loads(response.body)
+
+        assert response.status_code == 400
+        assert body["error"]["type"] == "Bad Request"
+        assert body["error"]["param"] == "body.messages"
+
+    @pytest.mark.parametrize(
+        "path", ["/v1/messages", "/v1/messages/count_tokens"]
+    )
+    @pytest.mark.asyncio
+    async def test_anthropic_paths_get_the_anthropic_envelope(self, path: str):
+        response = await validation_exception_handler(
+            _fake_request(path=path), RequestValidationError(self._errors)
+        )
+        body = json.loads(response.body)
+
+        assert response.status_code == 400
+        assert body["type"] == "error"
+        assert body["error"] == {
+            "type": "invalid_request_error",
+            "message": body["error"]["message"],
+        }
+        assert "Field required" in body["error"]["message"]
+
+    @pytest.mark.asyncio
+    async def test_a_root_path_does_not_hide_the_anthropic_api(self):
+        request = _fake_request(path="/proxy/v1/messages")
+        request.scope["root_path"] = "/proxy"
+
+        response = await validation_exception_handler(
+            request, RequestValidationError(self._errors)
+        )
+        body = json.loads(response.body)
+
+        assert body["type"] == "error"
