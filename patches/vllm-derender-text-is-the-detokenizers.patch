+@pytest.mark.asyncio
+@pytest.mark.parametrize('surface', ['chat', 'completion'])
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('include_stop', [False, True])
+@pytest.mark.parametrize('ids,stop,ends', [
+    # A stop with no stop_reason is an end on a model EOS id.
+    ([65, 66], None, 'end with 66'),
+    ([], None, 'are empty'),
+    ([65, 99], None, 'end with 99'),  # a caller's stop id reports that id
+    # A stop on a caller's stop token id ends on that id.
+    ([65, 66], 99, 'end with 66'),
+    ([65, 1], 99, 'end with 1'),
+    ([], 99, 'are empty'),
+])
+async def test_derender_refuses_a_stop_its_ids_do_not_end_on(
+        surface, stream, include_stop, ids, stop, ends):
+    """A choice that reports a stop on a stop token ends on that token, as
+    every choice the generate route returns does. One that does not is the
+    caller's to correct: derender names it, and takes no id's text away."""
+    from vllm.entrypoints.openai.chat_completion.protocol import (
+        ChatCompletionRequest,
+    )
+    from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+    from vllm.exceptions import VLLMValidationError
+
+    derenderer = _plain_derenderer()
+    payload = dict(request_id='request', choices=[dict(
+        index=0, token_ids=ids, finish_reason='stop', stop_reason=stop)])
+    chat = ChatCompletionRequest(
+        model='unit', messages=[], include_stop_str_in_output=include_stop)
+    completion = CompletionRequest(
+        model='unit', prompt='p', include_stop_str_in_output=include_stop)
+    with pytest.raises(VLLMValidationError) as refused:
+        if stream:
+            chunk = GenerateStreamResponse.model_validate(payload)
+            if surface == 'chat':
+                await derenderer.derender_chat_stream('unit', chunk, chat_request=chat)
+            else:
+                await derenderer.derender_completion_stream(
+                    'unit', chunk, completion_request=completion)
+        else:
+            response = GenerateResponse.model_validate(payload)
+            if surface == 'chat':
+                derenderer._derender_chat(response, chat)
+            else:
+                derenderer._derender_completion([response], None, completion)
+    field = ('generate_chunk.choices[0]' if stream
+             else 'generate_response.choices[0]' if surface == 'chat'
+             else 'generate_responses[0].choices[0]')
+    assert refused.value.parameter == field
+    claim = ('stop_reason null, an end on one of the model\'s EOS ids [1, 2]'
+             if stop is None else f'stop_reason {stop}, an end on that stop token id')
+    assert f"{field} reports finish_reason 'stop' with {claim}" in str(refused.value)
+    assert f'but its token_ids {ends}.' in str(refused.value)
+    assert payload['choices'][0]['token_ids'] == ids
