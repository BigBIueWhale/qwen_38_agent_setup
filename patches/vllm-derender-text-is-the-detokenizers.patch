+def _text_token_ids(
+    token_ids: list[int],
+    finish_reason: str | None,
+    stop_reason: int | str | None,
+    include_stop_str_in_output: bool,
+    *,
+    eos_token_ids: set[int],
+    field: str,
+) -> list[int]:
+    """The ids of a generated choice that carry text, as on the chat route.
+
+    The finish metadata says whether the last id is the stop token the
+    generation ended on, which shows no text. The detokenizer is told so by
+    the engine that stopped; derender is told so by its caller, and holds the
+    caller to it: a stop with no stop_reason ends on one of the model's EOS
+    ids, a stop on a stop token id ends on that id. A choice whose ids say
+    otherwise is refused, naming it, and no id loses its text.
+
+    A stop string ends on ordinary text, and derender does not cut the text
+    at it: the string, and whatever the ids decode to after it, stay in the
+    text, which the chat route's detokenizer, having matched the string,
+    ends before it (after it when stop text is asked for).
+    """
+    stop_terminated = ended_on_stop_token(finish_reason, stop_reason)
+    if stop_terminated:
+        last = token_ids[-1] if token_ids else None
+        if stop_reason is None:
+            ends_on_it = last in eos_token_ids
+            claim = (
+                "stop_reason null, an end on one of the model's EOS ids "
+                f"{sorted(eos_token_ids)}"
+            )
+        else:
+            ends_on_it = last == stop_reason
+            claim = f"stop_reason {stop_reason}, an end on that stop token id"
+        if not ends_on_it:
+            ids = "are empty" if last is None else f"end with {last}"
+            raise VLLMValidationError(
+                f"{field} reports finish_reason 'stop' with {claim}, but its "
+                f"token_ids {ids}. Send the choice's token_ids, finish_reason "
+                "and stop_reason as /inference/v1/generate returned them.",
+                parameter=field,
+            )
+    text_ids, _ = split_stop_token(
+        list(token_ids),
+        stop_terminated=stop_terminated,
+        include_stop_str_in_output=include_stop_str_in_output,
+    )
+    return text_ids
+
