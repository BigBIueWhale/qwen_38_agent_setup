+def split_stop_token(
+    token_ids: list[int], *, stop_terminated: bool, include_stop_str_in_output: bool
+) -> tuple[list[int], int | None]:
+    """Separate the stop token a generation ended on from the ids that carry text.
+
+    A generation the engine ends on a stop token -- the model's end of turn or
+    a caller's stop token id -- shows no text for that token unless the caller
+    asked to see stop text (``include_stop_str_in_output``); the token itself
+    stays in the generation's ids. This is the one place that decides it: the
+    serving detokenizer and the derender routes both split here, so every
+    route hands a parser and a caller the same text for the same ids.
+    """
+    if stop_terminated and not include_stop_str_in_output and token_ids:
+        return token_ids[:-1], token_ids[-1]
+    return token_ids, None
+
+
+def ended_on_stop_token(finish_reason: str | None, stop_reason: int | str | None) -> bool:
+    """Whether a finished choice's last id is the stop token the engine ended on.
+
+    The engine ends a generation on the model's end of turn (stop_reason None)
+    or on a caller's stop token id (stop_reason that id). A stop string is
+    matched in the text after the engine and reports that string instead.
+    """
+    return finish_reason == "stop" and not isinstance(stop_reason, str)
