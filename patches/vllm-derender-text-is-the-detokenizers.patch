+def _plain_derenderer(eos_token_ids=(1, 2)):
+    """A derenderer without a parser over a one-character-per-id tokenizer,
+    given the model's EOS ids through the inputs the engine reads them from."""
+    tokenizer = SimpleNamespace(decode=lambda ids, **kwargs: ''.join(map(chr, ids)))
+    first, *rest = eos_token_ids
+    derenderer = OnlineDerenderer(
+        SimpleNamespace(
+            hf_config=SimpleNamespace(model_type='unit'), model='unit',
+            try_get_generation_config=lambda: {'eos_token_id': rest},
+        ),
+        SimpleNamespace(get_tokenizer=lambda: tokenizer,
+                        get_eos_token_id=lambda: first, _executor=None),
+        request_logger=None, chat_template=None,
+        chat_template_content_format='openai',
+    )
+    # The token-transport boundary, not the incremental decoder.
+    derenderer._detokenize_delta = lambda tokenizer, ids, state, **kwargs: (
+        ''.join(map(chr, ids)), state)
+    return derenderer
+
+
+def test_derender_reads_the_model_eos_ids_the_engine_reads():
+    """Both EOS sources count -- the generation config's list and the
+    tokenizer's EOS -- exactly as the engine's sampling parameters read them."""
+    from vllm.sampling_params import SamplingParams
+
+    derenderer = _plain_derenderer((1, 2, 3))
+    params = SamplingParams()
+    params.update_from_generation_config({'eos_token_id': [2, 3]}, 1)
+    assert derenderer.eos_token_ids == params.eos_token_ids == {1, 2, 3}
+
