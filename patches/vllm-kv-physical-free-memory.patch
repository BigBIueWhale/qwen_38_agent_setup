+            max_logprobs=max_logprobs, get_vocab_size=lambda: 1000
+        )
+    )
+    assert (
+        gpu_model_runner.GPUModelRunner._largest_admitted_logprob_count(runner)
+        == expected
+    )
+
+
+@pytest.mark.parametrize("num_logprobs", [None, 20])
+def test_served_text_step_samples_then_scores_the_prompt(num_logprobs):
+    """The served profile's text step samples with the counted log
+    probabilities, then scores every prompt row of the step; the CPU
+    warm-up (no count) samples as upstream does and scores nothing."""
+    from vllm.v1.worker import gpu_model_runner
+
+    events = []
+    hidden, last = torch.zeros(2048, 8), torch.zeros(1, 8)
+    runner = SimpleNamespace(
+        max_num_tokens=2048,
+        is_pooling_model=False,
+        encoder_cache={},
+        _dummy_run=lambda num_tokens, **kwargs: (
+            events.append(("forward", num_tokens, kwargs)) or (hidden, last)
+        ),
+        _dummy_sampler_run=lambda states, count: events.append(
+            ("sampler", states is last, count)
+        ),
+        _dummy_prompt_logprobs_run=lambda states, count: events.append(
+            ("prompt", states is hidden, count)
+        ),
+        _sync_device=lambda: None,
+    )
+    with patch.object(
+        gpu_model_runner,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_last_rank=True),
+    ):
+        gpu_model_runner.GPUModelRunner._run_dummy_text_step(
+            runner, num_logprobs=num_logprobs, force_attention=True
+        )
+    expected = [
+        ("forward", 2048, {"is_profile": True, "force_attention": True}),
+        ("sampler", True, num_logprobs),
+    ]
+    if num_logprobs is not None:
+        expected.append(("prompt", True, num_logprobs))
+    assert events == expected
+
