+def _profiling_runner(events, weights, graph_memory, stand_in):
+    """The runner surface Worker.determine_available_memory profiles through,
+    recording the order in which the profile runs."""
+
+    @contextmanager
+    def profiling_kv_cache():
+        events.append("stand-in built")
+        try:
+            yield stand_in
+        finally:
+            events.append("stand-in removed")
+
+    def profile_cudagraph_memory():
+        events.append("graphs profiled")
+        return graph_memory
+
+    return SimpleNamespace(
+        model_memory_usage=weights,
+        profiling_kv_cache=profiling_kv_cache,
+        profile_served_phases=Mock(side_effect=lambda: events.append("phases")),
+        profile_run=Mock(side_effect=AssertionError("V1 profiles served phases")),
+        profile_cudagraph_memory=Mock(side_effect=profile_cudagraph_memory),
+    )
+
+
+def _recording_memory_profiling(events, profile):
+    @contextmanager
+    def memory_profiling(*args, **kwargs):
+        events.append("window opened")
+        yield profile
+        events.append("window closed")
+
+    return memory_profiling
+
+
+@pytest.mark.parametrize("initial_residents", [0, 2 * GiB_bytes])
+@pytest.mark.parametrize("activation_peak", [0, GiB_bytes])
+@pytest.mark.parametrize("graph_memory", [0, GiB_bytes // 2])
+@pytest.mark.parametrize("utilization", [0.5, 0.92])
+@pytest.mark.parametrize("stand_in", [0, 3 * (1 << 20)])
+def test_physical_bound_charges_preexisting_residents_once(
+    monkeypatch, initial_residents, activation_peak, graph_memory, utilization,
+    stand_in,
+):
+    from vllm.v1.worker import gpu_worker
+
+    total = 32 * GiB_bytes
+    initially_free = total - initial_residents
+    weights = 20 * GiB_bytes
+    frontend = GiB_bytes // 4
+    # The window's peak held the stand-in pool beside the phases' peak.
+    profile = SimpleNamespace(
+        total_consumed=weights,
+        transient_peak_headroom=activation_peak + stand_in,
+        non_kv_cache_memory=weights + activation_peak + stand_in,
+        weights_memory=weights,
+        after_profile=SimpleNamespace(free_memory=initially_free - weights),
+    )
+    events: list[str] = []
+    runner = _profiling_runner(events, weights, graph_memory, stand_in)
+    worker = SimpleNamespace(
+        use_v2_model_runner=False,
+        init_snapshot=SimpleNamespace(free_memory=initially_free, total_memory=total),
+        requested_memory=int(total * utilization),
+        cache_config=SimpleNamespace(
+            kv_cache_memory_bytes=None, gpu_memory_utilization=utilization
+        ),
+        model_config=SimpleNamespace(multimodal_config=object()),
+        parallel_config=SimpleNamespace(_api_process_count=1),
+        model_runner=runner,
+        vllm_config=SimpleNamespace(
+            compilation_config=SimpleNamespace(
+                cudagraph_mode=gpu_worker.CUDAGraphMode.FULL
+            )
+        ),
+    )
+    monkeypatch.setenv("VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS", "1")
+    with (
+        patch.object(gpu_worker, "maybe_apply_startup_plan"),
+        patch.object(
+            gpu_worker, "memory_profiling",
+            _recording_memory_profiling(events, profile),
+        ),
+        patch.object(
+            gpu_worker, "current_platform", SimpleNamespace(is_cuda_alike=lambda: True)
+        ),
+        patch.object(
+            gpu_worker, "reserve_mm_ipc_gpu_memory",
+            side_effect=lambda n, *args: n - frontend,
+        ),
+        patch.object(
+            gpu_worker, "current_workspace_manager",
+            lambda: SimpleNamespace(reclaimable_workspace_bytes=lambda: GiB_bytes),
+        ),
+    ):
+        bound = gpu_worker.Worker.determine_available_memory(worker)
+    # Initial occupancy, profile residents, recurring peak, graph and frontend
+    # reservation each consume physical memory exactly once; the stand-in
+    # pool the profile attended to is the declared pool's place, not charged.
+    assert bound == (
+        total - initial_residents - weights - activation_peak - graph_memory - frontend
+    )
+    assert worker.available_kv_cache_memory_bytes == (
+        int(total * utilization) - weights - activation_peak - graph_memory
+    )
+    assert profile.transient_peak_headroom == activation_peak
+    # A warm pass outside the window, then the measured pass with the stand-in
+    # pool living inside it, then the graph estimate.
+    assert events == [
+        "stand-in built", "phases", "stand-in removed",
+        "window opened", "stand-in built", "phases", "stand-in removed",
+        "window closed",
+        "graphs profiled",
+    ]
+    runner.profile_run.assert_not_called()
+
