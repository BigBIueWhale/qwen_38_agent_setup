+@pytest.mark.parametrize(
+    ("num_tokens", "max_num_seqs", "profile_seq_lens", "expected"),
+    [
+        # Every request's context is the profiled length ...
+        (2048, 1, 262144, [262144]),
+        (12, 3, 16, [16, 16, 16]),
+        # ... unless its own query is longer: a context covers its query.
+        (29, 3, 10, [10, 10, 11]),
+    ],
+)
+def test_dummy_context_covers_its_own_query(
+    num_tokens, max_num_seqs, profile_seq_lens, expected
+):
+    from vllm.v1.worker import gpu_model_runner
+
+    captured = {}
+
+    def copy_(source, non_blocking=False):
+        captured["seq_lens"] = source[: len(expected)].tolist()
+        raise _StopAtSeqLens
+
+    batch_desc = SimpleNamespace(num_tokens=num_tokens, num_reqs=None)
+    runner = SimpleNamespace(
+        vllm_config=SimpleNamespace(
+            model_config=SimpleNamespace(multimodal_config=None),
+            parallel_config=SimpleNamespace(num_ubatches=1),
+        ),
+        uniform_decode_query_len=1,
+        max_num_tokens=num_tokens,
+        scheduler_config=SimpleNamespace(max_num_seqs=max_num_seqs),
+        _determine_batch_execution_and_padding=lambda **kwargs: (
+            gpu_model_runner.CUDAGraphMode.NONE, batch_desc, False, None, None
+        ),
+        dcp_world_size=1,
+        parallel_config=SimpleNamespace(cp_kv_cache_interleave_size=1),
+        _get_slot_mappings=lambda **kwargs: (None, None),
+        synchronize_input_prep=nullcontext,
+        optimistic_seq_lens_cpu=torch.zeros(8, dtype=torch.int32),
+        seq_lens=SimpleNamespace(copy_=copy_),
+    )
+    with pytest.raises(_StopAtSeqLens):
+        gpu_model_runner.GPUModelRunner._dummy_run(
+            runner, num_tokens, is_profile=True, force_attention=True,
+            profile_seq_lens=profile_seq_lens,
+        )
+    assert captured["seq_lens"] == expected
