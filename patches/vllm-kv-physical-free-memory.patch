+def test_served_profile_encodes_with_workspace_released_and_attends_in_text():
+    """The profile runs each phase in the residency serving runs it in: the
+    encoder with the reclaimable workspace released, the text step with it
+    resident, attending over the longest context a request holds."""
+    from vllm.v1.worker import gpu_model_runner
+
+    events = []
+
+    @contextmanager
+    def release():
+        events.append("released")
+        try:
+            yield 0
+        finally:
+            events.append("restored")
+
+    runner = SimpleNamespace(
+        max_model_len=4096,
+        _run_dummy_encoder=lambda: events.append("encoder"),
+        _run_dummy_text_step=lambda **kwargs: events.append(("text", kwargs)),
+    )
+    with patch.object(gpu_model_runner, "release_reclaimable_workspaces", release):
+        gpu_model_runner.GPUModelRunner.profile_served_phases(runner)
+    assert events == [
+        "released", "encoder", "restored",
+        ("text", {"force_attention": True, "profile_seq_lens": 4096}),
+    ]
+
+
+@pytest.mark.parametrize("fails", [False, True])
+def test_profiling_kv_cache_yields_stand_in_bytes_and_always_removes_it(fails):
+    from vllm.v1.core import kv_cache_utils
+    from vllm.v1.worker import gpu_model_runner
+
+    groups = ["group"]
+    cleaned = []
+    runner = SimpleNamespace(
+        vllm_config=SimpleNamespace(),
+        _init_minimal_kv_cache_for_profiling=lambda: SimpleNamespace(
+            num_blocks=3, kv_cache_groups=groups
+        ),
+        _cleanup_profiling_kv_cache=lambda: cleaned.append(True),
+    )
+    divisor = Mock(return_value=1 << 20)
+    with patch.object(kv_cache_utils, "_pool_bytes_per_block", divisor):
+        try:
+            with gpu_model_runner.GPUModelRunner.profiling_kv_cache(runner) as nbytes:
+                # Counted by the divisor the declared pool is admitted by.
+                assert nbytes == 3 << 20
+                assert cleaned == []
+                if fails:
+                    raise RuntimeError("profile failed")
+        except RuntimeError:
+            assert fails
+    divisor.assert_called_once_with(runner.vllm_config, groups)
+    assert cleaned == [True]
+
