+def test_largest_admitted_logprob_count(max_logprobs, expected):
+    """The most log probabilities per position SamplingParams admits: -1
+    admits the whole vocabulary, and no request can ask for more than it."""
+    from vllm.v1.worker import gpu_model_runner
+
+    runner = SimpleNamespace(
