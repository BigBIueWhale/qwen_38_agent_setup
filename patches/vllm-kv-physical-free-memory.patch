+def test_dummy_prompt_logprobs_scores_every_prompt_row_of_the_step():
+    """The dummy scores as serving does: the targets are a slice of a
+    prompt-length id tensor, one row per prompt position the step holds."""
+    from vllm.v1.worker import gpu_model_runner
+
+    calls = []
+
+    def computed(target_ids, hidden_states, logits_fn, count, mode):
+        calls.append(
+            (target_ids.shape[0], target_ids.dtype, hidden_states.shape[0], count,
+             mode, logits_fn)
+        )
+
+    for max_model_len, rows in ((4096, 2048), (1000, 999)):
+        calls.clear()
+        runner = SimpleNamespace(
+            max_num_tokens=2048,
+            max_model_len=max_model_len,
+            device=torch.device("cpu"),
+            model=SimpleNamespace(compute_logits=object()),
+            model_config=SimpleNamespace(logprobs_mode="raw_logits"),
+        )
+        with patch.object(
+            gpu_model_runner, "compute_prompt_logprobs_with_chunking", computed
+        ):
+            # The forward's output may be padded past the step's tokens.
+            gpu_model_runner.GPUModelRunner._dummy_prompt_logprobs_run(
+                runner, torch.zeros(2056, 8), 7
+            )
+        assert calls == [
+            (rows, torch.int64, rows, 7, "raw_logits", runner.model.compute_logits)
+        ]
+
