diff --git a/tests/v1/core/test_kv_cache_users_sizing.py b/tests/v1/core/test_kv_cache_users_sizing.py
new file mode 100644
index 0000000000000000000000000000000000000000..88a57dd44c275528350460b8e8cafbe75d07596c
--- /dev/null
+++ b/tests/v1/core/test_kv_cache_users_sizing.py
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU KV capacity is derived from --kv-cache-users, not from free memory.
+
+The pool must hold exactly N declared full-length contexts (plus the null
+block) on any machine: the same declaration has to produce the same block
+count on a laptop GPU and on a B200, with surplus VRAM left unclaimed and a
+shortfall failing closed at startup. Byte- and block-denominated sizing
+inputs are refused, not reconciled.
+"""
+
+import pytest
+import torch
+
+from vllm.config import ModelConfig, VllmConfig
+from vllm.utils.math_utils import cdiv
+from vllm.v1.core.kv_cache_utils import get_kv_cache_configs
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+pytestmark = pytest.mark.cpu_test
+
+BLOCK_SIZE = 16
+
+
+def _spec() -> FullAttentionSpec:
+    return FullAttentionSpec(
+        block_size=BLOCK_SIZE,
+        num_kv_heads=2,
+        head_size=64,
+        dtype=torch.float32,
+    )
+
+
+def _vllm_config(max_model_len: int, kv_cache_users: int | None) -> VllmConfig:
+    vllm_config = VllmConfig(model_config=ModelConfig(max_model_len=max_model_len))
+    vllm_config.cache_config.kv_cache_users = kv_cache_users
+    return vllm_config
+
+
+def _blocks_per_user(max_model_len: int) -> int:
+    return cdiv(max_model_len, BLOCK_SIZE)
+
+
+@pytest.mark.parametrize("users", [1, 3])
+@pytest.mark.parametrize("max_model_len", [16, 48, 50])
+def test_pool_holds_declared_users_plus_null_block(users, max_model_len):
+    spec = _spec()
+    vllm_config = _vllm_config(max_model_len, users)
+    expected_blocks = users * _blocks_per_user(max_model_len) + 1
+
+    # Surplus availability must not inflate the pool: "whatever fits" is the
+    # machine-specific sizing this flag exists to remove.
+    surplus = spec.page_size_bytes * (expected_blocks + 1000)
+    (kv_cache_config,) = get_kv_cache_configs(
+        vllm_config, [{"layer1": spec}], [surplus]
+    )
+
+    assert kv_cache_config.num_blocks == expected_blocks
+    assert kv_cache_config.kv_cache_tensors[0].size == (
+        spec.page_size_bytes * expected_blocks
+    )
+
+
+def test_declared_users_beyond_available_memory_fail_closed():
+    spec = _spec()
+    vllm_config = _vllm_config(64, 4)
+    expected_blocks = 4 * _blocks_per_user(64) + 1
+
+    with pytest.raises(ValueError, match="--kv-cache-users 4 requires"):
+        get_kv_cache_configs(
+            vllm_config,
+            [{"layer1": spec}],
+            [spec.page_size_bytes * (expected_blocks - 1)],
+        )
+
+
+def test_missing_kv_cache_users_fails_closed():
+    spec = _spec()
+    vllm_config = _vllm_config(16, None)
+    with pytest.raises(ValueError, match="--kv-cache-users was not"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+@pytest.mark.parametrize("bad_users", [0, -2])
+def test_non_positive_kv_cache_users_fails_closed(bad_users):
+    spec = _spec()
+    vllm_config = _vllm_config(16, bad_users)
+    with pytest.raises(ValueError, match="positive integer"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+def test_num_gpu_blocks_override_is_refused_alongside_users():
+    spec = _spec()
+    vllm_config = _vllm_config(16, 1)
+    vllm_config.cache_config.num_gpu_blocks_override = 128
+    with pytest.raises(ValueError, match="num_gpu_blocks_override"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+def test_per_worker_derivation_uses_projected_groups():
+    # PP: each stage holds N contexts of its own layers; a stage with more
+    # spare memory must not grow past the declaration.
+    spec = _spec()
+    vllm_config = _vllm_config(64, 2)
+    expected_blocks = 2 * _blocks_per_user(64) + 1
+    (config_a, config_b) = get_kv_cache_configs(
+        vllm_config,
+        [{"layer1": spec}, {"layer2": spec}],
+        [
+            spec.page_size_bytes * expected_blocks,
+            spec.page_size_bytes * expected_blocks * 5,
+        ],
+    )
+    assert config_a.num_blocks == expected_blocks
+    assert config_b.num_blocks == expected_blocks
