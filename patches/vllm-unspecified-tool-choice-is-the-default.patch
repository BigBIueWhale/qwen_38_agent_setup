+++ b/tests/entrypoints/openai/chat_completion/test_unspecified_tool_choice.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A tool choice decides both whether the call grammar is armed and whether
+calls are parsed, so the two can never disagree. A choice that is not
+specified, omitted or null, is "auto" with tools and "none" without."""
+
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.chat_completion.serving import OpenAIServingChat
+from vllm.entrypoints.openai.engine.protocol import RequestResponseMetadata
+from vllm.outputs import CompletionOutput, RequestOutput
+from vllm.parser import ParserManager
+
+MARKERS = {"</think>": 20000, "<tool_call>": 20001, "</tool_call>": 20002}
+TEXT = {v: k for k, v in MARKERS.items()}
+TOOLS = [{"type": "function", "function": {
+    "name": "write", "parameters": {
+        "type": "object", "properties": {"text": {"type": "string"}},
+        "required": ["text"],
+    },
+}}]
+CALL = (
+    "<tool_call>\n<function=write>\n<parameter=text>\none\n</parameter>"
+    "\n</function>\n</tool_call>"
+)
+OMITTED = object()
+
+
+def _encode(text):
+    ids = []
+    while text:
+        marker = next((m for m in MARKERS if text.startswith(m)), None)
+        if marker:
+            ids.append(MARKERS[marker])
+            text = text[len(marker):]
+        else:
+            ids.append(ord(text[0]))
+            text = text[1:]
+    return ids
+
+
+def _decode(ids):
+    return "".join(TEXT.get(i, chr(i)) for i in ids)
+
+
+def _tokenizer():
+    tokenizer = MagicMock()
+    tokenizer.get_vocab.return_value = MARKERS
+    tokenizer.all_special_tokens = list(MARKERS)
+    tokenizer.all_special_ids = list(MARKERS.values())
+    tokenizer.decode.side_effect = _decode
+    return tokenizer
+
+
+def _serving():
+    serving = OpenAIServingChat.__new__(OpenAIServingChat)
+    serving.response_role = "assistant"
+    serving.parser_cls = ParserManager.get_parser(
+        tool_parser_name="qwen3_coder", reasoning_parser_name="qwen3",
+        enable_auto_tools=True,
+    )
+    serving.model_config = None
+    serving.enable_auto_tools = True
+    serving.enable_prompt_tokens_details = False
+    serving.enable_log_outputs = False
+    serving.enable_log_deltas = False
+    serving.enable_force_include_usage = False
+    serving.request_logger = None
+    serving.system_fingerprint = None
+    serving.enable_per_request_metrics = False
+    return serving
+
+
+@pytest.mark.parametrize(
+    "fields,expected",
+    [
+        ({"tools": TOOLS}, "auto"),
+        ({"tools": TOOLS, "tool_choice": None}, "auto"),
+        ({}, "none"),
+        ({"tool_choice": None}, "none"),
+    ],
+    ids=["omitted-with-tools", "null-with-tools", "omitted", "null"],
+)
+def test_an_unspecified_tool_choice_is_the_default_for_its_tools(fields, expected):
+    request = ChatCompletionRequest(
+        model="unit", messages=[{"role": "user", "content": "x"}], **fields
+    )
+    assert request.tool_choice == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize(
+    "choice",
+    [OMITTED, None, "auto", "required",
+     {"type": "function", "function": {"name": "write"}}, "none"],
+    ids=["omitted", "null", "auto", "required", "named", "none"],
+)
+async def test_calls_are_parsed_exactly_where_the_grammar_is_armed(choice, stream):
+    fields = {} if choice is OMITTED else {"tool_choice": choice}
+    request = ChatCompletionRequest(
+        model="unit", messages=[{"role": "user", "content": "write"}], tools=TOOLS,
+        stream=stream, kv_scope="unit", **fields,
+    )
+    serving = _serving()
+    tokenizer = _tokenizer()
+    request = serving.parser_cls(tokenizer, request.tools).adjust_request(request)
+    armed = (
+        request.structured_outputs is not None
+        and request.structured_outputs.structural_tag is not None
+    )
+    ids = _encode("plan</think>\n\n" + CALL)
+
+    async def outputs():
+        # A non-streaming generation is read from its final output, whole.
+        size = 1 if stream else len(ids)
+        for start in range(0, len(ids), size):
+            group = ids[start:start + size]
+            last = start + size >= len(ids)
+            yield RequestOutput(
+                request_id="unit", prompt="prompt", prompt_token_ids=[1, 2, 3],
+                prompt_logprobs=None, outputs=[CompletionOutput(
+                    index=0, text=_decode(group), token_ids=group,
+                    cumulative_logprob=None, logprobs=None,
+                    finish_reason="stop" if last else None, stop_reason=None,
+                )], finished=last,
+            )
+
+    kwargs = dict(
+        request=request, result_generator=outputs(), request_id="chatcmpl-unit",
+        model_name="unit", conversation=[{"role": "user", "content": "write"}],
+        tokenizer=tokenizer, request_metadata=RequestResponseMetadata(request_id="unit"),
+    )
+    if not stream:
+        kwargs["parser"] = serving.parser_cls(tokenizer, request.tools)
+        response = await serving.chat_completion_full_generator(**kwargs)
+        message = response.choices[0].message
+        calls = [json.loads(c.function.arguments) for c in message.tool_calls]
+        content = message.content or ""
+    else:
+        arguments, content = {}, ""
+        async for event in serving.chat_completion_stream_generator(**kwargs):
+            if not event.startswith("data: ") or event.strip() == "data: [DONE]":
+                continue
+            for item in json.loads(event[6:]).get("choices", []):
+                content += item["delta"].get("content") or ""
+                for call_delta in item["delta"].get("tool_calls", []):
+                    index = call_delta["index"]
+                    arguments[index] = arguments.get(index, "") + (
+                        call_delta.get("function", {}).get("arguments") or ""
+                    )
+        calls = [json.loads(arguments[i]) for i in sorted(arguments)]
+
+    assert armed is (choice != "none")
+    if armed:
+        assert calls == [{"text": "one"}]
+        assert content.strip() == ""
+    else:
+        # Nothing could call a tool, so the call-shaped text is the model's text.
+        assert calls == []
+        assert content == "\n\n" + CALL
