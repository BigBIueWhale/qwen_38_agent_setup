+def pytest_configure(config):
+    # What a test needs that a machine may lack, declared on the test itself --
+    # on the test, its class, or its module's pytestmark -- so a runner can run
+    # it where that exists, and every other test where it does not. A test that
+    # needs one and does not say so fails on a machine without it.
+    config.addinivalue_line(
+        "markers",
+        "gpu: the test needs a GPU (a GPU build of vLLM resolves no platform "
+        "without one)",
+    )
+    config.addinivalue_line(
+        "markers",
+        "network: the test needs the network: the Hugging Face hub or a remote URL",
+    )
+
+
 def pytest_collection_modifyitems(config, items):
