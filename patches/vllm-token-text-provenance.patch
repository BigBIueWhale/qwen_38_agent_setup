+@pytest.mark.parametrize("marker", ["</think>", "<tool_call>"])
+def test_qwen_stop_stripped_boundary_never_rebinds_to_prose(
+    local_qwen_tokenizer, stream, chunk_size, prefix, marker
+):
+    """Visible text uses token positions even when the actual boundary is cut."""
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.parser import ParserManager
+    from vllm.sampling_params import RequestOutputKind
+    from vllm.v1.engine import EngineCoreOutput
+    from vllm.v1.engine.output_processor import OutputProcessor
+
+    tokenizer = local_qwen_tokenizer
+    retained = prefix + marker + " is a delimiter. "
+    # Encode the prose spelling as ordinary tokens, without the added token ID.
+    if prefix.startswith("雪"):
+        ids = [tokenizer.get_vocab()[piece] for piece in "éĽª"]
+        ids.extend(tokenizer.encode(prefix[1:], add_special_tokens=False))
+    elif prefix.startswith("\ufffd"):
+        ids = [tokenizer.get_vocab()["é"]]
+        ids.extend(tokenizer.encode(prefix[1:], add_special_tokens=False))
+    else:
+        ids = tokenizer.encode(prefix, add_special_tokens=False)
+    for part in (marker[:2], marker[2:]):
+        ids.extend(tokenizer.encode(part, add_special_tokens=False))
+    ids.extend(tokenizer.encode(" is a delimiter. HALT" + marker,
+                                add_special_tokens=False))
+    boundary_id = tokenizer.get_vocab()[marker]
+    assert ids.count(boundary_id) == 1
+    boundary_index = ids.index(boundary_id)
+    request = _tag_request(stop=["HALT" + marker], thinking=True)
+    # No structural grammar is needed for the natural boundary case; for the
+    # tool opener use the same external stop before a complete trigger arms.
+    request.sampling_params.structured_outputs = None
+    request.sampling_params.skip_special_tokens = False
+    request.sampling_params.output_kind = (
+        RequestOutputKind.DELTA if stream else RequestOutputKind.FINAL_ONLY
+    )
+    request.prompt_token_ids = tokenizer.encode("<think>", add_special_tokens=False)
+    processor = OutputProcessor(tokenizer, log_stats=False)
+    processor.add_request(request, prompt=None)
+    api_request = ChatCompletionRequest(messages=[])
+    parser_cls = ParserManager.get_parser(tool_parser_name="qwen3_coder",
+                                         reasoning_parser_name="qwen3",
+                                         enable_auto_tools=True)
+    parser = parser_cls(tokenizer, chat_template_kwargs={"enable_thinking": True})
+    reasoning, content, calls, received_ids = "", "", [], []
+    for start in range(0, len(ids), chunk_size):
+        chunk = ids[start:start + chunk_size]
+        result = processor.process_outputs([EngineCoreOutput(
+            request_id=request.request_id, new_token_ids=chunk,
+        )])
+        for output in result.request_outputs:
+            completion = output.outputs[0]
+            received_ids.extend(completion.token_ids)
+            if stream:
+                delta = parser.parse_output_delta(
+                    completion.text, completion.token_ids, api_request,
+                    prompt_token_ids=request.prompt_token_ids,
+                    finish_reason=completion.finish_reason,
+                    stop_reason=completion.stop_reason,
+                )
+                if delta is not None:
+                    reasoning += delta.reasoning or ""
+                    content += delta.content or ""
+                    calls.extend(delta.tool_calls or [])
+            else:
+                reasoning, content, calls = parser.parse_output(
+                    completion.text, api_request, enable_auto_tools=True,
+                    model_output_token_ids=completion.token_ids,
+                    finish_reason=completion.finish_reason,
+                    stop_reason=completion.stop_reason,
+                )
+        if result.reqs_to_abort:
+            break
+    assert result.reqs_to_abort == [request.request_id]
+    assert completion.stop_reason == "HALT" + marker
+    assert received_ids == ids
+    assert reasoning == retained
+    assert not content
+    assert not calls
+    assert parser.reasoning_token_count == boundary_index
