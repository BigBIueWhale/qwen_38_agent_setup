+class _ByteLevelTokenPositions:
+    """Release decoded token spans only as their text becomes visible.
+
+    ByteLevel ASCII terminals end at the end of their native decoder step.
+    Stop holdback can delay or remove that text, but cannot move its token.
+    """
+
+    def __init__(self, tokenizer: Tokenizer, terminals: dict[int, str]) -> None:
+        self.tokenizer = tokenizer
+        self.terminals = terminals
+        self.reset()
+
+    def reset(self) -> None:
+        self.decoder = NativeDecodeStream(self.tokenizer)
+        self.pending: deque[LexerInput] = deque()
+        self.offset = 0
+        self.has_tokens = False
+
+    def scan(self, text: str, token_ids: Sequence[int]) -> list[LexerInput]:
+        if not self.has_tokens and not token_ids:
+            return [TextChunk(text)] if text else []
+        self.has_tokens |= bool(token_ids)
+        for token_id in token_ids:
+            decoded = self.decoder.step(token_id) or ""
+            terminal = self.terminals.get(token_id)
+            if terminal is None:
+                if decoded:
+                    self.pending.append(TextChunk(decoded))
+                continue
+            spelling = self.tokenizer.id_to_token(token_id)
+            if not decoded.endswith(spelling):
+                raise RuntimeError("Native decoder lost an ASCII parser terminal")
+            before = decoded[: -len(spelling)]
+            if before:
+                self.pending.append(TextChunk(before))
+            self.pending.append(PreLexedTerminal(terminal, token_id, spelling))
+
+        results: list[LexerInput] = []
+        consumed = 0
+        while consumed < len(text):
+            if not self.pending:
+                raise RuntimeError("Parser text extends beyond its decoded token spans")
+            item = self.pending[0]
+            count = min(len(item.text) - self.offset, len(text) - consumed)
+            visible = text[consumed : consumed + count]
+            if visible != item.text[self.offset : self.offset + count]:
+                raise RuntimeError("Parser text differs from its decoded token spans")
+            if isinstance(item, TextChunk):
+                results.append(TextChunk(visible))
+            consumed += count
+            self.offset += count
+            if self.offset == len(item.text):
+                if isinstance(item, PreLexedTerminal):
+                    results.append(item)
+                self.pending.popleft()
+                self.offset = 0
+        return results
+
+    def finish(self) -> list[LexerInput]:
+        # An external stop can leave a visible fragment of a terminal.
+        # Preserve that fragment as text; never invent its hidden suffix.
+        results: list[LexerInput] = []
+        if self.pending and self.offset:
+            item = self.pending[0]
+            if isinstance(item, PreLexedTerminal):
+                results.append(TextChunk(item.text[: self.offset]))
+        self.pending.clear()
+        self.offset = 0
+        return results
+
