+class NativeDecodeStream:
+    """Incremental native decoding shared by output text and token pre-lexing."""
+
+    def __init__(
+        self,
+        tokenizer: tokenizers.Tokenizer,
+        *,
+        ids: list[int] | None = None,
+        skip_special_tokens: bool = False,
+        request_id: str | None = None,
+    ) -> None:
+        self.tokenizer = tokenizer
+        self.skip_special_tokens = skip_special_tokens
+        self.request_id = request_id
+        # Resolve on the module so native backend shims retain their behavior.
+        self.stream = tokenizers.decoders.DecodeStream(
+            ids=ids, skip_special_tokens=skip_special_tokens
+        )
+
+    def step(self, token_id: int) -> str | None:
+        try:
+            return self.stream.step(self.tokenizer, token_id)
+        except (OverflowError, TypeError):
+            # Native decoder issue https://github.com/vllm-project/vllm/issues/21951.
+            logger.exception("Encountered invalid token id: %r", token_id)
+            return None
+        except Exception as error:
+            if not str(error).startswith("Invalid prefix encountered"):
+                raise
+            # Preserve native decoder recovery for non-monotonic UTF-8:
+            # https://github.com/vllm-project/vllm/issues/17448.
+            logger.warning(
+                "Encountered invalid prefix detokenization error"
+                " for request %s, resetting decode stream.",
+                self.request_id,
+            )
+            self.stream = tokenizers.decoders.DecodeStream(
+                skip_special_tokens=self.skip_special_tokens
+            )
+            return self.stream.step(self.tokenizer, token_id)
 
 
