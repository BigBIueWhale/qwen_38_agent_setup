+class TestNativeByteLevelPositions:
+    """Native decoding owns marker offsets across byte and stop-buffer cuts."""
+
+    @staticmethod
+    def _scanner():
+        from types import SimpleNamespace
+        from tokenizers import Tokenizer, decoders, models
+
+        vocabulary = {chr(i): i for i in range(33, 127)}
+        vocabulary.update({"Ġ": 32, "é": 200, "Ľ": 201, "ª": 202,
+                           "</think>": 300, "<tool_call>": 301})
+        native = Tokenizer(models.BPE(vocabulary, []))
+        native.decoder = decoders.ByteLevel()
+        scanner = TokenIDScanner(
+            {300: "THINK_END", 301: "TOOL_START"},
+            SimpleNamespace(backend_tokenizer=native),
+        )
+        return scanner, native
+
+    @pytest.mark.parametrize("chunk_size", [1, 3, 17, 1000])
+    @pytest.mark.parametrize("holdback", [0, 1, 9, 1000])
+    @pytest.mark.parametrize("cut", [None, 0, 3, 8])
+    def test_literal_and_real_marker_positions(self, chunk_size, holdback, cut):
+        scanner, native = self._scanner()
+        before = "Example: </think> literal "
+        ids = [200, 201, 202, 32] + [ord(c) for c in before] + [300]
+        if cut is None:
+            ids += [ord(c) for c in " after </think> literal"] + [301]
+        expected_before = "雪 " + before
+        complete_text = native.decode(ids, skip_special_tokens=False)
+        end = len(complete_text) if cut is None else len(expected_before) + cut
+        sent = 0
+        items = []
+        for start in range(0, len(ids), chunk_size):
+            group = ids[start:start + chunk_size]
+            done = start + chunk_size >= len(ids)
+            available = native.decode(ids[:start + len(group)], skip_special_tokens=False)
+            # Native streaming holds an incomplete UTF-8 suffix.
+            available = available.rstrip("\ufffd")
+            visible_end = min(end, max(0, len(available) - (0 if done else holdback)))
+            delta = available[sent:visible_end]
+            sent = visible_end
+            items.extend(scanner.scan(delta, group))
+        items.extend(scanner.flush_pending())
+        assert "".join(item.text for item in items) == complete_text[:end]
+        terminals = [item.terminal for item in items if isinstance(item, PreLexedTerminal)]
+        assert terminals == (["THINK_END", "TOOL_START"] if cut is None
+                             else ["THINK_END"] if cut == 8 else [])
+        scanner.reset()
+        assert scanner.scan("</think>", [300]) == [PreLexedTerminal("THINK_END", 300, "</think>")]
