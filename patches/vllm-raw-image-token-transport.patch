+import pytest
+from pydantic import ValidationError
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateRequest
+
+PNG = 'data:image/png;base64,aGVsbG8='
+
+def request(**fields):
+    return GenerateRequest.model_validate(dict(
+        token_ids=[1], sampling_params={}, kv_scope='agent', **fields))
+
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('extra', [
+    {'features': {'mm_hashes': {'image': ['caller']}, 'mm_placeholders': {
+        'image': [{'offset': 0, 'length': 1}]}, 'kwargs_data': {'image': [None]}}},
+    {'mm_hashes': {'image': ['caller']}}, {'kwargs_data': {'image': ['tensor']}},
+    {'multi_modal_uuids': {'image': ['caller']}},
+])
+def test_generate_refuses_untrusted_media_payloads(stream, extra):
+    with pytest.raises(ValidationError, match='Extra inputs'):
+        request(stream=stream, **extra)
+
+
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('part', [
+    {'type': 'audio_url', 'url': PNG}, {'type': 'video_url', 'url': PNG},
+    {'type': 'image_embeds', 'image_embeds': 'tensor'},
+    {'type': 'unknown', 'url': PNG}, {'type': 'image_url', 'url': PNG},
+    {'type': 'image_url', 'uuid': 'caller', 'image_url': {'url': PNG}},
+    {'type': 'image_url', 'uuid': None, 'image_url': {'url': PNG}},
+    {'type': 'image_url', 'image_url': {'url': PNG, 'uuid': 'caller'}},
+    {'type': 'image_url', 'image_url': {'url': PNG, 'detail': 'low'}},
+    {'type': 'image_url', 'image_url': {'url': 'https://example.invalid/image.png'}},
+    {'type': 'image_url', 'image_url': {'url': 'data:image/jpeg;base64,AA=='}},
+])
+def test_generate_refuses_unsupported_image_parts(stream, part):
+    with pytest.raises(ValidationError):
+        request(stream=stream, content_parts=[part])
+
+
+def test_raw_png_transport_preserves_original_data_url():
+    supplied = {'type': 'image_url', 'image_url': {'url': PNG, 'detail': 'high'}}
+    parsed = GenerateRequest.model_validate_json(
+        request(content_parts=[supplied]).model_dump_json())
+    assert parsed.content_parts[0].model_dump() == supplied
+    schema = GenerateRequest.model_json_schema()
+    assert 'features' not in schema['properties']
+    assert schema['additionalProperties'] is False
+
