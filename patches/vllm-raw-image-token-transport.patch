+        start_id = config.vision_start_token_id
+        end_id = config.vision_end_token_id
+        spans: list[tuple[int, int]] = []
+        i = 0
+        while i < len(prompt_ids):
+            token = prompt_ids[i]
+            if token == start_id:
+                end = i + 1
+                while end < len(prompt_ids) and prompt_ids[end] == image_id:
+                    end += 1
+                if end == i + 1 or end == len(prompt_ids) or prompt_ids[end] != end_id:
+                    raise VLLMValidationError(
+                        "Rendered image spans must contain a complete image token run",
+                        parameter="token_ids",
+                    )
+                spans.append((i + 1, end - i - 1))
+                i = end + 1
+            elif token in (image_id, end_id, config.video_token_id):
+                raise VLLMValidationError(
+                    "Rendered media tokens must belong to a complete image span",
+                    parameter="token_ids",
+                )
+            else:
+                i += 1
+        expected = [(item.start_idx, item.length)
+                    for item in placeholders.get("image", [])]
+        if spans != expected:
+            raise VLLMValidationError(
+                "Rendered image token spans do not match the supplied images",
+                parameter="token_ids",
+            )
+        return placeholders
