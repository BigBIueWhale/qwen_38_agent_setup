+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Raw image inputs and exact rendered token geometry, without a model run."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateRequest
+from vllm.exceptions import VLLMValidationError
+from vllm.model_executor.models.qwen3_vl import Qwen3VLMultiModalProcessor
+from vllm.multimodal.processing.context import TimingContext
+from vllm.multimodal.processing.inputs import ProcessorInputs, RenderedPromptTokens
+from vllm.multimodal.processing.processor import MultiModalProcessingInfo, PromptReplacement
+from vllm.renderers.base import BaseRenderer
+
+PNG = 'data:image/png;base64,aGVsbG8='
+IMAGE, START, END, VIDEO = 101, 102, 103, 104
+
+
+def request(**fields):
+    return GenerateRequest.model_validate(dict(
+        token_ids=[1], sampling_params={}, kv_scope='agent', **fields))
+
+
+
+def processor(lengths):
+    instance = object.__new__(Qwen3VLMultiModalProcessor)
+    instance.info = SimpleNamespace(
+        get_tokenizer=lambda: None,
+        get_hf_config=lambda: SimpleNamespace(
+            image_token_id=IMAGE, vision_start_token_id=START,
+            vision_end_token_id=END, video_token_id=VIDEO),
+    )
+    updates = {'image': [[PromptReplacement('image', [IMAGE], [IMAGE] * n).resolve(i)]
+                         for i, n in enumerate(lengths)]}
+    info = MultiModalProcessingInfo(
+        kwargs={'image': [None] * len(lengths)},
+        hashes={'image': [f'native-{i}' for i in range(len(lengths))]},
+        prompt_updates=updates,
+    )
+    instance._cached_apply_hf_processor = lambda inputs, timing: (
+        list(inputs.prompt.token_ids if isinstance(inputs.prompt, RenderedPromptTokens) else inputs.prompt),
+        info, False,
+    )
+    items = SimpleNamespace(get_all_counts=lambda: {'image': len(lengths)})
+    return instance, items
+
+
+@pytest.mark.parametrize('lengths', [[1], [2], [2, 3], [3, 2], [1, 1, 1]])
+def test_rendered_image_tokens_are_validated_without_second_expansion(lengths):
+    instance, items = processor(lengths)
+    original = [9]
+    rendered = [9]
+    spans = []
+    for n in lengths:
+        original += [START, IMAGE, END, 8]
+        spans.append((len(rendered) + 1, n))
+        rendered += [START, *([IMAGE] * n), END, 8]
+    context = TimingContext(enabled=False)
+    first = instance.apply(ProcessorInputs(original, items), context)
+    assert first['prompt_token_ids'] == rendered
+    incoming = ProcessorInputs(RenderedPromptTokens(rendered), items)
+    second = instance.apply(incoming, context)
+    assert second['prompt_token_ids'] == rendered
+    assert second['mm_hashes'] == first['mm_hashes']
+    assert [(p.offset, p.length) for p in second['mm_placeholders']['image']] == spans
+    assert incoming.prompt.token_ids == rendered
+
+
+@pytest.mark.parametrize('tokens,lengths', [
+    ([START, IMAGE, END], [2]),
+    ([START, IMAGE, IMAGE, IMAGE, END], [2]),
+    ([START, IMAGE, IMAGE, END, START, IMAGE, END], [2]),
+    ([START, IMAGE, IMAGE, END, IMAGE], [2]),
+    ([START, IMAGE, IMAGE, END, END], [2]),
+    ([START, IMAGE, IMAGE], [2]),
+    ([START, END], [2]),
+    ([START, IMAGE, 7, IMAGE, END], [2]),
+    ([START, IMAGE, START, IMAGE, END], [2]),
+    ([START, VIDEO, VIDEO, END], [2]),
+    ([START, IMAGE, IMAGE, IMAGE, IMAGE, IMAGE, END], [2, 3]),
+    ([START, IMAGE, IMAGE, IMAGE, END, START, IMAGE, IMAGE, END], [2, 3]),
+])
+def test_rendered_image_geometry_refuses_incomplete_or_unmatched_spans(tokens, lengths):
+    instance, items = processor(lengths)
+    with pytest.raises(VLLMValidationError) as exc:
+        instance.apply(ProcessorInputs(RenderedPromptTokens(tokens), items), TimingContext(enabled=False))
+    assert exc.value.parameter == 'token_ids'
+
+
+@pytest.mark.asyncio
+async def test_rendered_media_handoff_preserves_salt_and_uses_full_remote_inputs():
+    async def resolve(prompt, media, **kwargs):
+        assert isinstance(prompt, RenderedPromptTokens)
+        assert prompt.token_ids == [1, START, IMAGE, END]
+        assert media == {'image': ['raw']}
+        assert kwargs == dict(mm_uuids=None, mm_processor_kwargs=None,
+                              tokenization_kwargs=None, skip_mm_cache=True)
+        return {'type': 'multimodal', 'prompt_token_ids': prompt.token_ids}
+
+    renderer = SimpleNamespace(model_config=SimpleNamespace(is_encoder_decoder=False),
+        _process_multimodal_async=AsyncMock(side_effect=resolve))
+    result = await BaseRenderer.process_rendered_multimodal_async(
+        renderer, [1, START, IMAGE, END], {'image': ['raw']}, cache_salt='salt')
+    assert result['cache_salt'] == 'salt'
+
+
+@pytest.fixture
+def image_model(monkeypatch):
+    from vllm.config.multimodal import MultiModalConfig
+    from vllm.entrypoints.chat_utils import BaseMultiModalItemTracker
+
+    monkeypatch.setenv('VLLM_QWEN38_STRICT_IMAGE_CONTRACT', '1')
+    monkeypatch.setenv('VLLM_MAX_IMAGE_PIXELS', '16777216')
+    monkeypatch.delenv('VLLM_MEDIA_CACHE', raising=False)
+    # Model metadata is supplied locally; media decoding remains real.
+    info = SimpleNamespace(validate_num_items=lambda modality, count: None)
+    monkeypatch.setattr(BaseMultiModalItemTracker, 'mm_processor', property(
+        lambda tracker: SimpleNamespace(info=info)))
+    monkeypatch.setattr(BaseMultiModalItemTracker, 'model_cls', property(
+        lambda tracker: SimpleNamespace(get_placeholder_str=lambda modality, count: '<image>')))
+    return SimpleNamespace(
+        max_model_len=1000, is_encoder_decoder=False, is_multimodal_model=True,
+        hf_config=SimpleNamespace(use_unified_vision_chunk=False),
+        multimodal_config=MultiModalConfig(), allowed_local_media_path='',
+        allowed_media_domains=None,
+    )
+
+
+def png_source(color):
+    import base64
+    from io import BytesIO
+    from PIL import Image
+
+    buffer = BytesIO()
+    Image.new('RGB', (32, 32), color=color).save(buffer, 'PNG')
+    data = buffer.getvalue()
+    return data, 'data:image/png;base64,' + base64.b64encode(data).decode()
+
+
+def serving_tokens(model, process_images):
+    from unittest.mock import MagicMock
+    from vllm.entrypoints.scale_out.token_in_token_out.serving import ServingTokens
+    from vllm.outputs import CompletionOutput, RequestOutput
+
+    serving = object.__new__(ServingTokens)
+    serving.model_config = model
+    serving.default_sampling_params = {}
+    serving.override_max_tokens = None
+    serving.force_no_detokenize = False
+    serving.enable_prompt_tokens_details = False
+    serving.enable_log_outputs = False
+    serving._check_model = AsyncMock(return_value=None)
+    serving._maybe_get_adapters = MagicMock(return_value=None)
+    serving.models = SimpleNamespace(model_name=lambda adapter: 'model')
+    serving._base_request_id = MagicMock(return_value='request')
+    serving._log_inputs = MagicMock()
+    serving._get_data_parallel_rank = MagicMock(return_value=None)
+    serving._get_session_id_from_headers = MagicMock(return_value=None)
+    serving.online_renderer = SimpleNamespace(renderer=SimpleNamespace(
+        process_rendered_multimodal_async=AsyncMock(side_effect=process_images)))
+    dispatched = []
+
+    async def generate(prompt, params, request_id, **kwargs):
+        dispatched.append((prompt, params))
+        yield RequestOutput(
+            request_id=request_id, prompt=None, prompt_token_ids=prompt['prompt_token_ids'],
+            prompt_logprobs=None, finished=True, outputs=[CompletionOutput(
+                index=0, text='', token_ids=[9], cumulative_logprob=None,
+                logprobs=None, finish_reason='stop')])
+
+    serving.engine_client = SimpleNamespace(errored=False, generate=generate,
+        vllm_config=SimpleNamespace(scheduler_config=SimpleNamespace(max_num_seqs=10)))
+    return serving, dispatched
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('stream', [False, True])
+async def test_render_json_generate_preserves_source_images_tokens_salt_and_identity(image_model, stream):
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.entrypoints.scale_out.render.serving import ServingRender
+    from vllm.multimodal.hasher import MultiModalHasher
+
+    sources = [png_source('red'), png_source('blue')]
+    parts = [{'type': 'image_url', 'image_url': {'url': url, 'detail': 'high'}}
+             for _, url in sources]
+    tokens = [9, START, IMAGE, IMAGE, END, 8, START, IMAGE, IMAGE, IMAGE, END]
+    rendered = object.__new__(ServingRender)
+    rendered.model_config = image_model
+    rendered.default_sampling_params = {}
+    rendered.override_max_tokens = None
+    rendered._check_model = AsyncMock(return_value=None)
+    rendered.online_renderer = SimpleNamespace(render_chat=AsyncMock(return_value=(
+        [], [{'type': 'multimodal', 'prompt_token_ids': tokens}]
+    )))
+    chat = ChatCompletionRequest(model='model', stream=stream, kv_scope='agent',
+        cache_salt='salt', messages=[{'role': 'user', 'content': parts}])
+    outgoing = await rendered.render_chat_request(chat)
+    incoming = GenerateRequest.model_validate_json(outgoing.model_dump_json())
+    assert incoming.token_ids == tokens
+    assert [part.model_dump() for part in incoming.content_parts] == parts
+    assert 'features' not in incoming.model_dump()
+    seen_hashes = []
+
+    async def process_images(ids, media, *, cache_salt):
+        assert ids == tokens and cache_salt == 'salt'
+        assert [item.original_bytes for item in media['image']] == [data for data, _ in sources]
+        hashes = [MultiModalHasher.hash_kwargs('sha256', image=item) for item in media['image']]
+        seen_hashes.append(hashes)
+        return dict(type='multimodal', prompt_token_ids=ids, mm_hashes={'image': hashes},
+                    cache_salt=cache_salt)
+
+    serving, dispatched = serving_tokens(image_model, process_images)
+    for _ in range(2):
+        response = await serving.serve_tokens(incoming)
+        if stream:
+            events = [event async for event in response]
+            assert events[-1] == 'data: [DONE]\n\n'
+        else:
+            assert response.choices[0].finish_reason == 'stop'
+    assert len(dispatched) == 2
+    assert seen_hashes[0] == seen_hashes[1]
+    assert seen_hashes[0][0] != seen_hashes[0][1]
+    assert all(prompt['cache_salt'] == 'salt' for prompt, _ in dispatched)
+    assert all(params.extra_args['kv_scope'] == 'agent' for _, params in dispatched)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('stream', [False, True])
+async def test_direct_generate_decodes_source_before_processing_or_engine(image_model, stream):
+    serving, dispatched = serving_tokens(image_model, AsyncMock())
+    req = request(stream=stream, content_parts=[
+        {'type': 'image_url', 'image_url': {'url': PNG}}])
+    with pytest.raises(ValueError, match='Failed to load image'):
+        await serving.serve_tokens(req)
+    assert not dispatched
+    serving.online_renderer.renderer.process_rendered_multimodal_async.assert_not_called()
+
+
+def test_rendered_prompt_processes_only_media_without_retokenization():
+    from unittest.mock import MagicMock
+
+    instance, items = processor([2])
+    instance._apply_hf_processor_tokens_only = MagicMock(side_effect=AssertionError('already rendered'))
+    instance._apply_hf_processor_mm_only = MagicMock(return_value={'pixels': 'processed'})
+    tokens = [START, IMAGE, IMAGE, END]
+    prompt_ids, processed, updated = instance._apply_hf_processor_main(
+        RenderedPromptTokens(tokens), items, {}, {}, enable_hf_prompt_update=True)
+    assert prompt_ids == tokens and prompt_ids is not tokens
+    assert processed == {'pixels': 'processed'} and updated is False
+    instance._apply_hf_processor_tokens_only.assert_not_called()
+    instance._apply_hf_processor_mm_only.assert_called_once()
+
+
+@pytest.mark.parametrize('cached', [False, True])
+def test_native_image_processing_retains_exact_spans_and_full_cache_data(image_model, cached):
+    from io import BytesIO
+    from PIL import Image
+    from transformers import BatchFeature, Qwen2VLImageProcessor
+    from vllm.multimodal.cache import MultiModalProcessorOnlyCache
+    from vllm.multimodal.media import ImageMediaIO
+    from vllm.multimodal.parse import MultiModalDataParser
+
+    # The actual image processor uses the served patch/merge geometry and
+    # pixel limits. No language model or weights are instantiated.
+    image_processor = Qwen2VLImageProcessor(
+        size={'shortest_edge': 65536, 'longest_edge': 16777216},
+        patch_size=16, temporal_patch_size=2, merge_size=2,
+        image_mean=[0.5] * 3, image_std=[0.5] * 3,
+    )
+    media = []
+    for size, color in (((64, 64), 'red'), ((320, 512), 'blue')):
+        buffer = BytesIO()
+        Image.new('RGB', size, color).save(buffer, 'PNG')
+        media.append(ImageMediaIO().load_bytes(buffer.getvalue()))
+    mm_items = MultiModalDataParser().parse_mm_data({'image': media})
+    native = image_processor.preprocess([item.media for item in media], return_tensors='pt')
+    lengths = [int(grid.prod()) // 4 for grid in native['image_grid_thw']]
+    assert lengths[0] != lengths[1]
+    tokens = [9]
+    expected_spans = []
+    for length in lengths:
+        expected_spans.append((len(tokens) + 1, length))
+        tokens.extend([START, *([IMAGE] * length), END, 8])
+
+    instance = object.__new__(Qwen3VLMultiModalProcessor)
+    cache_config = SimpleNamespace(mm_processor_cache_gb=0.02, mm_hasher_algorithm='sha256')
+    instance.cache = (MultiModalProcessorOnlyCache(SimpleNamespace(
+        get_multimodal_config=lambda: cache_config)) if cached else None)
+    instance.info = SimpleNamespace(
+        model_id='local-image-processor',
+        parse_mm_data=lambda data, **kwargs: MultiModalDataParser().parse_mm_data(data),
+        ctx=SimpleNamespace(get_mm_config=lambda: cache_config),
+        get_tokenizer=lambda: None,
+        get_image_processor=lambda **kwargs: image_processor,
+        get_hf_processor=lambda **kwargs: SimpleNamespace(image_token_id=IMAGE, image_token='<image>'),
+        get_hf_config=lambda: SimpleNamespace(
+            image_token_id=IMAGE, vision_start_token_id=START,
+            vision_end_token_id=END, video_token_id=VIDEO,
+            vision_config=SimpleNamespace(spatial_merge_size=2)),
+    )
+    processed_counts = []
+
+    def process_images(*, mm_items, **kwargs):
+        images = mm_items['image'].get_all() if 'image' in mm_items else []
+        processed_counts.append(len(images))
+        return (image_processor.preprocess(images, return_tensors='pt') if images else BatchFeature({}))
+
+    instance._apply_hf_processor_mm_only = process_images
+    context = TimingContext(enabled=False)
+    results = [instance.apply(ProcessorInputs(RenderedPromptTokens(tokens), mm_items), context)
+               for _ in range(2)]
+    assert processed_counts == ([2, 0] if cached else [2, 2])
+    assert results[0]['mm_hashes'] == results[1]['mm_hashes']
+    assert results[0]['mm_hashes']['image'][0] != results[0]['mm_hashes']['image'][1]
+    for result in results:
+        assert result['prompt_token_ids'] == tokens
+        assert [(p.offset, p.length) for p in result['mm_placeholders']['image']] == expected_spans
+        assert all(item is not None for item in result['mm_kwargs']['image'])
+        for item, length in zip(result['mm_kwargs']['image'], lengths):
+            assert item['pixel_values'].data.shape[0] == length * 4
