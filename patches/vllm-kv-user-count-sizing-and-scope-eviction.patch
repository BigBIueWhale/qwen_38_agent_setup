+def test_cpu_spec_windowed_group_counts_trailing_window_only():
+    # A full-attention group needs its whole prefix; a recurrent/windowed
+    # group is resident at the trailing window the load path reads. For a
+    # Mamba-style window of one chunk, one 128-token user is 8 + 1 chunks,
+    # not 8 + 8: counting every boundary snapshot would double the declared
+    # footprint for chunks a full-length re-entry never reads.
+    groups = (
+        OffloadingGroupConfig(16, ("full_layer",)),
+        OffloadingGroupConfig(16, ("mamba_layer",), sliding_window_size_in_chunks=1),
+    )
+    spec = _create_spec(groups=groups)
+    assert spec.num_blocks == 9
