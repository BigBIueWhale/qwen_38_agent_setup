--- /dev/null
+++ b/tests/entrypoints/test_kv_scope_protocol.py
@@ -0,0 +1,174 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Agent-scope identity must land uniformly on every generation surface.
+
+Grouping the offload tier by agent only works if every protocol can carry
+the identity: a surface without the field silently produces unlabelled
+requests, and the tier then cannot tell one agent's blocks from another's.
+These tests prove, offline, that all five generation protocols this build
+can actually import expose ``kv_scope`` beside
+``cache_salt`` / ``kv_transfer_params``, validate it identically, and
+deliver them into ``SamplingParams.extra_args`` — the one internal channel
+the engine reads.
+
+The Cohere surface is deliberately not in this set: its protocol models
+hard-import the optional ``cohere`` SDK, which the --network none image
+cannot install, so upstream's endpoint existed only as the accident of a
+guarded import. The registration was excised rather than left guarded, and
+the absence of any /cohere route is asserted below as an enforced fact.
+"""
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from vllm.entrypoints.anthropic.protocol import AnthropicMessagesRequest
+from vllm.entrypoints.anthropic.serving import AnthropicServingMessages
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateRequest
+from vllm.sampling_params import SamplingParams
+
+pytestmark = pytest.mark.cpu_test
+
+_SCOPE = "toolu_01AbCdEf"
+
+
+def _minimal_payload(request_cls: type[BaseModel]) -> dict:
+    """Smallest valid payload per protocol, before the identity fields."""
+    if request_cls is ChatCompletionRequest:
+        return {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    if request_cls is CompletionRequest:
+        return {"model": "m", "prompt": "hi"}
+    if request_cls is ResponsesRequest:
+        return {"model": "m", "input": "hi"}
+    if request_cls is AnthropicMessagesRequest:
+        return {
+            "model": "m",
+            "max_tokens": 16,
+            "messages": [{"role": "user", "content": "hi"}],
+        }
+    if request_cls is GenerateRequest:
+        return {
+            "request_id": "req-1",
+            "token_ids": [1, 2, 3],
+            "sampling_params": SamplingParams(),
+        }
+    raise AssertionError(f"unhandled protocol {request_cls}")
+
+
+ALL_GENERATION_REQUESTS = [
+    ChatCompletionRequest,
+    CompletionRequest,
+    ResponsesRequest,
+    AnthropicMessagesRequest,
+    GenerateRequest,
+]
+
+
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_every_surface_accepts_scope_fields(request_cls):
+    request = request_cls(
+        **_minimal_payload(request_cls),
+        kv_scope=_SCOPE,
+    )
+    assert request.kv_scope == _SCOPE
+
+
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_every_surface_defaults_scope_to_main_line(request_cls):
+    # Absent == null == the main session line (the harness's
+    # parent_tool_use_id convention); no surface may invent a default scope.
+    request = request_cls(**_minimal_payload(request_cls))
+    assert request.kv_scope is None
+
+
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_every_surface_rejects_empty_scope(request_cls):
+    # An empty scope id is not "main line", it is a malformed identity; it
+    # must die at the protocol boundary, identically everywhere.
+    with pytest.raises(ValidationError):
+        request_cls(**_minimal_payload(request_cls), kv_scope="")
+
+
+@pytest.mark.parametrize(
+    "request_cls",
+    [ChatCompletionRequest, CompletionRequest, ResponsesRequest],
+)
+def test_openai_surfaces_deliver_scope_into_extra_args(request_cls):
+    request = request_cls(
+        **_minimal_payload(request_cls),
+        kv_scope=_SCOPE,
+    )
+    if request_cls is ResponsesRequest:
+        sampling = request.to_sampling_params(
+            default_max_tokens=32, default_sampling_params={}
+        )
+    else:
+        sampling = request.to_sampling_params(
+            max_tokens=32, default_sampling_params={}
+        )
+    assert sampling.extra_args is not None
+    assert sampling.extra_args["kv_scope"] == _SCOPE
+
+
+@pytest.mark.parametrize(
+    "request_cls",
+    [ChatCompletionRequest, CompletionRequest, ResponsesRequest],
+)
+def test_openai_surfaces_omit_absent_scope_from_extra_args(request_cls):
+    request = request_cls(**_minimal_payload(request_cls))
+    if request_cls is ResponsesRequest:
+        sampling = request.to_sampling_params(
+            default_max_tokens=32, default_sampling_params={}
+        )
+    else:
+        sampling = request.to_sampling_params(
+            max_tokens=32, default_sampling_params={}
+        )
+    extra_args = sampling.extra_args or {}
+    assert "kv_scope" not in extra_args
+
+
+def test_anthropic_translation_forwards_scope_fields():
+    # Anthropic rides the chat pipeline; the translation must pass identity
+    # through verbatim — Anthropic is one surface of six, not a special one.
+    request = AnthropicMessagesRequest(
+        **_minimal_payload(AnthropicMessagesRequest),
+        kv_scope=_SCOPE,
+    )
+    chat_request = AnthropicServingMessages._build_base_request(
+        request, [{"role": "user", "content": "hi"}]
+    )
+    assert chat_request.kv_scope == _SCOPE
+
+
+def test_cohere_endpoint_absence_is_enforced_not_import_dependent():
+    # The generate router assembly must register every supported surface and
+    # must not contain a /cohere route under any installed-package state:
+    # a guarded registration would make the endpoint set depend on which
+    # optional SDKs happen to import, which is exactly the half-present
+    # shape this fork forbids.
+    from fastapi import FastAPI
+
+    from types import SimpleNamespace
+
+    from vllm.entrypoints.generate.api_router import register_generate_api_routers
+    from vllm.entrypoints.scale_out.factories import register_scale_out_api_routers
+
+    app = FastAPI()
+    # The token-in-token-out attach reads app.state.args (tokens_only
+    # servers mount an extra abort route); mirror the minimal real state.
+    app.state.args = SimpleNamespace(tokens_only=False)
+    register_generate_api_routers(app)
+    register_scale_out_api_routers(app, ("generate",))
+    paths = {getattr(route, "path", "") for route in app.routes}
+    assert not any(path.startswith("/cohere") for path in paths), paths
+    for required in (
+        "/v1/chat/completions",
+        "/v1/completions",
+        "/v1/responses",
+        "/v1/messages",
+        "/inference/v1/generate",
+    ):
+        assert required in paths, (required, sorted(paths))
diff --git a/tests/v1/core/test_kv_cache_users_sizing.py b/tests/v1/core/test_kv_cache_users_sizing.py
new file mode 100644
--- /dev/null
+++ b/tests/v1/core/test_kv_cache_users_sizing.py
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU KV capacity is derived from --kv-cache-users, not from free memory.
+
+The pool must hold exactly N declared full-length contexts (plus the null
+block) on any machine: the same declaration has to produce the same block
+count on a laptop GPU and on a B200, with surplus VRAM left unclaimed and a
+shortfall failing closed at startup. Byte- and block-denominated sizing
+inputs are refused, not reconciled.
+
+The per-worker number these tests pass is the worker's PHYSICAL KV bound
+(the whole card minus every measured resident: weights, non-torch
+allocations, the activation peak, frontend reservations) — not profiling's
+conservative availability estimate, which additionally withholds the
+(1 - utilization) reserve, is informational, and can neither shrink nor
+veto the declaration. Only a declaration exceeding the physical bound is
+refused.
+"""
+
+import pytest
+import torch
+
+from vllm.config import ModelConfig, VllmConfig
+from vllm.utils.math_utils import cdiv
+from vllm.v1.core.kv_cache_utils import get_kv_cache_configs
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+pytestmark = pytest.mark.cpu_test
+
+BLOCK_SIZE = 16
+
+
+def _spec() -> FullAttentionSpec:
+    return FullAttentionSpec(
+        block_size=BLOCK_SIZE,
+        num_kv_heads=2,
+        head_size=64,
+        dtype=torch.float32,
+    )
+
+
+def _vllm_config(max_model_len: int, kv_cache_users: int | None) -> VllmConfig:
+    vllm_config = VllmConfig(model_config=ModelConfig(max_model_len=max_model_len))
+    vllm_config.cache_config.kv_cache_users = kv_cache_users
+    return vllm_config
+
+
+def _blocks_per_user(max_model_len: int) -> int:
+    return cdiv(max_model_len, BLOCK_SIZE)
+
+
+@pytest.mark.parametrize("users", [1, 3])
+@pytest.mark.parametrize("max_model_len", [16, 48, 50])
+def test_pool_holds_declared_users_plus_null_block(users, max_model_len):
+    spec = _spec()
+    vllm_config = _vllm_config(max_model_len, users)
+    expected_blocks = users * _blocks_per_user(max_model_len) + 1
+
+    # Surplus availability must not inflate the pool: "whatever fits" is the
+    # machine-specific sizing this flag exists to remove.
+    surplus = spec.page_size_bytes * (expected_blocks + 1000)
+    (kv_cache_config,) = get_kv_cache_configs(
+        vllm_config, [{"layer1": spec}], [surplus]
+    )
+
+    assert kv_cache_config.num_blocks == expected_blocks
+    assert kv_cache_config.kv_cache_tensors[0].size == (
+        spec.page_size_bytes * expected_blocks
+    )
+
+
+def test_declared_users_beyond_the_physical_bound_fail_closed():
+    spec = _spec()
+    vllm_config = _vllm_config(64, 4)
+    expected_blocks = 4 * _blocks_per_user(64) + 1
+
+    with pytest.raises(ValueError, match="--kv-cache-users 4 requires"):
+        get_kv_cache_configs(
+            vllm_config,
+            [{"layer1": spec}],
+            [spec.page_size_bytes * (expected_blocks - 1)],
+        )
+
+
+def test_missing_kv_cache_users_fails_closed():
+    spec = _spec()
+    vllm_config = _vllm_config(16, None)
+    with pytest.raises(ValueError, match="--kv-cache-users was not"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+@pytest.mark.parametrize("bad_users", [0, -2])
+def test_non_positive_kv_cache_users_fails_closed(bad_users):
+    spec = _spec()
+    vllm_config = _vllm_config(16, bad_users)
+    with pytest.raises(ValueError, match="positive integer"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+def test_num_gpu_blocks_override_is_refused_alongside_users():
+    spec = _spec()
+    vllm_config = _vllm_config(16, 1)
+    vllm_config.cache_config.num_gpu_blocks_override = 128
+    with pytest.raises(ValueError, match="num_gpu_blocks_override"):
+        get_kv_cache_configs(
+            vllm_config, [{"layer1": spec}], [spec.page_size_bytes * 100]
+        )
+
+
+def test_per_worker_derivation_uses_projected_groups():
+    # PP: each stage holds N contexts of its own layers; a stage with more
+    # spare memory must not grow past the declaration.
+    spec = _spec()
+    vllm_config = _vllm_config(64, 2)
+    expected_blocks = 2 * _blocks_per_user(64) + 1
+    (config_a, config_b) = get_kv_cache_configs(
+        vllm_config,
+        [{"layer1": spec}, {"layer2": spec}],
+        [
+            spec.page_size_bytes * expected_blocks,
+            spec.page_size_bytes * expected_blocks * 5,
+        ],
+    )
+    assert config_a.num_blocks == expected_blocks
+    assert config_b.num_blocks == expected_blocks
