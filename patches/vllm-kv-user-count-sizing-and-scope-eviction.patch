+    request.all_token_ids = list(range(4))
+    request.lora_request = None
+    request.is_finished.return_value = False
+    return request
+
+
+def test_req_context_carries_the_request_scope():
+    """Every manager call for a request must see its owning agent — that
+    is the identity the tier groups blocks by."""
+    scheduler = _make_partial_tail_scheduler()
+    scheduler.on_new_request(_make_scoped_request("sub", "agent_A"))
+    assert scheduler._req_status["sub"].req_context.kv_scope == "agent_A"
+
+    scheduler.on_new_request(_make_scoped_request("main", None))
+    assert scheduler._req_status["main"].req_context.kv_scope is None
