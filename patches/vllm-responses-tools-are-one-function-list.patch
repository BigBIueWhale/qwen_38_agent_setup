+_RESPONSES_PATH = {
+    "type": "object",
+    "properties": {"path": {"type": "string"}},
+    "required": ["path"],
+}
+_RESPONSES_TOOLS = [
+    {"type": "function", "name": "read_file", "parameters": _RESPONSES_PATH},
+    {
+        "type": "namespace",
+        "name": "fs",
+        "description": "Files",
+        "tools": [{"type": "function", "name": "stat", "parameters": _RESPONSES_PATH}],
+    },
+]
+
+
+def _responses_request(tools, tool_choice):
+    from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+
+    return ResponsesRequest.model_validate(
+        {"input": "hi", "tools": tools, "tool_choice": tool_choice, "kv_scope": "a"}
+    )
+
+
+def _responses_call(name: str) -> str:
+    return (
+        f"<tool_call>\n<function={name}>\n<parameter=path>\na.txt\n</parameter>"
+        "\n</function>\n</tool_call>"
+    )
+
+
+@pytest.mark.parametrize(
+    "tool_choice, callable_names",
+    [
+        ("auto", {"read_file", "fs__stat"}),
+        ("required", {"read_file", "fs__stat"}),
+        ({"type": "function", "name": "fs__stat"}, {"fs__stat"}),
+        (
+            {
+                "type": "allowed_tools",
+                "mode": "auto",
+                "tools": [{"type": "function", "name": "read_file"}],
+            },
+            {"read_file"},
+        ),
+        (
+            {
+                "type": "allowed_tools",
+                "mode": "required",
+                "tools": [{"type": "function", "name": "fs__stat"}],
+            },
+            {"fs__stat"},
+        ),
+    ],
+)
+def test_qwen3_admits_the_names_the_responses_prompt_offers(
+    tool_choice, callable_names
+):
+    """The template offers a namespace's function under its flat name
+    (construct_tool_dicts); the grammar admits a call exactly to the offered
+    names the choice allows, and to nothing the model was never shown."""
+    from vllm.entrypoints.openai.responses.utils import construct_tool_dicts
+
+    request = _responses_request(_RESPONSES_TOOLS, tool_choice)
+    offered = {
+        tool["function"]["name"]
+        for tool in construct_tool_dicts(request.tools, request.tool_choice)
+    }
+    assert offered == {"read_file", "fs__stat"}
+    grammar = _qwen3_grammar(request.tool_choice, None, tools=request.tools)
+    for name in (*offered, "stat", "fs"):
+        assert _is_grammar_accept_string(grammar, _responses_call(name)) is (
+            name in callable_names
+        ), name
+
+
+def test_qwen3_required_refuses_tools_that_offer_no_function():
+    """A builtin tool is neither written into the prompt nor callable in this
+    format, so 'required' over builtins alone has nothing to require."""
+    from vllm.exceptions import VLLMValidationError
+
+    request = _responses_request([{"type": "web_search_preview"}], "required")
+    with pytest.raises(VLLMValidationError) as refused:
+        _qwen3_grammar(request.tool_choice, None, tools=request.tools)
+    assert refused.value.parameter == "tool_choice"
