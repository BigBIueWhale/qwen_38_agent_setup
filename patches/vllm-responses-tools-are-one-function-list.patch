+def test_a_tool_choice_no_parser_parses_is_refused_alike(choice):
+    """One refusal for chat and Responses: a choice that lets the model call
+    is refused while no tool parser parses the calls, and served otherwise."""
+    from types import SimpleNamespace
+
+    from openai.types.responses.tool_choice_allowed import ToolChoiceAllowed
+    from openai.types.responses.tool_choice_function import ToolChoiceFunction
+
+    from vllm.entrypoints.openai.chat_completion.protocol import (
+        ChatCompletionNamedFunction,
+        ChatCompletionNamedToolChoiceParam,
+    )
+    from vllm.renderers.online_renderer import OnlineRenderer
+
+    selected = {
+        "named-chat": ChatCompletionNamedToolChoiceParam(
+            type="function", function=ChatCompletionNamedFunction(name="get_weather")
+        ),
+        "named-responses": ToolChoiceFunction(type="function", name="get_weather"),
+        "allowed-tools": ToolChoiceAllowed(
+            type="allowed_tools", mode="required",
+            tools=[{"type": "function", "name": "get_weather"}],
+        ),
+    }.get(choice, choice)
+    renderer = SimpleNamespace(
+        renderer=SimpleNamespace(tokenizer=object()), use_harmony=False
+    )
+    for parser in (None, SimpleNamespace(tool_parser_cls=None)):
+        with pytest.raises(
+            VLLMValidationError, match="--enable-auto-tool-choice"
+        ) as refused:
+            OnlineRenderer.require_tool_choice_parsed(renderer, selected, parser)
+        assert refused.value.parameter == "tool_choice"
+        OnlineRenderer.require_tool_choice_parsed(renderer, "none", parser)
+    OnlineRenderer.require_tool_choice_parsed(
+        renderer, selected, SimpleNamespace(tool_parser_cls=object)
+    )
+    harmony = SimpleNamespace(renderer=renderer.renderer, use_harmony=True)
+    OnlineRenderer.require_tool_choice_parsed(harmony, selected, None)
+
+
