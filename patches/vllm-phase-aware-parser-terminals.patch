diff --git a/tests/parser/engine/test_qwen_terminal_authority.py b/tests/parser/engine/test_qwen_terminal_authority.py
--- /dev/null
+++ b/tests/parser/engine/test_qwen_terminal_authority.py
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen reasoning controls are token based; armed tool syntax is byte based."""
+import json
+
+import pytest
+import xgrammar as xgr
+
+from tests.parser.engine.test_qwen_xml_fidelity import MARKERS, TOOL, encode, parse
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.tool_parsers.structural_tag_registry import get_model_structural_tag
+
+
+def call(name='write', value='kept'):
+    return ('<tool_call>\n<function=' + name + '>\n<parameter=text>' + value
+            + '</parameter>\n</function>\n</tool_call>')
+
+
+def tool_ids(wire, added_start, added_end):
+    ids=[]
+    while wire:
+        marker=next((m for m, enabled in (
+            ('<tool_call>', added_start), ('</tool_call>', added_end)
+        ) if enabled and wire.startswith(m)), None)
+        if marker is None:
+            ids.append(ord(wire[0]));wire=wire[1:]
+        else:
+            ids.append(MARKERS[marker]);wire=wire[len(marker):]
+    return ids
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13, 128])
+@pytest.mark.parametrize('added_start', [False, True])
+@pytest.mark.parametrize('added_end', [False, True])
+def test_content_phase_tool_language_is_independent_of_tokenization(
+    chunk_size, added_start, added_end,
+):
+    prefix='plan</think>before\n'
+    wire=call()
+    ids=encode(prefix)+tool_ids(wire,added_start,added_end)+encode('\nafter')
+    reasoning,content,calls=parse(prefix+wire+'\nafter',chunk_size,ids)
+    assert reasoning=='plan'
+    assert content=='before\n\nafter'
+    assert [json.loads(args) for args in calls]==[{'text':'kept'}]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13, 128])
+def test_ordinary_token_trigger_does_not_end_inactive_reasoning(chunk_size):
+    text='plan '+call()
+    reasoning,content,calls=parse(text,chunk_size,[ord(c) for c in text])
+    assert reasoning==text
+    assert content==''
+    assert calls==[]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13, 128])
+@pytest.mark.parametrize('added_end', [False, True])
+def test_implicit_reasoning_end_admits_text_encoded_call_closer(chunk_size,added_end):
+    wire=call()
+    reasoning,content,calls=parse('plan'+wire,chunk_size,
+        encode('plan')+tool_ids(wire,True,added_end))
+    assert reasoning=='plan'
+    assert content==''
+    assert [json.loads(args) for args in calls]==[{'text':'kept'}]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13, 128])
+def test_literal_thinking_marker_does_not_move_the_real_token_boundary(chunk_size):
+    reasoning='plan </think> still reasoning '
+    wire=call()
+    text=reasoning+'</think>'+wire
+    ids=[ord(c) for c in reasoning]+[MARKERS['</think>']]+tool_ids(wire,False,False)
+    actual,content,calls=parse(text,chunk_size,ids)
+    assert actual==reasoning
+    assert content==''
+    assert [json.loads(args) for args in calls]==[{'text':'kept'}]
+
+
+@pytest.fixture(scope='module')
+def grammar():
+    # A complete byte alphabet plus atomic wrappers: both tokenizations are
+    # available to the actual matcher, with no model or tokenizer approximation
+    # of the grammar's acceptance decision.
+    vocabulary=[chr(i) for i in range(128)]+['<tool_call>','</tool_call>','<eos>']
+    info=xgr.TokenizerInfo(vocabulary,stop_token_ids=[130])
+    tools=ChatCompletionRequest(messages=[],tools=[TOOL]).tools
+    tag=get_model_structural_tag('qwen_3_coder',tools,'auto',False)
+    return xgr.GrammarCompiler(info,max_threads=1).compile_structural_tag(tag)
+
+
+@pytest.mark.parametrize('added_start', [False, True])
+@pytest.mark.parametrize('added_end', [False, True])
+@pytest.mark.parametrize('name,valid', [('write',True),('unknown',False)])
+def test_native_grammar_arms_both_tokenizations(grammar,added_start,added_end,name,valid):
+    ids=tool_ids(call(name),added_start,added_end)
+    remap={MARKERS['<tool_call>']:128,MARKERS['</tool_call>']:129}
+    matcher=xgr.GrammarMatcher(grammar)
+    accepted=all(matcher.accept_token(remap.get(i,i)) for i in ids+[130])
+    assert accepted is valid
+    assert matcher.is_terminated() is valid
