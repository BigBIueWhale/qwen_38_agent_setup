+
+
+@pytest.mark.parametrize("is_recurrent", [False, True])
+def test_attention_extension_keeps_the_immutable_partial_prefix(is_recurrent):
+    """Extending an attention block leaves its shorter prefix valid, so the
+    partial entry stays reachable; a recurrent state replaces its checkpoint."""
+    pool = BlockPool(8, enable_caching=True, hash_block_size=4)
+    hashes = [BlockHash(bytes([i])) for i in range(1, 5)]
+    block = pool.get_new_blocks(1)[0]
+    writer = SimpleNamespace(block_hashes=hashes)
+    pool.cache_partial_block(writer, block, 8, 0, 16, is_recurrent=is_recurrent)
+    assert pool.get_cached_block(hashes[1], [0]) == [block]
+    pool.cache_full_blocks(writer, [block], 0, 1, 16, 0, is_recurrent=is_recurrent)
+    assert block.block_hash == make_block_hash_with_group_id(hashes[3], 0)
+    assert pool.get_cached_block(hashes[3], [0]) == [block]
+    if is_recurrent:
+        assert pool.get_cached_block(hashes[1], [0]) is None
+    else:
+        assert pool.get_cached_block(hashes[1], [0]) == [block]
+    pool._maybe_evict_cached_block(block)
+    assert pool.get_cached_block(hashes[1], [0]) is None
+    assert pool.get_cached_block(hashes[3], [0]) is None
