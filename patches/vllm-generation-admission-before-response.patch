+@pytest.mark.parametrize("fail_after", [0, 1])
+def test_a_responses_failure_after_the_status_line_ends_with_its_error_event(
+    fail_after,
+):
+    path, body = SURFACES["responses"]
+
+    async def admit(*args, **kwargs):
+        return await FakeStream(
+            [_output("partial", finished=False), _output()], fail_after=fail_after
+        ).prime()
+
+    app, _ = _app(admit)
+    with TestClient(app) as client:
+        response = client.post(path, json=body)
+    assert response.status_code == 200
+    events = _events(response.text)
+    assert [kind for kind, _ in events[:2]] == [
+        "response.created", "response.in_progress",
+    ]
+    kind, data = events[-1]
+    assert kind == "error", events
+    assert data["type"] == "error"
+    assert data["code"] == "InternalServerError"
+    assert data["sequence_number"] == len(events) - 1
+    assert not any(k in ("response.completed", "response.incomplete")
+                   for k, _ in events)
