+    app, _ = _app(admit)
+    with TestClient(app) as client:
+        response = client.post(path, json=body | fan_out)
+    assert response.status_code == 400, (surface, response.text)
+    assert "each with its own new kv_scope" in response.text
+    assert admit.await_count == 0
