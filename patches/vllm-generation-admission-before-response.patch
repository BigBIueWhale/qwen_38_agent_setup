+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Admission is a step of its own, and the admitted stream owns its request.
+
+admit() raises every refusal before its caller has committed to a response.
+Whatever then happens to the returned stream -- exhausted, closed, cancelled
+or dropped -- the request finishes or is aborted; nothing stays in flight.
+"""
+
+import asyncio
+import gc
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from vllm.exceptions import VLLMValidationError
+from vllm.outputs import CompletionOutput, RequestOutput
+from vllm.sampling_params import RequestOutputKind, SamplingParams
+from vllm.v1.engine.async_llm import AsyncLLM
+from vllm.v1.engine.output_processor import RequestOutputCollector
+
+pytestmark = pytest.mark.cpu_test
+
+_PROMPT = {"type": "token", "prompt_token_ids": [1, 2, 3]}
+
+
+def _output(finished: bool) -> RequestOutput:
+    return RequestOutput(
+        request_id="internal", prompt=None, prompt_token_ids=[1, 2, 3],
+        prompt_logprobs=None, finished=finished,
+        outputs=[CompletionOutput(
+            index=0, text="x", token_ids=[4], cumulative_logprob=None,
+            logprobs=None, finish_reason="stop" if finished else None,
+        )],
+    )
+
+
+def _engine(*outputs: RequestOutput, refusal: Exception | None = None):
+    engine = object.__new__(AsyncLLM)
+    engine.log_requests = False
+    queue = RequestOutputCollector(RequestOutputKind.DELTA, "internal")
+    for output in outputs:
+        queue.put(output)
+
+    async def add_request(*args, **kwargs):
+        if refusal is not None:
+            raise refusal
+        return queue
+
+    engine.add_request = AsyncMock(side_effect=add_request)
+    engine.abort = AsyncMock()
+    return engine
+
+
+def _params() -> SamplingParams:
+    return SamplingParams(max_tokens=4, extra_args={"kv_scope": "line"})
+
+
+@pytest.mark.asyncio
+async def test_admit_raises_the_refusal_before_any_stream_exists():
+    refusal = VLLMValidationError("refused", parameter="kv_scope")
+    engine = _engine(refusal=refusal)
+    with pytest.raises(VLLMValidationError) as excinfo:
+        await engine.admit(_PROMPT, _params(), "req")
+    assert excinfo.value is refusal
+    engine.abort.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_admit_returns_the_admitted_request_outputs():
+    engine = _engine(_output(False))
+    stream = await engine.admit(_PROMPT, _params(), "req")
+    engine.add_request.assert_awaited_once()
+    assert (await anext(stream)).finished is False
+    queue = await engine.add_request.side_effect()
+    queue.put(_output(True))
+    assert [output.finished async for output in stream] == [True]
+    engine.abort.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_closing_an_admitted_stream_aborts_its_request():
+    engine = _engine(_output(False))
+    stream = await engine.admit(_PROMPT, _params(), "req")
+    await stream.aclose()
+    engine.abort.assert_awaited_once_with("internal", internal=True)
+
+
+@pytest.mark.asyncio
+async def test_dropping_an_admitted_stream_unread_aborts_its_request():
+    # A response that is never iterated, e.g. a client gone before the body
+    # starts, still frees its request.
+    engine = _engine(_output(False))
+    stream = await engine.admit(_PROMPT, _params(), "req")
+    del stream
+    gc.collect()
+    for _ in range(3):
+        await asyncio.sleep(0)
+    engine.abort.assert_awaited_once_with("internal", internal=True)
+
+
+@pytest.mark.asyncio
+async def test_cancelling_the_consumer_aborts_its_request():
+    engine = _engine()  # no output ever arrives
+    stream = await engine.admit(_PROMPT, _params(), "req")
+    consumer = asyncio.create_task(anext(stream))
+    await asyncio.sleep(0)
+    consumer.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await consumer
+    engine.abort.assert_awaited_once_with("internal", internal=True)
+
+
+@pytest.mark.asyncio
+async def test_generate_admits_on_first_iteration_and_yields_the_same_outputs():
+    engine = _engine(_output(True))
+    generator = engine.generate(_PROMPT, _params(), "req")
+    engine.add_request.assert_not_awaited()
+    assert [output.finished async for output in generator] == [True]
+    engine.add_request.assert_awaited_once()
+
+    refusal = VLLMValidationError("refused", parameter="kv_scope")
+    refused = _engine(refusal=refusal)
+    with pytest.raises(VLLMValidationError):
+        await anext(refused.generate(_PROMPT, _params(), "req"))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [asyncio.CancelledError, ConnectionError])
+async def test_a_failed_engine_submission_leaves_nothing_in_flight(failure):
+    # Admission is all or nothing: once the output processor holds the
+    # request, a submission that fails or is cancelled aborts it again.
+    engine = object.__new__(AsyncLLM)
+    engine.log_requests = False
+    engine.output_processor = MagicMock()
+    engine.engine_core = MagicMock()
+    engine.engine_core.add_request_async = AsyncMock(side_effect=failure())
+    engine.abort = AsyncMock()
+    request = MagicMock(request_id="internal")
+    with pytest.raises(failure):
+        await engine._add_request(request, None, None, 0, MagicMock())
+    engine.output_processor.add_request.assert_called_once()
+    engine.abort.assert_awaited_once_with("internal", internal=True)
