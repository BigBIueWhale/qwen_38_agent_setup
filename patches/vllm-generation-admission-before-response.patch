+++ b/tests/entrypoints/test_generation_admission.py
@@ -0,0 +1,321 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every generation surface finishes admission before its status line.
+
+A refusal that admission raises -- input validation, the agent-ID rules --
+is answered with an error status of its own, never inside a stream that has
+already been answered 200. The routes, serving classes and exception handlers
+here are the served ones; only the engine client and the renderer are fakes.
+"""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from vllm.entrypoints.anthropic.serving import AnthropicServingMessages
+from vllm.entrypoints.generate.api_router import register_generate_api_routers
+from vllm.entrypoints.openai.chat_completion.batch_serving import (
+    OpenAIServingChatBatch,
+)
+from vllm.entrypoints.openai.chat_completion.serving import OpenAIServingChat
+from vllm.entrypoints.openai.completion.serving import OpenAIServingCompletion
+from vllm.entrypoints.openai.responses.serving import OpenAIServingResponses
+from vllm.entrypoints.scale_out.factories import register_scale_out_api_routers
+from vllm.entrypoints.scale_out.token_in_token_out.serving import ServingTokens
+from vllm.entrypoints.serve.exception_handling.register import (
+    init_exception_handler,
+)
+from vllm.exceptions import VLLMValidationError
+from vllm.outputs import CompletionOutput, RequestOutput
+from vllm.v1.engine.exceptions import EngineGenerateError
+
+pytestmark = pytest.mark.cpu_test
+
+_REFUSAL = "admission refused this request (unit)"
+_TOKEN_INPUT = {"type": "token", "prompt_token_ids": [1, 2, 3]}
+_MESSAGES = [{"role": "user", "content": "hi"}]
+
+# Every generative route, with a streaming body that names its line of work.
+SURFACES = {
+    "chat": ("/v1/chat/completions",
+             {"model": "m", "messages": _MESSAGES, "stream": True,
+              "kv_scope": "line"}),
+    "completion": ("/v1/completions",
+                   {"model": "m", "prompt": "hi", "stream": True,
+                    "kv_scope": "line"}),
+    "responses": ("/v1/responses",
+                  {"model": "m", "input": "hi", "stream": True,
+                   "kv_scope": "line"}),
+    "anthropic": ("/v1/messages",
+                  {"model": "m", "max_tokens": 16, "messages": _MESSAGES,
+                   "stream": True, "kv_scope": "line"}),
+    "tokens": ("/inference/v1/generate",
+               {"token_ids": [1, 2, 3], "sampling_params": {}, "stream": True,
+                "kv_scope": "line"}),
+    "batch": ("/v1/chat/completions/batch",
+              {"model": "m", "messages": [_MESSAGES, _MESSAGES],
+               "kv_scope": ["line-a", "line-b"]}),
+}
+
+
+class FakeStream:
+    """An admitted request's output stream, as the engine client returns it:
+    already started, so closing it runs its cleanup like the real one."""
+
+    def __init__(self, outputs, fail_after=None):
+        self.outputs = outputs
+        self.fail_after = fail_after
+        self.closed = False
+        self._gen = self._run()
+
+    async def _run(self):
+        try:
+            yield None  # admission marker, consumed by prime()
+            for index, output in enumerate(self.outputs):
+                if self.fail_after is not None and index == self.fail_after:
+                    raise EngineGenerateError()
+                yield output
+            if self.fail_after is not None and self.fail_after >= len(self.outputs):
+                raise EngineGenerateError()
+        finally:
+            self.closed = True
+
+    async def prime(self):
+        await anext(self._gen)
+        return self._gen
+
+
+def _output(text="ok", finished=True):
+    return RequestOutput(
+        request_id="unit", prompt=None, prompt_token_ids=[1, 2, 3],
+        prompt_logprobs=None, finished=finished,
+        outputs=[CompletionOutput(
+            index=0, text=text, token_ids=[4], cumulative_logprob=None,
+            logprobs=None, finish_reason="stop" if finished else None,
+            stop_reason=None,
+        )],
+    )
+
+
+def _engine(admit):
+    model_config = MagicMock()
+    model_config.hf_config.model_type = "test"
+    model_config.max_model_len = 4096
+    model_config.is_encoder_decoder = False
+    model_config.generation_config = "auto"
+    model_config.override_generation_config = {}
+    model_config.get_diff_sampling_param.return_value = {}
+    engine = MagicMock()
+    engine.model_config = model_config
+    engine.vllm_config = MagicMock(kv_transfer_config=None)
+    engine.vllm_config.scheduler_config.max_num_seqs = 1
+    engine.errored = False
+    engine.is_tracing_enabled = AsyncMock(return_value=False)
+    engine.admit = admit
+    engine.generate = MagicMock(
+        side_effect=AssertionError("a served surface must admit, not generate")
+    )
+    return engine
+
+
+def _app(admit) -> tuple[FastAPI, MagicMock]:
+    engine = _engine(admit)
+    models = MagicMock()
+    models.model_name.return_value = "m"
+    models.lora_requests = {}
+    renderer = MagicMock()
+    renderer.render_chat = AsyncMock(return_value=(_MESSAGES, [_TOKEN_INPUT]))
+    renderer.render_completion = AsyncMock(return_value=[_TOKEN_INPUT])
+    renderer.preprocess_chat = AsyncMock(return_value=(_MESSAGES, [_TOKEN_INPUT]))
+    renderer.preprocess_completion = AsyncMock(return_value=[_TOKEN_INPUT])
+    renderer.use_harmony = False
+    renderer.validate_chat_template.return_value = None
+    renderer.parser = None
+    chat_args = dict(
+        online_renderer=renderer, request_logger=None, chat_template=None,
+        chat_template_content_format="auto",
+    )
+    app = FastAPI()
+    app.state.args = SimpleNamespace(tokens_only=False, log_error_stack=False)
+    register_generate_api_routers(app)
+    register_scale_out_api_routers(app, ("generate",))
+    init_exception_handler(app)
+    state = app.state
+    state.openai_serving_chat = OpenAIServingChat(engine, models, "assistant", **chat_args)
+    state.openai_serving_chat_batch = OpenAIServingChatBatch(
+        engine, models, "assistant", **chat_args
+    )
+    state.anthropic_serving_messages = AnthropicServingMessages(
+        engine, models, "assistant", **chat_args
+    )
+    state.openai_serving_completion = OpenAIServingCompletion(
+        engine, models, online_renderer=renderer, request_logger=None
+    )
+    state.openai_serving_responses = OpenAIServingResponses(
+        engine, models, renderer, request_logger=None, chat_template=None,
+        chat_template_content_format="auto",
+    )
+    state.serving_tokens = ServingTokens(
+        engine, models, renderer, request_logger=None,
+    )
+    return app, engine
+
+
+def _refuse(*args, **kwargs):
+    raise VLLMValidationError(_REFUSAL, parameter="kv_scope")
+
+
+@pytest.mark.parametrize("surface", sorted(SURFACES))
+def test_an_admission_refusal_is_a_400_before_any_status_line(surface):
+    path, body = SURFACES[surface]
+    admit = AsyncMock(side_effect=_refuse)
+    app, engine = _app(admit)
+    with TestClient(app) as client:
+        response = client.post(path, json=body)
+    assert response.status_code == 400, (surface, response.text)
+    assert not response.headers["content-type"].startswith("text/event-stream")
+    assert _REFUSAL in response.text
+    assert admit.await_count == 1
+    engine.generate.assert_not_called()
