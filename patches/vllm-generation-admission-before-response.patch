+    admit = AsyncMock(side_effect=AssertionError("must not be reached"))
+    app, _ = _app(admit)
+    with TestClient(app) as client:
+        response = client.post(path, json=body)
+    assert response.status_code == 400, (surface, response.text)
+    assert "same kv_scope for every request that continues a conversation" in (
+        response.text
+    )
+    assert admit.await_count == 0
