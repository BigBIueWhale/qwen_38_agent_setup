@@ -133,6 +133,28 @@ class InputProcessor:
     def get_tokenizer(self) -> TokenizerLike:
         return self.renderer.get_tokenizer()
 
+    def _validate_priority(self, priority: int) -> None:
+        """A priority orders requests only where the scheduler orders by it.
+
+        Every route that reaches the engine is admitted here, so this holds
+        for all of them. A first-come-first-served scheduler serves requests
+        in arrival order whatever their priority, so a priority other than 0
+        asks for an order nothing applies, and is refused.
+        """
+        if priority == 0:
+            return
+        policy = self.scheduler_config.policy
+        if policy != "priority":
+            raise VLLMValidationError(
+                f"priority {priority} orders a request only under priority "
+                "scheduling, and this server schedules first come, first served "
+                f"(--scheduling-policy {policy}): the request would be served in "
+                "arrival order whatever its priority. Send priority 0 or omit "
+                "it, or serve with --scheduling-policy priority.",
+                parameter="priority",
+                value=priority,
+            )
+
     def _validate_params(
         self,
         params: SamplingParams | PoolingParams,
@@ -415,6 +437,7 @@ class InputProcessor:
         resumable: bool = False,
         session_id: str | None = None,
     ) -> EngineCoreRequest:
+        self._validate_priority(priority)
         self._validate_params(params, supported_tasks)
         self._validate_lora(lora_request)
 
