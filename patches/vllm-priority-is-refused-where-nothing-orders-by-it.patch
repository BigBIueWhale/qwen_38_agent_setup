@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A priority orders requests only where the scheduler orders by it.
+
+Admission, which every route that reaches the engine passes, refuses a priority
+a first-come-first-served scheduler would not apply, naming the parameter,
+before the request reaches the engine; priority 0, which asks for nothing, and
+any priority under priority scheduling are admitted. A route that reads the
+priority from its header refuses a header that is not an integer, instead of
+serving the request as if it had not been sent."""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+import vllm.v1.engine.input_processor as input_processor_module
+from vllm.entrypoints.generate.base.serving import (
+    PRIORITY_HEADER,
+    GenerateBaseServing,
+)
+from vllm.exceptions import VLLMValidationError
+from vllm.sampling_params import SamplingParams
+from vllm.v1.engine.input_processor import InputProcessor
+
+
+def _admission(policy: str) -> InputProcessor:
+    vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            try_get_generation_config=lambda: {}, return_sampling_mask=False
+        ),
+        cache_config=None,
+        lora_config=None,
+        scheduler_config=SimpleNamespace(policy=policy),
+        speculative_config=None,
+        structured_outputs_config=None,
+        observability_config=None,
+        use_v2_model_runner=False,
+        reasoning_config=None,
+        kv_transfer_config=None,
+    )
+    with patch.object(input_processor_module, "InputPreprocessor"):
+        return InputProcessor(
+            vllm_config,
+            SimpleNamespace(_executor=None, tokenizer=None),
+            mm_registry=SimpleNamespace(supports_multimodal_inputs=lambda _: False),
+        )
+
+
+@pytest.mark.parametrize("priority", [1, -1, 2**63 - 1])
+def test_a_priority_first_come_first_served_would_not_apply_is_refused(priority):
+    with pytest.raises(VLLMValidationError) as refused:
+        _admission("fcfs").process_inputs(
+            "request",
+            {"type": "token", "prompt_token_ids": [1]},
+            SamplingParams(),
+            ("generate",),
+            priority=priority,
+        )
+    assert refused.value.parameter == "priority"
+    assert refused.value.value == priority
+    message = str(refused.value)
+    assert "first come, first served (--scheduling-policy fcfs)" in message
+    assert "Send priority 0 or omit it" in message
+    assert "--scheduling-policy priority" in message
+
+
+def test_a_priority_that_asks_for_nothing_or_is_applied_is_admitted():
+    _admission("fcfs")._validate_priority(0)
+    for priority in (-3, 0, 7):
+        _admission("priority")._validate_priority(priority)
+
+
+@pytest.mark.parametrize("header", ["high", "1.5", ""])
+def test_a_priority_header_that_is_not_an_integer_is_refused(header):
+    raw_request = SimpleNamespace(headers={PRIORITY_HEADER: header})
+    with pytest.raises(VLLMValidationError) as refused:
+        GenerateBaseServing._get_priority(SimpleNamespace(priority=0), raw_request)
+    assert refused.value.parameter == PRIORITY_HEADER
+    assert refused.value.value == header
+
+
+def test_a_priority_header_that_is_an_integer_is_the_priority():
+    request = SimpleNamespace(priority=0)
+    raw_request = SimpleNamespace(headers={PRIORITY_HEADER: "3"})
+    assert GenerateBaseServing._get_priority(request, raw_request) == 3
+    assert GenerateBaseServing._get_priority(request, SimpleNamespace(headers={})) == 0
