+@pytest.mark.asyncio
+@pytest.mark.parametrize('agent', ['agent', '  opaque:/agent  '])
+@pytest.mark.parametrize('kind', [RequestOutputKind.DELTA, RequestOutputKind.CUMULATIVE])
+async def test_input_stream_retains_opaque_id_and_accepts_new_sampling_params(streaming_engine, agent, kind):
+    engine = streaming_engine
+    initial = SamplingParams(max_tokens=7, output_kind=kind,
+                             extra_args={'kv_scope': agent})
+    following = SamplingParams(max_tokens=3, output_kind=kind,
+                               extra_args={'kv_scope': agent})
+
+    async def chunks():
+        yield StreamingInput(prompt={'prompt_token_ids': [42]})
+        yield StreamingInput(prompt={'prompt_token_ids': [43]}, sampling_params=following)
+
+    assert [output async for output in AsyncLLM.generate(engine, chunks(), initial, 'req')] == []
+    requests = [call.args[0] for call in engine._add_request.call_args_list]
+    assert len(requests) == 3
+    assert [request.resumable for request in requests] == [True, True, False]
+    assert [request.sampling_params.max_tokens for request in requests] == [7, 3, 7]
+    assert all(request.sampling_params.extra_args['kv_scope'] == agent for request in requests)
+    assert len({request.request_id for request in requests}) == 1
+    engine.abort.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('agent', ['other', ' agent ', None, '', '   ', 7])
+@pytest.mark.parametrize('first_chunk', [False, True])
+@pytest.mark.parametrize('kind', [RequestOutputKind.DELTA, RequestOutputKind.CUMULATIVE])
+async def test_input_stream_refuses_id_change_before_dispatch_and_aborts_only_its_request(streaming_engine, agent, first_chunk, kind):
+    engine = streaming_engine
+    initial = SamplingParams(max_tokens=7, output_kind=kind,
+                             extra_args={'kv_scope': 'agent'})
+    following = SamplingParams(max_tokens=3, output_kind=kind,
+                               extra_args={'kv_scope': agent})
+
+    async def chunks():
+        if not first_chunk:
+            yield StreamingInput(prompt={'prompt_token_ids': [42]})
+        yield StreamingInput(prompt={'prompt_token_ids': [43]}, sampling_params=following)
+
+    with pytest.raises(VLLMValidationError) as caught:
+        _ = [output async for output in AsyncLLM.generate(engine, chunks(), initial, 'req')]
+    assert caught.value.parameter == 'kv_scope'
+    requests = [call.args[0] for call in engine._add_request.call_args_list]
+    assert len(requests) == 1 + int(not first_chunk)
+    assert not requests[-1].resumable
+    assert all(request.sampling_params.extra_args['kv_scope'] == 'agent' for request in requests)
+    assert all(request.prompt_token_ids != [43] for request in requests)
+    engine.abort.assert_awaited_once_with(requests[0].request_id, internal=True)
