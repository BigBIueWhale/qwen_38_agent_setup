+    @model_validator(mode="before")
+    @classmethod
+    def refuse_prompt_truncation(cls, data):
+        if not isinstance(data, dict):
+            return data
+        # The template renders the prompt and the tokenizer's default side
+        # cuts its head: the template's own markers, the system text and the
+        # tool definitions go first, and the model reads a prompt that starts
+        # mid-message.
+        if (value := data.get("truncate_prompt_tokens")) is not None:
+            raise VLLMValidationError(
+                "truncate_prompt_tokens would cut the rendered chat prompt by "
+                "token count, from its head by default -- the template's "
+                "markers, the system text and the tool definitions first -- "
+                "so the model would read a prompt that starts mid-message. "
+                "This server never truncates a chat prompt. Remove "
+                "truncate_prompt_tokens and shorten the messages yourself.",
+                parameter="truncate_prompt_tokens",
+                value=value,
+            )
+        if (value := data.get("truncation_side")) is not None:
+            raise VLLMValidationError(
+                "truncation_side chooses which end of the chat prompt "
+                "truncate_prompt_tokens cuts, and this server never truncates "
+                "a chat prompt. Remove truncation_side.",
+                parameter="truncation_side",
+                value=value,
+            )
+        return data
+
