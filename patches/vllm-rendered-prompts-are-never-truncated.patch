diff --git a/tests/entrypoints/openai/test_prompt_truncation_refused.py b/tests/entrypoints/openai/test_prompt_truncation_refused.py
new file mode 100644
index 0000000000000000000000000000000000000000..659087e6ebf26ae157c3ee099dd4e32fe4b2b0ce
--- /dev/null
+++ b/tests/entrypoints/openai/test_prompt_truncation_refused.py
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A prompt the chat template renders is never truncated.
+
+Truncation by token count cuts the rendered prompt from the tokenizer's
+default side, its head: the template's markers, the system text and the tool
+definitions go first, and the model reads a prompt that starts mid-message.
+Every surface that renders through the template refuses the parameter that
+would ask for it, naming it.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+from pydantic import ValidationError
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+from vllm.exceptions import VLLMValidationError
+
+
+@pytest.mark.parametrize(
+    "parameter,value",
+    [("truncate_prompt_tokens", 5), ("truncate_prompt_tokens", -1),
+     ("truncation_side", "left"), ("truncation_side", "right")],
+)
+def test_chat_refuses_prompt_truncation(parameter, value):
+    with pytest.raises(VLLMValidationError) as refusal:
+        ChatCompletionRequest.model_validate(
+            {"model": "m", "messages": [{"role": "user", "content": "hi"}],
+             parameter: value}
+        )
+    assert refusal.value.parameter == parameter
+
+
+def test_chat_tokenizes_without_truncation():
+    request = ChatCompletionRequest.model_validate(
+        {"model": "m", "messages": [{"role": "user", "content": "hi"}], "max_tokens": 8}
+    )
+    params = request.build_tok_params(SimpleNamespace(max_model_len=64))
+    assert params.truncate_prompt_tokens is None
+    assert params.truncation_side is None
+
+
+def _responses(**fields):
+    return ResponsesRequest.model_validate(
+        {"model": "m", "input": "hi", "kv_scope": "agent", **fields}
+    )
+
+
+def test_responses_refuses_truncation_auto():
+    with pytest.raises(VLLMValidationError) as refusal:
+        _responses(truncation="auto", max_output_tokens=8)
+    assert refusal.value.parameter == "truncation"
+
+
+def test_responses_refuses_a_null_truncation():
+    # The response echoes truncation as "auto" or "disabled"; a null that the
+    # request admitted could not be echoed back.
+    with pytest.raises(ValidationError):
+        _responses(truncation=None)
+
+
+@pytest.mark.parametrize("fields", [{}, {"truncation": "disabled"}])
+def test_responses_tokenizes_without_truncation(fields):
+    request = _responses(max_output_tokens=8, **fields)
+    assert request.truncation == "disabled"
+    params = request.build_tok_params(SimpleNamespace(max_model_len=64))
+    assert params.truncate_prompt_tokens is None
