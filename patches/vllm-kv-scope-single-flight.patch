+
+# --- One request in flight per kv_scope, refused at admission ------------
+
+
+def _frontend_admission():
+    """The real AsyncLLM admission and output processor. Input processing and
+    the engine core process are the only stand-ins; the engine answers every
+    request at once with one token and a stop."""
+    from vllm.v1.engine import EngineCoreOutput, EngineCoreRequest, FinishReason
+    from vllm.v1.engine.async_llm import AsyncLLM
+    from vllm.v1.engine.output_processor import (
+        OutputProcessor,
+        RequestOutputCollector,
+    )
+
+    llm = object.__new__(AsyncLLM)
+    llm.log_requests = False
+    llm.output_processor = OutputProcessor(None, log_stats=False)
+    llm.engine_core = MagicMock()
+    llm.engine_core.abort_requests_async = AsyncMock()
+
+    async def engine_core_add(request):
+        llm.output_processor.process_outputs([EngineCoreOutput(
+            request_id=request.request_id, new_token_ids=[4],
+            finish_reason=FinishReason.STOP,
+        )])
+
+    llm.engine_core.add_request_async = AsyncMock(side_effect=engine_core_add)
+
+    def core_request(request_id, params):
+        return EngineCoreRequest(
+            request_id=f"{request_id}-internal", external_req_id=request_id,
+            prompt_token_ids=[1, 2, 3], mm_features=None, arrival_time=0,
+            lora_request=None, cache_salt=None, data_parallel_rank=None,
+            sampling_params=params, pooling_params=None,
+        )
+
+    async def add_request(request_id, prompt, params, **kwargs):
+        request = core_request(request_id, params)
+        queue = RequestOutputCollector(params.output_kind, request.request_id)
+        await llm._add_request(request, None, None, 0, queue)
+        return queue
+
+    llm.add_request = add_request
+
+    def hold_in_flight(request_id, scope):
+        from vllm.sampling_params import SamplingParams
+
+        params = SamplingParams(max_tokens=1, extra_args={"kv_scope": scope})
+        request = core_request(request_id, params)
+        llm.output_processor.add_request(
+            request, None, None, 0,
+            RequestOutputCollector(params.output_kind, request.request_id),
+        )
+
+    return llm, hold_in_flight
+
+
+@pytest.mark.parametrize("surface", sorted(SURFACES))
+def test_an_overlapping_request_under_one_scope_is_a_400_naming_it(surface):
+    path, body = SURFACES[surface]
+    scopes = body["kv_scope"]
+    # A batch is refused on its last conversation, after admitting the others.
+    scope = scopes[-1] if isinstance(scopes, list) else scopes
+    llm, hold_in_flight = _frontend_admission()
+    app, _ = _app(llm.admit)
+    hold_in_flight("earlier", scope)
+
+    with TestClient(app) as client:
+        response = client.post(path, json=body)
+    assert response.status_code == 400, (surface, response.text)
+    assert not response.headers["content-type"].startswith("text/event-stream")
+    assert f"kv_scope {scope!r} already has a request in flight (earlier)" in (
+        response.text
+    )
+    assert "Wait for it to finish or abort it" in response.text
+    # Only the earlier request is still in flight under any ID.
+    assert list(llm.output_processor.kv_scope_requests) == [scope]
+    assert llm.output_processor.kv_scope_requests[scope].external_req_id == (
+        "earlier"
+    )
+
+    # Once the earlier request ends, the same body is admitted and answered.
+    llm.output_processor.abort_requests(["earlier"], internal=False)
+    with TestClient(app) as client:
+        response = client.post(path, json=body)
+    assert response.status_code == 200, (surface, response.text)
+    assert llm.output_processor.kv_scope_requests == {}
+
