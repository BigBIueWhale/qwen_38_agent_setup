             None
         """
+        # A kv_scope has at most one request in flight, and the output
+        # processor of the one API server process answers that at admission.
+        # Several API server processes would each see only their own share.
+        if client_count != 1:
+            raise ValueError(
+                "One API server process admits every generation request, so "
+                "that it can refuse a second request in flight under one "
+                f"kv_scope; got {client_count}. Serve with --api-server-count 1."
+            )
