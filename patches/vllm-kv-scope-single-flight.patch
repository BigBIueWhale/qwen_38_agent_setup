@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A kv_scope names one line of work, which has at most one request in flight.
+
+The frontend process knows every request in flight, so it refuses an
+overlapping request under one ID at admission: before the engine sees it,
+and before an HTTP surface answers. Finishing or aborting the earlier request
+frees the ID; a different ID is never affected.
+"""
+
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from vllm.exceptions import VLLMValidationError
+from vllm.pooling_params import PoolingParams
+from vllm.sampling_params import RequestOutputKind, SamplingParams
+from vllm.v1.engine import EngineCoreOutput, EngineCoreRequest, FinishReason
+from vllm.v1.engine.async_llm import AsyncLLM
+from vllm.v1.engine.output_processor import OutputProcessor, RequestOutputCollector
+
+pytestmark = pytest.mark.cpu_test
+
+
+def _request(name: str, scope: str | None, *, resumable: bool = False):
+    """A generation under ``scope``, or, with none, a pooling request.
+
+    Only a pooling request names no line of work: an engine request cannot be
+    built for generation without one.
+    """
+    return EngineCoreRequest(
+        request_id=f"{name}-internal",
+        external_req_id=name,
+        prompt_token_ids=[1, 2, 3],
+        mm_features=None,
+        arrival_time=0,
+        lora_request=None,
+        cache_salt=None,
+        data_parallel_rank=None,
+        sampling_params=None if scope is None else SamplingParams(
+            max_tokens=4, detokenize=False, extra_args={"kv_scope": scope},
+            output_kind=RequestOutputKind.DELTA,
+        ),
+        pooling_params=PoolingParams(task="embed") if scope is None else None,
+        resumable=resumable,
+    )
+
+
+def _processor() -> OutputProcessor:
+    return OutputProcessor(None, log_stats=False)
+
+
+def _add(processor, request):
+    queue = RequestOutputCollector(RequestOutputKind.DELTA, request.request_id)
+    processor.add_request(request, None, None, 0, queue)
+
+
+def test_an_overlapping_request_under_one_id_is_refused_by_name():
+    processor = _processor()
+    _add(processor, _request("first", "line"))
+    with pytest.raises(VLLMValidationError) as excinfo:
+        _add(processor, _request("second", "line"))
+    message = str(excinfo.value)
+    assert excinfo.value.parameter == "kv_scope"
+    assert "'line' already has a request in flight (first)" in message
+    assert "Wait for it to finish or abort it" in message
+    assert "a concurrent line of work needs its own new kv_scope" in message
+    assert set(processor.request_states) == {"first-internal"}
+
+
+def test_finishing_the_earlier_request_frees_the_id():
+    processor = _processor()
+    _add(processor, _request("first", "line"))
+    processor.process_outputs([EngineCoreOutput(
+        request_id="first-internal", new_token_ids=[4],
+        finish_reason=FinishReason.STOP,
+    )])
+    assert "first-internal" not in processor.request_states
+    _add(processor, _request("second", "line"))
+    assert processor.kv_scope_requests["line"].request_id == "second-internal"
+
+
+@pytest.mark.parametrize("internal", [True, False])
+def test_aborting_the_earlier_request_frees_the_id(internal):
+    processor = _processor()
+    _add(processor, _request("first", "line"))
+    processor.abort_requests(
+        ["first-internal" if internal else "first"], internal=internal
+    )
+    _add(processor, _request("second", "line"))
+    assert set(processor.request_states) == {"second-internal"}
+
+
+def test_different_ids_and_pooling_requests_run_side_by_side():
+    processor = _processor()
+    _add(processor, _request("a", "line-a"))
+    _add(processor, _request("b", "line-b"))
+    _add(processor, _request("pool-1", None))
+    _add(processor, _request("pool-2", None))
+    assert set(processor.kv_scope_requests) == {"line-a", "line-b"}
+    assert len(processor.request_states) == 4
+
+
+def test_an_input_stream_chunk_continues_its_own_request():
+    processor = _processor()
+    _add(processor, _request("stream", "line", resumable=True))
+    # Later chunks of the same input stream carry the same request ID.
+    _add(processor, _request("stream", "line", resumable=True))
+    assert set(processor.request_states) == {"stream-internal"}
+
+
+@pytest.mark.asyncio
+async def test_admission_refuses_the_overlap_before_the_engine_sees_it():
+    engine = object.__new__(AsyncLLM)
+    engine.log_requests = False
+    engine.output_processor = _processor()
+    engine.engine_core = MagicMock()
+    engine.engine_core.add_request_async = AsyncMock()
+    engine.engine_core.abort_requests_async = AsyncMock()
+
+    async def add(name):
+        request = _request(name, "line")
+        queue = RequestOutputCollector(RequestOutputKind.DELTA, request.request_id)
+        await engine._add_request(request, None, None, 0, queue)
+
+    await add("first")
+    with pytest.raises(VLLMValidationError):
+        await add("second")
+    assert engine.engine_core.add_request_async.await_count == 1
+
+    # Aborting the first (a closed stream or a client that went away) frees
+    # the ID for the next request.
+    await engine.abort("first-internal", internal=True)
+    await add("third")
+    assert engine.engine_core.add_request_async.await_count == 2
+
+
+@pytest.mark.parametrize("client_count", [0, 2, 4])
+def test_only_one_api_server_process_may_admit_generation(client_count):
+    # Each API server process has its own output processor; with several, two
+    # requests under one ID could be admitted side by side. Refused at start.
+    with pytest.raises(ValueError, match="--api-server-count 1"):
+        AsyncLLM(
+            vllm_config=MagicMock(), executor_class=MagicMock(),
+            log_stats=False, client_count=client_count,
+        )
