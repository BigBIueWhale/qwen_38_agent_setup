+def test_qwen3_auto_tool_choice_is_constrained_without_strict(
+    sample_tools: list[ChatCompletionToolsParam],
+):
+    """A declared Qwen schema binds whether or not the transport said strict."""
+    tag = get_model_structural_tag(
+        model="qwen_3_coder",
+        tools=sample_tools,
+        tool_choice="auto",
+        reasoning=False,
+    )
+
+    assert isinstance(tag, StructuralTag)
+    fmt = tag.model_dump()["format"]
+    assert fmt["type"] == "triggered_tags"
+    assert fmt["triggers"] == ["<tool_call>\n<function="]
+    assert fmt["excludes"] == ["<think>", "</think>"]
+    assert fmt["stop_after_first"] is False
+    assert fmt["tags"][0]["content"]["json_schema"] == (
+        sample_tools[0].function.parameters
+    )
+
