+# ---------------------------------------------------------------------------
+# Qwen3 XML structural tag: one call per turn when parallel calls are off
+# ---------------------------------------------------------------------------
+_QWEN3_CALL = (
+    "<tool_call>\n<function=get_weather>\n<parameter=city>\nParis\n</parameter>"
+    "\n</function>\n</tool_call>"
+)
+
+
+def _qwen3_grammar(tool_choice, parallel_tool_calls, tools=None):
+    tag = get_model_structural_tag(
+        model="qwen_3_coder",
+        tools=tools if tools is not None else _k3_tools_by_name(),
+        tool_choice=tool_choice,
+        reasoning=False,
+        parallel_tool_calls=parallel_tool_calls,
+    )
+    assert isinstance(tag, StructuralTag)
+    return Grammar.from_structural_tag(tag)
+
+
+@pytest.mark.parametrize("parallel_tool_calls", [None, True, False])
+def test_qwen3_auto_accepts_prose_and_one_call(parallel_tool_calls):
+    grammar = _qwen3_grammar("auto", parallel_tool_calls)
+    assert _is_grammar_accept_string(grammar, "Just an answer.")
+    assert _is_grammar_accept_string(grammar, "Checking.\n\n" + _QWEN3_CALL)
+
+
+@pytest.mark.parametrize("parallel_tool_calls", [None, True])
+def test_qwen3_auto_allows_several_calls_unless_parallel_is_off(
+    parallel_tool_calls,
+):
+    grammar = _qwen3_grammar("auto", parallel_tool_calls)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL + "\n" + _QWEN3_CALL)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL + " and more text")
+
+
+def test_qwen3_auto_with_parallel_off_ends_the_turn_after_one_call():
+    """``parallel_tool_calls: false`` is enforced at decode time.
+
+    The model cannot produce a second call or trailing text -- which is also
+    what its template asks of it -- so nothing has to be dropped afterwards
+    and the model is never shown a turn with less in it than it produced.
+    """
+    grammar = _qwen3_grammar("auto", False)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, _QWEN3_CALL + "\n" + _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, _QWEN3_CALL + " and more text")
+
+
+def test_qwen3_required_with_parallel_off_is_exactly_one_call():
+    grammar = _qwen3_grammar("required", False)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, _QWEN3_CALL + "\n" + _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, "text first " + _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, "no call at all")
+
+
+def test_qwen3_required_allows_several_calls_when_parallel_is_on():
+    grammar = _qwen3_grammar("required", True)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL + "\n" + _QWEN3_CALL)
+
+
+@pytest.mark.parametrize("reasoning", [False, True])
+@pytest.mark.parametrize("choice", ["auto", "required", "named"])
+def test_single_qwen_call_preserves_the_builtin_reasoning_prefix(reasoning, choice):
+    selected = (
+        ChatCompletionNamedToolChoiceParam(
+            type="function", function=ChatCompletionNamedFunction(name="get_weather")
+        )
+        if choice == "named" else choice
+    )
+    tag = get_model_structural_tag(
+        "qwen_3_coder", _k3_tools_by_name(), selected, reasoning,
+        parallel_tool_calls=False,
+    )
+    prefix = "thinking</think>\n\n" if reasoning else ""
+    grammar = Grammar.from_structural_tag(tag)
+    assert _is_grammar_accept_string(grammar, prefix + _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, prefix + _QWEN3_CALL * 2)
+    assert not _is_grammar_accept_string(grammar, prefix + _QWEN3_CALL + "tail")
+
+
+def test_qwen_tool_parser_passes_the_request_call_limit(sample_tools, monkeypatch):
+    monkeypatch.setenv("VLLM_ENFORCE_STRICT_TOOL_CALLING", "1")
+    parser = Qwen3EngineToolParser(MagicMock(), sample_tools)
+    request = ChatCompletionRequest(
+        messages=[], tools=sample_tools, tool_choice="auto", parallel_tool_calls=False
+    )
+    grammar = Grammar.from_structural_tag(parser.get_structural_tag(request))
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL)
+    assert not _is_grammar_accept_string(grammar, _QWEN3_CALL * 2)
+
+
+def test_qwen3_grammar_rejects_what_the_parser_now_treats_as_text():
+    """The parser accepts exactly this grammar: what it takes as content the
+    grammar never produces as a call, and vice versa."""
+    grammar = _qwen3_grammar("auto", None)
+    bare = "<function=get_weather>\n<parameter=city>\nParis\n</parameter>\n</function>"
+    # Grammar-legal free text, parsed as content.
+    assert _is_grammar_accept_string(grammar, "The format is " + bare)
+    assert _is_grammar_accept_string(grammar, "<tool_call> is an opener")
+    # A call the grammar rejects: undeclared name, undeclared parameter.
+    assert not _is_grammar_accept_string(
+        grammar, _QWEN3_CALL.replace("get_weather", "erase_disk")
+    )
+    assert not _is_grammar_accept_string(
+        grammar, _QWEN3_CALL.replace("city", "colour")
+    )
 
 
