+@pytest.mark.parametrize('chunk_size', [None, 1, 13])
+@pytest.mark.parametrize('value', VALUES)
+def test_framing_habit_cannot_change_a_decoded_value(value, chunk_size):
+    """A hugged value and a framed value decode to the same string.
+
+    The model's framing habit is slot-bound, not value-bound: it emits the
+    padding it was trained on for some parameters and not others. Because the
+    parser removes exactly the transport's framing, both spellings of a value
+    that neither begins nor ends with a newline mean the same thing, so the
+    habit cannot decide what reaches a tool.
+    """
+    if value.startswith('\n') or value.endswith('\n'):
+        pytest.skip('only a value with no framing of its own has two spellings')
+    framed = ('plan</think><tool_call>\n<function=write>\n'
+              '<parameter=text>\n' + value + '\n</parameter>\n</function>\n</tool_call>')
+    hugged = ('plan</think><tool_call>\n<function=write>\n'
+              '<parameter=text>' + value + '</parameter>\n</function>\n</tool_call>')
+    _, _, framed_calls = parse(framed, chunk_size)
+    _, _, hugged_calls = parse(hugged, chunk_size)
+    assert json.loads(framed_calls[0]) == {'text': value}
+    assert json.loads(hugged_calls[0]) == json.loads(framed_calls[0])
 
 
