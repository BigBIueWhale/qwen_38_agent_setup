+def _unframe_parameter_value(value: str, *, complete: bool) -> str:
+    """Invert the transport's framing: one newline off each end, at most once.
+
+    A parameter is carried as ``<parameter=NAME>`` ``\\n`` VALUE ``\\n``
+    ``</parameter>``.  Removing exactly one newline from each end is the exact
+    inverse of that encoding, so ``decode(encode(v)) == v`` for every ``v`` --
+    including values that themselves begin or end with a newline, which
+    transport as ``\\n\\n`` and keep their own.  Nothing becomes inexpressible,
+    and a value the model hugged against its tags decodes to the same string as
+    one it framed, which is what makes the model's slot-bound framing habit
+    irrelevant instead of load-bearing.
+
+    ``complete`` is false for the one parameter whose closer has not been
+    generated yet: its trailing framing newline has not been observed, so a
+    trailing newline there is value text and is kept.
+    """
+    if value.startswith("\n"):
+        value = value[1:]
+    if complete and value.endswith("\n"):
+        value = value[:-1]
+    return value
+
