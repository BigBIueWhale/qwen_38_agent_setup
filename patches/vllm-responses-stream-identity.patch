+@pytest.mark.asyncio
+@pytest.mark.parametrize("finish", ["stop", "length"])
+@pytest.mark.parametrize("shape", ["text", "tool", "two_tools", "mixed"])
+async def test_terminal_response_uses_streamed_items_and_ids(finish, shape):
+    """Item IDs, call IDs, arguments and order must survive terminal replay."""
+    serving = _make_serving_instance_with_reasoning()
+    serving._initialize_tool_sessions = AsyncMock()
+    parser = MagicMock()
+    # The scripted parser splits no reasoning on an exact id boundary.
+    parser.reasoning_token_count = None
+    parser.parse.side_effect = AssertionError("Streaming output must not be reparsed")
+    deltas = []
+    if shape == "mixed":
+        deltas.append(DeltaMessage(reasoning="preserved thinking"))
+    if shape in ("text", "mixed"):
+        deltas.extend([DeltaMessage(content=" first"), DeltaMessage(content="\nlast ")])
+    if shape != "text":
+        for index in range(2 if shape == "two_tools" else 1):
+            deltas.extend([
+                DeltaMessage(tool_calls=[DeltaToolCall(
+                    index=index, function=DeltaFunctionCall(name="lookup", arguments="{"),
+                )]),
+                DeltaMessage(tool_calls=[DeltaToolCall(
+                    index=index, function=DeltaFunctionCall(arguments='"x":1}'),
+                )]),
+            ])
+    parser.parse_delta.side_effect = deltas
+    context = SimpleContext(response_parser=parser)
+
+    async def outputs():
+        for index in range(len(deltas)):
+            terminal = index == len(deltas) - 1
+            context.append_output(RequestOutput(
+                request_id="req", prompt="question", prompt_token_ids=[1, 2],
+                prompt_logprobs=None, outputs=[CompletionOutput(
+                    index=0, text=f"raw{index}", token_ids=[10 + index],
+                    cumulative_logprob=0.0, logprobs=None,
+                    finish_reason=finish if terminal else None, stop_reason=None,
+                )], finished=terminal,
+            ))
+            yield context
+
+    request = ResponsesRequest(input="question", tools=[], stream=True, kv_scope="agent")
+    events = [event async for event in serving.responses_stream_generator(
+        request, SamplingParams(max_tokens=20), outputs(), context, "model",
+        MagicMock(), RequestResponseMetadata(request_id="req"), created_time=123,
+    )]
+    assert events[-1].type == ("response.incomplete" if finish == "length"
+                              else "response.completed")
+    added = [event.item for event in events if event.type == "response.output_item.added"]
+    done = [event.item for event in events if event.type == "response.output_item.done"]
+    final = events[-1].response
+    assert [item.model_dump() for item in final.output] == [item.model_dump() for item in done]
+    assert [item.id for item in added] == [item.id for item in done]
+    assert [item.call_id for item in added if item.type == "function_call"] == [
+        item.call_id for item in final.output if item.type == "function_call"
+    ]
+    assert final.usage.input_tokens == 2
+    assert final.usage.output_tokens == len(deltas)
+    assert final.usage.output_tokens_details.reasoning_tokens is None
+    assert [event.sequence_number for event in events] == list(range(len(events)))
+    serving._initialize_tool_sessions.assert_not_awaited()
+    parser.parse.assert_not_called()
+    if finish == "length":
+        assert done[-1].status == "incomplete"
+    else:
+        results = [{"type": "function_call_output", "call_id": item.call_id,
+                    "output": "result"} for item in added if item.type == "function_call"]
+        messages = construct_input_messages(request_input=list(final.output) + results)
+        assert [message["tool_call_id"] for message in messages if message["role"] == "tool"] == [
+            result["call_id"] for result in results
+        ]
+
