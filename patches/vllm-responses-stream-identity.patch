+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("finish", ["stop", "length"])
+async def test_text_output_retains_logprobs_and_status_on_both_transports(stream, finish):
+    from openai.types.responses.response_output_text import Logprob
+
+    serving = _make_serving_instance_with_reasoning()
+    serving.parser = None
+    serving._initialize_tool_sessions = AsyncMock()
+    logprob = Logprob(token="A", bytes=[65], logprob=-0.25, top_logprobs=[])
+    serving._create_response_logprobs = MagicMock(return_value=[logprob])
+    context = SimpleContext()
+
+    async def outputs():
+        context.append_output(RequestOutput(
+            request_id="req", prompt="q", prompt_token_ids=[1, 2],
+            prompt_logprobs=None, outputs=[CompletionOutput(
+                index=0, text="A", token_ids=[65], cumulative_logprob=-0.25,
+                logprobs=[{}], finish_reason=finish, stop_reason=None,
+            )], finished=True,
+        ))
+        yield context
+
+    request = ResponsesRequest(
+        input="q", stream=stream, include=["message.output_text.logprobs"],
+    )
+    args = (request, SamplingParams(max_tokens=20), outputs(), context, "model",
+            MagicMock(), RequestResponseMetadata(request_id="req"))
+    if stream:
+        events = [event async for event in serving.responses_stream_generator(*args)]
+        response = events[-1].response
+        done = next(event for event in events if event.type == "response.output_item.done")
+        assert done.item.model_dump() == response.output[0].model_dump()
+    else:
+        response = await serving.responses_full_generator(*args)
+    assert response.status == ("incomplete" if finish == "length" else "completed")
+    assert response.output[0].status == response.status
+    assert response.output[0].content[0].logprobs == [logprob]
