+])
+def test_log_probabilities_are_refused_naming_the_field(field, value):
+    # A message's log probabilities would be those of the tokens its text came
+    # from; the parser does not divide the generated ids into items, and one
+    # token can end the message and begin a call.
+    with pytest.raises(VLLMValidationError) as refused:
+        ResponsesRequest.model_validate(
+            {"input": "q", "kv_scope": "agent", field: value})
+    assert refused.value.parameter == field
+    assert "/v1/chat/completions" in str(refused.value)
+
+
+@pytest.mark.parametrize("fields", [{}, {"top_logprobs": 0}, {"top_logprobs": None}])
+def test_a_request_asking_for_no_log_probabilities_is_served(fields):
+    request = ResponsesRequest.model_validate({"input": "q", "kv_scope": "agent", **fields})
+    assert request.to_sampling_params(8, {}).logprobs is None
