+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The raw-token contract carries the observed cause into either API shape."""
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import (
+    GenerateResponse, GenerateStreamResponse,
+)
+from vllm.renderers.online_derenderer import OnlineDerenderer
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('surface', ['chat', 'completion'])
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('tokens', [[], [65, 66]])
+@pytest.mark.parametrize('finish,stop', [
+    ('stop', None), ('stop', 'END'), ('stop', 99),
+    ('length', None), ('length', 'final_response_token_budget'), ('abort', None),
+])
+async def test_derender_keeps_empty_output_and_observed_terminal(surface, stream, tokens, finish, stop):
+    renderer = object.__new__(OnlineDerenderer)
+    renderer.parser = None
+    renderer.renderer = SimpleNamespace(get_tokenizer=lambda: SimpleNamespace(
+        decode=lambda ids, **kwargs: ''.join(map(chr, ids))))
+    # This test isolates the token-transport boundary from the independent
+    # incremental Unicode decoder (covered by test_derender_stream.py).
+    renderer._detokenize_delta = lambda tokenizer, ids, state, **kwargs: (
+        ''.join(map(chr, ids)), state)
+    payload = dict(request_id='request', choices=[dict(
+        index=0, token_ids=tokens, finish_reason=finish, stop_reason=stop)])
+    if stream:
+        incoming = GenerateStreamResponse.model_validate_json(
+            GenerateStreamResponse.model_validate(payload).model_dump_json())
+        method = getattr(renderer, f'derender_{surface}_stream')
+        response, _ = await method('model', incoming)
+        choice = response.choices[0]
+        text = choice.delta.content or '' if surface == 'chat' else choice.text
+    else:
+        incoming = GenerateResponse.model_validate_json(
+            GenerateResponse.model_validate(payload).model_dump_json())
+        if surface == 'chat':
+            choice = renderer._derender_chat(incoming)[0]
+            text = choice.message.content
+        else:
+            choices, _, _ = renderer._derender_completion([incoming])
+            choice = choices[0]
+            text = choice.text
+    assert text == ''.join(map(chr, tokens))
+    assert choice.finish_reason == finish
+    assert choice.stop_reason == stop
