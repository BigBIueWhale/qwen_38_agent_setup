+
+    for missing in ('finish_reason', 'token_ids'):
+        fields = dict(index=0, finish_reason='stop', token_ids=[])
+        del fields[missing]
+        with pytest.raises(ValidationError, match=missing):
+            GenerateResponseChoice(**fields)
+    for reason in (None, 'error', 'invented'):
+        with pytest.raises(ValidationError, match='finish_reason'):
+            GenerateResponseChoice(index=0, token_ids=[], finish_reason=reason)
