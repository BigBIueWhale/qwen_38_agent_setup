+@pytest.mark.asyncio
+@pytest.mark.parametrize('stream', [False, True])
+@pytest.mark.parametrize('fault', [
+    'empty_iterator', 'missing_terminal', 'missing_choice', 'missing_request_terminal',
+    'engine_error', 'empty_engine_error', 'duplicate_choice', 'out_of_range',
+    'after_request_terminal', 'after_choice_terminal', 'unknown_cause',
+    'stop_without_finish', 'missing_prompt',
+])
+async def test_generation_integrity_failures_are_errors_on_both_transports(stream, fault):
+    from vllm.entrypoints.openai.engine.protocol import ErrorResponse
+
+    engine = _mock_engine()
+    n = 2 if fault in ('missing_choice', 'after_choice_terminal') else 1
+    res = _make_request_output('req', [9], 'stop', True)
+    outputs = [res]
+    if fault == 'empty_iterator':
+        outputs = []
+    elif fault == 'missing_terminal':
+        res.outputs[0].finish_reason = None
+    elif fault == 'missing_choice':
+        pass
+    elif fault == 'missing_request_terminal':
+        res.finished = False
+    elif fault in ('engine_error', 'empty_engine_error'):
+        res.outputs[0].finish_reason = 'error'
+        if fault == 'empty_engine_error':
+            res.outputs[0].token_ids = []
+    elif fault == 'duplicate_choice':
+        res.outputs.append(res.outputs[0])
+    elif fault == 'out_of_range':
+        res.outputs[0].index = 1
+    elif fault == 'after_request_terminal':
+        outputs.append(res)
+    elif fault == 'after_choice_terminal':
+        res.finished = False
+        outputs.append(_make_request_output('req', [8], 'stop', False))
+    elif fault == 'unknown_cause':
+        res.outputs[0].finish_reason = 'invented'
+    elif fault == 'stop_without_finish':
+        res.finished = False
+        res.outputs[0].finish_reason = None
+        res.outputs[0].stop_reason = 'END'
+    elif fault == 'missing_prompt':
+        res.prompt_token_ids = None
+
+    async def generate(*args, **kwargs):
+        for output in outputs:
+            yield output
+
+    engine.generate = MagicMock(side_effect=generate)
+    serving = _build_serving_tokens(engine)
+    request = GenerateRequest(token_ids=[1], sampling_params={'n': n}, stream=stream,
+        stream_options=StreamOptions(include_usage=True))
+    response = await serving.serve_tokens(request)
+    if stream:
+        events = _parse_sse_chunks([event async for event in response])
+        assert '[DONE]' not in events
+        assert events[-1]['error']['code'] == 500
+        assert all(not e.get('usage') for e in events)
+    else:
+        assert isinstance(response, ErrorResponse)
+        assert response.error.code == 500
+
+
+@pytest.mark.parametrize('stream', [False, True])
+def test_generate_transport_owns_output_kind(stream):
+    from pydantic import ValidationError
+    from vllm.sampling_params import RequestOutputKind
+
+    for kind in RequestOutputKind:
+        with pytest.raises(ValidationError, match='output_kind'):
+            GenerateRequest(token_ids=[1], stream=stream, sampling_params={'output_kind': kind})
+        request = GenerateRequest(token_ids=[1], stream=stream,
+            sampling_params=SamplingParams(output_kind=kind), kv_scope='agent')
+        encoded = request.model_dump_json()
+        assert 'output_kind' not in encoded
+        decoded = GenerateRequest.model_validate_json(encoded)
+        assert decoded.to_sampling_params(99, {'output_kind': kind}).output_kind == (
+            RequestOutputKind.DELTA if stream else RequestOutputKind.FINAL_ONLY)
+
