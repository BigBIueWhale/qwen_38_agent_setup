+@pytest.mark.asyncio
+@pytest.mark.parametrize('stream', [False, True])
+async def test_parallel_sampling_keeps_staggered_choices_and_total_usage(stream):
+    from types import SimpleNamespace
+    from vllm.sampling_params import RequestOutputKind
+    from vllm.v1.engine.parallel_sampling import ParentRequest
+
+    engine = _mock_engine()
+
+    async def generate(prompt, params, request_id, **kwargs):
+        assert params.output_kind == (
+            RequestOutputKind.DELTA if stream else RequestOutputKind.FINAL_ONLY)
+        parent = ParentRequest(SimpleNamespace(
+            params=params, request_id=request_id, external_req_id=request_id))
+        children = [parent.get_child_info(i)[0] for i in range(params.n)]
+        steps = [(1, [81], None), (0, [90], 'stop'), (1, [82], 'length')]
+        for index, tokens, reason in steps:
+            if not stream and reason is None:
+                continue
+            if not stream and index == 1:
+                tokens = [81, 82]
+            res = _make_request_output(request_id, tokens, reason, index=index)
+            res.outputs[0].stop_reason = 'final_response_token_budget' if reason == 'length' else None
+            outputs, finished = parent.get_outputs(children[index], res.outputs[0])
+            if outputs:
+                res.outputs, res.finished = outputs, finished
+                yield res
+
+    engine.generate = MagicMock(side_effect=generate)
+    serving = _build_serving_tokens(engine)
+    request = GenerateRequest(
+        token_ids=[1, 2, 3], sampling_params={'n': 2}, stream=stream,
+        stream_options=StreamOptions(include_usage=True, continuous_usage_stats=True))
+    response = await serving.serve_tokens(request)
+    if stream:
+        events = _parse_sse_chunks([event async for event in response])
+        assert events[-1] == '[DONE]'
+        chunks = [event for event in events[:-1] if event['choices']]
+        assert [event['usage']['completion_tokens'] for event in chunks] == [1, 2, 3]
+        tokens = {i: [] for i in range(2)}
+        terminals = {}
+        for event in chunks:
+            for choice in event['choices']:
+                tokens[choice['index']].extend(choice['token_ids'])
+                if choice['finish_reason'] is not None:
+                    terminals[choice['index']] = (choice['finish_reason'], choice['stop_reason'])
+        usage = events[-2]['usage']
+    else:
+        assert [choice.index for choice in response.choices] == [0, 1]
+        tokens = {choice.index: choice.token_ids for choice in response.choices}
+        terminals = {choice.index: (choice.finish_reason, choice.stop_reason) for choice in response.choices}
+        usage = response.usage.model_dump()
+    assert tokens == {0: [90], 1: [81, 82]}
+    assert terminals == {0: ('stop', None), 1: ('length', 'final_response_token_budget')}
+    assert usage['prompt_tokens'] == 3
+    assert usage['completion_tokens'] == 3
+    assert usage['total_tokens'] == 6
+
