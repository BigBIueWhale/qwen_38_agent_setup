+class _GenerateOutputState:
+    """Evidence for a complete engine result, shared by both transports."""
+
+    def __init__(self, n: int, *, final_only: bool):
+        self.n = n
+        self.final_only = final_only
+        self.terminals: set[int] = set()
+        self.finished = False
+        self.prompt_tokens: int | None = None
+        self.cached_tokens: int | None = None
+
+    def accept(self, res: RequestOutput) -> None:
+        if self.finished:
+            raise GenerationError("Engine output arrived after request completion")
+        if self.prompt_tokens is None:
+            if res.prompt_token_ids is None:
+                raise GenerationError("Engine output is missing prompt token IDs")
+            self.prompt_tokens = len(res.prompt_token_ids)
+            if res.encoder_prompt_token_ids is not None:
+                self.prompt_tokens += len(res.encoder_prompt_token_ids)
+            self.cached_tokens = res.num_cached_tokens
+
+        indices: set[int] = set()
+        terminals = set(self.terminals)
+        for output in res.outputs:
+            i = output.index
+            if not 0 <= i < self.n or i in indices or i in terminals:
+                raise GenerationError("Engine output has an invalid or repeated choice")
+            indices.add(i)
+            reason = output.finish_reason
+            if reason == "error":
+                raise GenerationError("Internal server error")
+            if reason is None:
+                if self.final_only or output.stop_reason is not None:
+                    raise GenerationError("Engine output is missing a terminal cause")
+            elif reason in ("stop", "length", "abort"):
+                terminals.add(i)
+            else:
+                raise GenerationError("Engine output has an unknown terminal cause")
+        if res.finished != (len(terminals) == self.n):
+            raise GenerationError("Engine completion disagrees with choice terminals")
+        self.terminals = terminals
+        self.finished = res.finished
+
+    def finish(self) -> None:
+        if not self.finished:
+            raise GenerationError("Engine output ended before all choices completed")
 
 
