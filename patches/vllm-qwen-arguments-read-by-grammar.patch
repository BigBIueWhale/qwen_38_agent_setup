+def _grammar_accepts(schema, call):
+    import xgrammar as xgr
+    from xgrammar.testing import _is_grammar_accept_string
+    from vllm.tool_parsers.structural_tag_registry import get_model_structural_tag
+
+    request = ChatCompletionRequest(messages=[], tools=[{
+        'type': 'function', 'function': {'name': 'write', 'parameters': schema},
+    }])
+    return _is_grammar_accept_string(xgr.Grammar.from_structural_tag(
+        get_model_structural_tag('qwen_3_coder', request.tools, 'auto', False)), call)
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13])
+@pytest.mark.parametrize('additional', [False, None])
+@pytest.mark.parametrize('content', MARKUP)
+def test_json_value_strings_carry_parameter_markup(content, additional, chunk_size):
+    """A JSON value ends at the first closer outside its strings.
+
+    The grammar admits any string inside an array or object value, markup
+    included, so the call is published exactly as written: not cut at the
+    marker, refused as a repeated parameter, or returned as content.
+    """
+    schema = dict(TODO_SCHEMA)
+    if additional is False:
+        schema['additionalProperties'] = False
+    todos = [{'content': content, 'status': 'pending'}]
+    call = ('<tool_call>\n<function=write>\n<parameter=todos>\n' + json.dumps(todos)
+            + '\n</parameter>\n</function>\n</tool_call>')
+    assert _grammar_accepts(schema, call)
+    reasoning, content_text, calls = parse('plan</think>' + call, chunk_size,
+                                           schema=schema)
+    assert (reasoning, content_text) == ('plan', '')
+    assert [json.loads(c) for c in calls] == [{'todos': todos}]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 13])
+def test_open_declared_slot_reads_its_declared_production(chunk_size):
+    """A declared name whose slot is open is read by its declared production.
+
+    With undeclared names admitted, the same text also parses as the array
+    cut at its inner closer followed by a second ``path``; that reading is a
+    repeat the model did not write, and the declared one is read instead.
+    """
+    schema = {'type': 'object', 'required': ['path'], 'properties': {
+        'path': {'type': 'string'},
+        'ignore': {'type': 'array', 'items': {'type': 'string'}}}}
+    ignore = ['x</parameter>\n<parameter=path>\ny']
+    call = ('<tool_call>\n<function=write>\n<parameter=path>\n/a\n</parameter>\n'
+            '<parameter=ignore>\n' + json.dumps(ignore)
+            + '\n</parameter>\n</function>\n</tool_call>')
+    assert _grammar_accepts(schema, call)
+    _, _, calls = parse('plan</think>' + call, chunk_size, schema=schema)
+    assert [json.loads(c) for c in calls] == [{'path': '/a', 'ignore': ignore}]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 13])
+def test_whole_body_closes_at_the_wrapper_while_a_json_reading_is_open(chunk_size):
+    """The call closes where the grammar's only surviving reading closes it.
+
+    After ``["x</parameter>`` the array's string is still open, but the
+    undeclared slot has also closed a raw value, and a newline then cannot
+    continue a JSON string: the wrapper ends the call, read by the reading
+    the grammar kept.
+    """
+    schema = {'type': 'object', 'properties': {
+        'ignore': {'type': 'array', 'items': {'type': 'string'}}}}
+    call = ('<tool_call>\n<function=write>\n<parameter=ignore>\n["x</parameter>\n'
+            '</function>\n</tool_call>')
+    assert _grammar_accepts(schema, call)
+    reasoning, content, calls = parse('plan</think>' + call, chunk_size, schema=schema)
+    assert (reasoning, content) == ('plan', '')
+    assert [json.loads(c) for c in calls] == [{'ignore': '["x'}]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3])
+def test_truncated_json_value_is_the_unfinished_parameter(chunk_size):
