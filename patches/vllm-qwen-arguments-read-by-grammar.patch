+def test_qwen3_arguments_are_read_by_the_grammar_productions(body, parameters):
+    """The reader and the grammar are one definition of the argument body.
+
+    Every body here is accepted by the rendered grammar, and the reader
+    returns the parameters the grammar's productions close -- a raw value up
+    to its closer, a JSON value up to the first closer outside its strings,
+    a constant whole -- and every prefix of the body is a reading too.
+    """
+    grammar = Grammar.from_structural_tag(
+        get_model_structural_tag(
+            model="qwen_3_coder",
+            tools=_qwen_schema_tools(_QWEN_READING_PARAMETERS),
+            tool_choice="auto",
+            reasoning=False,
+        )
+    )
+    call = "<tool_call>\n<function=get_weather>" + body + "</function>\n</tool_call>"
+    assert _is_grammar_accept_string(grammar, call)
+    reading = read_qwen_arguments(body, _QWEN_READING_PARAMETERS)
+    assert reading is not None and reading.complete
+    assert reading.parameters == parameters
+    for cut in range(len(body)):
+        prefix = read_qwen_arguments(body[:cut], _QWEN_READING_PARAMETERS)
+        assert prefix is not None, body[:cut]
+
+
