+def resolve_final_response_token_budget(
+    requested: int | None, server_budget: int | None,
+) -> int | None:
+    """Resolve the final-answer ceiling shared by generation protocols."""
+    requested = validate_final_response_token_budget(requested)
+    server_budget = validate_final_response_token_budget(server_budget)
+    if server_budget is None:
+        return requested
+    return server_budget if requested is None else min(requested, server_budget)
+
+
