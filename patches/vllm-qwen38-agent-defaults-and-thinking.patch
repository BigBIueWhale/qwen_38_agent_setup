+class AnthropicThinkingConfig(BaseModel):
+    """Anthropic-compatible control for extended/adaptive thinking."""
+
+    type: Literal["enabled", "disabled", "adaptive"]
+    budget_tokens: Annotated[int, Field(gt=0)] | None = None
+
+    @model_validator(mode="after")
+    def validate_budget_shape(self) -> "AnthropicThinkingConfig":
+        if self.type == "disabled":
+            raise ValueError(
+                "Thinking cannot be disabled in this correctness-first profile. "
+                "Use preserve_thinking=false to omit historical reasoning traces."
+            )
+        if self.type == "enabled" and self.budget_tokens is None:
+            raise ValueError(
+                "thinking.budget_tokens is required when thinking is enabled"
+            )
+        if self.type != "enabled" and self.budget_tokens is not None:
+            raise ValueError(
+                "thinking.budget_tokens is only valid when thinking.type is enabled"
+            )
+        return self
+
 
