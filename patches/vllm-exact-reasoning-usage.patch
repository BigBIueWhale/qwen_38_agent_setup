+def _reasoning_token_count(
+    parser: Parser | None, generated_token_count: int
+) -> int | None:
+    """Reasoning ids of one choice, from the parser that split it.
+
+    The count is the parser's own, taken on the token-id stream it split
+    reasoning from content on, never a re-tokenisation of the reasoning
+    text.  ``None`` when there is no parser or the parser has no exact id
+    boundary: usage then omits the count rather than fabricating one.  A
+    parser that was handed fewer or more ids than the choice generated has
+    split a different stream, and the request is refused rather than
+    reported with a count that does not describe it.
+    """
+    if parser is None:
+        return None
+    count = parser.reasoning_token_count
+    if count is None:
+        return None
+    if parser.generated_token_count != generated_token_count:
+        raise ValueError(
+            "reasoning token accounting refused: the parser was handed "
+            f"{parser.generated_token_count} generated ids but the choice "
+            f"generated {generated_token_count}"
+        )
+    return count
+
+
+def _make_completion_tokens_details(
+    reasoning_token_counts: GenericSequence[int | None],
+) -> CompletionTokenUsageInfo | None:
+    """Sum the choices' reasoning ids the way ``completion_tokens`` sums
+    their generated ids; absent as soon as one choice has no exact count."""
+    total = 0
+    for count in reasoning_token_counts:
+        if count is None:
+            return None
+        total += count
+    return CompletionTokenUsageInfo(reasoning_tokens=total)
+
+
