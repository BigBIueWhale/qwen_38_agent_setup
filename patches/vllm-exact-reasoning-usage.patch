+class CompletionTokenUsageInfo(OpenAIBaseModel):
+    reasoning_tokens: int
+    """Generated tokens the reasoning parser consumed inside reasoning:
+    the ids before the id at which it split reasoning from content, counted
+    on that same id stream.  Included in `completion_tokens`, which counts
+    every generated id -- the reasoning-end marker and any stop token among
+    them."""
+
+
