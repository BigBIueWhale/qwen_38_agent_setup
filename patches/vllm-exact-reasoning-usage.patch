+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The exact reasoning token count is the parser's own split, on token ids.
+
+Every count here is checked against the position of the boundary id in the
+generated id stream -- the only definition that cannot drift from the split
+the client received -- through the same composed parser the chat endpoint
+uses, on both the delta-by-delta and the batch path.
+"""
+
+from unittest.mock import MagicMock
+
+import pytest
+
+from tests.parser.engine.conftest import make_mock_tokenizer
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser import ParserManager
+from vllm.parser.engine.events import EventType
+from vllm.parser.engine.parser_engine import ParserEngine
+from vllm.parser.engine.parser_engine_config import (
+    ParserEngineConfig,
+    ParserState,
+    Transition,
+)
+from vllm.parser.qwen3 import (
+    THINK_END,
+    THINK_START,
+    TOOL_CALL_END,
+    TOOL_CALL_START,
+    Qwen3Parser,
+)
+
+END_OF_TURN = "<|im_end|>"
+VOCAB = {
+    THINK_START: 98,
+    THINK_END: 99,
+    TOOL_CALL_START: 100,
+    TOOL_CALL_END: 101,
+    END_OF_TURN: 102,
+}
+
+
+def tokens(*pieces: str) -> tuple[str, list[int]]:
+    """Text and ids for a sequence of markers and single-character tokens.
+
+    The mock tokenizer decodes an unknown ASCII id to its character, so a
+    plain token is one character with its code point as the id.
+    """
+    ids = [VOCAB[piece] if piece in VOCAB else ord(piece) for piece in pieces]
+    return "".join(pieces), ids
+
+
+@pytest.fixture
+def tokenizer():
+    return make_mock_tokenizer(VOCAB)
+
+
+@pytest.fixture
+def request_stub():
+    req = MagicMock(spec=ChatCompletionRequest)
+    req.tools = []
+    req.tool_choice = "auto"
+    req.include_reasoning = True
+    return req
+
+
+@pytest.fixture
+def composed_parser(tokenizer):
+    """The parser the chat endpoint builds for this deployment."""
+    parser_cls = ParserManager.get_parser(
+        tool_parser_name="qwen3_coder",
+        reasoning_parser_name="qwen3",
+        enable_auto_tools=True,
+    )
+    assert parser_cls is not None
+    return parser_cls(tokenizer, [], chat_template_kwargs={"enable_thinking": True})
+
+
+def stream(parser, request, deltas, *, prompt_token_ids=(1, 2, 3)):
+    outputs = []
+    for index, pieces in enumerate(deltas):
+        text, ids = tokens(*pieces)
+        outputs.append(
+            parser.parse_delta(
+                delta_text=text,
+                delta_token_ids=ids,
+                request=request,
+                prompt_token_ids=list(prompt_token_ids),
+                finished=index == len(deltas) - 1,
+            )
+        )
+    return outputs
+
+
+def joined(outputs, field):
+    return "".join(getattr(delta, field) or "" for delta in outputs if delta)
+
+
+class TestStreaming:
+    def test_counts_ids_before_the_explicit_end(self, composed_parser, request_stub):
+        deltas = [("A", "B"), ("C", THINK_END, "D"), ("E",)]
+        outputs = stream(composed_parser, request_stub, deltas)
+
+        assert joined(outputs, "reasoning") == "ABC"
+        assert joined(outputs, "content") == "DE"
+        assert composed_parser.reasoning_token_count == 3
+        assert composed_parser.generated_token_count == 6
+
+    def test_counts_ids_before_the_implicit_tool_call_end(
+        self, composed_parser, request_stub
+    ):
+        call = (
+            TOOL_CALL_START,
+            *"\n<function=f>\n<parameter=x>1</parameter>\n</function>\n",
+            TOOL_CALL_END,
+        )
+        deltas = [("A", "B"), ("C",), call]
+        outputs = stream(composed_parser, request_stub, deltas)
+
+        assert joined(outputs, "reasoning") == "ABC"
+        assert any(delta and delta.tool_calls for delta in outputs)
+        assert composed_parser.reasoning_token_count == 3
+        assert composed_parser.generated_token_count == 3 + len(call)
+
+    def test_counts_every_id_when_reasoning_never_ends(
+        self, composed_parser, request_stub
+    ):
+        # A generation cut by max_tokens inside reasoning is all reasoning,
+        # and a special token generated before the boundary is a generated
+        # id inside it, exactly as completion_tokens counts it.
+        deltas = [("A", THINK_START, "B"), ("C", END_OF_TURN)]
+        stream(composed_parser, request_stub, deltas)
+
+        assert composed_parser.reasoning_token_count == 5
+        assert composed_parser.generated_token_count == 5
+
+    def test_boundary_inside_a_merged_delta(self, composed_parser, request_stub):
+        # A lagging server merges several steps into one delta; the count
+        # still splits at the boundary id within it.
+        deltas = [("A", "B", "C", THINK_END, "D", "E", "F")]
+        outputs = stream(composed_parser, request_stub, deltas)
+
+        assert joined(outputs, "reasoning") == "ABC"
+        assert joined(outputs, "content") == "DEF"
+        assert composed_parser.reasoning_token_count == 3
+
+    def test_starts_at_zero_before_any_delta(self, composed_parser):
+        assert composed_parser.reasoning_token_count == 0
+        assert composed_parser.generated_token_count == 0
+
+
+class TestBatch:
+    def test_batch_split_is_made_on_ids_and_counted(
+        self, composed_parser, request_stub
+    ):
+        text, ids = tokens("A", "B", "C", THINK_END, "D", "E")
+
+        reasoning, content, tool_calls = composed_parser.parse(
+            text,
+            request_stub,
+            enable_auto_tools=True,
+            model_output_token_ids=ids,
+        )
+
+        assert reasoning == "ABC"
+        assert content == "DE"
+        assert not tool_calls
+        assert composed_parser.reasoning_token_count == 3
+        assert composed_parser.generated_token_count == len(ids)
+
+    def test_batch_and_stream_agree_on_the_same_generation(
+        self, tokenizer, request_stub
+    ):
+        pieces = ("A", "B", THINK_END, "C", "D")
+        parser_cls = ParserManager.get_parser(
+            tool_parser_name="qwen3_coder",
+            reasoning_parser_name="qwen3",
+            enable_auto_tools=True,
+        )
+        streamed = parser_cls(tokenizer, [])
+        batched = parser_cls(tokenizer, [])
+
+        outputs = stream(streamed, request_stub, [pieces[:1], pieces[1:3], pieces[3:]])
+        text, ids = tokens(*pieces)
+        reasoning, content, _ = batched.parse(
+            text, request_stub, enable_auto_tools=True, model_output_token_ids=ids
+        )
+
+        assert joined(outputs, "reasoning") == reasoning == "AB"
+        assert joined(outputs, "content") == content == "CD"
+        assert streamed.reasoning_token_count == batched.reasoning_token_count == 2
+
+    def test_whole_sequence_count_matches_the_incremental_count(
+        self, composed_parser, request_stub
+    ):
+        _, ids = tokens("A", "B", THINK_END, "C")
+        stream(composed_parser, request_stub, [("A", "B"), (THINK_END, "C")])
+
+        assert composed_parser.reasoning_parser.count_reasoning_tokens(ids) == 2
+        assert composed_parser.reasoning_token_count == 2
+
+
+class TestRefusals:
+    def test_text_fed_without_ids_refuses_the_count(self, tokenizer, request_stub):
+        engine = Qwen3Parser(tokenizer)
+        engine.extract_reasoning("AB" + THINK_END + "C", request_stub)
+
+        with pytest.raises(ValueError, match="without its token ids"):
+            engine.reasoning_token_count
+
+    def test_disabled_thinking_counts_nothing(self, tokenizer, request_stub):
+        engine = Qwen3Parser(tokenizer, chat_template_kwargs={"enable_thinking": False})
+        stream(engine, request_stub, [("A", "B")])
+
+        assert engine.reasoning_token_count == 0
+        assert engine.count_reasoning_tokens([65, 66]) == 0
+
+    @pytest.mark.parametrize(
+        ("transitions", "reason"),
+        [
+            (
+                {
+                    (ParserState.REASONING, "THINK_END"): Transition(
+                        ParserState.CONTENT, (EventType.REASONING_END,)
+                    ),
+                    (ParserState.CONTENT, "THINK_START"): Transition(
+                        ParserState.REASONING, (EventType.REASONING_START,)
+                    ),
+                },
+                "re-enters reasoning",
+            ),
+            (
+                {
+                    (ParserState.REASONING, "THINK_END"): Transition(
+                        ParserState.CONTENT, ()
+                    ),
+                },
+                "without announcing",
+            ),
+        ],
+    )
+    def test_a_grammar_without_one_id_boundary_serves_no_count(
+        self, tokenizer, transitions, reason
+    ):
+        config = ParserEngineConfig(
+            name="test-grammar",
+            initial_state=ParserState.REASONING,
+            terminals={"THINK_START": THINK_START, "THINK_END": THINK_END},
+            token_id_terminals={"THINK_START": THINK_START, "THINK_END": THINK_END},
+            transitions=transitions,
+        )
+        engine = ParserEngine(tokenizer, parser_engine_config=config)
+
+        assert engine.reasoning_token_count is None
+        with pytest.raises(ValueError, match=reason):
+            engine.count_reasoning_tokens([65, 99, 66])
