+class TestFormatRegistration:
+    """Whether a format's forwarded ids and text can disagree is a property of
+    the format alone, so registering it decides, before any request."""
+
+    def test_forwarding_ids_while_acting_in_content_is_refused_at_registration(self):
+        import dataclasses
+
+        from vllm.parser.qwen3 import Qwen3Parser
+
+        class ActsOnAnOpenerInContent(Qwen3Parser):
+            @classmethod
+            def engine_config(cls, thinking):
+                config = super().engine_config(thinking)
+                transitions = dict(config.transitions)
+                transitions[(ParserState.CONTENT, "THINK_START")] = Transition(
+                    next_state=ParserState.CONTENT
+                )
+                return dataclasses.replace(config, transitions=transitions)
+
+        with pytest.raises(ValueError, match=r"acts on \['THINK_START'\] in content"):
+            make_adapters(ActsOnAnOpenerInContent)
+
+    def test_forwarding_ids_requires_naming_every_configuration(self):
+        class Unnamed(ParserEngine):
+            batch_tool_pass_uses_ids = True
+
+        with pytest.raises(NotImplementedError, match="engine_configs"):
+            make_adapters(Unnamed)
+
+    def test_every_format_that_forwards_ids_registers(self):
+        from vllm.parser.nemotron_v3 import NemotronV3Parser
+        from vllm.parser.qwen3 import Qwen3Parser
+        from vllm.parser.seed_oss import SeedOssParser
+
+        for parser_cls in (Qwen3Parser, SeedOssParser, NemotronV3Parser):
+            assert parser_cls.batch_tool_pass_uses_ids
+            configs = parser_cls.engine_configs()
+            assert {config.initial_state for config in configs} == {
+                ParserState.REASONING,
+                ParserState.CONTENT,
+            }
+            parser_cls.check_format()
