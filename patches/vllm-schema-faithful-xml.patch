+class _XMLParameterSchema:
+    """Narrow lexical interpretations using the complete tool schema."""
+
+    def __init__(self, schema: dict, params: dict[str, str]):
+        self.schema = schema
+        self.validator = Draft202012Validator(schema, registry=Registry())
+        self.values: dict[str, object] = dict(params)
+        self.known: dict[str, object] = {}
+        self.unknown = set(params)
+
+    def _reference(self, reference: str) -> dict | bool | None:
+        if not reference.startswith("#/"):
+            return None
+        resolved = self.schema
+        for part in unquote(reference[2:]).split("/"):
+            key = part.replace("~1", "/").replace("~0", "~")
+            resolved = (
+                resolved[int(key)] if isinstance(resolved, list) else resolved[key]
+            )
+        return resolved
+
+    def _condition_is_known(self, schema, seen=frozenset()) -> bool:
+        if not isinstance(schema, dict) or not self.unknown:
+            return True
+        reference = schema.get("$ref")
+        if reference:
+            resolved = self._reference(reference)
+            if reference in seen or resolved is None:
+                return False
+            if not self._condition_is_known(resolved, seen | {reference}):
+                return False
+        if self.unknown.intersection(schema.get("properties", {})):
+            return False
+        if any(
+            re.search(pattern, name)
+            for pattern in schema.get("patternProperties", {})
+            for name in self.unknown
