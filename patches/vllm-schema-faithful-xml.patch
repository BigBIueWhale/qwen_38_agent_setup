+def test_stable_discriminator_resolves_many_parameter_types(monkeypatch, composition):
+    import vllm.parser.qwen3 as qwen
+
+    expected = {'kind': 'number', **{f'field_{i}': i for i in range(20)}}
+    properties = {name: {'type': ['string', 'integer']} for name in expected}
+    properties['kind'] = {'type': 'string'}
+    numbers = {'properties': {name: {'type': 'integer'} for name in expected
+                              if name != 'kind'}}
+    numbers['properties']['kind'] = {'const': 'number'}
+    strings = {'properties': {name: {'type': 'string'} for name in expected}}
+    strings['properties']['kind'] = {'const': 'text'}
+    schema = {'type': 'object', 'properties': properties, 'required': list(expected)}
+    if composition == 'conditional':
+        schema.update({'if': {'properties': {'kind': {'const': 'number'}}},
+                       'then': numbers, 'else': strings})
+    else:
+        schema['anyOf'] = [numbers, strings]
+
+    actual_validator = qwen.Draft202012Validator
+    full_checks = 0
+
+    class CountedValidator:
+        def __init__(self, schema, **kwargs):
+            self.inner = actual_validator(schema, **kwargs)
+
+        def evolve(self, **kwargs):
+            return self.inner.evolve(**kwargs)
+
+        def is_valid(self, instance):
+            nonlocal full_checks
+            full_checks += 1
+            assert full_checks < 16, 'enumerated parameter combinations before narrowing'
+            return self.inner.is_valid(instance)
+
+    monkeypatch.setattr(qwen, 'Draft202012Validator', CountedValidator)
+    raw = '\n'.join(f'<parameter={name}>{value}</parameter>'
+                    for name, value in expected.items())
+    result = qwen._qwen3_arg_converter(raw, False, schema)
+    assert json.loads(result) == expected
+
