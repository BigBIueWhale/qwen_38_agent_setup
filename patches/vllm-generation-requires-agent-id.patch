+class ChatCompletionGenerationRequest(ChatCompletionRequest):
+    """A chat completion that generates, naming the line of work it belongs to.
+
+    ChatCompletionRequest is the shape rendering shares; rendering allocates no
+    KV and names no agent. Generation requires one kv_scope, which names one
+    line of work and so one sequence: n must be 1.
+    """
+
+    # The parent caches its own field names for the extra-field warning.
+    field_names: ClassVar[set[str] | None] = None
+
+    kv_scope: KvScope
+    n: Annotated[int, Field(ge=1, le=1)] | None = 1
+
+    @model_validator(mode="before")
+    @classmethod
+    def check_line_of_work(cls, data: Any) -> Any:
+        if isinstance(data, dict):
+            require_kv_scope_value(data.get("kv_scope"))
+            require_one_sequence(data.get("n"), "n")
+        return data
+
+    def to_sampling_params(
+        self,
+        max_tokens: int,
+        default_sampling_params: dict,
+    ) -> SamplingParams:
+        params = super().to_sampling_params(max_tokens, default_sampling_params)
+        params.extra_args = {**(params.extra_args or {}), "kv_scope": self.kv_scope}
+        return params
+
