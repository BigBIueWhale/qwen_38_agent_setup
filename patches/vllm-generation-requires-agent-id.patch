+# The agent-ID rule every generation obeys, whoever the caller. A kv_scope
+# names one line of work: a conversation and its continuations. A fork or a
+# subagent is a new line. One request of a line generates one sequence.
+KV_SCOPE_RULE = (
+    "send the same kv_scope for every request that continues a conversation, "
+    "and a new, never-used kv_scope for a fork or a subagent"
+)
+ONE_SEQUENCE_RULE = (
+    "one kv_scope names one line of work, which generates one sequence per "
+    "request. Send one request per sequence instead, each with its own new "
+    "kv_scope; they share any common prompt prefix by content"
+)
+
+
+def require_kv_scope_value(value: object) -> str:
+    """Refuse a generation that names no line of work, or names it blankly."""
+    if value is None:
+        raise VLLMValidationError(
+            f"kv_scope is required for generation: {KV_SCOPE_RULE}.",
+            parameter="kv_scope",
+        )
+    if not isinstance(value, str) or not value.strip():
+        raise VLLMValidationError(
+            "kv_scope must be an agent ID containing a non-whitespace "
+            f"character: {KV_SCOPE_RULE}.",
+            parameter="kv_scope",
+            value=value,
+        )
+    return value
+
+
+def require_one_sequence(
+    value: object, parameter: str, quantity: str | None = None
+) -> None:
+    """Refuse fanning one request, and so one kv_scope, into several sequences.
+
+    Anything but an integer is left to type validation.
+    """
+    if isinstance(value, int) and not isinstance(value, bool) and value != 1:
+        raise VLLMValidationError(
+            f"{quantity or parameter} must be 1: {ONE_SEQUENCE_RULE}.",
+            parameter=parameter,
+            value=value,
+        )
+
+
+def require_kv_scope(params: "SamplingParams") -> str:
+    """Require the agent-ID rule of every generation, whoever builds it.
+
+    A generation names the line of work its KV belongs to, and that line
+    generates one sequence per request. The engine request type applies this
+    when it is built, so no producer -- the input processor, a caller that
+    builds an engine request itself, or the engine's own notices -- can hand
+    the scheduler and the KV connectors a generation without an identity.
+    """
+    scope = require_kv_scope_value(
