diff --git a/tests/entrypoints/test_kv_scope_protocol.py b/tests/entrypoints/test_kv_scope_protocol.py
new file mode 100644
index 0000000000000000000000000000000000000000..e31c0e909a6f5c231be8dba1f70989e9e2f5ab64
--- /dev/null
+++ b/tests/entrypoints/test_kv_scope_protocol.py
@@ -0,0 +1,376 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every generation surface names one line of work with an opaque kv_scope.
+
+Prefix reuse matches content and cache_salt whatever the ID. ID syntax does
+not encode ancestry. Generation request models require the ID and the served
+schema says so; the render models they share their shape with allocate no KV
+and have no ID. One line of work generates one sequence per request. The
+shared engine boundary holds the same rules for every other caller, direct
+SamplingParams callers included.
+"""
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from vllm.entrypoints.anthropic.protocol import (
+    AnthropicCountTokensRequest,
+    AnthropicMessagesRequest,
+)
+from vllm.entrypoints.anthropic.serving import AnthropicServingMessages
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    BatchChatCompletionRequest,
+    ChatCompletionGenerationRequest,
+    ChatCompletionRequest,
+)
+from vllm.entrypoints.openai.completion.protocol import (
+    CompletionGenerationRequest,
+    CompletionRequest,
+)
+from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import (
+    GenerateRequest,
+    TokenGenerationRequest,
+)
+from vllm.exceptions import VLLMValidationError
+from vllm.sampling_params import SamplingParams, require_kv_scope
+
+pytestmark = pytest.mark.cpu_test
+
+_SCOPE = "toolu_01AbCdEf"
+_RULE = (
+    "send the same kv_scope for every request that continues a conversation, "
+    "and a new, never-used kv_scope for a fork or a subagent"
+)
+
+
+def _minimal_payload(request_cls: type[BaseModel]) -> dict:
+    """Smallest valid payload per protocol, before the identity fields."""
+    if issubclass(request_cls, ChatCompletionRequest):
+        return {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    if request_cls is BatchChatCompletionRequest:
+        return {"model": "m", "messages": [[{"role": "user", "content": "hi"}]]}
+    if issubclass(request_cls, CompletionRequest):
+        return {"model": "m", "prompt": "hi"}
+    if request_cls is ResponsesRequest:
+        return {"model": "m", "input": "hi"}
+    if request_cls in (AnthropicMessagesRequest, AnthropicCountTokensRequest):
+        return {
+            "model": "m",
+            "max_tokens": 16,
+            "messages": [{"role": "user", "content": "hi"}],
+        }
