+def _body_schema(schema: dict, path: str) -> dict:
+    content = schema["paths"][path]["post"]["requestBody"]["content"]
+    ref = content["application/json"]["schema"]
+    if "$ref" not in ref:
+        ref = next(item for item in ref.get("anyOf", ()) if "$ref" in item)
+    return schema["components"]["schemas"][ref["$ref"].rsplit("/", 1)[1]]
