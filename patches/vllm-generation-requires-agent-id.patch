diff --git a/tests/v1/engine/test_engine_request_identity.py b/tests/v1/engine/test_engine_request_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9343c090535dcabfa7bf0918c92978ca99b3d6a
--- /dev/null
+++ b/tests/v1/engine/test_engine_request_identity.py
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every engine request for generation names its line of work, by construction.
+
+The scheduler and the KV connectors read the agent ID off every request they are
+given, so the identity is part of the engine request type: it cannot be built,
+or decoded, for generation without one. That covers every producer -- the input
+processor, a caller that builds an engine request itself, and the engine's own
+notice that a KV-transfer request was rejected before admission.
+"""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from vllm.entrypoints.generate.base.serving import GenerateBaseServing
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    ChatCompletionGenerationRequest,
+)
+from vllm.entrypoints.openai.engine.protocol import ErrorInfo, ErrorResponse
+from vllm.exceptions import VLLMValidationError
+from vllm.pooling_params import PoolingParams
+from vllm.sampling_params import SamplingParams
+from vllm.v1.engine import EngineCoreRequest
+from vllm.v1.engine.async_llm import AsyncLLM
+from vllm.v1.request import Request
+from vllm.v1.serial_utils import MsgpackDecoder, MsgpackEncoder
+
+pytestmark = pytest.mark.cpu_test
+
+
+def _engine_request(sampling_params=None, pooling_params=None):
+    return EngineCoreRequest(
+        request_id="request",
+        prompt_token_ids=[1, 2, 3],
+        mm_features=None,
+        sampling_params=sampling_params,
+        pooling_params=pooling_params,
+        arrival_time=0.0,
+        lora_request=None,
+        cache_salt=None,
+        data_parallel_rank=None,
+    )
+
+
+@pytest.mark.parametrize("extra_args", [None, {}, {"kv_scope": "  "}])
+def test_a_generation_without_an_identity_cannot_be_built(extra_args):
+    with pytest.raises(VLLMValidationError) as excinfo:
+        _engine_request(SamplingParams(max_tokens=1, extra_args=extra_args))
+    assert excinfo.value.parameter == "kv_scope"
+
+
+def test_a_generation_of_several_sequences_cannot_be_built():
+    with pytest.raises(VLLMValidationError) as excinfo:
+        _engine_request(SamplingParams(n=2, extra_args={"kv_scope": "agent"}))
+    assert excinfo.value.parameter == "n"
+
+
+def test_a_pooling_request_names_no_line_of_work():
+    request = _engine_request(pooling_params=PoolingParams(task="embed"))
+    assert Request.from_engine_core_request(request, None).kv_scope is None
+
+
+def test_the_engine_decodes_the_identity_it_was_sent():
+    sent = _engine_request(SamplingParams(max_tokens=1, extra_args={"kv_scope": "a"}))
+    frames = MsgpackEncoder().encode(sent)
+    received = MsgpackDecoder(EngineCoreRequest).decode(frames)
+    assert Request.from_engine_core_request(received, None).kv_scope == "a"
+
+
+def test_a_rejected_remote_prefill_notifies_under_the_requests_own_scope():
+    """The notice stands for the rejected request and carries its identity."""
+    notify = AsyncMock()
+    serving = SimpleNamespace(
+        has_kv_connector=True,
+        engine_client=SimpleNamespace(notify_kv_transfer_request_rejected=notify),
+        _get_data_parallel_rank=lambda raw_request: None,
+    )
+    request = ChatCompletionGenerationRequest(
+        model="model",
+        messages=[{"role": "user", "content": "hi"}],
+        kv_scope="agent-a",
+        kv_transfer_params={"do_remote_prefill": True},
+    )
+    refusal = ErrorResponse(error=ErrorInfo(message="no", type="BadRequest", code=400))
+
+    async def refused():
+        return refusal
+
+    result = asyncio.run(
+        GenerateBaseServing._with_kv_transfer_rejection_cleanup(
+            serving, refused(), request, None
+        )
+    )
+    assert result is refusal
+    notify.assert_awaited_once_with(
+        request.request_id,
+        {"do_remote_prefill": True},
+        "agent-a",
+        data_parallel_rank=None,
+    )
+
