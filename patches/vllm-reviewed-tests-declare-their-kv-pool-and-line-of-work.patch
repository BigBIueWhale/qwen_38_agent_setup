+    def _one_line_of_work_per_prompt(
+        sampling_params: SamplingParams, count: int
+    ) -> list[SamplingParams]:
+        """sampling_params once per prompt, each copy naming its own new
+        kv_scope: every prompt is a conversation of its own, and a line of
+        work generates one sequence at a time. The runner names the line of
+        every prompt it generates for, so the parameters it is given name
+        none."""
+        if (sampling_params.extra_args or {}).get("kv_scope") is not None:
+            raise ValueError(
+                "VllmRunner names a new kv_scope for each prompt; pass sampling "
+                "parameters that name none."
+            )
+        lines = []
+        for _ in range(count):
+            params = sampling_params.clone()
+            params.extra_args = {
+                **(params.extra_args or {}),
+                "kv_scope": str(uuid.uuid4()),
+            }
+            lines.append(params)
+        return lines
