+        output += list(map(ord, "\n<function=write>\n<parameter=text>value"))
+        # Both thinking markers and the wrapper closer are grammar-legal
+        # literal value text. They cannot reopen thinking or move its boundary.
+        output += [129, 131, 128] + [ord("x")] * 20
+        for end in range(chunk_size, len(output) + chunk_size, chunk_size):
+            holder.update_state([output[:end]], None)
+            logits = torch.zeros((1, 133))
+            logits[:, 129] = -float("inf")
+            before = logits.clone()
