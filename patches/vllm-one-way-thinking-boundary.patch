+        content = [130] + list(map(ord, "\n<function=write>\n<parameter=text>"))
+        content += [128] + list(map(ord, "value</parameter>\n</function>\n")) + [131]
+        output = [ord("p")] + ([] if implicit else [129]) + content
+        request.append_output_token_ids(output)
