+    def test_budget_forces_once_and_never_reopens_after_the_closer(self, qwen):
+        _, config, _ = qwen
+        holder = ThinkingBudgetStateHolder(config, 1, 0, torch.device("cpu"), False)
+        holder.sync_batch(BatchUpdate(
+            batch_size=1, removed=(), moved=(),
+            added=[(0, SamplingParams(thinking_token_budget=2), [128], [])],
+        ))
+        output = [10, 10]
+        holder.update_state([output], None)
+        logits = torch.zeros((1, 133))
+        holder.apply_to_logits(logits, False, None)
+        assert logits[0, 129] > 0
+        output += [129, 128, 10, 10, 10]
+        holder.update_state([output], None)
+        logits.zero_()
