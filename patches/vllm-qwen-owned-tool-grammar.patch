+            tools=_qwen_schema_tools(parameters),
+            tool_choice="auto",
+            reasoning=False,
+        )
+    )
+
+    assert _is_grammar_accept_string(grammar, _qwen_call(key, accepted))
+    assert not _is_grammar_accept_string(grammar, _qwen_call(key, rejected))
