+def test_qwen3_nested_reference_keeps_the_root_definition_tables(
+    key, parameters, accepted, rejected
+):
+    """Slicing a property out of the document must not orphan its references.
+
+    A property is embedded in the tag on its own, so the root ``$defs`` /
+    ``definitions`` tables have to travel with it. Without them the reference
+    dangles and the grammar cannot be built at all -- the tool stops working
+    rather than becoming permissive, which no test reached before.
+    """
+    grammar = Grammar.from_structural_tag(
+        get_model_structural_tag(
+            model="qwen_3_coder",
+            tools=_qwen_schema_tools(parameters),
+            tool_choice="auto",
+            reasoning=False,
+        )
+    )
+
+    assert _is_grammar_accept_string(grammar, _qwen_call(key, accepted))
+    assert not _is_grammar_accept_string(grammar, _qwen_call(key, rejected))
+
