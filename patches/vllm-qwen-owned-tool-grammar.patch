+# ---------------------------------------------------------------------------
+# Qwen3 XML tool calls
+# ---------------------------------------------------------------------------
+# <tool_call>
+# <function=NAME>
+# <parameter=KEY>
+# VALUE
+# </parameter>
+# </function>
+# </tool_call>
+#
+# vLLM owns this tag instead of consuming XGrammar's builtin because the
+# language needs one rule XGrammar's converter cannot be asked for: an
+# unconstrained string value must not contain ``<parameter=``. That channel is
+# emitted from C++ as ``TagDispatch(excludes=("</parameter>"))`` with no Python
+# lever, so a value could absorb the next parameter's opener and still parse --
+# as a different call that is well formed, ordered and schema-satisfying, which
+# is why the slip was published rather than rejected. Excluding the opener makes
+# the merge ungrammatical at decode time: the bitmask forbids the token that
+# would complete it, and the only legal continuations are more value text or the
+# real closer, so the slip self-corrects into the call the model meant.
+#
+# Every other production this builder has reproduces XGrammar's Qwen language
+# exactly, including its ``[ \n\t]*`` padding around every value, its ordered
+# required chain, and its treatment of enums, constants and references. One
+# production it deliberately does not have is XGrammar's constrained-string
+# regex; ``_QWEN_REFUSED_STRING_KEYS`` refuses that declaration instead.
+_QWEN_PARAM_OPEN = "<parameter="
+_QWEN_PARAM_CLOSE = "</parameter>"
+_QWEN_CALL_BEGIN_PREFIX = "<tool_call>\n<function="
+_QWEN_CALL_BEGIN_SUFFIX = ">\n"
+_QWEN_CALL_END = "\n</function>\n</tool_call>"
+_QWEN_CALL_TRIGGER = "<tool_call>\n<function="
+_QWEN_THINK_END = "</think>"
+_QWEN_THINK_SUFFIX = "\n\n"
+_QWEN_THINK_EXCLUDE_TOKENS = ["<think>", "</think>"]
+_QWEN_WHITESPACE = r"[ \n\t]*"
+_QWEN_VARIABLE_NAME = r"[a-zA-Z_][a-zA-Z0-9_]*"
+# XGrammar emits a string carrying any of these as a regex rather than on the
+# raw channel, and a regex here cannot carry the exclusion. xgrammar's regex
+# engine has no lookahead, so forbidding a fixed substring is expressible only
+# as an unrolled DFA over the allowed characters, and an unrolled DFA cannot
+# then carry a ``{m,n}`` bound on the same value. No regex therefore both
+# bounds a string's length and forbids ``<parameter=``, so there is nothing to
+# repair: a second channel that quietly dropped the exclusion is the hole this
+# builder exists to close. Such a declaration is refused by name instead.
+_QWEN_REFUSED_STRING_KEYS = ("pattern", "format", "minLength", "maxLength")
+
+
+def _qwen_raw_value() -> AnyTextFormat:
+    """The raw string channel: any text carrying neither parameter marker.
+
+    Both markers are named explicitly because ``TagFormat`` folds its ``end``
+    into the content's excludes only when the text format is its direct
+    content, and this channel is also used nested inside a sequence.
+    """
+    return AnyTextFormat(excludes=[_QWEN_PARAM_OPEN, _QWEN_PARAM_CLOSE])
+
+
+def _qwen_whitespace() -> RegexFormat:
+    return RegexFormat(pattern=_QWEN_WHITESPACE)
+
+
+def _qwen_padded(content: Any) -> SequenceFormat:
+    """Wrap a value in the grammar padding XGrammar writes around every one."""
+    return SequenceFormat(elements=[_qwen_whitespace(), content, _qwen_whitespace()])
+
+
+def _qwen_definitions(root: dict[str, Any]) -> dict[str, Any]:
+    """The root's definition tables, which a sliced sub-schema still needs."""
+    return {
+        key: root[key]
+        for key in ("$defs", "definitions")
+        if isinstance(root.get(key), dict)
+    }
+
+
+def _qwen_embed(schema: dict[str, Any], root: dict[str, Any]) -> dict[str, Any]:
+    """Re-attach the root definition tables to a schema sliced out of it.
+
+    Slicing a property out of the parameters document orphans every
+    ``#/$defs/...`` reference inside it, so the tables travel with it or the
+    embedded schema cannot be compiled at all.
+    """
+    definitions = _qwen_definitions(root) if isinstance(root, dict) else {}
+    if not definitions:
+        return schema
+    embedded = dict(schema)
+    for key, value in definitions.items():
+        embedded.setdefault(key, value)
+    return embedded
+
+
+def _qwen_resolve(prop: Any, root: dict[str, Any], seen: tuple[str, ...] = ()) -> Any:
+    """Follow local ``$ref`` and single-branch ``allOf`` far enough to type it.
+
+    Only the channel decision needs this: a property that resolves to a string
+    rides the raw channel, and every other resolved type is real JSON. An
+    unresolvable reference is left alone and handled as an unknown type.
+    """
+    if not isinstance(prop, dict):
+        return prop
+    reference = prop.get("$ref")
+    if (
+        isinstance(reference, str)
+        and reference.startswith("#/")
+        and reference not in seen
+    ):
+        resolved: Any = root
+        try:
+            for part in reference[2:].split("/"):
+                key = part.replace("~1", "/").replace("~0", "~")
+                resolved = (
+                    resolved[int(key)]
+                    if isinstance(resolved, list)
+                    else resolved[key]
+                )
+        except (KeyError, IndexError, ValueError, TypeError):
+            return prop
+        siblings = {key: value for key, value in prop.items() if key != "$ref"}
+        target = _qwen_resolve(resolved, root, seen + (reference,))
+        return {**(target if isinstance(target, dict) else {}), **siblings}
+    branches = prop.get("allOf")
+    if isinstance(branches, list) and len(branches) == 1:
+        inner = _qwen_resolve(branches[0], root, seen)
+        if isinstance(inner, dict):
+            return {**inner, **{k: v for k, v in prop.items() if k != "allOf"}}
+    return prop
+
+
+def _qwen_value(prop: Any, root: dict[str, Any], tool: str, parameter: str) -> Any:
+    """Build the value production for one parameter, or refuse to have one."""
+    resolved = _qwen_resolve(prop, root)
+    if not isinstance(resolved, dict) or not resolved:
+        return _qwen_raw_value()
+    reference = resolved.get("$ref")
+    if isinstance(reference, str) and reference.startswith("#/"):
+        # A local reference this builder could not follow -- missing, or
+        # circular. Hand the schema and its definition tables to the JSON
+        # channel so XGrammar decides it exactly as it does for every other
+        # model: a dangling reference is refused outright, and a self-referring
+        # one compiles to a production nothing satisfies. Answering an
+        # unresolvable schema with "any text" would fail open.
+        return _qwen_padded(JSONSchemaFormat(json_schema=_qwen_embed(resolved, root)))
+    json_type = resolved.get("type")
+    enum_values = resolved.get("enum")
+    if enum_values is None and isinstance(resolved.get("const"), str):
+        enum_values = [resolved["const"]]
+    if (
+        isinstance(enum_values, list)
+        and enum_values
+        and all(isinstance(value, str) for value in enum_values)
+    ):
+        branches = [ConstStringFormat(value=value) for value in enum_values]
+        return _qwen_padded(
+            branches[0] if len(branches) == 1 else OrFormat(elements=branches)
+        )
+    if json_type == "string":
+        refused = [key for key in _QWEN_REFUSED_STRING_KEYS if key in resolved]
+        if refused:
+            raise VLLMValidationError(
+                f"Tool {tool!r} parameter {parameter!r} declares "
+                f"{', '.join(refused)} on a string. The Qwen XML transport "
+                "emits string values raw, and the raw channel excludes "
+                f"{_QWEN_PARAM_OPEN!r} so that a value cannot absorb the next "
+                "parameter's opener; that exclusion cannot be written inside a "
+                "length-bounded regex, so this constraint has no grammar. "
+                "Declare the parameter without it and validate it in the tool.",
+                parameter="tools",
+            )
+        return _qwen_raw_value()
+    if (
+        json_type is None
+        or isinstance(json_type, list)
+        or {"anyOf", "oneOf"} & resolved.keys()
+    ):
+        # Includes a non-local ``$ref``, which XGrammar also leaves
+        # unconstrained.
+        # XGrammar's ``xml_any`` is the raw channel unioned with JSON arrays and
+        # objects, and both of those are already raw text without a closer, so
+        # the union accepts exactly the raw channel's language.
+        return _qwen_raw_value()
+    return _qwen_padded(JSONSchemaFormat(json_schema=_qwen_embed(resolved, root)))
+
+
+def _qwen_any_parameter(extra: Any, root: dict[str, Any], tool: str) -> TagFormat:
+    """One parameter whose name the schema does not declare."""
+    return TagFormat(
+        begin=_QWEN_PARAM_OPEN,
+        content=SequenceFormat(
+            elements=[
+                RegexFormat(pattern=_QWEN_VARIABLE_NAME + ">"),
+                _qwen_value(
+                    extra if isinstance(extra, dict) else {},
+                    root,
+                    tool,
+                    "additionalProperties",
+                ),
+            ]
+        ),
+        end=_QWEN_PARAM_CLOSE,
+    )
+
+
+def _qwen_arguments(parameters: dict[str, Any] | bool, tool: str) -> Any:
+    """Build a tool's argument body: declared order, required chain, extras."""
+    if not isinstance(parameters, dict):
+        return StarFormat(
+            content=SequenceFormat(
+                elements=[_qwen_whitespace(), _qwen_any_parameter(None, {}, tool)]
+            )
+        )
+    # The parameters document may itself be a ``$ref`` or a single-branch
+    # ``allOf`` wrapper. Reading ``properties`` straight off the wrapper finds
+    # none and leaves every argument unconstrained, so the body is read off the
+    # resolved document while references still resolve against the original.
+    root = parameters
+    resolved = _qwen_resolve(parameters, root)
+    if not isinstance(resolved, dict):
+        resolved = parameters
+    properties = resolved.get("properties")
+    additional = resolved.get("additionalProperties")
+    if not isinstance(properties, dict) or not properties:
+        if additional is False:
+            return _qwen_whitespace()
+        return StarFormat(
+            content=SequenceFormat(
+                elements=[
+                    _qwen_whitespace(),
+                    _qwen_any_parameter(additional, root, tool),
+                ]
+            )
+        )
+    required = set(resolved.get("required") or [])
+    elements: list[Any] = [_qwen_whitespace()]
+    for key, prop in properties.items():
+        tag = TagFormat(
+            begin=f"{_QWEN_PARAM_OPEN}{key}>",
+            content=_qwen_value(prop, root, tool, key),
+            end=_QWEN_PARAM_CLOSE,
+        )
+        elements.append(tag if key in required else OptionalFormat(content=tag))
+        elements.append(_qwen_whitespace())
+    if additional is not False:
+        elements.append(
+            StarFormat(
+                content=SequenceFormat(
+                    elements=[
+                        _qwen_any_parameter(additional, root, tool),
+                        _qwen_whitespace(),
+                    ]
+                )
+            )
+        )
+    return SequenceFormat(elements=elements)
+
+
+def _qwen_tool_tags(tools: list[FunctionToolParam]) -> list[TagFormat]:
+    return [
+        TagFormat(
+            begin=(
+                f"{_QWEN_CALL_BEGIN_PREFIX}{tool.function.name}"
+                f"{_QWEN_CALL_BEGIN_SUFFIX}"
+            ),
+            content=_qwen_arguments(
+                get_function_parameters(tool.function), tool.function.name
+            ),
+            end=_QWEN_CALL_END,
+        )
+        for tool in tools
+    ]
+
+
+@register_vllm_structural_tag("qwen_3_coder")
+def get_qwen_3_coder_structural_tag(
+    tools: list[FunctionToolParam],
+    builtin_tools: list[BuiltinToolParam],
+    tool_choice: SimplifiedToolChoice,
+    reasoning: bool,
+    parallel_tool_calls: bool | None = None,
+) -> StructuralTag:
+    del builtin_tools
+
+    tags = _qwen_tool_tags(tools)
+    # The grammar owns the call count: with parallel calls off the turn ends
+    # after the first complete tag, so nothing produced has to be dropped
+    # afterwards and the model is never shown a turn with less in it than it
+    # generated. A forced choice is already exactly one tag.
+    single_call = parallel_tool_calls is False
+
+    if tool_choice == "auto":
+        suffix_tag: Any = (
+            TriggeredTagsFormat(
+                triggers=[_QWEN_CALL_TRIGGER],
+                tags=tags,
+                excludes=_QWEN_THINK_EXCLUDE_TOKENS,
+                stop_after_first=single_call,
+            )
+            if tags
+            else AnyTextFormat(excludes=_QWEN_THINK_EXCLUDE_TOKENS)
+        )
+    elif tool_choice == "forced":
+        if not tags:
+            raise VLLMValidationError(
+                "Forced tool choice must resolve to exactly one tool. Name a "
+                "function this request also declares in `tools`.",
+                parameter="tool_choice",
+            )
+        suffix_tag = tags[0]
+    else:
+        suffix_tag = TagsWithSeparatorFormat(
+            tags=tags,
+            separator="\n",
+            at_least_one=True,
+            stop_after_first=single_call,
+        )
+
+    if not reasoning:
+        return StructuralTag(format=suffix_tag)
+
+    prefix_tag = SequenceFormat(
+        elements=[
+            TagFormat(begin="", content=AnyTextFormat(), end=_QWEN_THINK_END),
+            ConstStringFormat(value=_QWEN_THINK_SUFFIX),
+        ]
+    )
+    return StructuralTag(format=SequenceFormat(elements=[prefix_tag, suffix_tag]))
