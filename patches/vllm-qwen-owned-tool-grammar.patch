+                "body": {
+                    "type": "object",
+                    "properties": {"v": {"type": "integer"}},
+                    "required": ["v"],
+                }
+            },
+            "$ref": "#/$defs/body",
+        },
+    ],
+)
+def test_qwen3_root_composition_still_binds_every_property(parameters):
+    """A wrapper around the parameters document does not relax it.
+
+    Reading ``properties`` off the wrapper finds none, which used to leave
+    every argument unconstrained -- accepting values the declared schema
+    forbids.
+    """
+    grammar = Grammar.from_structural_tag(
+        get_model_structural_tag(
+            model="qwen_3_coder",
+            tools=_qwen_schema_tools(parameters),
+            tool_choice="auto",
+            reasoning=False,
+        )
+    )
+
+    assert _is_grammar_accept_string(grammar, _qwen_call("v", "7"))
+    assert not _is_grammar_accept_string(grammar, _qwen_call("v", "notnum"))
+
+
+def test_qwen3_unresolvable_local_reference_is_refused():
+    """An unresolvable schema is refused, never answered with "any text".
+
+    XGrammar refuses a dangling local reference for every model it builds, and
+    the Qwen builder must not turn that refusal into an unconstrained value.
+    """
+    tag = get_model_structural_tag(
+        model="qwen_3_coder",
+        tools=_qwen_schema_tools(
+            {
+                "type": "object",
+                "additionalProperties": False,
+                "properties": {"v": {"$ref": "#/$defs/missing"}},
+                "required": ["v"],
+            }
+        ),
+        tool_choice="auto",
+        reasoning=False,
+    )
+
+    with pytest.raises(RuntimeError):
+        Grammar.from_structural_tag(tag)
+
+
+def test_qwen3_external_reference_stays_unconstrained():
+    """A reference this builder cannot follow at all is not a local one.
+
+    XGrammar leaves an external ``$ref`` unconstrained, so the raw channel is
+    kept for it rather than routed into the refusal above.
+    """
+    grammar = Grammar.from_structural_tag(
+        get_model_structural_tag(
+            model="qwen_3_coder",
+            tools=_qwen_schema_tools(
+                {
+                    "type": "object",
+                    "additionalProperties": False,
+                    "properties": {"v": {"$ref": "https://example.com/s.json"}},
+                    "required": ["v"],
+                }
+            ),
+            tool_choice="auto",
+            reasoning=False,
+        )
+    )
+
+    assert _is_grammar_accept_string(grammar, _qwen_call("v", "anything"))
 
 
