+def _png_url():
+    import base64
+    import io
+
+    from PIL import Image
+
+    buffer = io.BytesIO()
+    Image.new('RGB', (8, 8)).save(buffer, format='PNG')
+    return 'data:image/png;base64,' + base64.b64encode(buffer.getvalue()).decode()
+
+
+def _rendered_by_chat(parts):
+    """The image sources the chat parser renders, in order."""
+    from types import SimpleNamespace
+
+    from vllm.entrypoints.chat_utils import _parse_chat_message_content_part
+
+    rendered = []
+    recorder = SimpleNamespace(
+        model_config=SimpleNamespace(enable_prompt_embeds=False),
+        parse_image=lambda url, uuid: rendered.append(url),
+    )
+    for part in parts:
+        _parse_chat_message_content_part(
+            part, recorder, wrap_dicts=True, interleave_strings=False)
+    return rendered
+
+
+@pytest.mark.asyncio
+async def test_render_carries_every_image_chat_renders(monkeypatch):
+    """Render carries exactly the images the chat parser renders, in order.
+
+    Both image part types, extra keys, a null uuid and a plain-string item
+    beside them render as chat renders them; each image travels in the
+    transport's one image shape, so a rendered span always has its image.
+    """
+    from types import SimpleNamespace
+    from unittest.mock import AsyncMock
+
+    import vllm.entrypoints.scale_out.render.serving as render_module
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.entrypoints.scale_out.render.serving import ServingRender
+
+    url = _png_url()
+    parts = [
+        {'type': 'image_url', 'image_url': {'url': url}},
+        {'type': 'image_url', 'image_url': {'url': url, 'detail': 'high'}},
+        {'type': 'input_image', 'image_url': url, 'detail': 'auto'},
+        {'type': 'image_url', 'image_url': {'url': url, 'name': 'x.png'}},
+        {'type': 'image_url', 'image_url': {'url': url}, 'cache_control': {}},
+        {'type': 'image_url', 'image_url': {'url': url}, 'uuid': None},
+        'plain text', {'type': 'text', 'text': 'describe'},
+    ]
+    render = object.__new__(ServingRender)
+    render._check_model = AsyncMock(return_value=None)
+    render.model_config = SimpleNamespace(max_model_len=64)
+    render.default_sampling_params = {}
+    render.override_max_tokens = None
+    render.online_renderer = SimpleNamespace(render_chat=AsyncMock(
+        return_value=([], [{'type': 'token', 'prompt_token_ids': [7, 8]}])))
+    monkeypatch.setattr(render_module, 'extract_prompt_components',
+                        lambda config, engine_input: SimpleNamespace(
+                            token_ids=engine_input['prompt_token_ids']))
+    monkeypatch.setattr(render_module, 'extract_prompt_len',
+                        lambda config, engine_input: 2)
+    request = ChatCompletionRequest(model='unit', messages=[
+        {'role': 'user', 'content': parts[:3]},
+        {'role': 'user', 'content': parts[3:]},
+    ])
+    generate = await render.render_chat_request(request)
+    assert [part.image_url.url for part in generate.content_parts] == (
+        _rendered_by_chat(parts))
+    assert [part.image_url.detail for part in generate.content_parts] == [
+        'auto', 'high', 'auto', 'auto', 'auto', 'auto']
+    # What render returns is what generation accepts.
+    TokenGenerationRequest.model_validate(
+        {**generate.model_dump(mode='json'), 'kv_scope': 'agent'})
