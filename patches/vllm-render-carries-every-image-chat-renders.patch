+    def derive_rendered_media_token_ids(self) -> Mapping[str, frozenset[int]]:
+        """For each modality this processor accepts, the added-vocabulary ids
+        its rendered spans place where the model embeds an item's features.
+
+        A function of the model and its tokenizer, which every instance of the
+        processor shares, and a dummy processing per modality, so the renderer
+        derives it once, from the processor it builds, and hands it to every
+        span check (``RenderedPromptTokens.media_token_ids``).
