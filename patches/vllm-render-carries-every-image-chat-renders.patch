@@ -163,6 +163,17 @@ class BaseRenderer(ABC, Generic[_T]):
     def _decode(self, *args, **kwargs):
         return self.get_tokenizer().decode(*args, **kwargs)
 
+    def require_no_rendered_media(self, token_ids: list[int]) -> None:
+        """Refuse a rendered media span in ids that supply no media.
+
+        Rendered ids that arrive with images resolve every span against them
+        (process_rendered_multimodal_async); ids that arrive with none must
+        hold none. The processor's rendered-span check decides both, so an
+        image span never reaches the model as bare placeholder text.
+        """
+        if self.mm_processor is not None:
+            self.mm_processor._find_rendered_prompt_placeholders(list(token_ids), {})
+
     def get_mm_processor(self) -> "BaseMultiModalProcessor":
         if self.mm_processor is None:
             raise ValueError("Multi-modal processor not available for text-only models")
