+    """The inline image a content part supplies, with its detail, or None.
+
+    The part is parsed exactly as the chat renderer parses it, so the parts
+    chat renders as images are exactly the parts that return one: the render
+    route carries these to generation, and every image span it renders
+    arrives with its image.
+    """
+    if isinstance(part, str):
+        return None
+    part_type, content = _parse_chat_message_content_mm_part(part)
+    if part_type not in IMAGE_PART_TYPES:
+        return None
+    detail = (
+        part["detail"]
+        if part_type == "input_image"
+        else part["image_url"].get("detail", "auto")  # type: ignore[typeddict-item]
+    )
+    return cast(str, content), detail
