+def test_the_renderer_derives_the_media_ids_once_for_every_processor(monkeypatch):
+    """The renderer derives the ids once, from the processor it builds, before
+    the processor-only instance -- the one /generate's images go through --
+    exists, and that one map is what every span check reads: no instance
+    derives its own, at startup or at a request, and a processor that cannot
+    derive them refuses startup."""
+    from types import SimpleNamespace
+
+    import vllm.renderers.base as renderer_base
+    from vllm.exceptions import VLLMValidationError
+    from vllm.multimodal.processing.context import TimingContext
+    from vllm.multimodal.processing.inputs import (
+        ProcessorInputs, RenderedPromptTokens)
+    from vllm.multimodal.processing.processor import BaseMultiModalProcessor
+
+    derive = BaseMultiModalProcessor.derive_rendered_media_token_ids
+    derivations = []
+
+    def counted(self):
+        derivations.append(self)
+        return derive(self)
+
+    monkeypatch.setattr(
+        BaseMultiModalProcessor, 'derive_rendered_media_token_ids', counted)
+    built = []
+    monkeypatch.setattr(renderer_base, 'mm_registry', SimpleNamespace(
+        supports_multimodal_inputs=lambda model_config: True,
+        processor_cache_from_config=lambda config: None,
+        processor_only_cache_from_config=lambda config: object(),
+        create_processor=lambda model_config, tokenizer, cache: (
+            built.append(_plain_processor([])) or built[-1][0]),
+    ))
+
+    class Renderer(renderer_base.BaseRenderer):
+        def render_messages(self, *args, **kwargs):
+            raise NotImplementedError
+
+    config = SimpleNamespace(
+        model_config=SimpleNamespace(renderer_num_workers=1, multimodal_config=None),
+        parallel_config=SimpleNamespace(_api_process_rank=0),
+        observability_config=SimpleNamespace(enable_mm_processor_stats=False),
+    )
+    renderer = Renderer(config, tokenizer=None)
+    (main, span), (readonly, _) = built
+    assert renderer._readonly_mm_processor is readonly
+    assert derivations == [main]
+    assert renderer.rendered_media_token_ids == {'image': frozenset({9})}
+    one_image = SimpleNamespace(get_all_counts=lambda: {'image': 1})
+    for tokens, refused in (([1, *span, 7], False), ([1, *span, 9], True)):
+        inputs = ProcessorInputs(
+            RenderedPromptTokens(tokens, renderer.rendered_media_token_ids), one_image)
+        if refused:
+            with pytest.raises(VLLMValidationError, match='outside the span'):
+                readonly.apply(inputs, TimingContext(enabled=False))
+        else:
+            readonly.apply(inputs, TimingContext(enabled=False))
+    assert derivations == [main], 'the processor-only instance derived its own'
+
+    def cannot_derive(self):
+        raise RuntimeError('no dummy item')
+
+    monkeypatch.setattr(
+        BaseMultiModalProcessor, 'derive_rendered_media_token_ids', cannot_derive)
+    with pytest.raises(RuntimeError, match='no dummy item'):
+        Renderer(config, tokenizer=None)
