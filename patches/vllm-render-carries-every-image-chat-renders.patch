+        media_ids: dict[str, frozenset[int]] = {}
+        for modality, limit in self.info.allowed_mm_limits.items():
+            if limit == 0:
+                continue
+            inputs = self.dummy_inputs.get_dummy_processor_inputs(
+                seq_len=self.info.ctx.model_config.max_model_len,
+                mm_counts={modality: 1},
