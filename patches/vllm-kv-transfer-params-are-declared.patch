+@dataclass(frozen=True)
+class KVTransferParamShape:
+    """What a connector's protocol defines under one request
+    ``kv_transfer_params`` key: the JSON value its code reads there, and the
+    other keys it reads that value with.
+
+    A connector reads a request's parameters inside the engine core, where a
+    value of another shape -- a string where it calls ``.get``, a list where
+    it hashes -- raises for every request the engine serves. Admission holds
+    each value to its key's shape instead, and refuses one that is not.
+
+    A value that asks the connector to act -- any value but null and false
+    (see ``asks``) -- is read only together with each key in ``requires``,
+    sent with a value that is not null, and never beside a key in
+    ``excludes`` that asks too. Without its companions a connector either
+    skips the action, so the caller is told of a transfer that never
+    happens, or reads the missing keys inside the engine core and raises
+    there; beside a key it excludes, it acts on one and drops the other.
+    Admission refuses both, naming the keys.
+    """
+
+    description: str
+    conforms: Callable[[object], bool] = field(compare=False, repr=False)
+    requires: tuple[str, ...] = ()
+    excludes: tuple[str, ...] = ()
+
+    def __str__(self) -> str:
+        return self.description
+
+    def requiring(self, *keys: str) -> "KVTransferParamShape":
+        """This shape, read only together with ``keys``."""
+        return replace(self, requires=tuple(dict.fromkeys(self.requires + keys)))
+
+    def excluding(self, *keys: str) -> "KVTransferParamShape":
+        """This shape, never read beside ``keys``."""
+        return replace(self, excludes=tuple(dict.fromkeys(self.excludes + keys)))
+
+
+def asks(value: object) -> bool:
+    """Whether a request's value asks its connector to act: null and false
+    ask for nothing, so a proxy may fill a key it does not use with either."""
+    return value is not None and value is not False
+
+
+def _shape(description: str, conforms: Callable[[object], bool]) -> KVTransferParamShape:
+    return KVTransferParamShape(description, conforms)
+
+
