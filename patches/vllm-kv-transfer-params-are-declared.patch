+# The source cross-check: every key a connector's modules read from a
+# request's kv_transfer_params, or return from request_finished for the peer
+# node, is one it declares. Keys starting with "_" are the connector's own
+# markers, written into the request's parameters after admission.
+_RECEIVERS = {
+    "params",
+    "kv_params",
+    "kv_transfer_params",
+    "_kvp",
+    "request.kv_transfer_params",
