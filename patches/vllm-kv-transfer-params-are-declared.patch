diff --git a/tests/v1/engine/test_kv_transfer_params_admission.py b/tests/v1/engine/test_kv_transfer_params_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..aacc8fe1fe4036a10d03abf7a4bd5635f3bb5ac7
--- /dev/null
+++ b/tests/v1/engine/test_kv_transfer_params_admission.py
@@ -0,0 +1,256 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Admission refuses kv_transfer_params that no configured KV connector
+takes, naming the key and the connector, and a value that is not what the
+connector reads, naming its shape, before the request reaches the engine; and
+only a connector that takes do_remote_prefill is told of a refused request's
+remote-prefill blocks, when admission takes the parameters it names them by."""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+import vllm.v1.engine.input_processor as input_processor_module
+from vllm.config.kv_transfer import KVTransferConfig
+from vllm.entrypoints.generate.base.serving import GenerateBaseServing
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    ChatCompletionGenerationRequest,
+)
+from vllm.entrypoints.openai.engine.protocol import ErrorInfo, ErrorResponse
+from vllm.exceptions import VLLMValidationError
+from vllm.sampling_params import SamplingParams
+from vllm.v1.engine.input_processor import InputProcessor
+
+# The connector config/runtime-v1.sh launches: the CPU tier alone.
+DEPLOYED = KVTransferConfig(
+    kv_connector="OffloadingConnector",
+    kv_role="kv_both",
+    kv_connector_extra_config={"cpu_kv_cache_users": 1},
+)
+NIXL = KVTransferConfig(kv_connector="NixlConnector", kv_role="kv_both")
+P2P = KVTransferConfig(
+    kv_connector="OffloadingConnector",
+    kv_role="kv_both",
+    kv_connector_extra_config={
+        "spec_name": "TieringOffloadingSpec",
+        "cpu_kv_cache_users": 1,
+        "secondary_tiers": [{"type": "p2p"}],
+    },
+)
+
+
+def _admission(kv_transfer_config: KVTransferConfig | None) -> InputProcessor:
+    vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            try_get_generation_config=lambda: {}, return_sampling_mask=False
+        ),
+        cache_config=None,
+        lora_config=None,
+        scheduler_config=None,
+        speculative_config=None,
+        structured_outputs_config=None,
+        observability_config=None,
+        use_v2_model_runner=False,
+        reasoning_config=None,
+        kv_transfer_config=kv_transfer_config,
+    )
+    with patch.object(input_processor_module, "InputPreprocessor"):
+        return InputProcessor(
+            vllm_config,
+            SimpleNamespace(_executor=None, tokenizer=None),
+            mm_registry=SimpleNamespace(supports_multimodal_inputs=lambda _: False),
+        )
+
+
+def _request(**fields) -> ChatCompletionGenerationRequest:
+    return ChatCompletionGenerationRequest(
+        model="m", messages=[{"role": "user", "content": "hi"}], kv_scope="a", **fields
+    )
+
+
+def _admit(processor: InputProcessor, **fields) -> None:
+    params = _request(**fields).to_sampling_params(8, {})
+    with patch.object(SamplingParams, "verify"):
+        processor._validate_params(params, ("generate",))
+
+
+def _refusal(processor: InputProcessor, **fields) -> VLLMValidationError:
+    with pytest.raises(VLLMValidationError) as excinfo:
+        _admit(processor, **fields)
+    assert excinfo.value.parameter == "kv_transfer_params"
+    return excinfo.value
+
+
+def test_the_cpu_offload_tier_admits_its_store_cap():
+    _admit(_admission(DEPLOYED), kv_transfer_params={"max_offload_tokens": 64})
+
+
+@pytest.mark.parametrize(
+    "key", ["do_remote_prefill", "kv_load_tiers", "prompt_token_ids"]
+)
+def test_a_key_the_configured_connector_does_not_take_is_refused_naming_both(key):
+    message = str(_refusal(_admission(DEPLOYED), kv_transfer_params={key: True}))
+    assert f"key {key!r} is not a parameter of OffloadingConnector" in message
+    assert "(it takes max_offload_tokens)" in message
+    assert "(it takes max_offload_tokens). Next: remove it." in message or (
+        "takes no prompt ids from a request. Next: remove it." in message
+    )
+
+
+def test_reused_prompt_ids_are_refused_for_what_the_server_does_instead():
+    """Upstream's decode node took a prefill node's prompt ids from this key;
+    this server renders every prompt from the request, so no connector, nor
+    any server of this build, takes it."""
+    for config in (DEPLOYED, None, NIXL):
+        message = str(
+            _refusal(_admission(config), kv_transfer_params={"prompt_token_ids": [1]})
+        )
+        assert "'prompt_token_ids' carries a prefill node's prompt ids" in message
+        assert "takes no prompt ids from a request. Next: remove it." in message
+
+
+def test_every_refused_key_is_named():
+    message = str(
+        _refusal(
+            _admission(DEPLOYED),
+            kv_transfer_params={"max_offload_tokens": 1, "a": 1, "b": 2},
+        )
+    )
+    assert "keys 'a', 'b' are not parameters of OffloadingConnector" in message
+    assert "max_offload_tokens'" not in message
+
+
+def test_without_a_connector_every_key_is_refused():
+    message = str(
+        _refusal(_admission(None), kv_transfer_params={"max_offload_tokens": 1})
+    )
+    assert "reaches no KV connector: this server configures none" in message
+
+
+def test_a_connector_that_declares_nothing_is_named_as_declaring_nothing():
+    config = KVTransferConfig(
+        kv_connector="SimpleCPUOffloadConnector", kv_role="kv_both"
+    )
+    message = str(_refusal(_admission(config), kv_transfer_params={"x": 1}))
+    assert "of SimpleCPUOffloadConnector, the KV connector" in message
+    assert "(it takes none); SimpleCPUOffloadConnector declares no key; a " in message
+    assert "overriding KVConnectorBase_V1.get_kv_transfer_params_keys" in message
+
+
+def test_lmcache_without_its_native_adapter_names_use_native():
+    config = KVTransferConfig(kv_connector="LMCacheConnectorV1", kv_role="kv_both")
+    message = str(_refusal(_admission(config), kv_transfer_params={"lmcache.x": 1}))
+    assert "with use_native set in kv_connector_extra_config" in message
+
+
+@pytest.mark.parametrize(
+    "config,kv_transfer_params,shape",
+    [
+        (P2P, {"remote_kv_source": "x"}, "an object whose kv_request_id"),
+        (P2P, {"remote_decoder": "x"}, "an object whose kv_request_id"),
+        (P2P, {"remote_prefiller": [1]}, "an object whose kv_request_id"),
+        (DEPLOYED, {"max_offload_tokens": -1}, "a non-negative integer"),
+        (NIXL, {"remote_engine_id": ["e"]}, "a string"),
+    ],
+)
+def test_a_value_the_connector_cannot_read_is_refused_naming_its_shape(
+    config, kv_transfer_params, shape
+):
+    """Each of these raised where the connector read it, in the engine core,
+    for every request the engine served."""
+    ((key, value),) = kv_transfer_params.items()
+    message = str(_refusal(_admission(config), kv_transfer_params=kv_transfer_params))
+    assert f"kv_transfer_params key {key!r} must be {shape}" in message
+    assert f"reads it, not {_kind(value)}. Next: send it in that shape, or remove it." in (
+        message
+    )
+
+
+def _kind(value) -> str:
+    return {str: "a string", list: "a list", int: "an integer"}[type(value)] + (
+        f" ({value!r})"
+    )
+
+
+def test_a_value_the_connector_reads_is_admitted():
+    _admit(
+        _admission(P2P),
+        kv_transfer_params={
+            "remote_kv_source": {
+                "kv_request_id": "t",
+                "remote_host": "10.0.0.1",
+                "remote_port": 5710,
+            },
+            "remote_decoder": {"kv_request_id": "t"},
+        },
+    )
+
+
+def test_a_connector_that_takes_the_key_admits_it():
+    _admit(_admission(NIXL), kv_transfer_params={"do_remote_prefill": True})
+
+
+@pytest.mark.parametrize("smuggled", ["x", ["a"], 3])
+def test_kv_transfer_params_through_vllm_xargs_must_be_an_object(smuggled):
+    """vllm_xargs reaches the same engine parameter; a non-object would reach
+    the connector, whose first read of it raises in the engine core."""
+    message = str(
+        _refusal(_admission(DEPLOYED), vllm_xargs={"kv_transfer_params": smuggled})
+    )
+    assert "kv_transfer_params must be an object of KV connector parameters" in message
+
+
+def _serving(kv_transfer_config: KVTransferConfig | None):
+    notify = AsyncMock()
+    processor = _admission(kv_transfer_config)
+    engine_client = SimpleNamespace(
+        model_config=None,
+        renderer=None,
+        input_processor=processor,
+        vllm_config=processor.vllm_config,
+        notify_kv_transfer_request_rejected=notify,
+    )
+    serving = GenerateBaseServing(engine_client, None, request_logger=None)
+    serving._get_data_parallel_rank = lambda raw_request: None
+    return serving, notify
+
+
+def _rejected(serving, request):
+    refusal = ErrorResponse(error=ErrorInfo(message="no", type="BadRequest", code=400))
+
+    async def refused():
+        return refusal
+
+    result = asyncio.run(
+        serving._with_kv_transfer_rejection_cleanup(refused(), request, None)
+    )
+    assert result is refusal
+
+
+@pytest.mark.parametrize("kv_transfer_config", [DEPLOYED, None])
+def test_no_notice_without_a_connector_that_takes_remote_prefill(kv_transfer_config):
+    serving, notify = _serving(kv_transfer_config)
+    _rejected(serving, _request(kv_transfer_params={"do_remote_prefill": True}))
+    notify.assert_not_awaited()
+
+
+def test_parameters_admission_refuses_reach_no_connector_as_a_notice():
+    """The notice reaches the connector without crossing admission; a value
+    the connector cannot read names no blocks it could free."""
+    serving, notify = _serving(NIXL)
+    request = _request(
+        kv_transfer_params={"do_remote_prefill": True, "remote_engine_id": ["e"]}
+    )
+    _rejected(serving, request)
+    notify.assert_not_awaited()
+
+
+def test_a_connector_that_takes_remote_prefill_is_told_of_the_refusal():
+    serving, notify = _serving(NIXL)
+    request = _request(kv_transfer_params={"do_remote_prefill": True})
+    _rejected(serving, request)
+    notify.assert_awaited_once_with(
+        request.request_id, {"do_remote_prefill": True}, "a", data_parallel_rank=None
+    )
diff --git a/tests/v1/kv_connector/unit/test_kv_transfer_params_keys.py b/tests/v1/kv_connector/unit/test_kv_transfer_params_keys.py
new file mode 100644
index 0000000000000000000000000000000000000000..f11e1e2bbc3b34e520163dc585eb1f0798e541f3
--- /dev/null
+++ b/tests/v1/kv_connector/unit/test_kv_transfer_params_keys.py
@@ -0,0 +1,426 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Each KV connector declares the request ``kv_transfer_params`` keys its
+protocol defines, as it is configured."""
+
+import ast
+import importlib.util
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+import vllm
+from vllm.config.kv_transfer import KVTransferConfig
+from vllm.distributed.kv_transfer.kv_connector.factory import KVConnectorFactory
+from vllm.distributed.kv_transfer.kv_connector.v1.base import (
+    ANY_VALUE,
+    INTEGER,
+    NON_NEGATIVE_INTEGER,
+    STRING,
+    KVConnectorBase_V1,
+    KVTransferParamsKeys,
+)
+
+VLLM = Path(vllm.__file__).parent
+CONNECTORS = VLLM / "distributed/kv_transfer/kv_connector/v1"
+
+
+def _config(kv_connector: str | None, **extra) -> SimpleNamespace:
+    if kv_connector is None:
+        return SimpleNamespace(kv_transfer_config=None)
+    return SimpleNamespace(
+        kv_transfer_config=KVTransferConfig(
+            kv_connector=kv_connector, kv_role="kv_both", **extra
+        )
+    )
+
+
+def _keys(kv_connector: str | None, **extra) -> KVTransferParamsKeys:
+    config = _config(kv_connector, **extra)
+    return KVConnectorFactory.get_kv_transfer_params_keys(config)
+
+
+CPU_OFFLOAD = {"kv_connector_extra_config": {"cpu_kv_cache_users": 1}}
+
+
+def _tiering(*tiers: dict) -> dict:
+    extra = {"spec_name": "TieringOffloadingSpec", "cpu_kv_cache_users": 1}
+    if tiers:
+        extra["secondary_tiers"] = list(tiers)
+    return {"kv_connector_extra_config": extra}
+
+
+def test_a_vocabulary_defines_its_keys_and_everything_under_its_namespaces():
+    keys = KVTransferParamsKeys(keys={"a": STRING}, namespaces={"ns.": ANY_VALUE})
+    assert keys.defines("a") and keys.defines("ns.anything")
+    assert not keys.defines("b") and not keys.defines("ns")
+    union = keys | KVTransferParamsKeys(keys={"b": INTEGER})
+    assert union.defines("b") and union.defines("ns.x") and union.defines("a")
+    assert str(union) == "a, b, ns.*"
+    assert str(KVTransferParamsKeys()) == ""
+    assert union.shape_of("a") == STRING and union.shape_of("ns.x") == ANY_VALUE
+
+
+def test_a_key_two_connectors_define_holds_its_value_to_both():
+    """Every child of a MultiConnector reads the same request, so a value
+    must be what each that defines its key reads."""
+    union = KVTransferParamsKeys(keys={"n": INTEGER}) | KVTransferParamsKeys(
+        keys={"n": NON_NEGATIVE_INTEGER}
+    )
+    shape = union.shape_of("n")
+    assert shape.conforms(3) and not shape.conforms(-1) and not shape.conforms("3")
+    assert str(shape) == "an integer, and a non-negative integer"
+    assert (
+        KVTransferParamsKeys(keys={"n": INTEGER}) | KVTransferParamsKeys(keys={"n": INTEGER})
+    ).shape_of("n") == INTEGER
+
+
+def test_scalar_shapes_take_only_their_json_type():
+    assert INTEGER.conforms(1) and not INTEGER.conforms(True)
+    assert not INTEGER.conforms(1.0) and not INTEGER.conforms("1")
+    assert STRING.conforms("") and not STRING.conforms(None)
+    assert NON_NEGATIVE_INTEGER.conforms(0) and not NON_NEGATIVE_INTEGER.conforms(-1)
+
+
+def test_no_connector_takes_no_key():
+    assert _keys(None) == KVTransferParamsKeys()
+
+
+def test_a_connector_that_declares_nothing_takes_nothing(monkeypatch):
+    """An out-of-tree connector inherits the empty declaration: every key a
+    request names for it is refused at admission until it declares one."""
+
+    class OutOfTreeConnector(KVConnectorBase_V1):
+        def __init__(self, vllm_config, role, kv_cache_config):
+            super().__init__(vllm_config, role, kv_cache_config)
+
+    module = ModuleType("out_of_tree_connector")
+    module.OutOfTreeConnector = OutOfTreeConnector
+    monkeypatch.setitem(sys.modules, "out_of_tree_connector", module)
+    keys = _keys(
+        "OutOfTreeConnector", kv_connector_module_path="out_of_tree_connector"
+    )
+    assert keys.keys == {} and keys.namespaces == {}
+    # Its operator's next action: declare what it reads.
+    assert keys.undeclared == (
+        "OutOfTreeConnector declares no key; a connector declares the keys it "
+        "reads by overriding KVConnectorBase_V1.get_kv_transfer_params_keys",
+    )
+
+
+def test_the_cpu_offload_tier_takes_only_its_store_cap():
+    """The CPU tier has no secondary tier for kv_load_tiers to select, so
+    only max_offload_tokens acts."""
+    keys = _keys("OffloadingConnector", **CPU_OFFLOAD)
+    assert keys == KVTransferParamsKeys(keys={"max_offload_tokens": NON_NEGATIVE_INTEGER})
+    assert not keys.defines("kv_load_tiers")
+    assert not keys.defines("do_remote_prefill")
+
+
+def test_the_tier_filter_is_taken_only_beside_a_secondary_tier():
+    assert set(_keys("OffloadingConnector", **_tiering()).keys) == {
+        "max_offload_tokens"
+    }
+    assert set(_keys("OffloadingConnector", **_tiering({"type": "fs"})).keys) == {
+        "max_offload_tokens",
+        "kv_load_tiers",
+    }
+    assert set(_keys("OffloadingConnector", **_tiering({"type": "p2p"})).keys) == {
+        "max_offload_tokens",
+        "kv_load_tiers",
+        "remote_prefiller",
+        "remote_decoder",
+        "remote_kv_source",
+    }
+
+
+def test_multi_connector_takes_what_any_child_takes():
+    children = [
+        {"kv_connector": "NixlConnector", "kv_role": "kv_both"},
+        {"kv_connector": "OffloadingConnector", "kv_role": "kv_both", **CPU_OFFLOAD},
+    ]
+    keys = _keys("MultiConnector", kv_connector_extra_config={"connectors": children})
+    assert keys == _keys("NixlConnector") | _keys("OffloadingConnector", **CPU_OFFLOAD)
+    assert keys.defines("do_remote_prefill") and keys.defines("max_offload_tokens")
+
+
+def test_lmcache_takes_its_namespace_only_through_its_native_adapter():
+    native = _keys("LMCacheConnectorV1", kv_connector_extra_config={"use_native": True})
+    assert native.defines("lmcache.skip_save") and native.defines("disagg_spec")
+    latest = _keys("LMCacheConnectorV1")
+    assert latest.keys == {} and latest.namespaces == {}
+    # The one way its operator declares them is the native adapter.
+    (reason,) = latest.undeclared
+    assert "with use_native set in kv_connector_extra_config" in reason
+
+
+# Each connector's own values: what it returns for its peer and what its
+# protocol documents are what admission takes; the values that raised where
+# the connector reads them are refused.
+_TAKEN_AND_REFUSED = [
+    (
+        "OffloadingConnector",
+        _tiering({"type": "p2p"}),
+        {
+            "remote_prefiller": {
+                "kv_request_id": "t",
+                "remote_host": "10.0.0.1",
+                "remote_port": 5710,
+            },
+            "remote_decoder": {"kv_request_id": "t"},
+            "remote_kv_source": {
+                "kv_request_id": "t",
+                "remote_host": "10.0.0.1",
+                "remote_port": 5710,
+            },
+            "kv_load_tiers": [{"medium": "cpu"}, {"locality": "REMOTE"}],
+            "max_offload_tokens": 0,
+        },
+        [
+            ("remote_kv_source", "x"),
+            ("remote_decoder", "x"),
+            ("remote_prefiller", [1]),
+            ("remote_prefiller", {"kv_request_id": ["t"]}),
+            ("kv_load_tiers", "cpu"),
+            ("kv_load_tiers", [{"medium": "tape"}]),
+            ("max_offload_tokens", -1),
+            ("max_offload_tokens", "64"),
+        ],
+    ),
+    (
+        "NixlConnector",
+        {},
+        {
+            "do_remote_prefill": True,
+            "do_remote_decode": False,
+            "remote_block_ids": [[1, 2], [3]],
+            "remote_engine_id": "e",
+            "remote_request_id": "r",
+            "remote_host": "h",
+            "remote_port": 5600,
+            "tp_size": 1,
+            "pp_size": 1,
+            "remote_num_tokens": 32,
+            "remote_blocks_expiry_time": None,
+            "transfer_mode": "pull",
+        },
+        [
+            ("remote_engine_id", ["e"]),
+            ("remote_request_id", {"r": 1}),
+            ("remote_num_tokens", "32"),
+            ("remote_block_ids", [1, 2]),
+            ("do_remote_prefill", "false"),
+        ],
+    ),
+    (
+        "MooncakeConnector",
+        {},
+        {"do_remote_decode": True, "transfer_id": "t"},
+        [("transfer_id", ["t"])],
+    ),
