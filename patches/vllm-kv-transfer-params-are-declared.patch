+def test_a_remote_prefill_requires_every_key_its_connector_indexes_for_it():
+    """A decode node acting on do_remote_prefill true indexes these keys of
+    the request -- for an aborted request too, whose notice reaches the
+    connector -- and a missing one raised KeyError in the engine core. The
+    keys it requires are exactly the ones it indexes."""
+    recv = _subscripted(
+        _function("nixl/metadata.py", "NixlConnectorMetadata.add_new_req_to_recv"),
+        ast.Load,
+    )
+    assert set(_keys("NixlConnector").shape_of("do_remote_prefill").requires) == recv
+    # A push decode node registers with the prefill node from keys it indexes,
+    # and seeds the block IDs it then records itself.
+    push = _function(
+        "nixl/push_scheduler.py", "NixlPushConnectorScheduler.update_state_after_alloc"
+    )
+    pushed = (_subscripted(push, ast.Load) | recv) - _subscripted(push, ast.Store)
+    assert set(_keys("NixlPushConnector").shape_of("do_remote_prefill").requires) == (
+        pushed
+    )
+    mooncake = _subscripted(
+        _function(
+            "mooncake/mooncake_connector.py", "MooncakeConnectorMetadata.add_new_req"
+        ),
+        ast.Load,
+    )
+    assert set(_keys("MooncakeConnector").shape_of("do_remote_prefill").requires) == (
+        mooncake
+    )
