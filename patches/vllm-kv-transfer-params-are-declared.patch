+@dataclass(frozen=True)
+class KVTransferParamsKeys:
+    """The request ``kv_transfer_params`` keys a connector's protocol defines.
+
+    These are the keys the connector reads from a request and the keys it
+    returns for a peer, since a proxy hands one node's returned parameters to
+    the next node as that request's own. Every key under one of
+    ``namespaces`` (prefixes) is defined too, for a connector whose request
+    vocabulary is open-ended. Admission refuses a request that names a key no
+    configured connector defines, so no parameter is ignored unseen.
+    """
+
+    keys: frozenset[str] = frozenset()
+    namespaces: frozenset[str] = frozenset()
+
+    def defines(self, key: str) -> bool:
+        return key in self.keys or key.startswith(tuple(self.namespaces))
+
+    def __or__(self, other: "KVTransferParamsKeys") -> "KVTransferParamsKeys":
+        return KVTransferParamsKeys(
+            keys=self.keys | other.keys,
+            namespaces=self.namespaces | other.namespaces,
+        )
+
+    def __str__(self) -> str:
+        return ", ".join(
+            sorted(self.keys) + sorted(f"{prefix}*" for prefix in self.namespaces)
+        )
+
+
