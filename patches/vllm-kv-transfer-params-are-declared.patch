+def test_a_mooncake_node_is_refused_what_its_role_never_does(kv_role):
+    """The scheduler asserts, inside the engine core, that a kv_producer is
+    never asked to pull a remote prefill and a kv_consumer never to serve a
+    remote decode. Admission refuses exactly what the real scheduler raises
+    on, on that role, and admits the rest; false and null ask for nothing."""
+    import torch
+
+    from vllm.distributed.kv_transfer.kv_connector.v1.mooncake.mooncake_connector import (  # noqa: E501
+        MooncakeConnectorScheduler,
+    )
+    from vllm.v1.kv_cache_interface import (
+        FullAttentionSpec,
+        KVCacheConfig,
+        KVCacheGroupSpec,
+    )
+
+    def scheduler():
+        return MooncakeConnectorScheduler(
+            SimpleNamespace(
+                cache_config=SimpleNamespace(block_size=16),
+                kv_transfer_config=SimpleNamespace(kv_role=kv_role),
+                scheduler_config=SimpleNamespace(disable_hybrid_kv_cache_manager=True),
+            ),
+            "engine",
+            KVCacheConfig(
+                num_blocks=100,
+                kv_cache_tensors=[],
+                kv_cache_groups=[KVCacheGroupSpec(["layer"], FullAttentionSpec(
+                    block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32,
+                ))],
+            ),
+        )
+
+    def request(params):
+        return SimpleNamespace(
+            request_id="r", kv_transfer_params=params,
+            prompt_token_ids=list(range(40)), num_prompt_tokens=40, status=None,
+        )
+
+    def raises(call) -> bool:
+        try:
+            call()
+        except AssertionError:
+            return True
+        return False
+
+    remote = {
+        "transfer_id": "t", "remote_engine_id": "e", "remote_bootstrap_addr": "h:1",
+    }
+    raised = {
+        "do_remote_prefill": raises(lambda: scheduler().get_num_new_matched_tokens(
+            request({"do_remote_prefill": True, **remote}), 0)),
+        "do_remote_decode": raises(lambda: scheduler().request_finished(
+            request({"do_remote_decode": True, "transfer_id": "t"}), ([1],))),
+    }
+    assert raised == {
+        "do_remote_prefill": kv_role == "kv_producer",
+        "do_remote_decode": kv_role == "kv_consumer",
