+@dataclass(frozen=True)
+class KVTransferParamsKeys:
+    """The request ``kv_transfer_params`` keys a connector's protocol defines,
+    each with the shape of the value the connector reads under it and the
+    keys it reads that value with.
+
+    These are the keys the connector reads from a request and the keys it
+    returns for a peer, since a proxy hands one node's returned parameters to
+    the next node as that request's own. Every key under one of
+    ``namespaces`` (prefixes) is defined too, for a connector whose request
+    vocabulary is open-ended. Admission refuses a request that names a key no
+    configured connector defines, so no parameter is ignored unseen; one
+    whose value is not its key's shape, so no value is dereferenced unseen;
+    and one that sends a value without the keys it is read with, or beside a
+    key it is never read with, so no parameter acts on keys that are not
+    there.
+    ``undeclared`` says, for a connector that could declare what it reads but
+    does not, what its operator does to declare it.
+    """
+
+    keys: Mapping[str, KVTransferParamShape] = field(default_factory=dict)
+    namespaces: Mapping[str, KVTransferParamShape] = field(default_factory=dict)
+    undeclared: tuple[str, ...] = ()
+
+    def defines(self, key: str) -> bool:
+        return key in self.keys or key.startswith(tuple(self.namespaces))
+
+    def shape_of(self, key: str) -> KVTransferParamShape:
+        """The shape a value of the defined ``key`` must have, and the keys it
+        is read with: every declaration that defines it holds it."""
+        shapes = [self.keys[key]] if key in self.keys else []
+        shapes += [
+            shape for prefix, shape in self.namespaces.items() if key.startswith(prefix)
+        ]
+        assert shapes, f"{key!r} is not defined"
+        shape = shapes[0]
+        for other in shapes[1:]:
+            shape = _all_of(shape, other)
+        return shape
+
+    def __or__(self, other: "KVTransferParamsKeys") -> "KVTransferParamsKeys":
+        def merged(
+            first: Mapping[str, KVTransferParamShape],
+            second: Mapping[str, KVTransferParamShape],
+        ) -> dict[str, KVTransferParamShape]:
+            union = dict(first)
+            for name, shape in second.items():
+                union[name] = _all_of(union[name], shape) if name in union else shape
+            return union
+
+        return KVTransferParamsKeys(
+            keys=merged(self.keys, other.keys),
+            namespaces=merged(self.namespaces, other.namespaces),
+            undeclared=tuple(dict.fromkeys(self.undeclared + other.undeclared)),
+        )
+
+    def __str__(self) -> str:
+        return ", ".join(
+            sorted(self.keys) + sorted(f"{prefix}*" for prefix in self.namespaces)
+        )
+
