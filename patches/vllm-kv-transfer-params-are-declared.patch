+def _string_constants(files: list[Path]) -> dict[str, str]:
+    constants = {}
+    for path in [*files, VLLM / "v1/kv_offload/base.py"]:
+        for node in ast.parse(path.read_text()).body:
+            if (
+                isinstance(node, ast.Assign)
+                and len(node.targets) == 1
+                and isinstance(node.targets[0], ast.Name)
+                and isinstance(node.value, ast.Constant)
+                and isinstance(node.value.value, str)
+            ):
+                constants[node.targets[0].id] = node.value.value
+    return constants
+
+
+def _used_keys(files: list[Path]) -> set[str]:
+    constants = _string_constants(files)
+
+    def key_of(node: ast.AST) -> str | None:
+        if isinstance(node, ast.Constant) and isinstance(node.value, str):
+            return node.value
+        if isinstance(node, ast.Name):
+            return constants.get(node.id)
+        return None
+
+    used: set[str] = set()
+    for path in files:
+        tree = ast.parse(path.read_text())
+        for node in ast.walk(tree):
+            receiver = key = None
+            if (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Attribute)
+                and node.func.attr == "get"
+                and node.args
+            ):
+                receiver, key = ast.unparse(node.func.value), key_of(node.args[0])
+            elif isinstance(node, ast.Subscript):
+                receiver, key = ast.unparse(node.value), key_of(node.slice)
+            elif (
+                isinstance(node, ast.Compare)
+                and len(node.ops) == 1
+                and isinstance(node.ops[0], (ast.In, ast.NotIn))
+            ):
+                receiver, key = ast.unparse(node.comparators[0]), key_of(node.left)
+            elif isinstance(node, ast.FunctionDef) and node.name.startswith(
+                "request_finished"
+            ):
+                for ret in ast.walk(node):
+                    if isinstance(ret, ast.Return) and isinstance(ret.value, ast.Tuple):
+                        returned = ret.value.elts[-1]
+                        if isinstance(returned, ast.Call) and ast.unparse(
+                            returned.func
+                        ) == "dict":
+                            used.update(k.arg for k in returned.keywords if k.arg)
+                        elif isinstance(returned, ast.Dict):
+                            used.update(filter(None, map(key_of, returned.keys)))
+            if receiver in _RECEIVERS and key is not None:
+                used.add(key)
+    return {key for key in used if not key.startswith("_")}
+
+
+def _files(*patterns: str) -> list[Path]:
+    files = sorted({path for pattern in patterns for path in VLLM.glob(pattern)})
+    assert files, patterns
+    return files
