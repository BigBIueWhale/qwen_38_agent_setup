+@dataclass(frozen=True)
+class KVTransferParamShape:
+    """The JSON value a connector's protocol defines under one request
+    ``kv_transfer_params`` key: what its code reads that value as.
+
+    A connector reads a request's parameters inside the engine core, where a
+    value of another shape -- a string where it calls ``.get``, a list where
+    it hashes -- raises for every request the engine serves. Admission holds
+    each value to its key's shape instead, and refuses one that is not.
+    """
+
+    description: str
+    conforms: Callable[[object], bool] = field(compare=False, repr=False)
+
+    def __str__(self) -> str:
+        return self.description
+
+
+def _shape(description: str, conforms: Callable[[object], bool]) -> KVTransferParamShape:
+    return KVTransferParamShape(description, conforms)
+
+
+ANY_VALUE = _shape("any value", lambda value: True)
+BOOLEAN = _shape("a boolean", lambda value: type(value) is bool)
+INTEGER = _shape("an integer", lambda value: type(value) is int)
+NON_NEGATIVE_INTEGER = _shape(
+    "a non-negative integer", lambda value: type(value) is int and value >= 0
+)
+NUMBER = _shape("a number", lambda value: type(value) in (int, float))
+STRING = _shape("a string", lambda value: type(value) is str)
+INTEGER_OR_DIGITS = _shape(
+    "an integer or a string of its decimal digits",
+    lambda value: type(value) is int
+    or (type(value) is str and value.isascii() and value.isdecimal()),
+)
+
+
+def nullable(shape: KVTransferParamShape) -> KVTransferParamShape:
+    return _shape(
+        f"{shape} or null", lambda value: value is None or shape.conforms(value)
+    )
+
+
+def either(*shapes: KVTransferParamShape) -> KVTransferParamShape:
+    return _shape(
+        " or ".join(map(str, shapes)),
+        lambda value: any(shape.conforms(value) for shape in shapes),
+    )
+
+
+def list_of(
+    items: KVTransferParamShape, described: str | None = None
+) -> KVTransferParamShape:
+    """A list whose every item has the shape ``items``; *described* names the
+    items in the plural ("integers") where that reads better."""
+    return _shape(
+        f"a list of {described}" if described else f"a list each of whose items is {items}",
+        lambda value: type(value) is list and all(map(items.conforms, value)),
+    )
+
+
+def text_naming(values: Iterable[str]) -> KVTransferParamShape:
+    """A string naming one of ``values``, in any case."""
+    named = frozenset(value.upper() for value in values)
+    return _shape(
+        f"one of {', '.join(sorted(named))} (any case)",
+        lambda value: type(value) is str and value.upper() in named,
+    )
+
+
+def object_with(
+    fields: Mapping[str, KVTransferParamShape], required: Iterable[str] = ()
+) -> KVTransferParamShape:
+    """An object whose named fields, where present, have their shapes; the
+    ``required`` ones must be present. The connector reads no other field."""
+    required = tuple(required)
+    parts = [
+        f"{name} {'is' if name in required else 'if present is'} {shape}"
+        for name, shape in fields.items()
+    ]
+    return _shape(
+        f"an object whose {', '.join(parts)}",
+        lambda value: type(value) is dict
+        and all(name in value for name in required)
+        and all(
+            shape.conforms(value[name])
+            for name, shape in fields.items()
+            if name in value
+        ),
+    )
+
+
+def _all_of(
+    first: KVTransferParamShape, second: KVTransferParamShape
+) -> KVTransferParamShape:
+    if first == second:
+        return first
+    return _shape(
+        f"{first}, and {second}",
+        lambda value: first.conforms(value) and second.conforms(value),
+    )
+
+
+@dataclass(frozen=True)
+class KVTransferParamsKeys:
+    """The request ``kv_transfer_params`` keys a connector's protocol defines,
+    each with the shape of the value the connector reads under it.
+
+    These are the keys the connector reads from a request and the keys it
+    returns for a peer, since a proxy hands one node's returned parameters to
+    the next node as that request's own. Every key under one of
+    ``namespaces`` (prefixes) is defined too, for a connector whose request
+    vocabulary is open-ended. Admission refuses a request that names a key no
+    configured connector defines, so no parameter is ignored unseen, and one
+    whose value is not its key's shape, so no value is dereferenced unseen.
+    ``undeclared`` says, for a connector that could declare what it reads but
+    does not, what its operator does to declare it.
+    """
+
+    keys: Mapping[str, KVTransferParamShape] = field(default_factory=dict)
+    namespaces: Mapping[str, KVTransferParamShape] = field(default_factory=dict)
+    undeclared: tuple[str, ...] = ()
+
+    def defines(self, key: str) -> bool:
+        return key in self.keys or key.startswith(tuple(self.namespaces))
+
+    def shape_of(self, key: str) -> KVTransferParamShape:
+        """The shape a value of the defined ``key`` must have: every
+        declaration that defines it holds it."""
+        shapes = [self.keys[key]] if key in self.keys else []
+        shapes += [
+            shape for prefix, shape in self.namespaces.items() if key.startswith(prefix)
+        ]
+        assert shapes, f"{key!r} is not defined"
+        shape = shapes[0]
+        for other in shapes[1:]:
+            shape = _all_of(shape, other)
+        return shape
+
+    def __or__(self, other: "KVTransferParamsKeys") -> "KVTransferParamsKeys":
+        def merged(
+            first: Mapping[str, KVTransferParamShape],
+            second: Mapping[str, KVTransferParamShape],
+        ) -> dict[str, KVTransferParamShape]:
+            union = dict(first)
+            for name, shape in second.items():
+                union[name] = _all_of(union[name], shape) if name in union else shape
+            return union
+
+        return KVTransferParamsKeys(
+            keys=merged(self.keys, other.keys),
+            namespaces=merged(self.namespaces, other.namespaces),
+            undeclared=tuple(dict.fromkeys(self.undeclared + other.undeclared)),
+        )
+
+    def __str__(self) -> str:
+        return ", ".join(
+            sorted(self.keys) + sorted(f"{prefix}*" for prefix in self.namespaces)
+        )
+
