+def _subscripted(
+    function: ast.FunctionDef, context: type[ast.expr_context]
+) -> set[str]:
+    return {
+        node.slice.value
+        for node in ast.walk(function)
+        if isinstance(node, ast.Subscript)
+        and isinstance(node.ctx, context)
+        and ast.unparse(node.value) in _RECEIVERS
+        and isinstance(node.slice, ast.Constant)
+        and isinstance(node.slice.value, str)
+    }
+
+
+def _function(relative: str, qualname: str) -> ast.FunctionDef:
+    tree = ast.parse((CONNECTORS / relative).read_text())
+    owner, name = qualname.split(".")
+    (cls,) = (n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == owner)
+    (function,) = (
+        n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == name
+    )
+    return function
+
