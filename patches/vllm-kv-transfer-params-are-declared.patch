+    for key, raised_there in raised.items():
+        assert keys.shape_of(key).conforms(True) is not raised_there, key
+        assert keys.shape_of(key).conforms(False), key
+    if kv_role != "kv_both":
+        refused = keys.shape_of(
+            "do_remote_prefill" if kv_role == "kv_producer" else "do_remote_decode")
+        assert str(refused).startswith(f"false on this {kv_role} node")
