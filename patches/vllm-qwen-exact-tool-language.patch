+def test_qwen_value_markup_is_identical_in_batch_and_stream(chunk_size, value):
+    """Only the exact parameter closer is structural within a value."""
+    parser_cls = next(p.parser_cls for p in _PAIRINGS if p.name == "qwen3")
+    vocab = {text: 20000 + n for n, text in enumerate([
+        "<think>", "</think>", "<tool_call>", "</tool_call>",
+    ])}
+    text = ("plan</think>before<tool_call>\n<function=write>\n<parameter=text>"
+            + value + "</parameter>\n</function>\n</tool_call>after")
+    tokens = []
+    offset = 0
+    while offset < len(text):
+        marker = next((m for m in vocab if text.startswith(m, offset)), None)
+        piece = marker if marker is not None else text[offset]
+        tokens.append((vocab[marker] if marker else ord(piece), piece))
+        offset += len(piece)
+    tools = [{"type": "function", "function": {
+        "name": "write", "parameters": {"type": "object", "properties": {
+            "text": {"type": "string"}}, "required": ["text"]},
+    }}]
+    validated = _TOOLS_VALIDATOR.validate_python(tools)
+    tok = MockTokenizer(vocab, tokens)
+    batch = parser_cls(tok, validated)
+    reasoning, content, calls = batch.parse(
+        text, _test_request(tools=tools), enable_auto_tools=True,
+        model_output_token_ids=[tid for tid, _ in tokens],
+    )
+    assert reasoning == "plan"
+    assert content == "beforeafter"
+    assert len(calls) == 1
+    assert json.loads(calls[0].arguments) == {"text": value}
+    stream = parser_cls(tok, validated)
+    result = collect_output(replay_streaming(
+        stream, tokens, chunk_size=chunk_size, finished_on_last=True, tools=tools,
+    ))
+    assert result.reasoning == reasoning
+    assert result.content == content
+    assert json.loads(result.tool_calls[0]["arguments"]) == {"text": value}
