+    config.cache_config.prefix_match_unit = 8
+    full = FullAttentionSpec(block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32)
+    if kind == 'window':
+        other = SlidingWindowSpec(block_size=16, num_kv_heads=1, head_size=1,
+                                  dtype=torch.float32, sliding_window=80)
+    elif kind == 'recurrent':
+        other = MambaSpec(block_size=24, shapes=((1, 1),), dtypes=(torch.float32,),
+                          mamba_cache_mode='align')
+    else:
+        other = full
+
+    def kv_config(wrapped):
+        return KVCacheConfig(num_blocks=0, kv_cache_tensors=[], kv_cache_groups=[
+            KVCacheGroupSpec([f'{name}-a', f'{name}-b'],
+                UniformTypeKVCacheSpecs(block_size=spec.block_size,
+                    kv_cache_specs={f'{name}-a': spec, f'{name}-b': spec})
+                if wrapped else spec)
+            for name, spec in [('first', full), ('second', other)]
+        ])
+
+    grouped, individual = kv_config(True), kv_config(False)
+    assert resolve_kv_cache_block_sizes(grouped, config) == resolve_kv_cache_block_sizes(individual, config)
+    actual = build_offloading_config(config, grouped)
+    expected = build_offloading_config(config, individual)
+    assert actual.groups == expected.groups
+    assert actual.groups[0].tokens_per_block == 16 * dcp
+    scheduler = SchedulerOffloadConfig.from_spec(MockOffloadingSpec(actual), config, grouped)
+    if kind == 'recurrent':
+        assert actual.groups[1].tokens_per_block == 24
+        assert scheduler.kv_group_configs[1].requires_cow_source
+        assert resolve_mamba_align_size(MockOffloadingSpec(actual), grouped) == 72
+
