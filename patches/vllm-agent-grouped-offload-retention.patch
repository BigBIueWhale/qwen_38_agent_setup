+def test_speculative_promotion_retains_no_context():
+    m = CPUOffloadingManager(3)
+    ctx = context('new-agent', 'promotion')
+    result = m._prepare_store([b'candidate'], ctx)
+    m.complete_store(result.keys_to_store, ctx)
