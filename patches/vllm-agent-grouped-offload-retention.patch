+def _scoped_request(request_id, prompt_token_ids, block_size, agent, cache_salt=None):
+    sampling_params = SamplingParams(max_tokens=17, extra_args={"kv_scope": agent})
+    sampling_params.update_from_generation_config({}, eos_token_id=100)
+    return Request(
+        request_id=request_id,
+        prompt_token_ids=prompt_token_ids,
+        sampling_params=sampling_params,
+        pooling_params=None,
+        cache_salt=cache_salt,
+        block_hasher=get_request_block_hasher(block_size, sha256),
+    )
+
+
+@pytest.mark.parametrize("reader_agent", ["new-agent", "own-agent", "writer-agent"])
+def test_prefix_match_is_content_and_salt_whatever_the_agent_id(reader_agent):
+    """An ID with cached blocks of its own matches another ID's resident
+    prefix exactly as a new ID does; only content and cache_salt decide."""
+    block_size = 16
+    manager = make_kv_cache_manager(
+        make_kv_cache_config(block_size, 16),
+        max_model_len=8192,
+        enable_caching=True,
+        hash_block_size=block_size,
+    )
+
+    def run(request):
+        computed, num_computed, _ = manager.get_computed_blocks(request)
+        blocks = manager.allocate_slots(
+            request, request.num_tokens - num_computed, num_computed, computed
+        )
+        assert blocks is not None
+        request.num_computed_tokens = request.num_tokens
+        manager.free(request)
+        return num_computed
+
+    # The reader's own line already has cached blocks of different content.
+    assert run(_scoped_request("own", [9] * (2 * block_size + 1), block_size,
+                               "own-agent")) == 0
+    common = [i for i in range(3) for _ in range(block_size)]
+    assert run(_scoped_request("writer", common + [7] * 5, block_size,
+                               "writer-agent")) == 0
+
+    reader = _scoped_request("reader", common + [8] * 5, block_size, reader_agent)
+    _, num_computed, _ = manager.get_computed_blocks(reader)
+    assert num_computed == 3 * block_size
+
+    salted = _scoped_request("salted", common + [8] * 5, block_size, reader_agent,
+                             cache_salt="other-salt")
+    _, num_computed, _ = manager.get_computed_blocks(salted)
+    assert num_computed == 0
+
