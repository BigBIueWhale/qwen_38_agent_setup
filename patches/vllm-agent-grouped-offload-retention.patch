+@pytest.mark.parametrize('seed', range(12))
+def test_shared_retention_randomized_capacity_pressure(seed):
+    rng = random.Random(seed)
+    m = CPUOffloadingManager(17)
+    contexts = [context(str(i)) for i in range(7)]
+    for _ in range(200):
+        ctx = rng.choice(contexts)
+        keys = {bytes([k]) for k in rng.sample(range(30), rng.randint(1, 8))}
+        m.retain_context(keys, ctx)
+        survivors = {
+            req_id: set(c.keys) for req_id, c in m._contexts.items()
+            if c.keys <= m._blocks.keys()
+        }
+        result = m.prepare_store(keys, ctx)
+        if result is not None:
+            m.complete_store(result.keys_to_store, ctx)
+        for req_id, required in survivors.items():
+            if req_id in m._contexts:
+                assert required <= m._blocks.keys()
+        if rng.random() < 0.3:
+            m.on_request_finished(ctx)
+        check(m)
