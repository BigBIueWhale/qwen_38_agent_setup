+def _coalesced_window_cache():
+    """CPU chunk 0 has an unwritten leading SWA block at the 96-token frontier."""
+    from vllm.v1.kv_cache_interface import KVCacheConfig
+    from vllm.v1.kv_offload.cpu.manager import CPUOffloadingManager
+
+    config = _make_vllm_config(extra_config={'blocks_per_chunk': 3})
+    groups = [
+        KVCacheGroupSpec(['full'], FullAttentionSpec(
+            block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32,
+        )),
+        KVCacheGroupSpec(['window'], SlidingWindowSpec(
+            block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32,
+            sliding_window=80,
+        )),
+    ]
+    kv_config = KVCacheConfig(num_blocks=20, kv_cache_tensors=[], kv_cache_groups=groups)
+    spec = MockOffloadingSpec(build_offloading_config(config, kv_config))
+    scheduler = OffloadingConnectorScheduler(spec, config, kv_config)
+    scheduler.manager = CPUOffloadingManager(8)
+
+    def request(agent, size):
+        req = MagicMock()
+        req.request_id = agent
+        req.kv_scope = agent
+        req.kv_transfer_params = None
+        req.num_prompt_tokens = size
+        req.num_tokens = size
+        req.num_computed_tokens = 0
+        req.block_hashes = [BlockHash(f'window-h{i}'.encode()) for i in range(size // 16)]
+        req.all_token_ids = list(range(size))
+        req.is_finished.return_value = False
+        req.skip_reading_prefix_cache = False
+        req.lora_request = None
+        scheduler.on_new_request(req)
+        return req
+
+    writer = request('writer', 97)
+    state = scheduler._req_status[writer.request_id]
+    state.update_offload_keys()
+    state.group_states[0].block_ids[:] = [1, 2, 3, 4, 5, 6]
+    state.group_states[1].block_ids[:] = [0, 12, 13, 14, 15, 16]
+    scheduler._build_store_jobs(SimpleNamespace(
+        num_scheduled_tokens={writer.request_id: 96}, finished_req_ids=(),
+    ))
+    for job in scheduler._jobs.values():
+        scheduler.manager.complete_store(job.keys, state.req_context)
+    scheduler.manager.on_request_finished(state.req_context)
+    return scheduler, writer, request
+
+
+def test_coalesced_window_holds_only_gpu_data_that_was_written():
+    scheduler, writer, _ = _coalesced_window_cache()
+    first_chunk = make_offload_key(writer.block_hashes[2], 1)
+    available = scheduler.manager._available_content[first_chunk]
+    assert available == tuple(
+        make_offload_key(block_hash, 1) for block_hash in writer.block_hashes[1:3]
+    )
+    assert first_chunk not in scheduler.manager._complete_blocks
+
+
+def test_coalesced_window_reuses_its_frontier_without_claiming_an_earlier_window():
+    scheduler, _, request = _coalesced_window_cache()
+    same_frontier = request('same-frontier', 97)
+    assert scheduler.get_num_new_matched_tokens(same_frontier, 0) == (96, True)
+    earlier_frontier = request('earlier-frontier', 49)
+    # A shorter request needs the SWA data at tokens 0..16. The earlier
+    # frontier is unavailable even though its chunk-end hash is resident.
+    assert scheduler.get_num_new_matched_tokens(earlier_frontier, 0) == (0, False)
+
