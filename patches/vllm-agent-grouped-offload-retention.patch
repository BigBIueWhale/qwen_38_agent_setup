+def test_storage_transfer_can_precede_generation_without_inventing_an_agent():
+    m = CPUOffloadingManager(4)
+    physical = ReqContext('physical-transfer')
+    result = m._prepare_store([b'end'], physical)
+    m.complete_store(result.keys_to_store, physical)
+    assert m._lookup(b'end', physical) is LookupResult.HIT
+    assert not m._contexts and not m._agents
+    assert m._available_content[b'end'] is None
+    # The first generation supplies the hash chain that describes the entry.
+    generation = ReqContext('generation', kv_scope='agent',
+                            prefix_content={b'end': (b'first', b'end')})
+    assert m.lookup(b'end', generation) is LookupResult.HIT
+    assert m._available_content[b'end'] == (b'first', b'end')
+    assert not m._contexts
+    m.retain_context([b'end'], generation)
+    assert m._contexts['generation'].keys == {b'end'}
+    check(m)
+
