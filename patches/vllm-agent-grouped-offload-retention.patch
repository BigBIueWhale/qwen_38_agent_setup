+    def request(agent, req_id):
+        req = MagicMock()
+        req.request_id, req.kv_scope = req_id, agent
+        req.kv_transfer_params = None
+        req.num_prompt_tokens = req.num_tokens = 97
+        req.num_computed_tokens = 0
+        req.block_hashes = [BlockHash(f'h{i}'.encode()) for i in range(12)]
+        req.all_token_ids = list(range(97))
