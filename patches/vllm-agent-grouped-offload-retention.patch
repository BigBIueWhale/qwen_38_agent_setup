+@pytest.mark.parametrize('reader', ['new', 'existing', 'writer'])
+def test_lookup_matches_content_whatever_the_agent_id(reader):
+    """Any ID matches any resident prefix it names by content: an ID with
+    cached data of its own is no more restricted than a new one."""
+    m = CPUOffloadingManager(6)
+    writer = context('writer')
+    store(m, writer, [b'prefix', b'writer-tail'])
+    m.on_request_finished(writer)
+    if reader == 'existing':
+        own = context('existing', 'own-turn')
+        store(m, own, [b'own-prefix', b'own-tail'])
+        m.on_request_finished(own)
+    ctx = context(reader, 'next-turn')
+    for key in [b'prefix', b'writer-tail']:
+        assert lookup(m, key, ctx) is LookupResult.HIT
+    load(m, [b'prefix', b'writer-tail'], ctx)
+    m.complete_load([b'prefix', b'writer-tail'], ctx)
+    # Loading shared data references it under the reader's own line.
+    assert m._references[b'prefix'] >= {'next-turn'}
+    check(m)
+
