+from vllm.v1.kv_offload.cpu.common import CPUOffloadingMetrics
+
+
+class AtomicTestContent(dict):
+    """These manager fixtures use one opaque data unit per offload key."""
+
+    def __missing__(self, key):
+        return (key,)
+
+    def get(self, key, default=None):
+        return self[key]
+
+
+def context(agent, request=None):
+    return ReqContext(req_id=request or agent, kv_scope=agent, prefix_content=AtomicTestContent())
+
+
+def lookup(manager, key, ctx):
+    return manager.lookup(key, ctx)
+
+
+def load(manager, keys, ctx):
+    return manager.prepare_load(keys, ctx)
+
+
+def store(manager, ctx, keys, *, complete=True, retain=None):
+    manager.retain_context(keys if retain is None else retain, ctx)
+    output = manager.prepare_store(keys, ctx)
+    assert output is not None
+    if complete:
+        manager.complete_store(output.keys_to_store, ctx)
+    return output
+
+
+def check(manager):
+    """Independently reconstruct every reverse reference and physical slot."""
+    references = {}
+    for req_id, ctx in manager._contexts.items():
+        assert req_id in manager._agents[ctx.agent_id]
+        for key in ctx.keys:
+            references.setdefault(key, set()).add(req_id)
+    assert references == manager._references
+    assert {r for rs in manager._agents.values() for r in rs} == set(manager._contexts)
+    blocks = manager._blocks
+    assert manager._canonical_content.keys() == blocks.keys()
+    assert manager._available_content.keys() == blocks.keys()
+    assert manager._complete_blocks <= blocks.keys()
+    assert set(manager._idle_context.values()) <= set(manager._contexts)
+    assert len(manager._idle_context) <= manager._num_blocks
+    allocated = {b.block_id for b in blocks.values()}
+    assert len(allocated) == len(blocks)
+    assert allocated.isdisjoint(manager._free_list)
+    assert len(allocated) + len(manager._free_list) == manager._num_allocated_blocks
+    assert manager._num_allocated_blocks <= manager._num_blocks
+    assert set(manager._evictable_blocks) == {k for k, b in blocks.items() if b.ref_cnt == 0}
+    assert manager._num_write_pending_blocks == sum(b.ref_cnt == -1 for b in blocks.values())
+
+
+def test_retained_contexts_fit_declared_chunk_count():
+    """Unlimited IDs cannot accumulate unlimited retained-context metadata."""
+    m = CPUOffloadingManager(4)
+    keys = [b'prefix', b'tail']
+    for i in range(100):
+        ctx = context(str(i))
+        store(m, ctx, keys)
+        m.on_request_finished(ctx)
+        assert len(m._contexts) <= 4
+        assert set(m._blocks) == set(keys)
+        for survivor in m._contexts.values():
+            assert survivor.keys == set(keys)
+        check(m)
+    # The most recently finished contexts are the ones retained.
+    assert set(m._idle_context) == {'96', '97', '98', '99'}
+
+
+def test_shared_prefix_capacity_counts_physical_data_once():
+    m = CPUOffloadingManager(4)
+    keys = [b'prefix', b'tail']
+    for agent in ['one', 'two', 'three']:
+        ctx = context(agent)
+        store(m, ctx, keys)
+        m.on_request_finished(ctx)
+    assert set(m._agents) == {'one', 'two', 'three'}
+    assert len(m._blocks) == 2
+    for req_id in m._idle_context.values():
+        assert m._contexts[req_id].keys == set(keys)
+    check(m)
+
