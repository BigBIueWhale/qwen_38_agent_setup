+def test_shared_partial_prefix_retention_survives_producer_eviction():
+    from vllm.v1.kv_offload.cpu.manager import CPUOffloadingManager
+
+    scheduler = _make_partial_tail_scheduler()
+    scheduler.manager = CPUOffloadingManager(8)
+    request = MagicMock()
+    request.request_id = "writer-request"
+    request.kv_scope = "writer-agent"
+    request.kv_transfer_params = None
+    request.num_prompt_tokens = 34
+    request.num_tokens = 34
+    request.num_computed_tokens = 0
+    request.block_hashes = [BlockHash(f"h{i}".encode()) for i in range(8)]
+    request.all_token_ids = list(range(34))
+    request.is_finished.return_value = False
+    request.lora_request = None
+    scheduler.on_new_request(request)
+    state = scheduler._req_status[request.request_id]
+    state.update_offload_keys()
+    state.group_states[0].block_ids[:] = [11, 12]
+    state.group_states[1].block_ids[:] = [0, 21]
+    scheduler._build_partial_tail_store_jobs(SimpleNamespace(
+        partial_tail_offloads={request.request_id: [(1, 99, 28)]},
+    ))
+    scheduler._build_store_jobs(SimpleNamespace(
+        num_scheduled_tokens={request.request_id: 28}, finished_req_ids=(),
+    ))
+    for job in scheduler._jobs.values():
+        scheduler.manager.complete_store(job.keys, state.req_context)
+    partial_keys = {
+        make_offload_key(request.block_hashes[3], 0),
+        make_offload_key(request.block_hashes[6], 0),
+        make_offload_key(request.block_hashes[6], 1),
+    }
+    assert scheduler.manager._contexts[request.request_id].keys == partial_keys
+    assert set(scheduler.manager._blocks) == partial_keys
+
+    # The writer advances. Its previous immutable partial state remains available
+    # in spare capacity, so another agent can fork that shorter prefix.
+    scheduler._build_store_jobs(SimpleNamespace(
+        num_scheduled_tokens={request.request_id: 32}, finished_req_ids=(),
+    ))
+    for job in scheduler._jobs.values():
+        scheduler.manager.complete_store(job.keys, state.req_context)
+    scheduler.manager.on_request_finished(state.req_context)
+    assert len(scheduler.manager._blocks) == 5
+
+    fork = MagicMock()
+    fork.request_id = "fork-request"
+    fork.kv_scope = "unrelated-opaque-agent"
+    fork.kv_transfer_params = None
+    fork.num_prompt_tokens = 30
+    fork.num_tokens = 30
+    fork.block_hashes = request.block_hashes[:7]
+    fork.skip_reading_prefix_cache = False
+    scheduler.on_new_request(fork)
+    assert scheduler.get_num_new_matched_tokens(fork, 0) == (28, True)
+    assert scheduler.manager._contexts[fork.request_id].keys == partial_keys
+
+    incoming = ReqContext(req_id="new-request", kv_scope="new-agent")
+    keys = [make_offload_key(f"new{i}".encode(), 0) for i in range(4)]
+    scheduler.manager.retain_context(keys, incoming)
+    incoming.prefix_content = {key: (key,) for key in keys}
+    output = scheduler.manager.prepare_store(keys, incoming)
+    assert output is not None
+    assert request.kv_scope not in scheduler.manager._agents
+    assert fork.kv_scope in scheduler.manager._agents
+    fork_context = scheduler._req_status[fork.request_id].req_context
+    assert all(scheduler.manager.lookup(k, fork_context) is LookupResult.HIT for k in partial_keys)
+    # An agent with cached data of its own matches the same resident content.
+    assert all(scheduler.manager.lookup(k, incoming) is LookupResult.HIT for k in partial_keys)
