+    state.update_offload_keys()
+    state.group_states[0].block_ids[:] = [1, 2, 3, 4, 5, 6]
+    state.group_states[1].block_ids[:] = [0, 0, 22, 23]
+    scheduler._build_store_jobs(SimpleNamespace(
+        num_scheduled_tokens={producer.request_id: 96}, finished_req_ids=(),
+    ))
+    for job in scheduler._jobs.values():
+        scheduler.manager.complete_store(job.keys, state.req_context)
