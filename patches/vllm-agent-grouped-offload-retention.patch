+@pytest.mark.parametrize('subagent_tail', [3, 4])
+def test_waiting_parent_survives_a_subagent_only_while_both_fit(subagent_tail):
+    """With one sequence at a time the parent has finished and is the least
+    recently used other ID: it survives exactly while its chunks and the
+    subagent's unshared chunks fit in the tier together."""
+    m = CPUOffloadingManager(6)
+    parent = context('parent')
+    store(m, parent, [b'system', b'parent-1', b'parent-2'])
+    m.on_request_finished(parent)
+    subagent = context('subagent')
+    tail = [f'sub-{i}'.encode() for i in range(subagent_tail)]
+    # The subagent matches the shared system prompt by content and extends it.
+    assert lookup(m, b'system', subagent) is LookupResult.HIT
+    output = store(m, subagent, tail, retain=[b'system', *tail])
+    survives = 3 + subagent_tail <= 6
+    assert ('parent' in m._agents) is survives
+    assert set(output.evicted_keys) == (set() if survives else {b'parent-1', b'parent-2'})
+    # The shared chunk stays: the subagent's own context references it.
+    assert lookup(m, b'system', subagent) is LookupResult.HIT
+    check(m)
