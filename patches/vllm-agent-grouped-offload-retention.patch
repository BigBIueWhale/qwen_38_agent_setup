+def test_sparse_window_is_local_and_fill_preserves_existing_agents():
+    m = CPUOffloadingManager(3, enable_events=True)
+    key = b'end'
+    suffix = (b'middle', key)
+    writer = window_context('writer', available=suffix, required=suffix)
+    store(m, writer, [key])
+    m.on_request_finished(writer)
+    assert writer.req_id in m._contexts
+    assert lookup(m, key, writer) is LookupResult.HIT
+    assert m._lookup(key, ReqContext('storage')) is LookupResult.MISS
+    assert list(m.take_events()) == []
+    with pytest.raises(AssertionError):
+        m.prepare_read([key], ReqContext('storage'))
+    fork = window_context('fork', required=suffix)
+    load(m, [key], fork)
+    m.complete_load([key], fork)
+    slot = m._blocks[key].block_id
+    earlier = window_context('earlier')
+    assert lookup(m, key, earlier) is LookupResult.MISS
+
+    output = store(m, earlier, [key], complete=False)
+    assert output.keys_to_store == [key]
+    assert list(output.store_spec.block_ids) == [slot]
+    assert m._num_allocated_blocks == 1
+    assert lookup(m, key, earlier) is LookupResult.HIT_PENDING
+    assert m._available_content[key] == (b'early', *suffix)
+    for agent in ['writer', 'fork']:
+        assert m._contexts[agent].keys == {key}
+    m.complete_store(output.keys_to_store, earlier)
+    assert lookup(m, key, earlier) is LookupResult.HIT
+    assert m._lookup(key, ReqContext('storage')) is LookupResult.HIT
+    events = list(m.take_events())
+    assert [(e.keys, e.removed) for e in events] == [([key], False)]
+    # The filled row serves every reader whose required data it holds,
+    # including the agents that wrote or read only its suffix before.
+    for agent in ['writer', 'fork']:
+        assert lookup(m, key, window_context(agent)) is LookupResult.HIT
+    check(m)
+
