+def _tool_the_template_is_never_given(
+    parameter: str, kind: str, *, namespace: str | None = None
+) -> VLLMValidationError:
+    where = f" in namespace {namespace!r}" if namespace is not None else ""
+    return VLLMValidationError(
+        f"{parameter} is a {kind!r} tool{where}. This model's chat template "
+        "is given only function tools and the functions of a namespace, so a "
+        f"{kind!r} tool would never reach the model, with or without a tool "
+        "server. Declare what it does as a function tool your client executes.",
+        parameter=parameter,
+    )
+
+
