+@pytest.mark.parametrize("exclude", [False, True])
+@pytest.mark.parametrize("tool_choice", ["auto", "required", "none"])
+@pytest.mark.parametrize("tools, parameter, cause", _NEVER_GIVEN)
+def test_a_tool_the_chat_template_is_never_given_is_refused(
+    tools, parameter, cause, tool_choice, exclude
+):
+    """The template is given functions only, so a declared tool of another
+    kind -- alone, beside a function, or inside a namespace -- would never
+    reach the model; the request is refused naming it, under every choice."""
+    request = ResponsesRequest(
+        input="hi", tools=tools, tool_choice=tool_choice, kv_scope="agent"
+    )
+    with pytest.raises(VLLMValidationError) as refused:
+        construct_tool_dicts(request.tools, request.tool_choice, exclude)
+    assert refused.value.parameter == parameter
+    assert f"{parameter} is {cause}" in str(refused.value)
+
+
+def test_the_chat_template_is_given_every_declared_function():
+    request = ResponsesRequest(
+        input="hi", tools=[_FUNCTION, _NAMESPACE], kv_scope="agent"
+    )
+    given = construct_tool_dicts(request.tools, request.tool_choice)
+    assert [tool["function"]["name"] for tool in given] == ["read_file", "fs__stat"]
+
