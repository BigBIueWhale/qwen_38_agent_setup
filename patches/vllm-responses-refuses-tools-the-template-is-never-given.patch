-    if not tools or (tool_choice == "none" and exclude_tools_when_tool_choice_none):
+    """The tools the chat template is given: every function tool and every
+    function of a namespace, flattened by ``iter_response_function_tool_dicts``
+    as the grammar and the parser read them.
+
+    A template is given functions and nothing else. A declared tool of any
+    other kind, a namespace member that is not a function, or a namespace
+    with no tools would never reach the model, so the request is refused
+    naming it, under every tool choice, rather than served without it. A tool
+    server does not change that: on this path it could only execute a call
+    the model was never told it could make.
+    """
+    if not tools:
+        return None
+    for index, tool in enumerate(tools):
+        if isinstance(tool, FunctionTool):
+            continue
+        if not isinstance(tool, NamespaceTool):
+            raise _tool_the_template_is_never_given(f"tools[{index}]", tool.type)
+        if not tool.tools:
+            raise VLLMValidationError(
+                f"tools[{index}] is namespace {tool.name!r} with no tools, so it "
+                "offers the model nothing. Declare the functions it groups, or "
+                "leave it out.",
+                parameter=f"tools[{index}]",
+            )
+        for member_index, member in enumerate(tool.tools):
+            if member.type != "function":
+                raise _tool_the_template_is_never_given(
+                    f"tools[{index}].tools[{member_index}]",
+                    member.type,
+                    namespace=tool.name,
+                )
+    if tool_choice == "none" and exclude_tools_when_tool_choice_none:
         return None
