     assert usage_chunks[-1]["metrics"]["time_to_first_token_ms"] == pytest.approx(500.0)
 
 
+@pytest.mark.asyncio
+@pytest.mark.parametrize("return_token_ids", [False, True])
+async def test_a_stream_reports_the_log_probability_of_a_step_with_no_text(
+    return_token_ids,
+):
+    """The parser may release no text for a step -- a reasoning end, a held
+    marker -- but the step generated its tokens, and the full response reports
+    a log probability for each. Its chunk carries them, so the stream reports
+    the same list, in order, with or without token ids."""
+    from vllm.logprobs import Logprob
+
+    class WithholdsTheFirstStep:
+        reasoning_token_count = None
+
+        def __init__(self, *args, **kwargs):
+            self.generated_token_count = 0
+
+        def parse_output_delta(self, delta_text, delta_token_ids, request,
+                               prompt_token_ids=None, *, finish_reason,
+                               stop_reason):
+            first = self.generated_token_count == 0
+            self.generated_token_count += len(delta_token_ids)
+            return None if first else DeltaMessage(content=delta_text)
+
+    serving = _build_minimal_metrics_serving_chat(enable_per_request_metrics=False)
+    serving.parser_cls = WithholdsTheFirstStep
+    serving.model_config = MockModelConfig()
+    steps = [("", [7], -0.5), ("Hi", [8], -0.25), ("!", [9], -0.125)]
+
+    async def outputs():
+        for index, (text, ids, logprob) in enumerate(steps):
+            last = index == len(steps) - 1
+            yield RequestOutput(
+                request_id="test-id", prompt="Test prompt",
+                prompt_token_ids=[1, 2, 3], prompt_logprobs=None, finished=last,
+                outputs=[CompletionOutput(
+                    index=0, text=text, token_ids=ids, cumulative_logprob=None,
+                    logprobs=[{ids[0]: Logprob(logprob=logprob, rank=1)}],
+                    finish_reason="stop" if last else None,
+                )],
+            )
+
+    request = ChatCompletionRequest(
+        model="test-model", messages=[{"role": "user", "content": "Test"}],
+        stream=True, logprobs=True, top_logprobs=0,
+        return_tokens_as_token_ids=True, return_token_ids=return_token_ids,
+    )
+    reported = []
+    async for line in serving.chat_completion_stream_generator(
+        request, outputs(), "chatcmpl-test-id", "test-model",
+        conversation=[{"role": "user", "content": "Test"}], tokenizer=MagicMock(),
+        request_metadata=RequestResponseMetadata(request_id="chatcmpl-test-id"),
+    ):
+        if not line.startswith("data: {"):
+            continue
+        for choice in json.loads(line[len("data: "):])["choices"]:
+            for entry in (choice.get("logprobs") or {}).get("content") or []:
+                reported.append((entry["token"], entry["logprob"]))
+    assert reported == [
+        ("token_id:7", -0.5), ("token_id:8", -0.25), ("token_id:9", -0.125)
+    ]
+
+
 @dataclass
 class MockEngine:
     model_config: MockModelConfig = field(default_factory=MockModelConfig)
