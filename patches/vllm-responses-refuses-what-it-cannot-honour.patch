+def test_a_prompt_template_is_refused_naming_what_to_send_instead():
+    """A prompt template lives with the provider that stores it; this server
+    holds none, so its text would never reach the model."""
+    with pytest.raises(VLLMValidationError) as refused:
+        _validate(
+            {
+                "input": "Hello",
+                "model": "test-model",
+                "prompt": {"id": "pmpt_123", "variables": {"city": "Paris"}},
+            }
+        )
+    assert refused.value.parameter == "prompt"
+    assert "holds no prompt templates" in str(refused.value)
+    assert "as instructions and input, and omit prompt" in str(refused.value)
