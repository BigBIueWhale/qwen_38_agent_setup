+@pytest.mark.asyncio
+@pytest.mark.parametrize("runs_the_tool", [True, False])
+async def test_max_tool_calls_is_refused_where_built_in_calls_are_not_counted(
+    runs_the_tool,
+):
+    # max_tool_calls bounds the built-in tool calls a response processes; a
+    # server that runs one itself does not count them.
