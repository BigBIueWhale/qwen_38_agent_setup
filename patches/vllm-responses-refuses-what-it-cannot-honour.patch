+def _stateless_serving(*, enable_store, model_type="test", **launch):
+    engine_client = MagicMock()
+    engine_client.errored = False
+    engine_client.model_config.max_model_len = 100
+    engine_client.model_config.hf_config.model_type = model_type
+    engine_client.model_config.get_diff_sampling_param.return_value = {}
+    serving = OpenAIServingResponses(
+        engine_client=engine_client,
+        models=MagicMock(),
+        online_renderer=MagicMock(),
+        request_logger=None,
+        chat_template=None,
+        chat_template_content_format="auto",
+        **launch,
+    )
+    serving._check_model = AsyncMock(return_value=None)
+    serving.enable_store = enable_store
+    return serving, engine_client
+
+
+@pytest.mark.asyncio
+async def test_previous_response_id_on_a_server_that_stores_nothing_is_refused():
+    serving, engine = _stateless_serving(enable_store=False)
+    request = ResponsesRequest(
+        input="q", kv_scope="agent", previous_response_id="resp_unknown"
+    )
+    refused = await serving.create_responses(request)
+    assert isinstance(refused, ErrorResponse)
+    assert (refused.error.code, refused.error.param) == (400, "previous_response_id")
+    assert "stores no responses" in refused.error.message
+    assert "`input`" in refused.error.message
+    assert "VLLM_ENABLE_RESPONSES_API_STORE=1" in refused.error.message
+    engine.admit.assert_not_called()
+
+    missing = await serving.retrieve_responses("resp_unknown", None, False)
+    assert (missing.error.code, missing.error.param) == (404, "response_id")
+    assert "stores no responses" in missing.error.message
+
+
+@pytest.mark.asyncio
+async def test_an_unknown_previous_response_id_is_named_by_its_field():
+    serving, engine = _stateless_serving(enable_store=True)
+    request = ResponsesRequest(
+        input="q", kv_scope="agent", previous_response_id="resp_unknown"
+    )
+    assert serving._validate_create_responses_input(request) is None
+    missing = await serving.create_responses(request)
+    assert (missing.error.code, missing.error.param) == (404, "previous_response_id")
+    assert missing.error.message == "Response with id 'resp_unknown' not found."
+    engine.admit.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("runs_the_tool", [True, False])
+async def test_max_tool_calls_is_refused_where_built_in_calls_are_not_counted(
+    runs_the_tool,
+):
+    # max_tool_calls bounds the built-in tool calls a response processes; a
+    # server that runs one itself does not count them.
+    tool_server = MagicMock(spec=ToolServer)
+    tool_server.has_tool.return_value = runs_the_tool
+    serving, engine = _stateless_serving(
+        enable_store=False,
+        model_type="gpt_oss",
+        reasoning_parser="openai_gptoss",
+        tool_server=tool_server,
+    )
+    serving._make_request_with_harmony = MagicMock(
+        return_value=([], [tokens_input([1, 2, 3])])
+    )
+    engine.admit = AsyncMock(side_effect=RuntimeError("admitted"))
+    request = ResponsesRequest(
+        input="q",
+        kv_scope="agent",
+        max_tool_calls=1,
+        tools=[{"type": "web_search_preview"}],
+    )
+    if runs_the_tool:
+        with pytest.raises(VLLMValidationError) as refused:
+            await serving.create_responses(request)
+        assert refused.value.parameter == "max_tool_calls"
+        assert "Omit max_tool_calls" in str(refused.value)
+        engine.admit.assert_not_called()
+    else:
+        with pytest.raises(RuntimeError, match="admitted"):
+            await serving.create_responses(request)
