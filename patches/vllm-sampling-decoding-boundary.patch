diff --git a/tests/entrypoints/openai/test_beam_search_boundary.py b/tests/entrypoints/openai/test_beam_search_boundary.py
--- /dev/null
+++ b/tests/entrypoints/openai/test_beam_search_boundary.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Unsupported decoding is refused before rendering on either transport."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    BatchChatCompletionRequest,
+    ChatCompletionRequest,
+)
+from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+from vllm.entrypoints.serve.exception_handling.handlers.vllm_error import (
+    vllm_error_handler,
+)
+from vllm.exceptions import VLLMValidationError
+
+
+SURFACES = [
+    (ChatCompletionRequest, "/v1/chat/completions"),
+    (ChatCompletionRequest, "/v1/chat/completions/render"),
+    (CompletionRequest, "/v1/completions"),
+    (CompletionRequest, "/v1/completions/render"),
+    (BatchChatCompletionRequest, "/v1/chat/completions/batch"),
+]
+
+
+def payload(request_type, **kwargs):
+    if request_type is CompletionRequest:
+        prompt = {"prompt": "hello"}
+    elif request_type is BatchChatCompletionRequest:
+        prompt = {"messages": [[{"role": "user", "content": "hello"}]]}
+    else:
+        prompt = {"messages": [{"role": "user", "content": "hello"}]}
+    return {"model": "m", "kv_scope": "opaque agent", **prompt, **kwargs}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("request_type, path", SURFACES)
+@pytest.mark.parametrize("stream", [False, True])
+async def test_unsupported_beam_search_returns_the_same_boundary_error(
+    request_type, path, stream,
+):
+    with pytest.raises(VLLMValidationError, match="Beam search is not supported") as error:
+        request_type.model_validate(payload(request_type, use_beam_search=True, stream=stream))
+    assert error.value.parameter == "use_beam_search"
+    request = SimpleNamespace(
+        scope={"type": "http", "path": path}, state=SimpleNamespace(),
+        app=SimpleNamespace(state=SimpleNamespace(args=SimpleNamespace(log_error_stack=False))),
+    )
+    response = await vllm_error_handler(request, error.value)
+    body = json.loads(response.body)
+    assert response.status_code == 400
+    assert body["error"]["param"] == "use_beam_search"
+    assert "Beam search is not supported" in body["error"]["message"]
+    assert "kv_scope" not in body["error"]["message"]
+
+
+@pytest.mark.parametrize("request_type, _path", SURFACES)
+@pytest.mark.parametrize("explicit", [False, True])
+def test_supported_sampling_does_not_require_a_decoding_flag(request_type, _path, explicit):
+    kwargs = {"use_beam_search": False} if explicit else {}
+    request = request_type.model_validate(payload(request_type, **kwargs))
+    assert request.use_beam_search is False
+    restored = request_type.model_validate_json(request.model_dump_json())
+    assert restored.use_beam_search is False
+
+
+@pytest.mark.parametrize("request_type", [ChatCompletionRequest, CompletionRequest, BatchChatCompletionRequest])
+def test_request_schema_advertises_the_supported_decoding_value(request_type):
+    flag = request_type.model_json_schema()["properties"]["use_beam_search"]
+    assert flag["const"] is False
+    assert flag["default"] is False
