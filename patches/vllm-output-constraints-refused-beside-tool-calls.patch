+def output_constraint_beside_tool_calls(
+    constraint: str, *, none_choice: str, named_choice: str
+) -> VLLMValidationError:
+    """Refuse an output constraint in a request whose tool choice can call.
+
+    One generation is decoded under one grammar. A tool choice that lets the
+    model call a tool arms the tool-call grammar, which cannot also enforce an
+    output constraint, so serving both would mean dropping one of them without
+    the caller knowing. Every surface refuses the pair instead, naming its own
+    spelling of the constraint and of the choices that resolve it.
+    """
+    return VLLMValidationError(
+        f"{constraint} constrains the output, and the tool choice lets the "
+        "model call a tool. One generation is decoded under one grammar, and "
+        "the tool-call grammar a callable tool needs cannot also enforce an "
+        f"output constraint, so this server serves one or the other. Send "
+        f"{none_choice} to have the answer follow {constraint}, remove "
+        f"{constraint} to let the model call tools, or declare the answer as "
+        f"the parameters of a function and force that call with {named_choice}.",
+        parameter=constraint,
+    )
+
+
 def structured_outputs_from_response_format(
     structured_outputs: StructuredOutputsParams | None,
     response_format: AnyResponseFormat | None,
