+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""An output constraint and a tool choice that can call are refused together.
+
+One generation is decoded under one grammar. A tool choice that lets the model
+call arms the tool-call grammar, which cannot also enforce the caller's output
+constraint, so the pair is refused on every surface, naming the constraint as
+the caller spelled it. With tool_choice "none" the constraint is the request's
+only grammar and reaches the sampling parameters unchanged.
+"""
+
+import pytest
+
+from vllm.entrypoints.anthropic.protocol import AnthropicMessagesRequest
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+from vllm.exceptions import VLLMValidationError
+
+_CHAT_TOOL = {
+    "type": "function",
+    "function": {
+        "name": "get_weather",
+        "parameters": {"type": "object", "properties": {"city": {"type": "string"}}},
+    },
+}
+_RESPONSES_TOOL = {
+    "type": "function",
+    "name": "get_weather",
+    "parameters": {"type": "object", "properties": {"city": {"type": "string"}}},
+}
+_ANTHROPIC_TOOL = {
+    "name": "get_weather",
+    "input_schema": {"type": "object", "properties": {"city": {"type": "string"}}},
+}
+_SCHEMA = {"type": "object", "properties": {"answer": {"type": "string"}}}
+
+_CHAT_CONSTRAINTS = [
+    ("response_format", {"type": "json_object"}),
+    ("response_format", {"type": "json_schema", "json_schema": {"name": "a", "schema": _SCHEMA}}),
+    ("structured_outputs", {"json": _SCHEMA}),
+    ("structured_outputs", {"regex": "[a-z]+"}),
+    ("structured_outputs", {"choice": ["yes", "no"]}),
+    ("structured_outputs", {"grammar": "root ::= 'yes'"}),
+]
+_CHAT_CALLING_CHOICES = [
+    None,
+    "auto",
+    "required",
+    {"type": "function", "function": {"name": "get_weather"}},
+]
+
+
+def _chat(**fields):
+    return ChatCompletionRequest.model_validate(
+        {"model": "m", "messages": [{"role": "user", "content": "hi"}], **fields}
+    )
+
+
+@pytest.mark.parametrize("constraint,value", _CHAT_CONSTRAINTS)
+@pytest.mark.parametrize("tool_choice", _CHAT_CALLING_CHOICES)
+def test_chat_refuses_a_constraint_beside_a_callable_tool(constraint, value, tool_choice):
+    fields = {"tools": [_CHAT_TOOL], constraint: value}
+    if tool_choice is not None:
+        fields["tool_choice"] = tool_choice
+    with pytest.raises(VLLMValidationError) as refusal:
+        _chat(**fields)
+    assert refusal.value.parameter == constraint
+    assert 'tool_choice "none"' in str(refusal.value)
+
+
+@pytest.mark.parametrize("constraint,value", _CHAT_CONSTRAINTS)
+def test_chat_keeps_the_constraint_when_no_tool_can_be_called(constraint, value):
+    request = _chat(tools=[_CHAT_TOOL], tool_choice="none", **{constraint: value})
+    assert request.extract_structured_outputs() is not None
+    assert _chat(**{constraint: value}).extract_structured_outputs() is not None
+
+
+def test_chat_text_format_is_no_constraint():
+    request = _chat(tools=[_CHAT_TOOL], response_format={"type": "text"})
+    assert request.tool_choice == "auto"
+    assert request.extract_structured_outputs() is None
+
+
+_RESPONSES_CONSTRAINTS = [
+    ("text.format", {"text": {"format": {"type": "json_object"}}}),
+    ("text.format", {"text": {"format": {"type": "json_schema", "name": "a", "schema": _SCHEMA}}}),
+    ("structured_outputs", {"structured_outputs": {"regex": "[a-z]+"}}),
+]
+
+
+def _responses(**fields):
+    return ResponsesRequest.model_validate(
+        {"model": "m", "input": "hi", "kv_scope": "agent", **fields}
+    )
+
+
+@pytest.mark.parametrize("constraint,fields", _RESPONSES_CONSTRAINTS)
+@pytest.mark.parametrize(
+    "tool_choice", [None, "auto", "required", {"type": "function", "name": "get_weather"}]
+)
+def test_responses_refuses_a_constraint_beside_a_callable_tool(constraint, fields, tool_choice):
+    extra = {} if tool_choice is None else {"tool_choice": tool_choice}
+    with pytest.raises(VLLMValidationError) as refusal:
+        _responses(tools=[_RESPONSES_TOOL], **fields, **extra)
+    assert refusal.value.parameter == constraint
+
+
+@pytest.mark.parametrize("constraint,fields", _RESPONSES_CONSTRAINTS)
+def test_responses_keeps_the_constraint_when_no_tool_can_be_called(constraint, fields):
+    request = _responses(tools=[_RESPONSES_TOOL], tool_choice="none", **fields)
+    assert request.extract_structured_outputs() is not None
+    assert _responses(**fields).extract_structured_outputs() is not None
+
+
+def test_responses_text_format_text_is_no_constraint():
+    request = _responses(tools=[_RESPONSES_TOOL], text={"format": {"type": "text"}})
+    assert request.extract_structured_outputs() is None
+
+
+def _anthropic(**fields):
+    return AnthropicMessagesRequest.model_validate(
+        {
+            "model": "m",
+            "max_tokens": 16,
+            "kv_scope": "agent",
+            "messages": [{"role": "user", "content": "hi"}],
+            **fields,
+        }
+    )
+
+
+_FORMAT = {"format": {"type": "json_schema", "schema": _SCHEMA}}
+
+
+@pytest.mark.parametrize(
+    "tool_choice",
+    [None, {"type": "auto"}, {"type": "any"}, {"type": "tool", "name": "get_weather"}],
+)
+def test_anthropic_refuses_an_output_format_beside_a_callable_tool(tool_choice):
+    extra = {} if tool_choice is None else {"tool_choice": tool_choice}
+    with pytest.raises(VLLMValidationError) as refusal:
+        _anthropic(tools=[_ANTHROPIC_TOOL], output_config=_FORMAT, **extra)
+    assert refusal.value.parameter == "output_config.format"
+
+
+def test_anthropic_keeps_the_output_format_when_no_tool_can_be_called():
+    request = _anthropic(
+        tools=[_ANTHROPIC_TOOL], tool_choice={"type": "none"}, output_config=_FORMAT
+    )
+    assert request.output_config.format.json_schema == _SCHEMA
+
+
+def test_anthropic_refuses_an_output_format_without_a_schema():
+    with pytest.raises(VLLMValidationError) as refusal:
+        _anthropic(output_config={"format": {"type": "json_schema"}})
+    assert refusal.value.parameter == "output_config.format.schema"
