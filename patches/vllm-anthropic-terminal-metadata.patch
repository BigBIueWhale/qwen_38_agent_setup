+    @pytest.mark.asyncio
+    @pytest.mark.parametrize('finish', [None, 'abort', 'error', 'tool_calls'])
+    async def test_invalid_completion_cause_is_never_reported_as_success(self, finish):
+        from vllm.entrypoints.openai.engine.protocol import GenerationError
+
+        usage = UsageInfo(prompt_tokens=10, completion_tokens=1, total_tokens=11)
+        response = ChatCompletionResponse(
+            id='chatcmpl-invalid', model='test-model', usage=usage,
+            choices=[ChatCompletionResponseChoice(
+                index=0, finish_reason=finish,
+                message=ChatMessage(role='assistant', content='diagnostic'),
+            )],
+        )
+        with pytest.raises(GenerationError):
+            _make_full_converter().messages_full_converter(response)
+
+        async def source():
+            yield _make_stream_chunk(delta=DeltaMessage(content='diagnostic'))
+            yield _make_stream_chunk(finish_reason=finish)
+            yield _make_stream_chunk(choices=[], usage=usage)
