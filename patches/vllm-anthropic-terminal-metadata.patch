+
+    @pytest.mark.asyncio
+    @pytest.mark.parametrize('ending', ['missing_usage', 'missing_finish', 'missing_done',
+                                         'repeated_usage', 'content_after_finish',
+                                         'content_after_usage', 'invalid_frame'])
+    async def test_incomplete_or_invalid_stream_has_no_success_terminal(self, ending):
+        usage = UsageInfo(prompt_tokens=10, completion_tokens=1, total_tokens=11)
+
+        async def source():
+            yield _make_stream_chunk(delta=DeltaMessage(role='assistant', content='diagnostic'))
+            if ending != 'missing_finish':
+                yield _make_stream_chunk(finish_reason='stop')
+            if ending == 'content_after_finish':
+                yield _make_stream_chunk(delta=DeltaMessage(content='too late'))
+            if ending != 'missing_usage':
+                yield _make_stream_chunk(choices=[], usage=usage)
+            if ending == 'repeated_usage':
+                yield _make_stream_chunk(choices=[], usage=usage)
+            if ending == 'content_after_usage':
+                yield _make_stream_chunk(delta=DeltaMessage(content='too late'))
+            if ending == 'invalid_frame':
+                yield 'invalid chat frame'
+            if ending != 'missing_done':
+                yield 'data: [DONE]'
+
+        events = _parse_sse_events([
+            item async for item in _make_stream_converter().message_stream_converter(source())
+        ])
+        assert events[-1][0] == 'error'
+        assert not any(kind == 'message_stop' for kind, _ in events)
+        assert any(data.get('delta', {}).get('text') == 'diagnostic' for _, data in events)
+        assert not any(data.get('delta', {}).get('text') == 'too late' for _, data in events)
