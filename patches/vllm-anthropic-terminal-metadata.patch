+class TestAnthropicTerminalMetadata:
+    @pytest.mark.asyncio
+    @pytest.mark.parametrize(
+        'finish, stop, tool, expected, sequence',
+        [
+            ('stop', None, False, 'end_turn', None),
+            ('stop', 151645, False, 'end_turn', None),
+            ('stop', '\n HALT \n', False, 'stop_sequence', '\n HALT \n'),
+            ('stop', None, True, 'tool_use', None),
+            ('stop', 151645, True, 'tool_use', None),
+            ('tool_calls', None, True, 'tool_use', None),
+            ('stop', 'HALT', True, 'stop_sequence', 'HALT'),
+            ('length', None, False, 'max_tokens', None),
+            ('length', None, True, 'max_tokens', None),
+            ('length', 'final_response_token_budget', True, 'max_tokens', None),
+        ],
+    )
+    async def test_stream_and_batch_report_observed_cause(
+        self, finish, stop, tool, expected, sequence,
+    ):
+        usage = UsageInfo(prompt_tokens=10, completion_tokens=5, total_tokens=15)
+        tool_calls = ([{
+            'id': 'call-terminal', 'type': 'function',
+            'function': {'name': 'lookup', 'arguments': '{"key":"value"}'},
+        }] if tool else [])
+        response = ChatCompletionResponse(
+            id='chatcmpl-terminal', model='test-model', usage=usage,
+            choices=[ChatCompletionResponseChoice(
+                index=0, finish_reason=finish, stop_reason=stop,
+                message=ChatMessage(role='assistant', content='visible',
+                                    tool_calls=tool_calls),
+            )],
+        )
+        batch = _make_full_converter().messages_full_converter(response)
+        assert (batch.stop_reason, batch.stop_sequence) == (expected, sequence)
+        assert [block.type for block in batch.content] == (
+            ['text', 'tool_use'] if tool else ['text']
+        )
+        assert batch.content[0].text == 'visible'
+        if tool:
+            assert batch.content[1].id == 'call-terminal'
+            assert batch.content[1].input == {'key': 'value'}
+
+        async def source():
+            # The first chunk is allowed to contain content alongside the role.
+            yield _make_stream_chunk(delta=DeltaMessage(role='assistant', content='visible'))
+            if tool:
+                yield _make_stream_chunk(delta=DeltaMessage(tool_calls=[
+                    _tc(id='call-terminal', name='lookup', args='{"key":'),
+                ]))
+                yield _make_stream_chunk(delta=DeltaMessage(tool_calls=[
+                    _tc(args='"value"}'),
+                ]))
+            yield _make_stream_chunk(finish_reason=finish, stop_reason=stop)
+            yield _make_stream_chunk(choices=[], usage=usage)
+            yield 'data: [DONE]'
+
+        events = _parse_sse_events([
+            item async for item in _make_stream_converter().message_stream_converter(source())
+        ])
+        assert not any(kind == 'error' for kind, _ in events)
+        assert [kind for kind, _ in events][-2:] == ['message_delta', 'message_stop']
+        terminal = next(data for kind, data in events if kind == 'message_delta')
+        assert terminal['delta'] == {
+            'stop_reason': expected, 'stop_sequence': sequence,
+        }
+        assert terminal['usage'] == batch.usage.model_dump(exclude_unset=True)
+        starts = [data['content_block'] for kind, data in events
+                  if kind == 'content_block_start']
+        assert [block['type'] for block in starts] == [block.type for block in batch.content]
+        text = ''.join(data['delta']['text'] for kind, data in events
+                       if kind == 'content_block_delta' and data['delta']['type'] == 'text_delta')
+        assert text == batch.content[0].text
+        if tool:
+            assert starts[1]['id'] == batch.content[1].id
+            args = ''.join(data['delta']['partial_json'] for kind, data in events
+                           if kind == 'content_block_delta'
+                           and data['delta']['type'] == 'input_json_delta')
+            assert json.loads(args) == batch.content[1].input
