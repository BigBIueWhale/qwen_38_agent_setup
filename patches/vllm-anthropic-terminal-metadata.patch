+def _anthropic_stop_metadata(
+    finish_reason: str | None,
+    stop_reason: str | int | None,
+    has_tool_use: bool,
+) -> AnthropicDelta:
+    """Translate the observed completion cause and output into native fields."""
+    if finish_reason == "length":
+        return AnthropicDelta(stop_reason="max_tokens", stop_sequence=None)
+    if finish_reason not in ("stop", "tool_calls"):
+        raise GenerationError(f"Chat generation ended with {finish_reason!r}")
+    if isinstance(stop_reason, str):
+        return AnthropicDelta(stop_reason="stop_sequence", stop_sequence=stop_reason)
+    if finish_reason == "tool_calls" and not has_tool_use:
+        raise GenerationError("Chat reported tool calls without tool-use output")
+    return AnthropicDelta(
+        stop_reason="tool_use" if has_tool_use else "end_turn", stop_sequence=None,
+    )
 
 
