+@pytest.mark.parametrize("chunk_size", [1, 13, 1000])
+@pytest.mark.parametrize("choice", ["auto", "required"])
+@pytest.mark.parametrize("value", ["HALT", "</tool_call> HALT <tool_call>", "λ HALT"])
+def test_structural_text_stop_keeps_the_call(chunk_size, choice, value):
+    from unittest.mock import MagicMock
+    from vllm.v1.engine.detokenizer import BaseIncrementalDetokenizer
+    from vllm.v1.structured_output.stop_checker import StructuralTagStopChecker
+
+    request = _tag_request(stop=["HALT"], choice=choice)
+    body = CALL.format(value)
+    output = body + (" after HALT discarded" if choice == "auto" else "")
+    pieces = [output[i:i + chunk_size] for i in range(0, len(output), chunk_size)]
+
+    class TextDetokenizer(BaseIncrementalDetokenizer):
+        def decode_next(self, token):
+            return pieces[token]
+
+    detok = TextDetokenizer(request)
+    detok.stop_checker = StructuralTagStopChecker(MagicMock(), request, None)
+    reason = None
+    for token in range(len(pieces)):
+        reason = detok.update([token], False)
+        if reason:
+            break
+    assert reason == ("HALT" if choice == "auto" else None)
+    assert detok.get_next_output_text(True, False) == (
+        body + " after " if choice == "auto" else body
+    )
