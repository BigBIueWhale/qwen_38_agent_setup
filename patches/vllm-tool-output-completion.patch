+async def test_served_call_requires_eos_and_observed_closing_wrapper(
+    monkeypatch, stream, chunk_size, body, finish_reason, stop_reason, promoted,
+    tool_choice,
+):
+    """A stochastic cut or caller stop must not publish an executable call.
+
+    Run the real serving generators and deployment parser with controlled model
+    output. The complete encoded stream proves the same outcome for batch and
+    both small-chunk streams; no model, transport or listener is involved.
+    """
+    ids = _encode("plan</think>" + body)
+    request = ChatCompletionRequest(
+        model="unit", messages=[{"role": "user", "content": "write"}],
+        tools=TOOLS, tool_choice=tool_choice, stream=stream, kv_scope="unit",
+    )
+    tokenizer = MagicMock()
+    tokenizer.get_vocab.return_value = MARKERS
+    tokenizer.all_special_tokens = list(MARKERS)
+    tokenizer.all_special_ids = list(MARKERS.values())
+    tokenizer.decode.side_effect = _decode
+
+    async def outputs():
+        size = chunk_size or len(ids)
+        for start in range(0, len(ids), size):
+            group = ids[start:start + size]
+            last = start + size >= len(ids)
+            yield RequestOutput(
+                request_id="unit", prompt="prompt", prompt_token_ids=[1, 2, 3],
+                prompt_logprobs=None, outputs=[CompletionOutput(
+                    index=0, text=_decode(group), token_ids=group,
+                    cumulative_logprob=None, logprobs=None,
+                    finish_reason=finish_reason if last else None,
+                    stop_reason=stop_reason if last else None,
+                )], finished=last,
+            )
+
+    kwargs = dict(
+        request=request, result_generator=outputs(), request_id="chatcmpl-unit",
+        model_name="unit", conversation=[{"role": "user", "content": "write"}],
+        tokenizer=tokenizer, request_metadata=RequestResponseMetadata(request_id="unit"),
+    )
+    serving = _serving()
+    if not stream:
+        kwargs["parser"] = serving.parser_cls(tokenizer, request.tools)
+        response = await serving.chat_completion_full_generator(**kwargs)
+        choice = response.choices[0]
+        calls = choice.message.tool_calls or []
+        content = choice.message.content or ""
+        reasoning = choice.message.reasoning or ""
+        terminal, actual_stop = choice.finish_reason, choice.stop_reason
+    else:
+        calls, contents, reasonings, terminals = [], [], [], []
+        async for event in serving.chat_completion_stream_generator(**kwargs):
+            if not event.startswith("data: ") or event.strip() == "data: [DONE]":
+                continue
+            payload = json.loads(event[6:])
+            assert "error" not in payload, payload
+            for choice in payload.get("choices", []):
+                delta = choice["delta"]
+                calls.extend(delta.get("tool_calls") or [])
+                contents.append(delta.get("content") or "")
+                reasonings.append(delta.get("reasoning") or "")
+                if choice.get("finish_reason"):
+                    terminals.append((choice["finish_reason"], choice.get("stop_reason")))
+        assert len(terminals) == 1
+        terminal, actual_stop = terminals[0]
+        content, reasoning = "".join(contents), "".join(reasonings)
+
+    assert reasoning == "plan"
+    assert actual_stop == stop_reason
+    assert terminal == ("tool_calls" if promoted and isinstance(tool_choice, str) else finish_reason)
+    if promoted:
+        assert calls
+        if "<function= write >" in body:
+            name = calls[0]["function"]["name"] if stream else calls[0].function.name
+            assert name == " write "
+        if body.endswith("after"):
+            assert content == "before  after"
+        elif body.endswith("cut"):
+            assert len(calls) == 1
+            assert content == "<tool_call>\n<function=write>\n<parameter=text>cut"
+    else:
+        assert calls == []
+        assert content == body
+
