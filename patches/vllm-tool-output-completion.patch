+def test_structural_stop_tokens_remain_valid_values_and_resume_in_text():
+    import xgrammar as xgr
+    from vllm.v1.core.sched.scheduler import Scheduler
+    from vllm.v1.request import Request, RequestStatus
+    from vllm.v1.structured_output import StructuredOutputManager
+
+    engine_request = _tag_request(stop_token_ids=[ord("X")])
+    request = Request.from_engine_core_request(engine_request, block_hasher=None)
+    vocabulary = [chr(i) for i in range(128)] + ["<eos>", "<eos2>"]
+    backend = XgrammarBackend.__new__(XgrammarBackend)
+    backend.compiler = xgr.GrammarCompiler(
+        xgr.TokenizerInfo(vocabulary, stop_token_ids=[128]), max_threads=1
+    )
+    backend.vocab_size = len(vocabulary)
+    backend.num_speculative_tokens = 0
+    backend.disable_any_whitespace = False
+    manager = StructuredOutputManager.__new__(StructuredOutputManager)
+    manager.backend = backend
+    manager.reasoner_cls = None
+    grammar = manager._create_grammar(request)
+    request.structured_output_request.grammar = grammar
+    request.status = RequestStatus.RUNNING
+    scheduler = Scheduler.__new__(Scheduler)
+    scheduler.structured_output_manager = manager
+    scheduler.max_model_len = 4096
+
+    for char in CALL.format("X </tool_call> X"):
+        bitmask = backend.allocate_token_bitmask(1)
+        grammar.fill_bitmask(bitmask, 0)
+        assert _token_allowed(bitmask[0], ord(char)), char
+        tokens, stopped = scheduler._update_request_with_output(request, [ord(char)])
+        assert not stopped, char
+        assert grammar.accept_tokens(request.request_id, tokens)
+    assert request.stop_reason is None
+    _, stopped = scheduler._update_request_with_output(request, [ord("X")])
+    assert stopped
+    assert request.stop_reason == ord("X")
