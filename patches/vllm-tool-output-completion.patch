+    request = ChatCompletionRequest(messages=[], tools=[{
+        'type': 'function', 'function': {'name': 'write', 'parameters': {
+            'type': 'object', 'properties': {'text': {'type': 'string'}},
+        }},
+    }])
+    choice = renderer._derender_chat(incoming, request)[0]
+    executable = closed and finish == 'stop' and stop is None
