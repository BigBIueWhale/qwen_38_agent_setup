+def _tag_request(*, stop=None, stop_token_ids=None, thinking=False, choice="auto"):
+    from vllm import SamplingParams
+    from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+    from vllm.sampling_params import StructuredOutputsParams
+    from vllm.tool_parsers.structural_tag_registry import get_model_structural_tag
+    from vllm.v1.engine import EngineCoreRequest
+
+    api_request = ChatCompletionRequest(messages=[], tools=[{
+        "type": "function", "function": {
+            "name": "write", "parameters": {
+                "type": "object", "properties": {"text": {"type": "string"}},
+                "required": ["text"],
+            },
+        },
+    }])
+    tag = get_model_structural_tag("qwen_3_coder", api_request.tools, choice, False)
+    params = SamplingParams(
+        stop=stop, stop_token_ids=stop_token_ids,
+        structured_outputs=StructuredOutputsParams(structural_tag=tag.model_dump_json()),
+        extra_args={"kv_scope": "stop-test"}, max_tokens=2048,
+    )
+    params.update_from_generation_config({"eos_token_id": [128, 129]}, 128)
+    params.structured_outputs._backend = "xgrammar"
+    return EngineCoreRequest(
+        request_id="stop-test", prompt_token_ids=[], mm_features=None,
+        sampling_params=params, pooling_params=None, arrival_time=0,
+        lora_request=None, cache_salt=None, data_parallel_rank=None,
+        external_req_id="stop-test", reasoning_ended=not thinking,
+    )
+
+
+CALL = (
+    "<tool_call>\n<function=write>\n<parameter=text>{}</parameter>"
+    "\n</function>\n</tool_call>"
+)
