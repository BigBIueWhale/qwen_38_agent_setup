+    body = '<tool_call>\n<function=write>\n<parameter=text>kept</parameter>\n</function>'
+    if closed:
+        body += '\n</tool_call>'
+    ids = [20000, 20001] + list(map(ord, body[len('<tool_call>'):]))
+    if closed:
+        ids = ids[:-len('</tool_call>')] + [20002]
+    renderer = object.__new__(OnlineDerenderer)
+    renderer.parser = ParserManager.get_parser(
+        tool_parser_name='qwen3_coder', reasoning_parser_name='qwen3',
