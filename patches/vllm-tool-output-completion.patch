+    ("\nextra</tool_call>", False), ("\n\n</tool_call>", False),
+])
+def test_call_closer_matches_the_native_grammar(suffix, accepted):
+    import xgrammar as xgr
+    from vllm.tool_parsers.structural_tag_registry import get_model_structural_tag
+
+    request = ChatCompletionRequest(messages=[], tools=TOOLS)
+    tag = get_model_structural_tag("qwen_3_coder", request.tools, "auto", False)
+    vocabulary = [chr(i) for i in range(128)] + ["<eos>"]
+    info = xgr.TokenizerInfo(vocabulary, stop_token_ids=[128])
+    grammar = xgr.GrammarCompiler(info, max_threads=1).compile_structural_tag(tag)
+    matcher = xgr.GrammarMatcher(grammar)
+    body = (
+        "<tool_call>\n<function=write>\n<parameter=text>kept</parameter>"
+        "\n</function>" + suffix
+    )
+    assert (matcher.accept_string(body) and matcher.accept_token(128)) is accepted
