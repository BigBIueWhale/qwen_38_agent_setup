new file mode 100644
--- /dev/null
+++ b/vllm/v1/structured_output/stop_checker.py
@@ -0,0 +1,92 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Keep text stop controls outside the request's native structural grammar."""
+
+from functools import lru_cache
+
+import xgrammar as xgr
+
+from vllm.config import StructuredOutputsConfig
+from vllm.reasoning import ReasoningParserManager
+from vllm.tokenizers import TokenizerLike
+from vllm.v1.engine import EngineCoreRequest
+from vllm.v1.structured_output.backend_xgrammar import compile_structural_tag
+
+
+@lru_cache(maxsize=128)
+def _compile_text_grammar(spec: str) -> xgr.CompiledGrammar:
+    # This matcher consumes decoded text; token masking stays in the engine.
+    compiler = xgr.GrammarCompiler(xgr.TokenizerInfo([]), max_threads=1)
+    return compile_structural_tag(compiler, spec)
+
+
+class StructuralTagStopChecker:
+    """Record characters consumed while a structural tag is armed.
+
+    The native grammar decides the boundaries, including literal markup in
+    values and triggers split across tokens. Stop matches that overlap these
+    characters cannot remove any part of a call.
+    """
+
+    def __init__(
+        self,
+        tokenizer: TokenizerLike,
+        request: EngineCoreRequest,
+        config: StructuredOutputsConfig | None,
+    ):
+        params = request.sampling_params
+        assert params is not None and params.structured_outputs is not None
+        spec = params.structured_outputs.structural_tag
+        assert spec is not None
+        self.matcher = xgr.GrammarMatcher(_compile_text_grammar(spec))
+        self.protected_spans: list[tuple[int, int]] = []
+        self.offset = 0
+        self.eos_token_ids = params.eos_token_ids
+        self.reasoner = None
+        self.reasoning_ended = request.reasoning_ended
+        self.reasoning_ids = list(request.prompt_token_ids or ())
+        if config and config.reasoning_parser and not config.enable_in_reasoning:
+            cls = ReasoningParserManager.get_reasoning_parser(config.reasoning_parser)
+            self.reasoner = cls(
+                tokenizer=tokenizer, **(request.reasoning_parser_kwargs or {})
+            )
+            if self.reasoning_ended is None:
+                self.reasoning_ended = self.reasoner.is_reasoning_end(self.reasoning_ids)
+        else:
+            self.reasoning_ended = True
+
+    def feed(self, text: str, token_id: int) -> None:
+        start = self.offset
+        self.offset += len(text)
+        if token_id in self.eos_token_ids:
+            return
+        if not self.reasoning_ended:
+            assert self.reasoner is not None
+            self.reasoning_ids.append(token_id)
+            if not self.reasoner.is_reasoning_end_streaming(
+                self.reasoning_ids, [token_id]
+            ):
+                return
+            self.reasoning_ended = True
+            content_ids = self.reasoner.extract_content_ids(self.reasoning_ids)
+            self.reasoning_ids.clear()
+            if not content_ids or content_ids[-1] != token_id:
+                return
+
+        complete = self.matcher.is_completed()
+        for index, char in enumerate(text, start):
+            if not self.matcher.accept_string(char):
+                raise RuntimeError("Decoded output violates the structural-tag grammar")
+            next_complete = self.matcher.is_completed()
+            if not complete or not next_complete:
+                spans = self.protected_spans
+                if spans and spans[-1][1] == index:
+                    spans[-1] = (spans[-1][0], index + 1)
+                else:
+                    spans.append((index, index + 1))
+            complete = next_complete
+
+    def discard_before(self, offset: int) -> None:
+        self.protected_spans = [
+            span for span in self.protected_spans if span[1] > offset
+        ]
