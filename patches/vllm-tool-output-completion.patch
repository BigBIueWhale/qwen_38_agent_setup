+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 13, 1000])
+@pytest.mark.parametrize("boundary", ["", "plan</think>", "plan"])
+@pytest.mark.parametrize("include_stop", [False, True])
+def test_structural_stop_through_qwen_output_processor(
+    local_qwen_tokenizer, stream, chunk_size, boundary, include_stop
+):
+    from vllm.sampling_params import RequestOutputKind
+    from vllm.v1.engine import EngineCoreOutput, FinishReason
+    from vllm.v1.engine.output_processor import OutputProcessor
+
+    tokenizer = local_qwen_tokenizer
+    request = _tag_request(stop=["HALT"], thinking=bool(boundary))
+    params = request.sampling_params
+    params.output_kind = RequestOutputKind.DELTA if stream else RequestOutputKind.FINAL_ONLY
+    params.include_stop_str_in_output = include_stop
+    params.update_from_generation_config({"eos_token_id": [248046, 248044]}, 248046)
+    request.prompt_token_ids = tokenizer.encode("<think>" if boundary else "</think>")
+    body = CALL.format("λ HALT </tool_call> HALT <think>")
+    text = boundary + body + " after HALT discarded"
+    ids = tokenizer.encode(text, add_special_tokens=False) + [248046]
+    processor = OutputProcessor(
+        tokenizer, log_stats=False,
+        structured_outputs_config=StructuredOutputsConfig(reasoning_parser="qwen3"),
+    )
+    processor.add_request(request, prompt=None)
+    outputs = []
+    delivered_ids = []
+    for start in range(0, len(ids), chunk_size):
+        chunk = ids[start:start + chunk_size]
+        delivered_ids.extend(chunk)
+        done = start + chunk_size >= len(ids)
+        result = processor.process_outputs([EngineCoreOutput(
+            request_id=request.request_id, new_token_ids=chunk,
+            finish_reason=FinishReason.STOP if done else None,
+        )])
+        outputs.extend(result.request_outputs)
+        if result.reqs_to_abort:
+            assert result.reqs_to_abort == [request.request_id]
+            break
+    assert outputs[-1].finished
+    assert outputs[-1].outputs[0].finish_reason == "stop"
+    assert outputs[-1].outputs[0].stop_reason == "HALT"
+    actual_text = "".join(out.outputs[0].text for out in outputs)
+    assert actual_text == boundary + body + " after " + ("HALT" if include_stop else "")
+    actual_ids = [token for out in outputs for token in out.outputs[0].token_ids]
+    assert actual_ids == delivered_ids
+
