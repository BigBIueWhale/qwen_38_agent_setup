+    generation = ReqContext('generation', kv_scope='agent',
+                            prefix_content={b'end': (b'first', b'end')})
+    m.begin_lookup(generation)
+    assert m.lookup(b'end', generation) is LookupResult.HIT
+    assert m.prefix_cache.view('agent').keys is None
+    m.retain_context([b'end'], generation)
+    assert m.prefix_cache.view('agent').keys == frozenset({b'first', b'end'})
