+def window_context(agent, available=None, required=None):
+    key = b'end'
+    content = (b'early', b'middle', key)
+    ctx = ReqContext(agent, kv_scope=agent, prefix_content={key: content})
+    if available is not None:
+        ctx.prefix_store[key] = available
+    ctx.prefix_required[key] = content if required is None else required
+    return ctx
+
