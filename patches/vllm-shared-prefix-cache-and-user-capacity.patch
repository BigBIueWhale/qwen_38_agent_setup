+++ b/tests/v1/core/test_prefix_cache.py
@@ -0,0 +1,370 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import pytest
+
+from vllm.v1.core.prefix_cache import PrefixCacheIndex
+
+
+def test_first_acquisition_then_own_cache_and_extensions():
+    index = PrefixCacheIndex()
+    index.register_tier('CPU', 16)
+    index.register_tier('GPU', 16)
+    for key in [b'prefix', b'writer-tail']:
+        index.insert('CPU', key, (key,))
+        index.acquire('CPU', 'writer', [key])
+    first_lookup = index.view('new-agent')
+    assert first_lookup.permits(b'prefix')
+    assert first_lookup.permits(b'writer-tail')
+    index.acquire('CPU', 'new-agent', [b'prefix'])
+    own_lookup = index.view('new-agent')
+    assert own_lookup.permits(b'prefix')
+    assert not own_lookup.permits(b'writer-tail')
+    index.insert('GPU', b'own-extension', (b'own-extension',))
+    index.acquire('GPU', 'new-agent', [b'own-extension'])
+    assert index.view('new-agent').permits(b'own-extension')
+    assert not index.view('new-agent').permits(b'writer-tail')
+
+
+@pytest.mark.parametrize('first,second', [('GPU', 'CPU'), ('CPU', 'GPU')])
+def test_own_cache_in_either_tier_prevents_another_initial_acquisition(first, second):
+    index = PrefixCacheIndex()
+    index.register_tier('CPU', 16)
+    index.register_tier('GPU', 16)
+    index.insert(first, b'own', (b'own',))
+    index.acquire(first, 'agent', [b'own'])
+    index.insert(second, b'another', (b'another',))
+    index.acquire(second, 'another-agent', [b'another'])
+    assert index.view('agent').permits(b'own')
+    assert not index.view('agent').permits(b'another')
+
+
+def test_releasing_one_agent_keeps_another_agents_shared_cache():
+    index = PrefixCacheIndex()
+    index.register_tier('CPU', 16)
+    index.register_tier('GPU', 16)
+    index.insert('CPU', b'shared', (b'shared',))
+    for agent in ['first', 'second']:
+        index.acquire('CPU', agent, [b'shared'])
+    index.release_agent('CPU', 'first')
+    assert index.view('first').keys is None
+    assert index.view('second').keys == frozenset({b'shared'})
+
+
+def test_tier_eviction_preserves_membership_in_another_tier():
+    index = PrefixCacheIndex()
+    index.register_tier('CPU', 16)
+    index.register_tier('GPU', 16)
+    for tier in ['CPU', 'GPU']:
