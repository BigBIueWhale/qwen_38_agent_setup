new file mode 100644
--- /dev/null
+++ b/vllm/v1/core/prefix_cache.py
@@ -0,0 +1,256 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Cache membership shared by the scheduler's physical KV tiers.
+
+Keys describe KV content, including its cache group. Agent IDs are opaque.
+An agent with no resident membership can acquire an initial shared prefix;
+subsequent matching uses the content it acquired or computed itself.
+"""
+
+from collections import OrderedDict
+from collections.abc import Callable, Collection, Hashable, Mapping
+from dataclasses import dataclass, field
+
+
+def cache_content_keys(
+    block_hashes: Collection[bytes],
+    group_id: int,
+) -> tuple[bytes, ...]:
+    """Name the hash-sized data units (or recurrent states) in a cache entry."""
+    suffix = group_id.to_bytes(4, "big")
+    return tuple(block_hash + suffix for block_hash in block_hashes)
+
+
+@dataclass(frozen=True, slots=True)
+class PrefixCacheView:
+    """A stable membership view for one complete prefix lookup."""
+
+    keys: frozenset[bytes] | None
+
+    def permits(self, key: bytes) -> bool:
+        return self.keys is None or key in self.keys
+
+    def allows(self, content: Collection[bytes]) -> bool:
+        return self.keys is None or self.keys.issuperset(content)
+
+
+@dataclass(slots=True)
+class ResidentPrefix:
+    # Storage-to-storage transfers may arrive before a generation request
+    # supplies the hash chain describing their contained data.
+    content: tuple[bytes, ...] | None
+    copies: int = 1
+    # None means the complete entry. Only a shortened selection needs a set.
+    agents: dict[str, frozenset[bytes] | None] = field(default_factory=dict)
+
+
+@dataclass(slots=True)
+class PrefixCacheTier:
+    capacity: int
+    on_release: Callable[[str], None]
+    entries: dict[bytes, ResidentPrefix] = field(default_factory=dict)
+    agents: OrderedDict[str, set[bytes]] = field(default_factory=OrderedDict)
+    references: int = 0
+
+
+class PrefixCacheIndex:
+    """Track acquired content while any of its physical tier copies exists.
+
+    A view is read-only. Looking up candidate blocks never acquires them;
+    acquisition follows selection of a usable prefix, or computation of new
+    KV. This prevents an early group hit from changing the remaining lookup.
+    """
+
+    def __init__(self) -> None:
+        self._tiers: dict[Hashable, PrefixCacheTier] = {}
+        self._owned: dict[str, int] = {}
+
+    def register_tier(
+        self, tier: Hashable, capacity: int,
+        on_release: Callable[[str], None] = lambda _agent: None,
+    ) -> None:
+        """Bound cached agent records by the tier's cache-entry capacity."""
+        assert tier not in self._tiers and capacity >= 0
+        self._tiers[tier] = PrefixCacheTier(capacity, on_release)
+
+    def set_capacity(self, tier: Hashable, capacity: int) -> None:
+        state = self._tiers[tier]
+        state.capacity = capacity
+        self._make_room(tier, None)
+
+    def _make_room(
+        self, tier: Hashable, acquiring: str | None,
+    ) -> None:
+        state = self._tiers[tier]
+        added = int(acquiring is not None and acquiring not in state.agents)
+        for agent_id in tuple(state.agents):
+            if len(state.agents) + added <= state.capacity:
+                return
+            if agent_id != acquiring:
+                self.release_agent(tier, agent_id)
+        assert len(state.agents) + added <= state.capacity
+
+    def view(self, agent_id: str) -> PrefixCacheView:
+        if agent_id not in self._owned:
+            return PrefixCacheView(None)
+        owned: set[bytes] = set()
+        for state in self._tiers.values():
+            for key in state.agents.get(agent_id, ()):
+                entry = state.entries[key]
+                assert entry.content is not None
+                selected = entry.agents[agent_id]
+                owned.update(entry.content if selected is None else selected)
+        assert owned
+        return PrefixCacheView(frozenset(owned))
+
+    def content(self, tier: Hashable, key: bytes) -> tuple[bytes, ...]:
+        content = self._tiers[tier].entries[key].content
+        assert content is not None
+        return content
+
+    def describe(self, tier: Hashable, key: bytes, content: tuple[bytes, ...]) -> None:
+        entry = self._tiers[tier].entries[key]
+        assert content and key in content and len(content) == len(set(content))
+        assert entry.content is None or entry.content == content
+        entry.content = content
+
+    def extend_content(
+        self, tier: Hashable, key: bytes, content: tuple[bytes, ...],
+    ) -> None:
+        """Publish a filled CPU chunk without expanding its existing users."""
+        entry = self._tiers[tier].entries[key]
+        previous = entry.content
+        assert previous is not None and entry.copies == 1
+        assert set(previous).issubset(content)
+        if previous == content:
+            return
+        acquired = frozenset(previous)
+        for agent_id, selected in entry.agents.items():
+            if selected is None:
+                entry.agents[agent_id] = acquired
+        entry.content = content
+
+    def insert(
+        self, tier: Hashable, key: bytes, content: tuple[bytes, ...] | None
+    ) -> None:
+        entries = self._tiers[tier].entries
+        entry = entries.get(key)
+        if entry is None:
+            entries[key] = ResidentPrefix(None)
+        else:
+            entry.copies += 1
+        if content is not None:
+            self.describe(tier, key, content)
+
+    def acquire(
+        self, tier: Hashable, agent_id: str, keys: Collection[bytes],
+        selection: Mapping[bytes, Collection[bytes]] | None = None,
+    ) -> None:
+        state = self._tiers[tier]
+        entries = state.entries
+        if not keys:
+            return
+        added = set(keys) - state.agents.get(agent_id, set())
+        assert added <= entries.keys()
+        self._make_room(tier, agent_id)
+        for key in set(keys):
+            entry = entries[key]
+            assert entry.content is not None
+            if selection is None:
+                entry.agents[agent_id] = None
+            else:
+                selected = frozenset(selection[key])
+                assert selected and selected.issubset(entry.content)
+                if agent_id in entry.agents:
+                    previous = entry.agents[agent_id]
+                    if previous is None:
+                        continue
+                    selected |= previous
+                entry.agents[agent_id] = (
+                    None if len(selected) == len(entry.content) else selected
+                )
+        if keys:
+            state.agents.setdefault(agent_id, set()).update(added)
+            state.agents.move_to_end(agent_id)
+        state.references += len(added)
+        self._owned[agent_id] = self._owned.get(agent_id, 0) + len(added)
+
+    def _release(self, agent_id: str) -> None:
+        self._owned[agent_id] -= 1
+        if not self._owned[agent_id]:
+            del self._owned[agent_id]
+
+    def remove(self, tier: Hashable, key: bytes) -> None:
+        state = self._tiers[tier]
+        entries = state.entries
+        entry = entries[key]
+        entry.copies -= 1
+        if entry.copies:
+            return
+        for agent_id in entry.agents:
+            self._release(agent_id)
+            state.agents[agent_id].remove(key)
+            if not state.agents[agent_id]:
+                del state.agents[agent_id]
+        state.references -= len(entry.agents)
