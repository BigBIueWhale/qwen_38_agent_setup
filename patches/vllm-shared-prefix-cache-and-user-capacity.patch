+def test_physical_copy_to_cpu_keeps_every_users_selected_content():
+    from vllm.v1.core.block_pool import BlockPool
+    from types import SimpleNamespace
+
+    gpu, writer, blocks = make_gpu_cache()
+    reader = SimpleNamespace(kv_scope='reader', block_hashes=writer.block_hashes)
+    gpu.acquire_cached_blocks(reader, ([blocks[0]],), 16)
+    cpu = BlockPool(8, enable_caching=True, hash_block_size=16)
+    cpu.bind_prefix_cache(gpu.prefix_cache)
+    copy = cpu.get_new_blocks(1)[0]
+    key = blocks[0].block_hash
+    # A transfer stamps metadata before completion makes it discoverable.
+    copy.set_block_hash(key, num_tokens=16)
+    cpu._insert_block_hash(key, copy, 16, gpu.prefix_cache.content(gpu.cache_tier, key))
+    gpu.prefix_cache.copy_membership(gpu.cache_tier, cpu.cache_tier, key)
+    gpu._maybe_evict_cached_block(blocks[0])
+    for agent in ['writer', 'reader']:
+        view = gpu.prefix_cache.view(agent)
+        assert view.keys is not None
+        assert cpu.get_cached_block(b'prefix', [0], view) == [copy]
+
