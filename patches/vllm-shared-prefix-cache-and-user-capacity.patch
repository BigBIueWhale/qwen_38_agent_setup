+@pytest.mark.parametrize('is_recurrent', [False, True])
+def test_coalesced_cpu_chunk_describes_exactly_its_contained_gpu_data(is_recurrent):
+    """An attention span contains sub-blocks; a checkpoint contains one state."""
+    from types import SimpleNamespace
+    from vllm.v1.core.block_pool import BlockPool
+    from vllm.v1.core.prefix_cache import cache_content_keys
+    from vllm.v1.kv_offload.base import LookupResult, ReqContext
+    from vllm.v1.kv_offload.cpu.manager import CPUOffloadingManager
+
+    pool = BlockPool(16, enable_caching=True, hash_block_size=4)
+    hashes = [bytes([i]) for i in range(1, 13)]
+    request = SimpleNamespace(kv_scope='producer', block_hashes=hashes)
+    blocks = pool.get_new_blocks(6)
+    pool.cache_full_blocks(request, blocks, 0, 6, 8, 0, is_recurrent=is_recurrent)
+    manager = CPUOffloadingManager(4)
+    manager.bind_prefix_cache(pool.prefix_cache)
+    # This chunk spans tokens 16..32: it does not include tokens 0..16.
+    content = cache_content_keys(hashes[5:8:2] if is_recurrent else hashes[4:8], 0)
+    key = content[-1]
+    ctx = ReqContext('store', kv_scope='cpu-agent', prefix_content={key: content})
+    output = manager.prepare_store([key], ctx)
+    manager.complete_store(output.keys_to_store, ctx)
+    view = pool.prefix_cache.view('cpu-agent')
+    assert pool.get_cached_block(hashes[3], [0], view) is None
+    assert pool.get_cached_block(hashes[5], [0], view) == [blocks[2]]
+    assert pool.get_cached_block(hashes[7], [0], view) == [blocks[3]]
+    assert pool.get_cached_block(hashes[9], [0], view) is None
+    assert view.permits(cache_content_keys([hashes[4]], 0)[0]) is (not is_recurrent)
+
+    # Owning just the final GPU block cannot acquire the earlier part of a
+    # larger CPU chunk that happens to have the same end hash.
+    selected = SimpleNamespace(kv_scope='gpu-agent', block_hashes=hashes)
+    pool.acquire_cached_blocks(selected, ([blocks[3]],), 32)
+    gpu_ctx = ReqContext('load', kv_scope='gpu-agent')
+    manager.begin_lookup(gpu_ctx)
+    assert manager.lookup(key, gpu_ctx) is LookupResult.MISS
+
