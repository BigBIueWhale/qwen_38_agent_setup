+def test_secondary_facing_lookup_borrows_data_without_acquiring_a_prefix():
+    from unittest.mock import MagicMock
+    from vllm.v1.kv_offload.base import ReqContext, LookupResult
+    from vllm.v1.kv_offload.tiering.manager import (
+        CPUPrimaryTierOffloadingManager, TieringOffloadingManager,
+        _SecondaryTierFacingParent,
+    )
+
+    region = MagicMock()
+    region.create_kv_memoryview.return_value = memoryview(bytearray(64)).cast('B', shape=(4, 16))
+    primary = CPUPrimaryTierOffloadingManager(4, region)
+    manager = TieringOffloadingManager(primary)
+    generation = ReqContext('store', kv_scope='writer', prefix_content={b'key': (b'key',)})
+    manager.on_new_request(generation)
+    result = manager.prepare_store([b'key'], generation)
+    manager.complete_store(result.keys_to_store, generation)
+    manager.on_request_finished(generation)
+    before = primary.prefix_cache.view('writer')
+
+    parent = _SecondaryTierFacingParent(manager, 0)
+    storage = ReqContext('storage-request')
+    parent.on_new_request(storage)
+    assert parent.lookup(b'key', storage) is LookupResult.HIT
+    parent.on_request_finished(storage)
+    assert primary.prefix_cache.view('writer') == before
+    assert set(primary.prefix_cache._owned) == {'writer'}
+    assert storage.req_id not in manager._req_state
+    assert storage.req_id not in primary._contexts
