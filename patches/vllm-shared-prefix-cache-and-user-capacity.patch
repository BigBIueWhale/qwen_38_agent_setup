diff --git a/tests/entrypoints/test_kv_scope_protocol.py b/tests/entrypoints/test_kv_scope_protocol.py
new file mode 100644
--- /dev/null
+++ b/tests/entrypoints/test_kv_scope_protocol.py
@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Every generation surface carries the same opaque cache-accounting ID.
+
+An agent without cached blocks may acquire a shared prefix; existing agents
+match their acquired cache and extend it. ID syntax does not encode ancestry.
+Rendering needs no ID because it allocates no KV. The shared engine boundary
+requires an ID for generation, including direct SamplingParams callers.
+"""
+
+import pytest
+from pydantic import BaseModel, ValidationError
+
+from vllm.entrypoints.anthropic.protocol import AnthropicMessagesRequest
+from vllm.entrypoints.anthropic.serving import AnthropicServingMessages
+from vllm.entrypoints.openai.chat_completion.protocol import (
+    BatchChatCompletionRequest,
+    ChatCompletionRequest,
+)
+from vllm.entrypoints.openai.completion.protocol import CompletionRequest
+from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateRequest
+from vllm.exceptions import VLLMValidationError
+from vllm.sampling_params import SamplingParams
+from vllm.v1.engine.input_processor import require_kv_scope
+
+pytestmark = pytest.mark.cpu_test
+
+_SCOPE = "toolu_01AbCdEf"
+
+
+def _minimal_payload(request_cls: type[BaseModel]) -> dict:
+    """Smallest valid payload per protocol, before the identity fields."""
+    if request_cls is ChatCompletionRequest:
+        return {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+    if request_cls is BatchChatCompletionRequest:
+        return {"model": "m", "messages": [[{"role": "user", "content": "hi"}]]}
+    if request_cls is CompletionRequest:
+        return {"model": "m", "prompt": "hi"}
+    if request_cls is ResponsesRequest:
+        return {"model": "m", "input": "hi"}
+    if request_cls is AnthropicMessagesRequest:
+        return {
+            "model": "m",
+            "max_tokens": 16,
+            "messages": [{"role": "user", "content": "hi"}],
+        }
+    if request_cls is GenerateRequest:
+        return {
+            "request_id": "req-1",
+            "token_ids": [1, 2, 3],
+            "sampling_params": SamplingParams(),
+        }
+    raise AssertionError(f"unhandled protocol {request_cls}")
+
+
+ALL_GENERATION_REQUESTS = [
+    ChatCompletionRequest,
+    BatchChatCompletionRequest,
+    CompletionRequest,
+    ResponsesRequest,
+    AnthropicMessagesRequest,
+    GenerateRequest,
+]
+
+_OPENAI_SURFACES = [ChatCompletionRequest, CompletionRequest, ResponsesRequest]
+
+
+def _sampling_params_for(request):
+    if isinstance(request, ResponsesRequest):
+        return request.to_sampling_params(
+            default_max_tokens=32, default_sampling_params={}
+        )
+    return request.to_sampling_params(max_tokens=32, default_sampling_params={})
+
+
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_every_surface_accepts_scope_fields(request_cls):
+    request = request_cls(
+        **_minimal_payload(request_cls),
+        kv_scope=_SCOPE,
+    )
+    assert request.kv_scope == _SCOPE
+
+
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_no_surface_invents_a_scope(request_cls):
+    # A model may be built without one -- rendering shares these models and
+    # allocates nothing -- but no surface may fabricate an identity to fill
+    # the gap. What is absent here is refused later, at the engine.
+    request = request_cls(**_minimal_payload(request_cls))
+    assert request.kv_scope is None
+
+
+@pytest.mark.parametrize("scope", ["", " ", "\t\n"])
+@pytest.mark.parametrize("request_cls", ALL_GENERATION_REQUESTS)
+def test_every_surface_rejects_empty_scope(request_cls, scope):
+    # An empty scope id is not "no agent", it is a malformed identity; it
+    # must die at the protocol boundary, identically everywhere.
+    with pytest.raises(ValidationError):
+        request_cls(**_minimal_payload(request_cls), kv_scope=scope)
+
+
+@pytest.mark.parametrize("request_cls", _OPENAI_SURFACES)
+def test_openai_surfaces_deliver_scope_into_extra_args(request_cls):
+    request = request_cls(**_minimal_payload(request_cls), kv_scope=_SCOPE)
+    sampling = _sampling_params_for(request)
+    assert sampling.extra_args is not None
+    assert sampling.extra_args["kv_scope"] == _SCOPE
+
+
+@pytest.mark.parametrize("request_cls", _OPENAI_SURFACES)
+def test_openai_surfaces_omit_absent_scope_from_extra_args(request_cls):
+    # Absence is carried through as absence rather than as a placeholder,
+    # which is precisely what lets the engine gate see it and refuse.
+    request = request_cls(**_minimal_payload(request_cls))
+    extra_args = _sampling_params_for(request).extra_args or {}
+    assert "kv_scope" not in extra_args
+
+
+@pytest.mark.parametrize("request_cls", _OPENAI_SURFACES)
+def test_the_engine_refuses_to_generate_for_a_request_naming_no_agent(request_cls):
+    # The rule, at the one place every generative request passes through.
+    request = request_cls(**_minimal_payload(request_cls))
+    with pytest.raises(VLLMValidationError) as excinfo:
+        require_kv_scope(_sampling_params_for(request))
+    assert excinfo.value.parameter == "kv_scope"
+    assert "required for generation" in str(excinfo.value)
+
+
+@pytest.mark.parametrize("request_cls", _OPENAI_SURFACES)
+def test_the_engine_admits_a_request_that_names_its_agent(request_cls):
+    request = request_cls(**_minimal_payload(request_cls), kv_scope=_SCOPE)
+    assert require_kv_scope(_sampling_params_for(request)) == _SCOPE
+
+
+@pytest.mark.parametrize("scope", ["", " ", "\t\n", 0, [], {}, b"x"])
+def test_the_engine_refuses_a_scope_that_is_not_a_non_empty_string(scope):
+    # Reaches the gate only through the direct SamplingParams path; the
+    # protocol models reject these earlier. Both doors are shut.
+    params = SamplingParams(max_tokens=1, extra_args={"kv_scope": scope})
+    with pytest.raises(VLLMValidationError) as excinfo:
+        require_kv_scope(params)
+    assert excinfo.value.parameter == "kv_scope"
+
+
+def test_a_batch_submits_every_conversation_under_the_one_agent():
+    # One batch is one caller, so its conversations share the caller's
+    # identity rather than each becoming an anonymous context.
+    batch = BatchChatCompletionRequest(
+        model="m",
+        messages=[
+            [{"role": "user", "content": "a"}],
+            [{"role": "user", "content": "b"}],
+        ],
+        kv_scope=_SCOPE,
+    )
+    singles = [batch.to_chat_completion_request(m) for m in batch.messages]
+    assert [s.kv_scope for s in singles] == [_SCOPE, _SCOPE]
+    assert require_kv_scope(_sampling_params_for(singles[0])) == _SCOPE
+
+
+def test_anthropic_translation_forwards_scope_fields():
+    # Anthropic rides the chat pipeline; the translation must pass identity
+    # through verbatim — Anthropic is one surface among equals, not special.
+    request = AnthropicMessagesRequest(
+        **_minimal_payload(AnthropicMessagesRequest),
+        kv_scope=_SCOPE,
+    )
+    chat_request = AnthropicServingMessages._build_base_request(
+        request, [{"role": "user", "content": "hi"}]
+    )
+    assert chat_request.kv_scope == _SCOPE
+
+
+def test_every_mounted_generative_route_is_an_identity_surface():
+    # The generate router assembly must register every supported surface and
+    # must not contain a route that reaches the engine without being able to
+    # name an agent. A guarded registration would make the endpoint set
+    # depend on which optional SDKs happen to import, which is exactly the
+    # half-present shape this fork forbids.
+    from types import SimpleNamespace
+
+    from fastapi import FastAPI
+
+    from vllm.entrypoints.generate.api_router import register_generate_api_routers
+    from vllm.entrypoints.scale_out.factories import register_scale_out_api_routers
+
+    app = FastAPI()
+    # The token-in-token-out attach reads app.state.args (tokens_only
+    # servers mount an extra abort route); mirror the minimal real state.
+    app.state.args = SimpleNamespace(tokens_only=False)
+    register_generate_api_routers(app)
+    register_scale_out_api_routers(app, ("generate",))
+    paths = {getattr(route, "path", "") for route in app.routes}
+    assert not any(path.startswith("/cohere") for path in paths), paths
+    assert "/generative_scoring" not in paths, sorted(paths)
+    for required in (
+        "/v1/chat/completions",
+        "/v1/chat/completions/batch",
+        "/v1/completions",
+        "/v1/responses",
+        "/v1/messages",
+        "/inference/v1/generate",
+    ):
+        assert required in paths, (required, sorted(paths))
+
+
+@pytest.mark.parametrize("scope", ["a", "unrelated ID", "α / β", " leading-and-trailing "])
+@pytest.mark.parametrize("request_cls", _OPENAI_SURFACES)
+def test_agent_id_is_opaque_and_preserved_without_lineage_or_cache_salt(scope, request_cls):
+    request = request_cls(**_minimal_payload(request_cls), kv_scope=scope)
+    params = _sampling_params_for(request)
+    assert require_kv_scope(params) == scope
+    assert request.cache_salt is None
