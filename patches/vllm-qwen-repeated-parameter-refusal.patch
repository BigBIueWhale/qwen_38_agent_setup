+class _RepeatedParameter(Exception):
+    """Argument text that names a parameter it already named.
+
+    The converter knows the arguments and the parser the call they belong
+    to, so the parser turns this into the refusal it answers with. It is no
+    ValueError: the engine's provisional-converter fallback catches those and
+    would publish the argument text as the call's arguments.
+    """
+
+    def __init__(self, name: str) -> None:
+        super().__init__(name)
+        self.name = name
+
+
