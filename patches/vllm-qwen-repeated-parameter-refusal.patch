+@pytest.mark.parametrize('chunk_size', [None, 13])
+@pytest.mark.parametrize('schema,arguments,argument,kind', UNCARRIABLE)
+def test_a_value_the_server_cannot_carry_back_is_refused_typed(
+    schema, arguments, argument, kind, chunk_size
+):
+    """The grammar writes an integer of any length and any string escape,
+    but a value a later request cannot read back -- an integer longer than
+    this process converts, half of a surrogate pair -- would make every
+    request that carries the call fail. Such a call is refused as the
+    model's, naming the parameter and the value, before any value is
+    converted: not read as having no reading (a 5xx), and not published."""
+    from vllm.entrypoints.serve.exception_handling.error_response import (
+        create_error_response,
+    )
+    from vllm.parser.qwen3 import QwenToolCallUncarriableValueError
+
+    call = ('<tool_call>\n<function=write>\n' + arguments
+            + '</function>\n</tool_call>')
+    assert _grammar_accepts(schema, call)
+    with pytest.raises(QwenToolCallUncarriableValueError) as refused:
+        parse('plan</think>' + call, chunk_size, schema=schema)
+    assert (refused.value.tool, refused.value.argument) == ('write', argument)
+    assert refused.value.kind.startswith(kind)
+    error = create_error_response(refused.value).error
+    assert (error.code, error.type, error.param) == (
+        422, 'ToolCallUncarriableValueError', None)
+    assert "cannot carry back into a prompt" in error.message
+    assert error.message.endswith('Generate the response again.')
+
+
+@pytest.mark.parametrize('chunk_size', [None, 13])
+@pytest.mark.parametrize('schema,arguments,expected', [
+    # An integer as long as the process converts.
+    ({'type': 'object', 'properties': {'n': {'type': 'integer'}}},
+     '<parameter=n>\n-' + '9' * INT_DIGITS + '\n</parameter>\n',
+     {'n': -int('9' * INT_DIGITS)}),
+    # A surrogate pair, escaped: one character.
+    (TODO_SCHEMA,
+     '<parameter=todos>\n[{"content": "\\ud83d\\ude00", "status": "pending"}]\n'
+     '</parameter>\n',
+     {'todos': [{'content': '\U0001f600', 'status': 'pending'}]}),
+    # A value its schema also admits as text is carried as the text.
+    ({'type': 'object', 'properties': {'n': {'type': ['integer', 'string']}}},
+     '<parameter=n>\n' + '9' * (INT_DIGITS + 1) + '\n</parameter>\n',
+     {'n': '9' * (INT_DIGITS + 1)}),
+])
+def test_a_value_the_server_can_carry_back_is_published_as_written(
+    schema, arguments, expected, chunk_size
+):
+    call = ('<tool_call>\n<function=write>\n' + arguments
+            + '</function>\n</tool_call>')
+    assert _grammar_accepts(schema, call)
+    _, _, calls = parse('plan</think>' + call, chunk_size, schema=schema)
+    assert [json.loads(c) for c in calls] == [expected]
+    if isinstance(expected.get('n'), int) or 'todos' in expected:
+        # A JSON reading keeps the model's own text.
+        written = arguments.split('\n', 1)[1].rsplit('\n</parameter>', 1)[0]
+        assert written in calls[0]
+
+
+def test_an_unconstrained_call_carries_such_a_value_as_its_text():
+    """With no grammar armed, a value its schema proves no carriable reading
+    of is the text the model wrote, as every other such value is."""
+    from vllm.parser.qwen3 import _qwen3_arg_converter
+
+    digits = '9' * (INT_DIGITS + 1)
+    schema = {'type': 'object', 'properties': {'n': {'type': 'integer'}}}
+    arguments = _qwen3_arg_converter(
+        '<parameter=n>\n' + digits + '\n</parameter>\n', False, schema, None)
+    assert json.loads(arguments) == {'n': digits}
