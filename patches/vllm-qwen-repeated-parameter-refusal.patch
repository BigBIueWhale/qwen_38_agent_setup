+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A call that names a parameter twice is refused on the wire, not failed, as
+every tool call refused for what the model wrote is."""
+
+import json
+from http import HTTPStatus
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.anthropic.protocol import AnthropicErrorResponse
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.entrypoints.openai.chat_completion.serving import OpenAIServingChat
+from vllm.entrypoints.openai.engine.protocol import (
+    RepeatedToolParameterError,
+    RequestResponseMetadata,
+    ToolCallRefusedError,
+)
+from vllm.entrypoints.serve.exception_handling.error_response import (
+    create_error_response,
+)
+from vllm.exceptions import VLLMServerError, VLLMUnprocessableEntityError
+from vllm.outputs import CompletionOutput, RequestOutput
+from vllm.parser import ParserManager
+from vllm.parser.qwen3 import (
+    QwenToolCallOutsideSchemaError,
+    QwenToolCallUncarriableValueError,
+)
+
+MARKERS = {"</think>": 20000, "<tool_call>": 20001, "</tool_call>": 20002}
+TEXT = {v: k for k, v in MARKERS.items()}
+TOOLS = [{"type": "function", "function": {
+    "name": "read", "parameters": {
+        "type": "object", "properties": {"path": {"type": "string"}},
+        "required": ["path"],
+    },
+}}]
+BODY = (
+    "plan</think><tool_call>\n<function=read>\n"
+    "<parameter=path>\na\n</parameter>\n<parameter=path>\nb\n</parameter>\n"
+    "</function>\n</tool_call>"
+)
+
+
+def _encode(text):
+    ids = []
+    while text:
+        marker = next((m for m in MARKERS if text.startswith(m)), None)
+        if marker:
+            ids.append(MARKERS[marker])
+            text = text[len(marker):]
+        else:
+            ids.append(ord(text[0]))
+            text = text[1:]
+    return ids
+
+
+def _decode(ids):
+    return "".join(TEXT.get(i, chr(i)) for i in ids)
+
+
+def _serving():
+    serving = OpenAIServingChat.__new__(OpenAIServingChat)
+    serving.response_role = "assistant"
+    serving.parser_cls = ParserManager.get_parser(
+        tool_parser_name="qwen3_coder", reasoning_parser_name="qwen3",
+        enable_auto_tools=True,
+    )
+    serving.model_config = None
+    serving.enable_auto_tools = True
+    serving.enable_prompt_tokens_details = False
+    serving.enable_log_outputs = False
+    serving.enable_log_deltas = False
+    serving.enable_force_include_usage = False
+    serving.request_logger = None
+    serving.system_fingerprint = None
+    serving.enable_per_request_metrics = False
+    return serving
+
+
+def _arguments(stream, chunk_size):
+    ids = _encode(BODY)
+    request = ChatCompletionRequest(
+        model="unit", messages=[{"role": "user", "content": "read"}], tools=TOOLS,
+        tool_choice="auto", stream=stream, kv_scope="unit",
+        stream_options={"include_usage": True} if stream else None,
+    )
+    tokenizer = MagicMock()
+    tokenizer.get_vocab.return_value = MARKERS
+    tokenizer.all_special_tokens = list(MARKERS)
+    tokenizer.all_special_ids = list(MARKERS.values())
+    tokenizer.decode.side_effect = _decode
+
+    async def outputs():
+        size = chunk_size or len(ids)
+        for start in range(0, len(ids), size):
+            group = ids[start:start + size]
+            last = start + size >= len(ids)
+            yield RequestOutput(
+                request_id="unit", prompt="prompt", prompt_token_ids=[1, 2, 3],
+                prompt_logprobs=None, outputs=[CompletionOutput(
+                    index=0, text=_decode(group), token_ids=group,
+                    cumulative_logprob=None, logprobs=None,
+                    finish_reason="stop" if last else None, stop_reason=None,
+                )], finished=last,
+            )
+
+    return request, tokenizer, dict(
+        request=request, result_generator=outputs(), request_id="chatcmpl-unit",
+        model_name="unit", conversation=[{"role": "user", "content": "read"}],
+        tokenizer=tokenizer,
+        request_metadata=RequestResponseMetadata(request_id="unit"),
+    )
+
+
+def test_the_refusal_is_a_typed_422_naming_the_call_and_parameter():
+    refusal = RepeatedToolParameterError("read", "path")
+    # The unprocessable-entity refusal a well-formed request gets when what it
+    # leads to cannot be served, never a server error.
+    assert isinstance(refusal, VLLMUnprocessableEntityError)
+    assert not isinstance(refusal, VLLMServerError)
+    error = create_error_response(refusal).error
+    assert error.code == HTTPStatus.UNPROCESSABLE_ENTITY.value
+    assert error.type == "RepeatedToolParameterError"
+    # No request parameter is at fault: the model wrote the repeat.
+    assert error.param is None
+    assert "call to 'read' names parameter 'path' more than once" in error.message
+    assert error.message.endswith("Generate the response again.")
+    anthropic = AnthropicErrorResponse.for_status(error.code, error.message)
+    assert anthropic.error.type == "invalid_request_error"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("chunk_size", [None, 1, 13])
+async def test_a_stream_ends_in_the_refusal_and_publishes_no_call(chunk_size):
+    _, _, kwargs = _arguments(True, chunk_size)
+    events = [
+        event async for event in _serving().chat_completion_stream_generator(**kwargs)
+    ]
+    assert events[-1] == "data: [DONE]\n\n"
+    payloads = [json.loads(event[len("data: "):]) for event in events[:-1]]
+    *chunks, last = payloads
+    assert last == {"error": {
+        "message": create_error_response(
+            RepeatedToolParameterError("read", "path")
+        ).error.message,
+        "type": "RepeatedToolParameterError", "param": None, "code": 422,
+    }}
+    for chunk in chunks:
+        assert "error" not in chunk
+        for choice in chunk["choices"]:
+            assert not choice["delta"].get("tool_calls")
+            assert choice.get("finish_reason") is None
+
+
+@pytest.mark.asyncio
+async def test_a_whole_response_is_refused_before_any_body():
+    request, tokenizer, kwargs = _arguments(False, None)
+    serving = _serving()
+    kwargs["parser"] = serving.parser_cls(tokenizer, request.tools)
+    with pytest.raises(RepeatedToolParameterError) as refused:
+        await serving.chat_completion_full_generator(**kwargs)
+    assert (refused.value.tool, refused.value.repeated_parameter) == ("read", "path")
+
+
+@pytest.mark.parametrize("refusal,wire_type", [
+    (RepeatedToolParameterError("read", "path"), "RepeatedToolParameterError"),
+    (QwenToolCallOutsideSchemaError("read"), "ToolCallOutsideSchemaError"),
+    (QwenToolCallUncarriableValueError("read", "offset", "an integer"),
+     "ToolCallUncarriableValueError"),
+])
+def test_every_refused_call_is_a_422_typed_by_its_kind(refusal, wire_type):
+    """The model's refused calls are one kind of refusal, each typed on the
+    wire by the name its class declares, so a caller tells them from every
+    other refusal by the type alone."""
+    assert isinstance(refusal, ToolCallRefusedError)
+    assert not isinstance(refusal, VLLMServerError)
+    error = create_error_response(refusal).error
+    assert (error.code, error.type, error.param) == (422, wire_type, None)
+    assert "The model's call to 'read'" in error.message
+    assert error.message.endswith("Generate the response again.")
+
+
+def test_a_refused_call_kind_cannot_be_declared_without_its_wire_type():
+    with pytest.raises(TypeError, match="wire_type"):
+        type("Untyped", (ToolCallRefusedError,), {})
