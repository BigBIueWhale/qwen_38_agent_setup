+class ToolCallRefusedError(VLLMUnprocessableEntityError):
+    """A tool call the model wrote is refused for what the model wrote.
+
+    The request was sound and the server did not fail: what cannot be served
+    is the model's own output, so the refusal is the unprocessable-entity one
+    (422) a well-formed request gets when what it leads to cannot be served,
+    no request parameter is at fault, no call is published, and the next
+    action is the caller's, to generate the response again. Each kind of
+    refusal declares the ``wire_type`` that names it -- the error ``type`` on
+    the wire, in a whole response and in a stream's error event alike -- as a
+    class keyword, so none can be defined without one, and a caller tells the
+    model's refused call from every other refusal by that type, never by the
+    message.
+    """
+
+    wire_type: ClassVar[str]
+
+    def __init_subclass__(cls, *, wire_type: str, **kwargs) -> None:
+        super().__init_subclass__(**kwargs)
+        cls.wire_type = wire_type
+
+
+class RepeatedToolParameterError(
+    ToolCallRefusedError, wire_type="RepeatedToolParameterError"
+):
+    """The model wrote a tool call that names one parameter more than once.
+
+    A call's arguments are an object, and an object holds each name once, so
+    the call cannot be returned as it was written: either value would be
+    dropped. The response is refused instead, naming the call and the
+    parameter.
+    """
+
+    def __init__(self, tool: str, repeated_parameter: str) -> None:
+        super().__init__(
+            f"The model's call to {tool!r} names parameter "
+            f"{repeated_parameter!r} more than once. A call's arguments are an "
+            "object that holds each name once, so the call is refused rather "
+            "than returned with one of the model's values dropped. Generate "
+            "the response again."
+        )
+        self.tool = tool
+        self.repeated_parameter = repeated_parameter
