+async def test_rendered_requests_keep_resolved_sampling_through_generate_json(
+    surface, requested_max, expected_max,
+):
+    from types import SimpleNamespace
+    from unittest.mock import AsyncMock
+
+    from vllm.entrypoints.scale_out.render.serving import ServingRender
+
+    render = object.__new__(ServingRender)
+    render.model_config = SimpleNamespace(max_model_len=512, is_encoder_decoder=False)
+    render.default_sampling_params = dict(DEFAULTS)
+    render.override_max_tokens = None
+    render._check_model = AsyncMock(return_value=None)
+    prompt = {"type": "token", "prompt_token_ids": [1, 2, 3]}
+    render.online_renderer = SimpleNamespace(
+        render_chat=AsyncMock(return_value=(None, [prompt])),
+        render_completion=AsyncMock(return_value=[prompt]),
+    )
+    kwargs = {"model": "model", "max_tokens": requested_max, "temperature": 1.0,
+              "top_p": 1.0, "top_k": 0, "thinking_token_budget": None,
+              "kv_scope": "agent"}
+    if surface == "chat":
+        request = ChatCompletionRequest(messages=[{"role": "user", "content": "hi"}], **kwargs)
