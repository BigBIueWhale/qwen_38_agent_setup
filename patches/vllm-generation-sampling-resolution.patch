+@pytest.mark.parametrize("supplied, expected", [(None, 100), (50, 50), (500, 100)])
+@pytest.mark.parametrize("surface", ["chat", "completion", "responses", "generate"])
+def test_every_surface_applies_the_same_final_answer_ceiling(surface, supplied, expected):
+    common = {"final_response_token_budget": supplied, "kv_scope": "agent"}
+    if surface == "chat":
+        request = ChatCompletionRequest(model="m", messages=[{"role": "user", "content": "hi"}], **common)
+        params = request.to_sampling_params(509, DEFAULTS)
+    elif surface == "completion":
+        params = CompletionRequest(model="m", prompt="hi", **common).to_sampling_params(509, DEFAULTS)
+    elif surface == "responses":
+        params = ResponsesRequest(model="m", input="hi", **common).to_sampling_params(509, DEFAULTS)
+    else:
+        params = generate({"final_response_token_budget": supplied}).to_sampling_params(509, DEFAULTS)
+    assert params.final_response_token_budget == expected
+
