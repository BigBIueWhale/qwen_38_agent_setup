+
+    serving = object.__new__(ServingTokens)
+    serving.model_config = SimpleNamespace(max_model_len=512, is_encoder_decoder=False)
+    serving.default_sampling_params = dict(DEFAULTS)
+    serving.override_max_tokens = None
+    serving.force_no_detokenize = False
+    serving.enable_prompt_tokens_details = False
+    serving.enable_log_outputs = False
+    serving._check_model = AsyncMock(return_value=None)
+    serving._maybe_get_adapters = MagicMock(return_value=None)
+    serving.models = SimpleNamespace(model_name=lambda _adapter: "model")
+    serving._base_request_id = MagicMock(return_value="request")
+    serving._log_inputs = MagicMock()
+    serving._get_data_parallel_rank = MagicMock(return_value=None)
+    serving._get_session_id_from_headers = MagicMock(return_value=None)
+    serving.online_renderer = SimpleNamespace(preprocess_completion=AsyncMock(
+        return_value=[{"type": "token", "prompt_token_ids": [1, 2, 3]}],
+    ))
+    captured = []
+
+    async def engine_generate(prompt, params, request_id, **kwargs):
+        captured.append(params)
+        yield RequestOutput(
+            request_id=request_id, prompt=None, prompt_token_ids=[1, 2, 3],
+            prompt_logprobs=None, finished=True,
+            outputs=[CompletionOutput(
+                index=0, text="answer", token_ids=[4], cumulative_logprob=None,
+                logprobs=None, finish_reason="stop",
+            )],
+        )
+
+    serving.engine_client = SimpleNamespace(
+        errored=False, generate=engine_generate,
+        vllm_config=SimpleNamespace(scheduler_config=SimpleNamespace(max_num_seqs=1)),
+    )
+    request = generate(settings)
+    request.stream = stream
+    before = request.model_dump_json()
+    response = await serving.serve_tokens(request)
+    if stream:
+        events = [event async for event in response]
+        assert events[-1].strip() == "data: [DONE]"
+        assert any('"finish_reason":"stop"' in event for event in events)
+    else:
+        assert response.choices[0].finish_reason == "stop"
+        assert response.choices[0].token_ids == [4]
+    assert len(captured) == 1
+    params = captured[0]
+    assert params.max_tokens == expected_max
+    assert params.final_response_token_budget == DEFAULTS["final_response_token_budget"]
+    assert params.temperature == settings.get("temperature", DEFAULTS["temperature"])
+    assert params.top_p == settings.get("top_p", DEFAULTS["top_p"])
+    assert params.top_k == settings.get("top_k", DEFAULTS["top_k"])
+    assert params.thinking_token_budget == settings.get("thinking_token_budget", 200)
+    assert params.extra_args["kv_scope"] == "agent"
+    if stream:
+        assert params.output_kind == RequestOutputKind.DELTA
+    assert request.model_dump_json() == before
