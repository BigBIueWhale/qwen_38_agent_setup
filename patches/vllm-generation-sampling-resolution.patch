+DEFAULTS = {
+    "temperature": 0.8, "top_p": 0.95, "top_k": 20, "min_p": 0.01,
+    "presence_penalty": 0.3, "repetition_penalty": 1.1,
+    "thinking_token_budget": 200, "final_response_token_budget": 100,
+}
+
+
+def generate(settings):
+    return GenerateRequest.model_validate({
+        "token_ids": [1, 2, 3], "sampling_params": settings, "kv_scope": "agent",
+    })
+
+
+def test_omitted_settings_remain_omitted_until_resolution():
+    request = generate({"min_tokens": 64})
+    assert json.loads(request.model_dump_json())["sampling_params"] == {"min_tokens": 64}
+    resolved = request.to_sampling_params(509, DEFAULTS)
+    assert resolved.max_tokens == 509 and resolved.min_tokens == 64
+    for key, value in DEFAULTS.items():
+        assert getattr(resolved, key) == value
+    assert resolved.extra_args["kv_scope"] == "agent"
+    assert request.sampling_params == {"min_tokens": 64}
+
+
+def test_explicit_neutral_values_survive_json_transport():
+    settings = {
+        "max_tokens": 16, "temperature": 1.0, "top_p": 1.0, "top_k": 0,
+        "min_p": 0.0, "presence_penalty": 0.0, "repetition_penalty": 1.0,
+        "thinking_token_budget": None,
+    }
+    request = GenerateRequest.model_validate_json(generate(settings).model_dump_json())
+    assert request.sampling_params == settings
+    resolved = request.to_sampling_params(16, DEFAULTS)
+    for key, value in settings.items():
+        assert getattr(resolved, key) == value
+    assert resolved.final_response_token_budget == 100
+
