+class SamplingParamsInput(dict[str, Any]):
+    """Supplied settings, before model defaults and prompt length are known.
+
+    Presence is part of the request: an explicit neutral value must survive
+    serialization, and omitted values must stay omitted until resolution.
+    """
+
+    @classmethod
+    def __get_pydantic_core_schema__(
+        cls, source_type: Any, handler: GetCoreSchemaHandler,
+    ) -> core_schema.CoreSchema:
+        excluded = {"skip_clone", "output_text_buffer_length"}
+        hints = get_type_hints(SamplingParams)
+        fields = {
+            field.name: hints[field.name]
+            for field in msgspec.structs.fields(SamplingParams)
+            if not field.name.startswith("_") and field.name not in excluded
+        }
+        fields["thinking_token_budget"] = ThinkingTokenBudget
+        fields["final_response_token_budget"] = FinalResponseTokenBudget
+
+        def supplied_values(value: Any) -> Any:
+            if isinstance(value, SamplingParams):
+                # A renderer has already resolved this object. Include every
+                # public value, even those equal to the engine's defaults.
+                return {name: getattr(value, name) for name in fields}
+            return value
+
+        return core_schema.no_info_after_validator_function(
+            cls,
+            core_schema.no_info_before_validator_function(
+                supplied_values,
+                core_schema.typed_dict_schema({
+                    name: core_schema.typed_dict_field(
+                        handler.generate_schema(hint), required=False,
+                    ) for name, hint in fields.items()
+                }, extra_behavior="forbid"),
+            ),
+        )
 
 
