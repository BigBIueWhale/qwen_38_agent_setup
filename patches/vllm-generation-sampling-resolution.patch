+def test_rendered_params_keep_default_valued_settings_after_serialization():
+    source = SamplingParams(max_tokens=16, thinking_token_budget=None)
+    rendered = GenerateRequest(token_ids=[1, 2, 3], sampling_params=source, kv_scope="agent")
+    serialized = json.loads(rendered.model_dump_json())
+    assert serialized["sampling_params"]["max_tokens"] == 16
+    assert serialized["sampling_params"]["temperature"] == 1.0
+    assert serialized["sampling_params"]["top_p"] == 1.0
+    assert serialized["sampling_params"]["thinking_token_budget"] is None
+    assert "output_text_buffer_length" not in serialized["sampling_params"]
+    assert "skip_clone" not in serialized["sampling_params"]
+    request = GenerateRequest.model_validate(serialized)
+    resolved = request.to_sampling_params(16, DEFAULTS)
+    assert resolved.max_tokens == source.max_tokens
+    assert resolved.temperature == source.temperature
+    assert resolved.top_p == source.top_p
+    assert resolved.thinking_token_budget is None
+    assert resolved.final_response_token_budget == 100
+    assert source.final_response_token_budget is None
+    assert source.extra_args is None
