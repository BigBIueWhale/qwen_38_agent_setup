--- a/vllm/v1/core/sched/utils.py
+++ b/vllm/v1/core/sched/utils.py
@@ -97,7 +97,26 @@ def check_stop(request: Request, max_model_len: int) -> bool:
     sampling_params = request.sampling_params
     assert sampling_params is not None
 
-    if request.num_output_tokens < sampling_params.min_tokens:
+    final_budget = sampling_params.final_response_token_budget
+    final_budget_reached = False
+    if final_budget is not None:
+        if request.final_response_start_index is None:
+            output = request.output_token_ids
+            for end_sequence in sampling_params._reasoning_end_token_sequences:
+                end_length = len(end_sequence)
+                if end_length and list(output[-end_length:]) == end_sequence:
+                    request.final_response_start_index = len(output)
+                    break
+        elif (
+            request.num_output_tokens - request.final_response_start_index
+            >= final_budget
+        ):
+            final_budget_reached = True
+
+    if (
+        request.num_output_tokens < sampling_params.min_tokens
+        and not final_budget_reached
+    ):
         return False
 
     last_token_id = request.output_token_ids[-1]
