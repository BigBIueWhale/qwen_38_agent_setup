+def validate_final_response_token_budget(
+    value: int | float | bool | None,
+) -> int | None:
+    """Validate the visible post-reasoning response-token limit."""
+    if value is None:
+        return None
+    if isinstance(value, (bool, float)) or not isinstance(value, int):
+        raise VLLMValidationError(
+            "`final_response_token_budget` must be a positive integer "
+            "or -1 for unlimited.",
+            parameter="final_response_token_budget",
+            value=value,
+        )
+    if value == -1:
+        return None
+    if value <= 0:
+        raise VLLMValidationError(
+            "`final_response_token_budget` must be a positive integer "
+            "or -1 for unlimited.",
+            parameter="final_response_token_budget",
+            value=value,
+        )
+    return value
+
+
+FinalResponseTokenBudget = Annotated[
+    int | None,
+    BeforeValidator(validate_final_response_token_budget),
+]
+
+
 class SamplingType(IntEnum):
     GREEDY = 0
     RANDOM = 1
