+def refuse(exc: Exception, *, route: str) -> JSONResponse:
+    """Classify a failure exactly as the OpenAI surfaces classify it.
+
+    A rejected request -- typed validation, the engine's own request
+    validation, a prompt the template refuses to render, an image the media
+    gate refuses, a prompt longer than the window -- is a client error on
+    every surface, and it is answered here as HTTP 400
+    ``invalid_request_error``; only a failure the classifier cannot lay at
+    the client's door is a logged 500 ``api_error``.
+    """
+    error = create_error_response(exc)
+    if error.error.code >= HTTPStatus.INTERNAL_SERVER_ERROR.value:
+        logger.exception("Error in %s: %s", route, exc)
+    return translate_error_response(error)
