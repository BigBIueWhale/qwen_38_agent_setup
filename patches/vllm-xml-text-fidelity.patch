diff --git a/tests/parser/engine/test_qwen_xml_fidelity.py b/tests/parser/engine/test_qwen_xml_fidelity.py
new file mode 100644
--- /dev/null
+++ b/tests/parser/engine/test_qwen_xml_fidelity.py
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Text fidelity across Qwen XML conversion and arbitrary streaming cuts."""
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest
+from vllm.parser import ParserManager
+
+MARKERS = {'<think>': 20000, '</think>': 20001,
+           '<tool_call>': 20002, '</tool_call>': 20003}
+REVERSE = {v: k for k, v in MARKERS.items()}
+TOOL = {'type': 'function', 'function': {'name': 'write', 'parameters': {
+    'type': 'object', 'properties': {'text': {'type': 'string'}},
+    'required': ['text'], 'additionalProperties': False}}}
+PARSER = ParserManager.get_parser(tool_parser_name='qwen3_coder',
+                                  reasoning_parser_name='qwen3', enable_auto_tools=True)
+
+
+def encode(text):
+    ids = []
+    while text:
+        marker = next((m for m in MARKERS if text.startswith(m)), None)
+        if marker:
+            ids.append(MARKERS[marker]); text = text[len(marker):]
+        else:
+            ids.append(ord(text[0])); text = text[1:]
+    return ids
+
+
+def decode(ids):
+    return ''.join(REVERSE.get(i, chr(i)) for i in ids)
+
+
+def parse(text, chunk_size, choice='auto'):
+    request = ChatCompletionRequest(messages=[{'role': 'user', 'content': 'test'}],
+                                    tools=[TOOL], tool_choice=choice)
+    tokenizer = MagicMock()
+    tokenizer.get_vocab.return_value = MARKERS
+    tokenizer.decode.side_effect = decode
+    tokenizer.all_special_tokens = list(MARKERS)
+    tokenizer.all_special_ids = list(MARKERS.values())
+    parser = PARSER(tokenizer, request.tools, chat_template_kwargs={'enable_thinking': True})
+    ids = encode(text)
+    if chunk_size is None:
+        reasoning, content, calls = parser.parse(text, request,
+            enable_auto_tools=True, model_output_token_ids=ids)
+        return reasoning or '', content or '', [c.arguments for c in calls or []]
+    reasoning, content, calls = '', '', {}
+    for start in range(0, len(ids), chunk_size):
+        group = ids[start:start+chunk_size]
+        delta = parser.parse_delta(decode(group), group, request,
+            prompt_token_ids=[1, 2, 3], finished=start+chunk_size >= len(ids))
+        if delta is None:
+            continue
+        reasoning += delta.reasoning or ''
+        content += delta.content or ''
+        for call in delta.tool_calls:
+            if call.function and call.function.arguments is not None:
+                calls[call.index] = calls.get(call.index, '') + call.function.arguments
+    return reasoning, content, list(calls.values())
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 13])
+@pytest.mark.parametrize('choice', [
+    'auto', 'required', {'type': 'function', 'function': {'name': 'write'}},
+])
+@pytest.mark.parametrize('before,between,after', [
+    (' \t', '\n\n', '\r\n'),
+    ('\n', ' ', 'answer\n'),
+    ('answer\n', '\t', '\n'),
+    ('', '', ''),
+])
+def test_content_around_tool_calls_is_verbatim(
+    before, between, after, chunk_size, choice,
+):
+    tool = ('<tool_call>\n<function=write>\n'
+            '<parameter=text>value</parameter>\n</function>\n</tool_call>')
+    text = 'plan\n</think>' + before + tool + between + tool + after
+    reasoning, content, calls = parse(text, chunk_size, choice=choice)
+    assert reasoning == 'plan\n'
+    assert content == before + between + after
+    assert [json.loads(arguments) for arguments in calls] == [
+        {'text': 'value'}, {'text': 'value'},
+    ]
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1])
+@pytest.mark.parametrize('choice', [
+    'auto', 'required', {'type': 'function', 'function': {'name': 'write'}},
+])
+def test_whitespace_without_a_call_survives_tool_choice(choice, chunk_size):
+    reasoning, content, calls = parse('plan</think> \t\r\n', chunk_size, choice=choice)
+    assert reasoning == 'plan'
+    assert content == ' \t\r\n'
+    assert calls == []
+
+
+VALUES = ['', '\n', '\n\n', '\nfirst\n', 'first\n', '\nfirst',
+          ' \t\r\nfirst\n\t ', 'first\nsecond\n', '雪\nשָׁלוֹם\n',
+          '\n</function></tool_call><think>\n', '"quoted"\n\\path\n']
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 2, 3, 7, 13, 64])
+@pytest.mark.parametrize('value', VALUES)
+def test_parameter_string_bytes_survive_every_transport_cut(value, chunk_size):
+    text = ('plan\n</think>\n before \t\n<tool_call>\n<function=write>\n'
+            '<parameter=text>' + value + '</parameter>\n</function>\n</tool_call>\n after \t\n')
+    reasoning, content, calls = parse(text, chunk_size)
+    assert reasoning == 'plan\n'
+    assert content == '\n before \t\n\n after \t\n'
+    assert len(calls) == 1
+    assert json.loads(calls[0]) == {'text': value}
+
+
+@pytest.mark.parametrize('chunk_size', [None, 1, 3, 13])
+@pytest.mark.parametrize('value', VALUES)
+def test_partial_string_diagnostic_preserves_raw_value_bytes(value, chunk_size):
+    text = ('plan</think><tool_call>\n<function=write>\n<parameter=text>' + value)
+    _, _, calls = parse(text, chunk_size)
+    assert len(calls) == 1
+    assert json.loads(calls[0]) == {'text': value}
