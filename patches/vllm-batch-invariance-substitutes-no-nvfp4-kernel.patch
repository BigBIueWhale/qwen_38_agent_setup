diff --git a/tests/model_executor/kernels/test_nvfp4_native_selection.py b/tests/model_executor/kernels/test_nvfp4_native_selection.py
index e17f21a2858907c9c3c3b71745b01af3ff540711..c692eb70d2c6dd8996f9c3ca7bc62905180ac132 100644
--- a/tests/model_executor/kernels/test_nvfp4_native_selection.py
+++ b/tests/model_executor/kernels/test_nvfp4_native_selection.py
@@ -92,3 +92,40 @@ def test_weight_only_checkpoints_keep_marlin(monkeypatch):
     device(monkeypatch, (9, 0), {MarlinNvFp4LinearKernel})
     kernel = init_nvfp4_linear_kernel(use_a16=True)
     assert isinstance(kernel, MarlinNvFp4LinearKernel)
+
+
+def test_batch_invariance_does_not_substitute_emulation(monkeypatch):
+    # VLLM_BATCH_INVARIANT's deterministic path is the native CUTLASS kernel; on
+    # a GPU without it, emulation is a substitute like any other.
+    monkeypatch.setenv("VLLM_BATCH_INVARIANT", "1")
+    device(monkeypatch, (9, 0), {MarlinNvFp4LinearKernel, EmulationNvFp4LinearKernel})
+    with pytest.raises(ValueError, match="VLLM_BATCH_INVARIANT needs") as refusal:
+        init_nvfp4_linear_kernel()
+    message = str(refusal.value)
+    assert "compute capability 9.0" in message
+    assert "CutlassNvFp4LinearKernel: not here" in message
+    assert "EmulationNvFp4LinearKernel, does not compute in FP4" in message
+    assert "unset VLLM_BATCH_INVARIANT" in message
+
+
+def test_batch_invariance_serves_named_emulation(monkeypatch):
+    monkeypatch.setenv("VLLM_BATCH_INVARIANT", "1")
+    device(monkeypatch, (9, 0), {EmulationNvFp4LinearKernel}, backend="emulation")
+    assert isinstance(init_nvfp4_linear_kernel(), EmulationNvFp4LinearKernel)
+
+
+def test_batch_invariance_uses_cutlass_where_it_runs(monkeypatch):
+    monkeypatch.setenv("VLLM_BATCH_INVARIANT", "1")
+    device(monkeypatch, (12, 0), {CutlassNvFp4LinearKernel, EmulationNvFp4LinearKernel})
+    assert isinstance(init_nvfp4_linear_kernel(), CutlassNvFp4LinearKernel)
+
+
+def test_a_disabled_native_kernel_is_named_as_the_next_action(monkeypatch):
+    monkeypatch.setenv("VLLM_DISABLED_KERNELS", "CutlassNvFp4LinearKernel")
+    device(monkeypatch, (12, 0), {CutlassNvFp4LinearKernel, MarlinNvFp4LinearKernel})
+    with pytest.raises(ValueError, match="native FP4 kernel") as refusal:
+        init_nvfp4_linear_kernel()
+    assert (
+        "remove CutlassNvFp4LinearKernel from VLLM_DISABLED_KERNELS"
+        in str(refusal.value)
+    )
