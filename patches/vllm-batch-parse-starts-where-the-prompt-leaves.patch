+            return
+        start_id = self._reasoning_start_token_id
+        end_id = self._reasoning_end_token_id
+        for token_id in reversed(prompt_token_ids):
+            if token_id == start_id:
+                self._start_in(ParserState.REASONING, reasoning_opened=True)
+                return
+            if token_id == end_id:
+                return
