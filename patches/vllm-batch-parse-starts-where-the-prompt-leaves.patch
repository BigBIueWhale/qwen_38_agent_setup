+@pytest.mark.asyncio
+@pytest.mark.parametrize("chunk_size", [None, 1, 3, 1000])
+async def test_a_continued_final_message_is_the_answer_on_both_responses_paths(
+    chunk_size,
+):
+    """A prompt that already closed reasoning -- the continued final message
+    Responses selects for an in-progress last item -- leaves the generation
+    outside reasoning on the batch path exactly as on the stream."""
+    from tests.parser.engine.test_qwen_xml_fidelity import (
+        MARKERS, PARSER, decode, encode,
+    )
+
+    prompt = encode("hi<think>\n\n</think>\n\nThe ans")
+    ids = encode("wer is 4.")
+    request = ResponsesRequest(
+        input="hi", stream=chunk_size is not None, kv_scope="unit",
+    )
+    tokenizer = MagicMock()
+    tokenizer.get_vocab.return_value = MARKERS
+    tokenizer.all_special_tokens = list(MARKERS)
+    tokenizer.all_special_ids = list(MARKERS.values())
+    tokenizer.decode.side_effect = decode
+    parser = PARSER(tokenizer, None)
+    serving = OpenAIServingResponses.__new__(OpenAIServingResponses)
+    serving.parser = PARSER
+    serving.enable_auto_tools = True
+
+    def completion(group, last):
+        return CompletionOutput(
+            index=0, text=decode(group), token_ids=group, cumulative_logprob=None,
+            logprobs=None, finish_reason="stop" if last else None, stop_reason=None,
+        )
+
+    if chunk_size is None:
+        items = serving._make_response_output_items(
+            request, completion(ids, True), tokenizer, parser, prompt_token_ids=prompt,
+        )
+    else:
+        context = SimpleContext(response_parser=parser)
+
+        async def outputs():
+            for start in range(0, len(ids), chunk_size):
+                group = ids[start:start + chunk_size]
+                last = start + chunk_size >= len(ids)
+                context.append_output(RequestOutput(
+                    request_id="unit", prompt="prompt", prompt_token_ids=prompt,
+                    prompt_logprobs=None, outputs=[completion(group, last)], finished=last,
+                ))
+                yield context
+
+        events = [event async for event in serving._process_simple_streaming_events(
+            request, SamplingParams(max_tokens=1000), outputs(), context, "unit",
+            tokenizer, RequestResponseMetadata(request_id="unit"), 123, lambda event: event,
+        )]
+        items = [event.item for event in events if event.type == "response.output_item.done"]
+    assert [(item.type, item.content[0].text) for item in items] == [
+        ("message", "wer is 4.")
+    ]
+    assert parser.reasoning_token_count == 0
