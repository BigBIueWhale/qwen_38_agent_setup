+    def adjust_initial_state_from_prompt(
+        self, prompt_token_ids: Sequence[int]
+    ) -> None:
+        """A prompt that opened reasoning leaves the model no opener to write.
+
+        When the prompt's last reasoning marker is ``<think>`` -- every
+        generation prompt the served template writes ends with it -- the
+        reasoning is open, and a ``<think>`` the model generates is part of
+        it. Otherwise the configured start holds: the generation's first
+        token may open reasoning, as a template that leaves the opener to the
+        model expects. A prompt that closed reasoning is parsed as content
+        before this is asked.
+        """
