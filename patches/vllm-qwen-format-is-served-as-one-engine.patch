+class Qwen3ServedParser(Qwen3Parser):
+    """The Qwen format, served as one engine.
+
+    ``ParserManager`` serves it wherever the reasoning parser and the tool
+    parser a launch names both adapt :class:`Qwen3Parser`, and binds those
+    two as ``reasoning_parser_cls`` and ``tool_parser_cls``, where the
+    serving layer reads a launch's parsers; this class names none itself.
+    One pass over the generation decides reasoning, content and calls,
+    beginning where the prompt leaves reasoning. The tool parser declares
+    the decoding grammar, which ``apply_tool_structural_tag`` arms, as it
+    arms a composed parser's.
+    """
+
+    reasoning_parser_cls = None
+    tool_parser_cls = None
+
+    def adjust_request(
+        self,
+        request: ChatCompletionRequest | ResponsesRequest,
+        *,
+        prompt_token_ids: Sequence[int] | None = None,
+    ) -> ChatCompletionRequest | ResponsesRequest:
+        # The engine keeps special tokens in the text it reads; the grammar
+        # is armed for the prompt the request rendered, the engine reading
+        # where that prompt leaves reasoning; and the tool parser adjusts the
+        # request last, as it does wherever it is served.
+        request = super().adjust_request(request, prompt_token_ids=prompt_token_ids)
