+def test_the_qwen_format_is_served_as_one_engine():
+    """A reasoning parser and a tool parser that both adapt the Qwen engine
+    are served as that one engine, which parses the output in one pass; the
+    serving layer reads the two configured parsers from the class, as it
+    reads a composed parser's. Two engines, or a reasoning parser served
+    without a tool parser, stay composed."""
+    from itertools import product
+
+    from vllm.parser.abstract_parser import DelegatingParser
+    from vllm.parser.parser_manager import ParserManager
+    from vllm.parser.qwen3 import Qwen3ServedParser
+    from vllm.reasoning import ReasoningParserManager
+    from vllm.tool_parsers import ToolParserManager
+
+    tokenizer = make_mock_tokenizer({TOOL_CALL_START: 100, TOOL_CALL_END: 101})
+    for reasoning, tool in product(("qwen3", "mimo"), ("qwen3_coder", "qwen3_xml", "mimo")):
+        served = ParserManager.get_parser(
+            tool_parser_name=tool, reasoning_parser_name=reasoning,
+            enable_auto_tools=True,
+        )
+        assert issubclass(served, Qwen3ServedParser), (reasoning, tool)
+        assert not issubclass(served, DelegatingParser)
+        assert served.reasoning_parser_cls is (
+            ReasoningParserManager.get_reasoning_parser(reasoning)
+        )
+        assert served.tool_parser_cls is ToolParserManager.get_tool_parser(tool)
+        parser = served(tokenizer, [])
+        assert parser.reasoning_parser is None
+        assert parser.tool_parser is None
+    for reasoning, tool, auto in (
+        ("nemotron_v3", "qwen3_coder", True),
+        ("qwen3", "qwen3_coder", False),
+    ):
+        composed = ParserManager.get_parser(
+            tool_parser_name=tool, reasoning_parser_name=reasoning,
+            enable_auto_tools=auto,
+        )
+        assert issubclass(composed, DelegatingParser), (reasoning, tool, auto)
+
+
+@pytest.mark.parametrize("thinking", [True, False])
+def test_the_one_engine_arms_the_grammar_a_composition_arms(thinking):
+    """The served engine arms the grammar a composition of the same two
+    parsers arms, for every tool choice and wherever the prompt leaves
+    reasoning: one function decides what the grammar covers and where the
+    engine applies it, so the request's structured-output parameters --
+    ``enable_in_reasoning`` among them -- are the same."""
+    import copy
+
+    from vllm.entrypoints.openai.chat_completion.protocol import (
+        ChatCompletionRequest,
+    )
+    from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+    from vllm.parser.abstract_parser import DelegatingParser
+    from vllm.parser.parser_manager import ParserManager
+
+    served = ParserManager.get_parser(
+        tool_parser_name="qwen3_coder", reasoning_parser_name="qwen3",
+        enable_auto_tools=True,
+    )
+    composed = type("Composed", (DelegatingParser,), {
+        "reasoning_parser_cls": served.reasoning_parser_cls,
+        "tool_parser_cls": served.tool_parser_cls,
+    })
+    think, think_end, text = 50, 51, 7
+    tokenizer = make_mock_tokenizer({
+        "<think>": think, "</think>": think_end,
+        TOOL_CALL_START: 100, TOOL_CALL_END: 101,
+    })
+    parameters = {
+        "type": "object", "properties": {"text": {"type": "string"}},
+        "required": ["text"], "additionalProperties": False,
+    }
+    tool = {"type": "function", "function": {"name": "write", "parameters": parameters}}
+    function = {"type": "function", "name": "write", "parameters": parameters}
+
+    def chat(**fields):
+        return ChatCompletionRequest(model="m", messages=[], tools=[tool], **fields)
+
+    def responses(choice):
+        return ResponsesRequest.model_validate({
+            "model": "m", "input": "x", "tools": [function], "tool_choice": choice,
+            "kv_scope": "unit",
+        })
+
+    def allowed(mode):
+        return {"type": "allowed_tools", "mode": mode,
+                "tools": [{"type": "function", "name": "write"}]}
+
+    named = {"type": "function", "function": {"name": "write"}}
+    requests = [
+        chat(tool_choice="auto"), chat(tool_choice="none"),
+        chat(tool_choice="required"), chat(tool_choice=named),
+        chat(tool_choice="required", parallel_tool_calls=False),
+        chat(tool_choice="auto", parallel_tool_calls=False),
+        ChatCompletionRequest(model="m", messages=[]),
+        responses("required"), responses({"type": "function", "name": "write"}),
+        responses(allowed("required")), responses(allowed("auto")),
+        responses("none"),
+    ]
+    prompts = [
+        # The served generation prompt ends inside the <think> it wrote.
+        [text, think, text],
+        # A continued final message closed reasoning.
+        [think, text, think_end, text],
+        # A call the prompt opened after its reasoning ends that reasoning.
+        [think, text, 100, text],
+        # A template that leaves the opener to the model.
+        [text],
+        # No rendered prompt.
+        None,
+    ]
+    kwargs = {"chat_template_kwargs": {"enable_thinking": thinking}}
+    held = 0
+    for request in requests:
+        for prompt in prompts:
+            armed = [
+                parser_cls(tokenizer, request.tools, **kwargs).adjust_request(
+                    copy.deepcopy(request), prompt_token_ids=prompt
+                )
+                for parser_cls in (composed, served)
+            ]
+            dumps = [(
+                adjusted.skip_special_tokens,
+                adjusted.structured_outputs,
+                getattr(adjusted, "response_format", None),
+                getattr(adjusted, "text", None),
+            ) for adjusted in armed]
+            assert dumps[0] == dumps[1], (request.tool_choice, prompt)
+            outputs = armed[1].structured_outputs
+            held += bool(outputs is not None and outputs.enable_in_reasoning)
+    # The forced choices are held through reasoning exactly where the
+    # prompt left it open while the model thinks.
+    assert held == (6 if thinking else 0)
