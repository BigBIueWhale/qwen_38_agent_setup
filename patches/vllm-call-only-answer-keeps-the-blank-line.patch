     assert _is_grammar_accept_string(grammar, _QWEN3_CALL + "\n" + _QWEN3_CALL)
 
 
+@pytest.mark.parametrize("choice", ["required", "named"])
+def test_qwen3_call_only_answer_may_follow_the_template_blank_line(choice):
+    """A forced or required call is generable in the shape the model is trained on.
+
+    The grammar starts after ``</think>``, where the template writes a blank line
+    before a call that is the whole answer; it starts at the call itself when a
+    ``<tool_call>`` ended reasoning, or when the model does not reason. Nothing
+    else may precede the call.
+    """
+    selected = (
+        ChatCompletionNamedToolChoiceParam(
+            type="function", function=ChatCompletionNamedFunction(name="get_weather")
+        )
+        if choice == "named" else choice
+    )
+    grammar = _qwen3_grammar(selected, None)
+    assert _is_grammar_accept_string(grammar, "\n\n" + _QWEN3_CALL)
+    assert _is_grammar_accept_string(grammar, _QWEN3_CALL)
+    for refused in ("\n", " ", "\n\n\n", "\n\n\n\n", "Calling it.\n\n"):
+        assert not _is_grammar_accept_string(grammar, refused + _QWEN3_CALL), refused
+
+
 @pytest.mark.parametrize("reasoning", [False, True])
 @pytest.mark.parametrize("choice", ["auto", "required", "named"])
 def test_single_qwen_call_preserves_the_builtin_reasoning_prefix(reasoning, choice):
