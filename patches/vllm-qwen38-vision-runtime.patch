+    runtime = _get_cuda_runtime()
+    pointer = ctypes.c_void_p()
+    _check_cuda_runtime(
+        runtime.cudaMalloc(ctypes.byref(pointer), size),
+        f"cudaMalloc({size})",
+    )
+    if pointer.value is None:
+        raise RuntimeError("cudaMalloc succeeded without returning a pointer.")
+    try:
+        _check_cuda_runtime(
+            runtime.cudaMemset(pointer, 0, size),
+            f"cudaMemset({size})",
+        )
+        _check_cuda_runtime(
+            runtime.cudaDeviceSynchronize(),
+            "cudaDeviceSynchronize after headroom commit",
+        )
