+def _check_cuda_runtime(status: int, operation: str) -> None:
+    if status == _CUDA_SUCCESS:
+        return
+    runtime = _get_cuda_runtime()
+    error = runtime.cudaGetErrorString(status)
+    detail = error.decode("utf-8", errors="replace") if error else "unknown error"
+    raise RuntimeError(f"{operation} failed with CUDA error {status}: {detail}")
