+
+import pytest
+import torch
+
+from vllm.v1.worker import workspace
+
+pytestmark = pytest.mark.cpu_test
+
+
+def test_reclaimable_workspace_release_preserves_primary(monkeypatch):
+    empty_cache_calls = []
+    monkeypatch.setattr(
+        torch.accelerator, "empty_cache", lambda: empty_cache_calls.append(True)
+    )
+    manager = workspace.WorkspaceManager(torch.device("cpu"))
+    (primary,) = manager.get_simultaneous(((64,), torch.uint8))
+    primary.fill_(17)
+    primary_ptr = primary.data_ptr()
+    manager.get_reclaimable_simultaneous(
+        "phase-local",
+        ((64,), torch.float32),
+        ((32,), torch.float16),
+    )
+    manager.lock()
+    empty_cache_calls.clear()
+
+    released = manager.release_reclaimable_workspaces()
+
+    assert released == 512
+    assert primary.data_ptr() == primary_ptr
+    assert primary.tolist() == [17] * 64
+    with pytest.raises(AssertionError, match="Model phases must not overlap"):
+        manager.get_reclaimable_simultaneous(
+            "phase-local", ((64,), torch.float32)
+        )
+
+    assert manager.restore_reclaimable_workspaces() == released
+    assert empty_cache_calls == [True, True]
+    (restored,) = manager.get_reclaimable_simultaneous(
+        "phase-local", ((64,), torch.float32)
+    )
+    assert restored.shape == (64,)
+    with pytest.raises(AssertionError, match="is locked"):
+        manager.get_reclaimable_simultaneous(
+            "phase-local", ((1024,), torch.float32)
+        )
+
+
+def test_reclaimable_workspace_context_restores_after_error(monkeypatch):
+    empty_cache_calls = []
+    monkeypatch.setattr(
+        torch.accelerator, "empty_cache", lambda: empty_cache_calls.append(True)
+    )
+    manager = workspace.WorkspaceManager(torch.device("cpu"))
+    manager.get_reclaimable_simultaneous(
+        "phase-local", ((64,), torch.float32)
+    )
+    manager.lock()
+    empty_cache_calls.clear()
+    monkeypatch.setattr(workspace, "_manager", manager)
+
+    with pytest.raises(RuntimeError, match="encoder failed"):
+        with workspace.release_reclaimable_workspaces() as released:
+            assert released == 256
+            raise RuntimeError("encoder failed")
+
+    (restored,) = manager.get_reclaimable_simultaneous(
+        "phase-local", ((64,), torch.float32)
+    )
+    assert restored.shape == (64,)
+    assert empty_cache_calls == [True, True]
+
+
+def test_nested_reclaimable_workspace_release_fails_closed(monkeypatch):
+    monkeypatch.setattr(torch.accelerator, "empty_cache", lambda: None)
+    manager = workspace.WorkspaceManager(torch.device("cpu"))
+    manager.get_reclaimable_simultaneous(
+        "phase-local", ((64,), torch.float32)
+    )
+    manager.lock()
+    monkeypatch.setattr(workspace, "_manager", manager)
+
+    with pytest.raises(AssertionError, match="already released"):
+        with workspace.release_reclaimable_workspaces():
+            with workspace.release_reclaimable_workspaces():
+                pass
+
+    (restored,) = manager.get_reclaimable_simultaneous(
+        "phase-local", ((64,), torch.float32)
+    )
+    assert restored.shape == (64,)
