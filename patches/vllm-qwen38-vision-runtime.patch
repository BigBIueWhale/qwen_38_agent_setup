+def _enforce_qwen38_strict_content_part(part: dict[str, Any]) -> None:
+    """Enforce the sole lossless/static image input contract before I/O.
+
+    Validation happens before the connector is touched so unsupported URLs and
+    modalities cannot trigger network or file access and so cache identity is
+    always derived from the actual accepted PNG bytes rather than a caller-
+    supplied UUID.
+    """
+    part_type = part.get("type")
+    if not isinstance(part_type, str):
+        raise VLLMValidationError(
+            "The Qwen3.8 image contract requires an explicit content-part "
+            "'type'; undocumented shorthand media parts are forbidden.",
+            parameter="type",
+        )
+
+    if part.get("uuid") is not None:
+        raise VLLMValidationError(
+            "Caller-supplied multimodal UUIDs are forbidden by the Qwen3.8 "
+            "image contract; cache identity must be derived from the actual "
+            "PNG bytes.",
+            parameter="uuid",
+        )
+
+    forbidden_modalities = {
+        "audio_embeds",
+        "audio_url",
+        "image_embeds",
+        "image_pil",
+        "input_audio",
+        "prompt_embeds",
+        "tool_reference",
+        "video_url",
+    }
+    if part_type in forbidden_modalities:
+        raise VLLMValidationError(
+            f"Content part type {part_type!r} is forbidden by the sole "
+            "Qwen3.8 deployment. Only text and canonical inline PNG images "
+            "are supported; video, audio, embeddings, PIL objects, caller "
+            "UUIDs, and deferred tool references are disabled.",
+            parameter="type",
+            value=part_type,
+        )
+
+    if part_type == "image_url":
